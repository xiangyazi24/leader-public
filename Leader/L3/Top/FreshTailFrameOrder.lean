import Leader.L3.Top.FreshTailClose

/-!
Physical/audit bridges for Q7c P.3, with an independent finite-frame
chronology argument for the anchor half of J5.

All claims concern the actual fixed-public trace, the audit generated by
digitAuditStep, and the genealogy reconstructed from its scheduler word.
The complete J1 provenance induction and the J2 global receipt bijection
are not asserted.

Consumer: TopClockFreshTailPhase / TopFreshTailBackwardsPurity.
No protocol row is changed.
-/

namespace L3

open Classical

set_option autoImplicit false
set_option Elab.async false

/-- A real digit audit records no future frame and cannot give two
different selected physical edges the same service time.
Consumer: the first-tail anchor's strict sample/export chronology. -/
def TopFreshTailAuditFrameOrder {c : Compiled} {n : Nat}
    (A : DigitAudit c n) : Prop :=
  (∀ f : DigitFrame c n, f ∈ A.frames → f.time ≤ A.clock) ∧
  (∀ f g : DigitFrame c n,
    f ∈ A.frames → g ∈ A.frames →
    f.time = g.time → f.edge = g.edge)

/-- The arbitrary-private initial audit has no historical frame.
Consumer: TopFreshTailAuditFrameOrder on reached prefixes. -/
theorem topFreshTailAuditFrameOrderInitial
    {c : Compiled} {n : Nat} (S : Fin n → ProjD c) :
    TopFreshTailAuditFrameOrder (digitAuditInitial S) := by
  unfold TopFreshTailAuditFrameOrder
  constructor
  · intro f hf
    change f ∈ ([] : List (DigitFrame c n)) at hf
    cases hf
  · intro f g hf
    change f ∈ ([] : List (DigitFrame c n)) at hf
    cases hf


theorem topFreshTailAuditBorderSourceDistinct
    {n : Nat} (s : Fin n) (hn : 5 ≤ n) :
    certSite s 0 ≠ certSite s (topClockSpan n - 1) := by
  intro heq
  have hw := cert_rho_ge_three n hn
  change 3 ≤ topClockSpan n at hw
  have hindex :=
    topFreshTailCausalSourceSiteInjective s hn
      (⟨0, show 0 < topClockSpan n by omega⟩ :
        Fin (topClockSpan n))
      (⟨topClockSpan n - 1,
        show topClockSpan n - 1 < topClockSpan n by omega⟩ :
        Fin (topClockSpan n))
      heq
  have hv := congrArg Fin.val hindex
  change 0 = topClockSpan n - 1 at hv
  omega

theorem topFreshTailAuditInitialDataOrigin
    {n : Nat} (C : HeadlineConfiguration n)
    (s : Fin n) (j : Fin (topClockSpan n))
    (value : Fin (compileAdvice (ceilLogTwo n)).topA)
    (tail : Bool)
    (hdata : (C (certSite s j.val)).qOut = .D value tail) :
    (topFreshTailGenealogyInitial C s).slots j =
      some { origin := .inherited j, born := 0 } ∧
    ((digitAuditInitial (piD C)).current
      (certSite s j.val)).comparison.out.atom =
      some (.inherited .comparison (certSite s j.val) .output) := by
  constructor
  · simp [topFreshTailGenealogyInitial,
      topFreshTailGenealogyInitialSlot, hdata]
  · simp [digitAuditInitial, digitGhostInitial, DigitGhost.initial,
      DigitLaneGhost.initial, digitLaneView, piD,
      ProjD.ofAgent, DigitOutGhost.atom, hdata]

theorem topFreshTailAuditLaneUnreadSample
    {c : Compiled} {n : Nat}
    (stamp : Nat) (source destination : Fin n)
    (x y : DigitLaneView c)
    (gx gy : DigitLaneGhost c n)
    (hxl : x.leader = false) (hyl : y.leader = false)
    (hu : x.out = .U) :
    (digitLaneReplay .comparison stamp source destination
      x y gx gy).x.out.atom =
        some (.sampled
          { time := stamp, site := source, lane := .comparison }) ∧
    (digitLaneReplay .comparison stamp source destination
      x y gx gy).sample =
        some
          ({ id :=
              { time := stamp, site := source, lane := .comparison }
             value := x.digit
             tail := x.marker
             cause := gx.out.obligation } : DigitSample c n) := by
  simp [digitLaneReplay, hxl, hyl, hu,
    OutTok.isD, OutTok.isU, DigitOutGhost.atom]

theorem topFreshTailAuditLaneMoveAtom
    {c : Compiled} {n : Nat}
    (stamp : Nat) (source destination : Fin n)
    (x y : DigitLaneView c)
    (gx gy : DigitLaneGhost c n)
    (value : Fin c.topA) (tail : Bool)
    (hxl : x.leader = false) (hyl : y.leader = false)
    (hxo : x.out = .D value tail)
    (hyb : y.marker = false) (hyo : y.out = .E) :
    (digitLaneReplay .comparison stamp source destination
      x y gx gy).y.out.atom = gx.out.atom := by
  simp [digitLaneReplay, hxl, hyl, hxo, hyb, hyo,
    OutTok.isD, OutTok.isE, DigitOutGhost.atom]

/-- The same old-atom transfer on the actual responder of a
physical source D move; independent QI/QC writes do not modify it.
Consumer: J1 unchanged-atom transport induction. -/
theorem topFreshTailAuditPhysicalMoveAtom
    {n : Nat} (ring : DirectedRing n) (hn : 2 ≤ n)
    (C : HeadlineConfiguration n)
    (Z : TopFixedTraceState n) (e : Fin n)
    (value : Fin (compileAdvice (ceilLogTwo n)).topA)
    (tail : Bool)
    (hxl : (Z.1.1 e).l = false)
    (hyl : (Z.1.1 (ring.rightNeighbor e)).l = false)
    (hxo : (Z.1.1 e).qOut = .D value tail)
    (hyb : (Z.1.1 (ring.rightNeighbor e)).beta = false)
    (hyo : (Z.1.1 (ring.rightNeighbor e)).qOut = .E) :
    ((topFixedTraceNext ring C Z e).1.2.current
      (ring.rightNeighbor e)).comparison.out.atom =
    (Z.1.2.current e).comparison.out.atom := by
  have hne : ring.rightNeighbor e ≠ e :=
    EWord.rightNeighborDifferent ring hn e
  have hlocal :=
    topFreshTailAuditLaneMoveAtom
      (Z.1.2.clock + 1) e (ring.rightNeighbor e)
      (digitLaneView .comparison (piD Z.1.1 e)
        (piD Z.1.1 e).word.beta)
      (digitLaneView .comparison
        (piD Z.1.1 (ring.rightNeighbor e))
        (piD Z.1.1 (ring.rightNeighbor e)).word.beta)
      (Z.1.2.current e).comparison
      (Z.1.2.current (ring.rightNeighbor e)).comparison
      value tail
      (by change (Z.1.1 e).l = false; exact hxl)
      (by change (Z.1.1 (ring.rightNeighbor e)).l = false; exact hyl)
      (by change (Z.1.1 e).qOut = .D value tail; exact hxo)
      (by change (Z.1.1 (ring.rightNeighbor e)).beta = false; exact hyb)
      (by change (Z.1.1 (ring.rightNeighbor e)).qOut = .E; exact hyo)
  simp only [topFixedTraceNext, digitAuditStep, digitGhostStep,
    if_neg hne, if_pos rfl]
  change (digitLaneReplay .comparison (Z.1.2.clock + 1)
    e (ring.rightNeighbor e)
    (digitLaneView .comparison (piD Z.1.1 e)
      (piD Z.1.1 e).word.beta)
    (digitLaneView .comparison
      (piD Z.1.1 (ring.rightNeighbor e))
      (piD Z.1.1 (ring.rightNeighbor e)).word.beta)
    (Z.1.2.current e).comparison
    (Z.1.2.current (ring.rightNeighbor e)).comparison).y.out.atom =
    (Z.1.2.current e).comparison.out.atom
  exact hlocal


end L3

namespace L3

/-!
Repair of the dropped audit bridges.  Consumer:
TopClockFreshTailPhase / TopFreshTailBackwardsPurity.
-/

/-- The new audit frame is at old clock + 1; all earlier frames
stay at or before the old clock. Consumer: J5 anchor chronology. -/
theorem topFreshTailAuditFrameOrderStep
    {c : Compiled} {n : Nat} (ring : DirectedRing n)
    (S : Fin n → ProjD c) (A : DigitAudit c n)
    (e : Fin n)
    (horder : TopFreshTailAuditFrameOrder A) :
    TopFreshTailAuditFrameOrder (digitAuditStep ring S A e) := by
  unfold TopFreshTailAuditFrameOrder at horder ⊢
  constructor
  · intro f hf
    simp only [digitAuditStep, List.mem_cons] at hf
    rcases hf with hnew | hold
    · subst f
      change A.clock + 1 ≤ A.clock + 1
      exact Nat.le_refl _
    · have hb := horder.1 f hold
      change f.time ≤ A.clock + 1
      omega
  · intro f g hf hg ht
    simp only [digitAuditStep, List.mem_cons] at hf hg
    rcases hf with hnew | hold
    · subst f
      rcases hg with hgnew | hgold
      · subst g
        rfl
      · have hb := horder.1 g hgold
        dsimp only at ht
        omega
    · rcases hg with hgnew | hgold
      · subst g
        have hb := horder.1 f hold
        dsimp only at ht
        omega
      · exact horder.2 f g hold hgold ht

/-- Scheduler fold transports frame chronology through every
selected edge. Consumer: reached-trace J5 anchor chronology. -/
private theorem topFreshTailAuditFrameOrderFold
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n)
    (word : List (Fin n)) :
    ∀ Z : TopFixedTraceState n,
      TopFreshTailAuditFrameOrder Z.1.2 →
      TopFreshTailAuditFrameOrder
        (word.foldl (topFixedTraceNext ring C) Z).1.2 := by
  induction word with
  | nil =>
      intro Z h
      exact h
  | cons e rest ih =>
      intro Z h
      change TopFreshTailAuditFrameOrder
        (rest.foldl (topFixedTraceNext ring C)
          (topFixedTraceNext ring C Z e)).1.2
      exact ih (topFixedTraceNext ring C Z e)
        (topFreshTailAuditFrameOrderStep
          ring (piD Z.1.1) Z.1.2 e h)

/-- The audit of every reached physical prefix has unique
selected-edge times. Consumer: first accepted-tail chronology. -/
theorem topFreshTailAuditFrameOrderReached
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n)
    (Z : TopFixedTraceState n)
    (hreach : topClockReached ring C Z) :
    TopFreshTailAuditFrameOrder Z.1.2 := by
  have hrun :=
    topFreshTailAuditFrameOrderFold ring C Z.2
      ((C, digitAuditInitial (piD C)), [])
      (topFreshTailAuditFrameOrderInitial (piD C))
  change TopFreshTailAuditFrameOrder
    (topFixedTraceRun ring C Z.2).1.2 at hrun
  rw [← hreach] at hrun
  exact hrun

/-- J5's first half, with no firstness assumption: a reached
genuine source-border tail export is itself the concrete anchor
at the current clock. The older sample and export cannot be in
the same frame because their physical edges are distinct.
Consumer: TopFreshTailBackwardsPurity. -/
theorem topFreshTailAuditGenuineTailAnchor
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (Z : TopFixedTraceState n)
    (hreach : topClockReached ring C Z)
    (hgenuine : topClockGenuineTailAccepted C s Z) :
    ∃ anchor : DigitExport (compileAdvice (ceilLogTwo n)) n,
      topClockConcreteTailAnchor s Z anchor ∧
      anchor.time = Z.1.2.clock := by
  obtain ⟨sample, exported, hsample, hexport,
    hlane, hsite, _, htail, htime, heLane, heSource,
    heDest, heAtom, heValue, heTail, _⟩ := hgenuine
  have hsampleCopy := hsample
  have hexportCopy := hexport
  obtain ⟨fs, hfs, hfsTime, hfsEdge, _, _⟩ := hsample
  obtain ⟨fe, hfe, hfeTime, hfeEdge, _⟩ := hexport
  have horder :=
    topFreshTailAuditFrameOrderReached ring C Z hreach
  have hsbound := horder.1 fs hfs
  have hstrict : sample.id.time < exported.time := by
    have hne : sample.id.time ≠ exported.time := by
      intro heq
      have hedges : fs.edge = fe.edge :=
        horder.2 fs fe hfs hfe (by omega)
      have hsites :
          certSite s 0 =
            certSite s (topClockSpan n - 1) := by
        calc
          certSite s 0 = sample.id.site := hsite.symm
          _ = fs.edge := hfsEdge.symm
          _ = fe.edge := hedges
          _ = exported.source := hfeEdge
          _ = certSite s (topClockSpan n - 1) := heSource
      exact topFreshTailAuditBorderSourceDistinct s hn hsites
    omega
  refine ⟨exported, ?_, htime⟩
  refine ⟨hexportCopy, heLane, heSource, heDest, heTail, ?_⟩
  exact ⟨sample, hsampleCopy, hlane, hsite,
    htail, hstrict, heAtom, heValue⟩

/-- Every actual D at a reached source index occupies precisely
one genealogy slot, aged no later than the audit clock.
Consumer: J1 carrier existence in the full source provenance. -/
theorem topFreshTailAuditReachedDataCarrier
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (Z : TopFixedTraceState n)
    (hreach : topClockReached ring C Z)
    (j : Fin (topClockSpan n))
    (value : Fin (compileAdvice (ceilLogTwo n)).topA)
    (tail : Bool)
    (hdata : (Z.1.1 (certSite s j.val)).qOut =
      .D value tail) :
    ∃ carrier : TopFreshTailCarrier (topClockSpan n),
      (topFreshTailGenealogy ring C s Z).slots j =
        some carrier ∧
      carrier.born ≤ Z.1.2.clock := by
  have hqueue :=
    topFreshTailCloseReachedQueue ring C s hn hbad Z hreach
  cases hslot :
      (topFreshTailGenealogy ring C s Z).slots j with
  | none =>
      have hempty := (hqueue.slot j).2 hslot
      rw [hdata] at hempty
      cases hempty
  | some carrier =>
      have hage := hqueue.age j carrier hslot
      exact ⟨carrier, rfl, hage⟩

private def topFreshTailAuditInputReplay
    {c : Compiled} {n : Nat}
    (x y : DigitLaneView c)
    (gx gy : DigitLaneGhost c n) :
    DigitInputGhost n × Bool :=
  if x.leader || y.leader then
    ({ x := none, y := none, fx := true, fy := true }, false)
  else
    let terminal := y.leader || y.marker
    let success :=
      x.carryLive && !terminal && !y.carryLive && y.input.isS
    let launch :=
      !x.leader && x.marker && !x.carryLive &&
        x.input.isS && !y.leader
    let offer := x.out.isD && y.marker
    let s : DigitInputGhost n :=
      { x := gx.input, y := gy.input, fx := false, fy := false }
    let s :=
      if !s.fx && x.carryLive then
        { s with x := none, fx := true }
      else s
    let s :=
      if !s.fy && y.carryLive then
        { s with y := none, fy := true }
      else s
    let s :=
      if !s.fx && x.input.isS && inT x.input && !x.marker then
        { s with x := gx.input, fx := true }
      else s
    let s :=
      if !s.fx && x.input.isX then
        let s := { s with x := none, fx := true }
        if !s.fy && !y.leader && !y.marker && y.input.isS then
          { s with y := gx.input, fy := true }
        else s
      else s
    let s :=
      if success && !s.fy then
        { s with y := none, fy := true }
      else s
    let s :=
      if launch && !s.fx then
        { s with x := none, fx := true }
      else s
    let s :=
      if !s.fx && x.input.isP then
        if terminal then
          if !inT x.input then
            { s with x := gx.input, fx := true }
          else if !x.marker then
            { s with x := none, fx := true }
          else s
        else if !y.leader && !y.marker &&
            y.input.isE && !y.carryLive && !s.fy then
          { x := none, y := gx.input, fx := true, fy := true }
        else if y.input.isS && !y.carryLive then
          { s with x := gx.input, fx := true }
        else s
      else s
    let accepted :=
      !s.fy && offer && y.input.isE && !y.carryLive
    let s :=
      if accepted then
        { s with y := gx.out.atom, fy := true }
      else s
    (s, accepted)

/-- Only the acceptance bit matters for the export template.
This is a definitional equation of the original digitLaneReplay.
Consumer: J2 exported source/time/operand authentication. -/
private theorem topFreshTailAuditLaneExportEquation
    {c : Compiled} {n : Nat}
    (lane : DigitLane) (stamp : Nat)
    (source destination : Fin n)
    (x y : DigitLaneView c) (gx gy : DigitLaneGhost c n) :
    (digitLaneReplay lane stamp source destination
      x y gx gy).exported =
      if (topFreshTailAuditInputReplay x y gx gy).2 then
        some
          ({ time := stamp, lane := lane,
             source := source, destination := destination,
             operand := gx.out.atom, value := outV c x.out,
             tail := outT x.out } : DigitExport c n)
      else none := by
  rfl

/-- Every literal comparison export carries the OLD output atom
and exact service stamp and endpoints. Consumer: J2 audit frame. -/
theorem topFreshTailAuditLaneExportFields
    {c : Compiled} {n : Nat}
    (lane : DigitLane) (stamp : Nat)
    (source destination : Fin n)
    (x y : DigitLaneView c) (gx gy : DigitLaneGhost c n)
    (exported : DigitExport c n)
    (hevent :
      (digitLaneReplay lane stamp source destination
        x y gx gy).exported = some exported) :
    exported.time = stamp ∧ exported.lane = lane ∧
    exported.source = source ∧ exported.destination = destination ∧
    exported.operand = gx.out.atom := by
  rw [topFreshTailAuditLaneExportEquation] at hevent
  split at hevent
  · cases hevent
    exact ⟨rfl, rfl, rfl, rfl, rfl⟩
  · cases hevent

def TopFreshTailAuditSourceDataProvenance
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (Z : TopFixedTraceState n) : Prop :=
  ∀ (j : Fin (topClockSpan n))
    (value : Fin (compileAdvice (ceilLogTwo n)).topA)
    (tail : Bool),
    (Z.1.1 (certSite s j.val)).qOut = .D value tail →
    ∃ carrier : TopFreshTailCarrier (topClockSpan n),
      (topFreshTailGenealogy ring C s Z).slots j = some carrier ∧
      ((∃ i : Fin (topClockSpan n),
          carrier.origin = .inherited i ∧
          (Z.1.2.current (certSite s j.val)).comparison.out.atom =
            some (.inherited .comparison (certSite s i.val) .output)) ∨
       ∃ (k : Fin (topClockSpan n))
         (sample : DigitSample (compileAdvice (ceilLogTwo n)) n),
          DigitRecordedSample Z.1.2 sample ∧
          sample.id.lane = .comparison ∧
          sample.id.site = certSite s k.val ∧
          (Z.1.2.current (certSite s j.val)).comparison.out.atom =
            some (.sampled sample.id) ∧
          sample.value = value ∧ sample.tail = tail)

/-- J1 base: every arbitrary initial source D is a distinct
inherited carrier and carries its actual inherited comparison
output atom. Consumer: J1 induction from the raw audit start. -/
theorem topFreshTailAuditSourceDataInitial
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n) :
    TopFreshTailAuditSourceDataProvenance ring C s
      ((C, digitAuditInitial (piD C)), []) := by
  unfold TopFreshTailAuditSourceDataProvenance
  intro j value tail hdata
  have hinitial :=
    topFreshTailAuditInitialDataOrigin C s j value tail hdata
  refine ⟨{ origin := .inherited j, born := 0 }, ?_, Or.inl ?_⟩
  · change (topFreshTailGenealogyInitial C s).slots j =
      some { origin := .inherited j, born := 0 }
    exact hinitial.1
  · refine ⟨j, rfl, ?_⟩
    exact hinitial.2

/-- J1 off-pair induction case. A D outside both selected
physical endpoints keeps its byte, genealogy identity, and audit
atom. Old recorded sample witnesses remain in the new audit.
Consumer: TopFreshTailAuditSourceDataProvenance one-edge step. -/
theorem topFreshTailAuditSourceDataAwayStep
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (Z : TopFixedTraceState n) (e : Fin n)
    (hreach : topClockReached ring C Z)
    (hprov : TopFreshTailAuditSourceDataProvenance ring C s Z)
    (j : Fin (topClockSpan n))
    (value : Fin (compileAdvice (ceilLogTwo n)).topA)
    (tail : Bool)
    (hsource : certSite s j.val ≠ e)
    (htarget : certSite s j.val ≠ ring.rightNeighbor e)
    (hdata : (Z.1.1 (certSite s j.val)).qOut =
      .D value tail) :
    ((topFixedTraceNext ring C Z e).1.1
      (certSite s j.val)).qOut = .D value tail ∧
    ∃ carrier : TopFreshTailCarrier (topClockSpan n),
      (topFreshTailGenealogy ring C s
        (topFixedTraceNext ring C Z e)).slots j = some carrier ∧
      ((∃ i : Fin (topClockSpan n),
          carrier.origin = .inherited i ∧
          ((topFixedTraceNext ring C Z e).1.2.current
            (certSite s j.val)).comparison.out.atom =
            some (.inherited .comparison (certSite s i.val) .output)) ∨
       ∃ (k : Fin (topClockSpan n))
         (sample : DigitSample (compileAdvice (ceilLogTwo n)) n),
          DigitRecordedSample
            (topFixedTraceNext ring C Z e).1.2 sample ∧
          sample.id.lane = .comparison ∧
          sample.id.site = certSite s k.val ∧
          ((topFixedTraceNext ring C Z e).1.2.current
            (certSite s j.val)).comparison.out.atom =
            some (.sampled sample.id) ∧
          sample.value = value ∧ sample.tail = tail) := by
  obtain ⟨carrier, hslot, hkind⟩ :=
    hprov j value tail hdata
  have hphysical :
      ((topFixedTraceNext ring C Z e).1.1
        (certSite s j.val)).qOut = .D value tail := by
    change (topFixedPublicNext ring C Z.1.1 e
      (certSite s j.val)).qOut = .D value tail
    exact (topPortLiteralAwayFields ring C Z.1.1 e
      (certSite s j.val) hsource htarget).2.2.trans hdata
  have htrace :=
    topFreshTailGenealogyTraceReached ring C s Z hreach
  have hoccupied :
      ((topFreshTailGenealogy ring C s Z).trace.1.1
        (certSite s j.val)).qOut ≠ .E := by
    rw [htrace, hdata]
    intro h
    cases h
  have hslotNew :
      (topFreshTailGenealogy ring C s
        (topFixedTraceNext ring C Z e)).slots j =
          some carrier := by
    rw [topFreshTailCausalReplayNext]
    exact topFreshTailCausalOffPairFrame ring C s
      (topFreshTailGenealogy ring C s Z) e j carrier
      hsource htarget hoccupied hslot
  have hatomFrame :
      ((topFixedTraceNext ring C Z e).1.2.current
        (certSite s j.val)).comparison.out.atom =
      (Z.1.2.current (certSite s j.val)).comparison.out.atom := by
    change ((digitAuditStep ring (piD Z.1.1) Z.1.2 e).current
      (certSite s j.val)).comparison.out.atom =
      (Z.1.2.current (certSite s j.val)).comparison.out.atom
    simp only [digitAuditStep, digitGhostStep,
      if_neg hsource, if_neg htarget]
  refine ⟨hphysical, carrier, hslotNew, ?_⟩
  rcases hkind with hinherited | hsample
  · obtain ⟨i, horigin, hatom⟩ := hinherited
    refine Or.inl ⟨i, horigin, ?_⟩
    rw [hatomFrame]
    exact hatom
  · obtain ⟨k, sample, hrecord, hlane, hsite, hatom,
      hvalue, htail⟩ := hsample
    have hrecordNew :
        DigitRecordedSample
          (topFixedTraceNext ring C Z e).1.2 sample :=
      digitRecordedSampleStep ring (piD Z.1.1)
        Z.1.2 e sample hrecord
    refine Or.inr ⟨k, sample, hrecordNew,
      hlane, hsite, ?_, hvalue, htail⟩
    rw [hatomFrame]
    exact hatom

theorem topFreshTailAuditLaneBlockedPortAtom
    {c : Compiled} {n : Nat}
    (stamp : Nat) (source destination : Fin n)
    (x y : DigitLaneView c) (gx gy : DigitLaneGhost c n)
    (value : Fin c.topA) (tail : Bool)
    (hxl : x.leader = false) (hyl : y.leader = false)
    (hxo : x.out = .D value tail)
    (hyb : y.marker = true)
    (hblock : y.input.isE = false ∨ y.carryLive = true) :
    (digitLaneReplay .comparison stamp source destination
      x y gx gy).x.out.atom = gx.out.atom := by
  rcases hblock with hi | hc
  · cases hiy : y.input with
    | E =>
        simp [hiy, InTok.isE] at hi
    | P v t =>
        simp [digitLaneReplay, hxl, hyl, hxo, hyb, hiy,
          OutTok.isD, InTok.isE]
    | S v t =>
        simp [digitLaneReplay, hxl, hyl, hxo, hyb, hiy,
          OutTok.isD, InTok.isE]
    | X =>
        simp [digitLaneReplay, hxl, hyl, hxo, hyb, hiy,
          OutTok.isD, InTok.isE]
  · cases hyc : y.carryLive with
    | false =>
        rw [hyc] at hc
        cases hc
    | true =>
        simp [digitLaneReplay, hxl, hyl, hxo, hyb, hyc,
          OutTok.isD]

end L3

