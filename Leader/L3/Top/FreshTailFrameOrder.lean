  simp [List.reverse_cons, List.filterMap_append,
    List.filter_append, hframeExport, hafter, hsource,
    hsite, hdestination, hneighbor]
  rw [← hsite]
  exact hneighbor

/-- The accepted tracked root restores a full home-sampled source
staircase without ANY source input/carry premise. The received
sample and exported OLD atom are the genuine anchor witnesses.
Consumer: J5 B+ first-root exit and the W base. -/
theorem topFreshTailAcceptedPortRootHomeStaircase
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (Z : TopFixedTraceState n)
    (root : TopFreshTailCarrier (topClockSpan n))
    (k : Fin (topClockSpan n))
    (sample : DigitSample (compileAdvice (ceilLogTwo n)) n)
    (hbarrier :
      TopFreshTailFirstBorderHomeBarrier
        ring C s Z root k sample)
    (hterminal : k.val + 1 = topClockSpan n)
    (e : Fin n)
    (hsite : e = certSite s k.val)
    (hyi : (Z.1.1 (ring.rightNeighbor e)).qIn = .E)
    (hyc : (Z.1.1 (ring.rightNeighbor e)).qCarry = .OFF) :
    topClockGenuineTailAccepted C s
      (topFixedTraceNext ring C Z e) ∧
    ∀ j : Fin (topClockSpan n),
      TopFreshTailFirstBorderHomeSlot
        ring C s (topFixedTraceNext ring C Z e)
        root j := by
  have hgeom :=
    topFreshTailCausalSourcePublicGeometry
      ring C s hn hbad Z hbarrier.spatial.queue.trace.1 k
  have hxl : (Z.1.1 e).l = false := by
    rw [hsite]
    exact hgeom.1
  have hyl :
      (Z.1.1 (ring.rightNeighbor e)).l = false := by
    rw [hsite]
    exact hgeom.2.1
  have hpositive : k.val ≠ 0 := by
    have hr := cert_rho_ge_three n hn
    change 3 ≤ topClockSpan n at hr
    omega
  have hxb : (Z.1.1 e).beta = false := by
    have hb := hgeom.2.2.1
    rw [if_neg hpositive] at hb
    rw [hsite]
    exact hb
  have hyb : (Z.1.1 (ring.rightNeighbor e)).beta =
      true := by
    have hb := hgeom.2.2.2
    rw [if_pos hterminal] at hb
    rw [hsite]
    exact hb
  have hneighbor :
      ring.rightNeighbor e = certSite s (topClockSpan n) := by
    rw [hsite]
    rw [topFreshTailFirstBorderNeighborSite ring s k.val,
      hterminal]
  have hxo : (Z.1.1 e).qOut = .D sample.value true := by
    rw [hsite]
    exact hbarrier.spatial.rootData
  have hAtom :
      (Z.1.2.current e).comparison.out.atom =
        some (.sampled sample.id) := by
    rw [hsite]
    exact hbarrier.spatial.rootAtom
  have htrace :=
    hbarrier.spatial.queue.trace.2
  obtain ⟨hsourceU, htargetP, _, _, hslotNew, _, _, _,
    hexport⟩ :=
    topFreshTailAcceptedPortQOAllSourceScratch
      ring hn C s (topFreshTailGenealogy ring C s Z)
      e k sample.value true root hsite hterminal hneighbor
      (by rw [htrace]; exact hxl)
      (by rw [htrace]; exact hyl)
      (by rw [htrace]; exact hxb)
      (by rw [htrace]; exact hyb)
      (by rw [htrace]; exact hyi)
      (by rw [htrace]; exact hyc)
      (by rw [htrace]; exact hxo)
      hbarrier.spatial.rootSlot
  have hphysicalU :
      ((topFixedTraceNext ring C Z e).1.1 e).qOut =
        .U := by
    change ((topFixedTraceNext ring C
      (topFreshTailGenealogy ring C s Z).trace e).1.1 e).qOut =
        .U at hsourceU
    rw [htrace] at hsourceU
    simpa using hsourceU
  have htarget :
      ((topFixedTraceNext ring C Z e).1.1
        (certSite s (topClockSpan n))).qIn =
          .P sample.value true := by
    change ((topFixedTraceNext ring C
      (topFreshTailGenealogy ring C s Z).trace e).1.1
        (ring.rightNeighbor e)).qIn =
          .P sample.value true at htargetP
    rw [htrace, hneighbor] at htargetP
    exact htargetP
  have hlast :
      (topFreshTailGenealogy ring C s
        (topFixedTraceNext ring C Z e)).slots k =
          some (topFreshTailGenealogyRearm k
            (Z.1.2.clock + 1) root) := by
    rw [topFreshTailCausalReplayNext]
    have hs := hslotNew
    simp only [ite_true] at hs
    rw [htrace] at hs
    exact hs
  have hlastFresh :
      ∃ stamp : Nat,
        (topFreshTailGenealogyRearm k
          (Z.1.2.clock + 1) root).origin =
          .freshBorder stamp := by
    obtain ⟨stamp, hrootFresh⟩ := hbarrier.spatial.rootFresh
    exact ⟨stamp,
      by simp [topFreshTailGenealogyRearm, hpositive, hrootFresh]⟩
  have hrecordSample :=
    digitRecordedSampleStep
      ring (piD Z.1.1) Z.1.2 e sample
      hbarrier.spatial.sampleRecorded
  obtain ⟨exported, _, htime, hlane, hsrc, hdst,
    hoperand, hvalue, htail, hrecordExport, _⟩ := hexport
  have hrecordExportNext :
      DigitRecordedExport
        (topFixedTraceNext ring C Z e).1.2
        exported := by
    change DigitRecordedExport
      (topFixedTraceNext ring C
        (topFreshTailGenealogy ring C s Z).trace e).1.2
      exported at hrecordExport
    rw [htrace] at hrecordExport
    exact hrecordExport
  have htimeNext :
      exported.time =
        (topFixedTraceNext ring C Z e).1.2.clock := by
    rw [htrace] at htime
    change exported.time = Z.1.2.clock + 1
    exact htime
  have hportSource :
      exported.source = certSite s (topClockSpan n - 1) := by
    have hk : k.val = topClockSpan n - 1 := by omega
    rw [hsrc, hsite, hk]
  have hportDestination :
      exported.destination = certSite s (topClockSpan n) := by
    rw [hdst, hneighbor]
  have hportOperand :
      exported.operand = some (.sampled sample.id) := by
    rw [htrace] at hoperand
    exact hoperand.trans hAtom
  have hgenuine :
      topClockGenuineTailAccepted C s
        (topFixedTraceNext ring C Z e) := by
    unfold topClockGenuineTailAccepted
    exact ⟨sample, exported, hrecordSample, hrecordExportNext,
      hbarrier.spatial.sampleLane, hbarrier.spatial.sampleSite,
      hbarrier.spatial.samplePositive, hbarrier.spatial.sampleTail,
      htimeNext, hlane, hportSource, hportDestination,
      hportOperand, hvalue, htail, htarget⟩
  refine ⟨hgenuine, ?_⟩
  intro j
  by_cases hbelow : j.val < k.val
  · obtain ⟨hawaySource, hawayTarget⟩ :=
      topFreshTailFirstBorderEarlierSiteOffSelectedPair
        ring s hn j k hbelow e hsite
    exact topFreshTailFirstBorderHomeSlotAway
      ring C s Z root j e hbarrier.spatial.queue
      (hbarrier.home j hbelow)
      hawaySource hawayTarget
  · have heq : j = k := by
      apply Fin.ext
      have hj := j.isLt
      omega
    subst j
    unfold TopFreshTailFirstBorderHomeSlot
    refine ⟨topFreshTailGenealogyRearm k
      (Z.1.2.clock + 1) root,
      hlast, hlastFresh, ?_, Or.inl ?_⟩
    · intro hpositiveNext
      exact ⟨Z.1.2.clock + 1, rfl⟩
    · rw [← hsite]
      exact hphysicalU

/-- Fresh current-wave false head is removed; its actual local
sample is the accepted comparison operand. Consumer: W port
order / chronological false-tail export. -/
theorem topFreshTailAcceptedPortWaveFalseService
    {n : Nat} (ring : DirectedRing n) (hn : 5 ≤ n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (G : TopFreshTailGenealogyState n)
    (e : Fin n) (j : Fin (topClockSpan n))
    (v : Fin (compileAdvice (ceilLogTwo n)).topA)
    (parent : TopFreshTailCarrier (topClockSpan n))
    (hsite : e = certSite s j.val)
    (hterminal : j.val + 1 = topClockSpan n)
    (hneighbor :
      ring.rightNeighbor e = certSite s (topClockSpan n))
    (hxl : (G.trace.1.1 e).l = false)
    (hyl : (G.trace.1.1 (ring.rightNeighbor e)).l = false)
    (hxb : (G.trace.1.1 e).beta = false)
    (hyb : (G.trace.1.1 (ring.rightNeighbor e)).beta = true)
    (hyi : (G.trace.1.1 (ring.rightNeighbor e)).qIn = .E)
    (hyc : (G.trace.1.1 (ring.rightNeighbor e)).qCarry = .OFF)
    (hxo : (G.trace.1.1 e).qOut = .D v false)
    (hslot : G.slots j = some parent)
    (birth : Nat) (hfresh : parent.origin = .freshBorder birth)
    (home : Fin (topClockSpan n))
    (sample : DigitSample (compileAdvice (ceilLogTwo n)) n)
    (hrecord : DigitRecordedSample G.trace.1.2 sample)
    (hlane : sample.id.lane = .comparison)
    (hhome : sample.id.site = certSite s home.val)
    (hvalue : sample.value = v)
    (htail : sample.tail = false)
    (hatom :
      (G.trace.1.2.current e).comparison.out.atom =
        some (.sampled sample.id))
    (anchorTime : Nat)
    (hafter : anchorTime < G.trace.1.2.clock + 1) :
    (topFreshTailGenealogyStep ring C s G e).slots j = none ∧
    ((topFreshTailGenealogyStep ring C s G e).trace.1.1 e).qOut =
      .E ∧
    ∃ exported : DigitExport (compileAdvice (ceilLogTwo n)) n,
      DigitRecordedExport
        (topFreshTailGenealogyStep ring C s G e).trace.1.2
        exported ∧
      DigitRecordedSample
        (topFreshTailGenealogyStep ring C s G e).trace.1.2
        sample ∧
      exported.operand = some (.sampled sample.id) ∧
      exported.value = sample.value ∧
      exported.tail = sample.tail ∧
      exported.source = e ∧
      exported.destination = ring.rightNeighbor e ∧
      topClockConcreteExportsAfter s
        (topFreshTailGenealogyStep ring C s G e).trace anchorTime =
        topClockConcreteExportsAfter s G.trace anchorTime ++
          [exported] := by
  obtain ⟨hq, _, _, _, hs, _, _, _, hexport⟩ :=
    topFreshTailAcceptedPortQOAllSourceScratch
      ring hn C s G e j v false parent hsite hterminal
      hneighbor hxl hyl hxb hyb hyi hyc hxo hslot
  obtain ⟨exported, hevent, htime, _, hsource, hdest,
    hoperand, hresultValue, hresultTail, hrecordExport, _⟩ :=
      hexport
  have hrecordNext :=
    digitRecordedSampleStep ring (piD G.trace.1.1)
      G.trace.1.2 e sample hrecord
  have happend :=
    topFreshTailAcceptedPortChronologicalAppend
      ring C s G.trace e anchorTime exported hevent
      (by rw [htime]; exact hafter)
  refine ⟨by simpa using hs, by simpa using hq,
    exported, hrecordExport, hrecordNext,
    hoperand.trans hatom, ?_, ?_, hsource, hdest, happend⟩
  · exact hresultValue.trans hvalue.symm
  · exact hresultTail.trans htail.symm

/-- Fresh current-wave true tail exports the home-zero operand
and leaves its fresh terminal U for the next cohort.
Consumer: W terminal wave renewal. -/
theorem topFreshTailAcceptedPortWaveTrueService
    {n : Nat} (ring : DirectedRing n) (hn : 5 ≤ n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (G : TopFreshTailGenealogyState n)
    (e : Fin n) (j : Fin (topClockSpan n))
    (v : Fin (compileAdvice (ceilLogTwo n)).topA)
    (parent : TopFreshTailCarrier (topClockSpan n))
    (hsite : e = certSite s j.val)
    (hterminal : j.val + 1 = topClockSpan n)
    (hneighbor :
      ring.rightNeighbor e = certSite s (topClockSpan n))
    (hxl : (G.trace.1.1 e).l = false)
    (hyl : (G.trace.1.1 (ring.rightNeighbor e)).l = false)
    (hxb : (G.trace.1.1 e).beta = false)
    (hyb : (G.trace.1.1 (ring.rightNeighbor e)).beta = true)
    (hyi : (G.trace.1.1 (ring.rightNeighbor e)).qIn = .E)
    (hyc : (G.trace.1.1 (ring.rightNeighbor e)).qCarry = .OFF)
    (hxo : (G.trace.1.1 e).qOut = .D v true)
    (hslot : G.slots j = some parent)
    (birth : Nat) (hfresh : parent.origin = .freshBorder birth)
    (sample : DigitSample (compileAdvice (ceilLogTwo n)) n)
    (hrecord : DigitRecordedSample G.trace.1.2 sample)
    (hlane : sample.id.lane = .comparison)
    (hhome : sample.id.site = certSite s 0)
    (hvalue : sample.value = v)
    (htail : sample.tail = true)
    (hatom :
      (G.trace.1.2.current e).comparison.out.atom =
        some (.sampled sample.id))
    (anchorTime : Nat)
    (hafter : anchorTime < G.trace.1.2.clock + 1) :
    ((topFreshTailGenealogyStep ring C s G e).trace.1.1 e).qOut =
      .U ∧
    (topFreshTailGenealogyStep ring C s G e).slots j =
      some { origin := .freshBorder birth
             born := G.trace.1.2.clock + 1 } ∧
    ((topFreshTailGenealogyStep ring C s G e).trace.1.2.current
      e).comparison.out.atom = none ∧
    ∃ exported : DigitExport (compileAdvice (ceilLogTwo n)) n,
      DigitRecordedExport
        (topFreshTailGenealogyStep ring C s G e).trace.1.2
        exported ∧
      DigitRecordedSample
        (topFreshTailGenealogyStep ring C s G e).trace.1.2
        sample ∧
      exported.operand = some (.sampled sample.id) ∧
      exported.value = sample.value ∧
      exported.tail = sample.tail ∧
      (topFreshTailGenealogyStep ring C s G e).consumed =
        G.consumed ++
          [(G.trace.1.2.clock + 1, some parent.origin)] ∧
      topClockConcreteExportsAfter s
        (topFreshTailGenealogyStep ring C s G e).trace anchorTime =
        topClockConcreteExportsAfter s G.trace anchorTime ++
          [exported] := by
  obtain ⟨hq, _, _, _, hs, ha, _, _, hexport⟩ :=
    topFreshTailAcceptedPortQOAllSourceScratch
      ring hn C s G e j v true parent hsite hterminal
      hneighbor hxl hyl hxb hyb hyi hyc hxo hslot
  have hpositive : j.val ≠ 0 := by
    have hr := cert_rho_ge_three n hn
    change 3 ≤ topClockSpan n at hr
    omega
  have hchild :
      topFreshTailGenealogyRearm j
        (G.trace.1.2.clock + 1) parent =
        { origin := .freshBorder birth
          born := G.trace.1.2.clock + 1 } := by
    simp [topFreshTailGenealogyRearm, hpositive, hfresh]
  have hsFresh :
      (topFreshTailGenealogyStep ring C s G e).slots j =
        some { origin := .freshBorder birth
               born := G.trace.1.2.clock + 1 } := by
    simpa [hchild] using hs
  have hrecordNext :=
    digitRecordedSampleStep ring (piD G.trace.1.1)
      G.trace.1.2 e sample hrecord
  obtain ⟨exported, hevent, htime, _, _, _, hoperand,
    hresultValue, hresultTail, hrecordExport, hconsumed⟩ :=
      hexport
  have happend :=
    topFreshTailAcceptedPortChronologicalAppend
      ring C s G.trace e anchorTime exported hevent
      (by rw [htime]; exact hafter)
  refine ⟨by simpa using hq, hsFresh, ha, exported,
    hrecordExport, hrecordNext, hoperand.trans hatom,
    ?_, ?_, hconsumed, happend⟩
  · exact hresultValue.trans hvalue.symm
  · exact hresultTail.trans htail.symm

