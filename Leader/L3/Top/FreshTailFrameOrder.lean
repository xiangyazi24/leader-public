theorem topFreshTailFirstBorderHomeBarrierRootHop
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (Z : TopFixedTraceState n)
    (root : TopFreshTailCarrier (topClockSpan n))
    (k : Fin (topClockSpan n))
    (sample : DigitSample (compileAdvice (ceilLogTwo n)) n)
    (hbarrier :
      TopFreshTailFirstBorderHomeBarrier
        ring C s Z root k sample)
    (e : Fin n)
    (hsite : e = certSite s k.val)
    (hnext : k.val + 1 < topClockSpan n)
    (hempty :
      (Z.1.1 (ring.rightNeighbor e)).qOut = .E) :
    TopFreshTailFirstBorderHomeBarrier
      ring C s (topFixedTraceNext ring C Z e)
      root
      (⟨k.val + 1, hnext⟩ : Fin (topClockSpan n))
      sample := by
  have hspatialNext :=
    topFreshTailFirstBorderSpatialBarrierRootHop
      ring C s hn hbad Z root k sample
      hbarrier.spatial e hsite hnext hempty
  have hgeom :=
    topFreshTailCausalSourcePublicGeometry
      ring C s hn hbad Z hbarrier.spatial.queue.trace.1 k
  have hxl : (Z.1.1 e).l = false := by
    rw [hsite]
    exact hgeom.1
  have hyl :
      (Z.1.1 (ring.rightNeighbor e)).l = false := by
    rw [hsite]
    exact hgeom.2.1
  have hnotBorder : k.val + 1 ≠ topClockSpan n := by
    omega
  have hmarker :
      (Z.1.1 (ring.rightNeighbor e)).beta = false := by
    have hm := hgeom.2.2.2
    rw [if_neg hnotBorder] at hm
    rw [hsite]
    exact hm
  have hsource :
      (Z.1.1 e).qOut = .D sample.value true := by
    rw [hsite]
    exact hbarrier.spatial.rootData
  have hatom :
      (Z.1.2.current e).comparison.out.atom =
        some (.sampled sample.id) := by
    rw [hsite]
    exact hbarrier.spatial.rootAtom
  obtain ⟨hchild, _, hnewU, _, _, _, hfreshChild, _⟩ :=
    topFreshTailFirstBorderStaircaseStep
      ring C s hn hbad Z e k hnext hsite
      root hbarrier.spatial.rootSlot
      hbarrier.spatial.rootFresh
      sample hbarrier.spatial.sampleRecorded hatom
      sample.value hsource hempty hxl hyl hmarker
      hbarrier.spatial.queue
  refine {
    spatial := hspatialNext
    home := ?_ }
  intro j hj
  by_cases hbelow : j.val < k.val
  · obtain ⟨hawaySource, hawayTarget⟩ :=
      topFreshTailFirstBorderEarlierSiteOffSelectedPair
        ring s hn j k hbelow e hsite
    exact topFreshTailFirstBorderHomeSlotAway
      ring C s Z root j e hbarrier.spatial.queue
      (hbarrier.home j hbelow)
      hawaySource hawayTarget
  · have hhomeUpper : j.val < k.val + 1 := by
      simpa only [Fin.val_mk] using hj
    have hhomeEqual : j.val = k.val := by
      omega
    have heq : j = k := Fin.ext hhomeEqual
    subst j
    have horigin :
        0 < k.val →
        ∃ birth : Nat,
          topFreshTailGenealogyRearm k
            (Z.1.2.clock + 1) root =
            topFreshTailGenealogyRearm k birth root := by
      intro _
      exact ⟨Z.1.2.clock + 1, rfl⟩
    have hunread :
        ((topFixedTraceNext ring C Z e).1.1
          (certSite s k.val)).qOut = .U := by
      rw [← hsite]
      exact hnewU
    unfold TopFreshTailFirstBorderHomeSlot
    exact ⟨topFreshTailGenealogyRearm k
      (Z.1.2.clock + 1) root,
      hchild, hfreshChild, horigin, Or.inl hunread⟩

theorem topFreshTailFirstBorderHomeSlotUnread
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (Z : TopFixedTraceState n)
    (root : TopFreshTailCarrier (topClockSpan n))
    (j : Fin (topClockSpan n))
    (e : Fin n)
    (hqueue : TopFreshTailCausalQueue ring C s Z)
    (hhome :
      TopFreshTailFirstBorderHomeSlot ring C s Z root j)
    (hsite : e = certSite s j.val)
    (hunread : (Z.1.1 e).qOut = .U) :
    TopFreshTailFirstBorderHomeSlot
      ring C s (topFixedTraceNext ring C Z e) root j := by
  unfold TopFreshTailFirstBorderHomeSlot at hhome ⊢
  obtain ⟨carrier, hslot, hfresh, hparent, _⟩ := hhome
  obtain ⟨hdata, nextCarrier, hnextSlot, hnextFresh,
    localSample, hrecord, hlane, hsampleSite, hatom,
    hsampleValue, hsampleTail⟩ :=
    topFreshTailFirstBorderFreshUnreadSampleStep
      ring C s hn hbad Z e hqueue j
      hsite hunread carrier hslot hfresh
  have hdigit :=
    topFreshTailFirstBorderReachedDigit
      ring C Z hqueue.trace.1 (certSite s j.val)
  have hgeom :=
    topFreshTailCausalSourcePublicGeometry
      ring C s hn hbad Z hqueue.trace.1 j
  have hmark := hgeom.2.2.1
  have hsampleData :
      ((topFixedTraceNext ring C Z e).1.1
        (certSite s j.val)).qOut =
        .D (C (certSite s j.val)).d
          (if j.val = 0 then true else false) := by
    have hdigitAtSource :
        (Z.1.1 e).d = (C (certSite s j.val)).d := by
      rw [hsite]
      exact hdigit
    have hmarkerAtSource :
        (Z.1.1 e).beta =
          (if j.val = 0 then true else false) := by
      rw [hsite]
      exact hmark
    rw [hdigitAtSource, hmarkerAtSource] at hdata
    exact hdata
  have hvalue :
      localSample.value = (C (certSite s j.val)).d := by
    rw [hsite] at hsampleValue
    exact hsampleValue.trans hdigit
  have htail :
      localSample.tail =
        (if j.val = 0 then true else false) := by
    rw [hsite] at hsampleTail
    exact hsampleTail.trans hmark
  have hnewParentOrigin :
      0 < j.val →
      ∃ birth : Nat,
        nextCarrier = topFreshTailGenealogyRearm j birth root := by
    intro hpositive
    have hsourceGhost :
        ((topFreshTailGenealogy ring C s Z).trace.1.1 e).qOut =
          .U := by
      rw [hqueue.trace.2]
      exact hunread
    have hleftGhost :
        ((topFreshTailGenealogy ring C s Z).trace.1.1 e).l =
          false := by
      rw [hqueue.trace.2, hsite]
      exact hgeom.1
    have hrightGhost :
        ((topFreshTailGenealogy ring C s Z).trace.1.1
          (ring.rightNeighbor e)).l = false := by
      rw [hqueue.trace.2, hsite]
      exact hgeom.2.1
    have hsameGhost :=
      topFreshTailCausalUnreadInterior
        ring C s (topFreshTailGenealogy ring C s Z)
        e j carrier hsite hpositive
        hsourceGhost hleftGhost hrightGhost hslot
    have hsameSlot :
        (topFreshTailGenealogy ring C s
          (topFixedTraceNext ring C Z e)).slots j =
            some carrier := by
      rw [topFreshTailCausalReplayNext]
      exact hsameGhost
    have heq : nextCarrier = carrier := by
      rw [hsameSlot] at hnextSlot
      exact (Option.some.inj hnextSlot).symm
    rw [heq]
    exact hparent hpositive
  exact ⟨nextCarrier, hnextSlot, hnextFresh,
    hnewParentOrigin,
    Or.inr ⟨localSample, hsampleData, hrecord, hlane,
      hsampleSite, hvalue, htail, hatom⟩⟩

theorem topFreshTailFirstBorderHomeBarrierBehindStep
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (hl : ∀ i : Fin n, (C i).l = false)
    (Z : TopFixedTraceState n)
    (root : TopFreshTailCarrier (topClockSpan n))
    (k : Fin (topClockSpan n))
    (sample : DigitSample (compileAdvice (ceilLogTwo n)) n)
    (hbarrier :
      TopFreshTailFirstBorderHomeBarrier
        ring C s Z root k sample)
    (j : Fin (topClockSpan n))
    (hbelow : j.val < k.val)
    (e : Fin n)
    (hsite : e = certSite s j.val) :
    TopFreshTailFirstBorderHomeBarrier
      ring C s (topFixedTraceNext ring C Z e)
      root k sample := by
  have hspatialNext :=
    topFreshTailFirstBorderSpatialBarrierBehindStep
      ring C s hn hbad hl Z root k sample
      hbarrier.spatial j hbelow e hsite
  have hnext : j.val + 1 < topClockSpan n := by
    have hk := k.isLt
    omega
  have hneighbor :
      ring.rightNeighbor e = certSite s (j.val + 1) := by
    rw [hsite]
    exact topFreshTailFirstBorderNeighborSite ring s j.val
  have hoccupied :
      (Z.1.1 (ring.rightNeighbor e)).qOut ≠ .E := by
    have hnextCarrier :
        ∃ carrier : TopFreshTailCarrier (topClockSpan n),
          (topFreshTailGenealogy ring C s Z).slots
            (⟨j.val + 1, hnext⟩ :
              Fin (topClockSpan n)) = some carrier := by
      by_cases hbeforeRoot : j.val + 1 < k.val
      · obtain ⟨carrier, hslot, _⟩ :=
          hbarrier.spatial.behind
            (⟨j.val + 1, hnext⟩ :
              Fin (topClockSpan n)) hbeforeRoot
        exact ⟨carrier, hslot⟩
      · have hsuccessorOffset :
            j.val + 1 = k.val := by
          omega
        have hnextRoot :
            (⟨j.val + 1, hnext⟩ :
              Fin (topClockSpan n)) = k := by
          apply Fin.ext
          simpa only [Fin.val_mk] using hsuccessorOffset
        rw [hnextRoot]
        exact ⟨root, hbarrier.spatial.rootSlot⟩
    obtain ⟨carrier, hslot⟩ := hnextCarrier
    rw [hneighbor]
    exact topFreshTailFirstBorderOccupiedOfCarrier
      ring C s Z hbarrier.spatial.queue
      (⟨j.val + 1, hnext⟩ :
        Fin (topClockSpan n)) carrier hslot
  refine {
    spatial := hspatialNext
    home := ?_ }
  intro i hi
  have hhome := hbarrier.home i hi
  by_cases hsame : i = j
  · subst i
    have hhomeCopy := hhome
    unfold TopFreshTailFirstBorderHomeSlot at hhomeCopy
    obtain ⟨carrier, hslot, hfresh, hparent, hkind⟩ :=
      hhomeCopy
    rcases hkind with hunread |
      ⟨localSample, hdata, hrecord, hlane,
       hsampleSite, hvalue, htail, hatom⟩
    · have hsourceU : (Z.1.1 e).qOut = .U := by
        rw [hsite]
        exact hunread
      exact topFreshTailFirstBorderHomeSlotUnread
        ring C s hn hbad Z root j e
        hbarrier.spatial.queue hhome
        hsite hsourceU
    · exact topFreshTailFirstBorderHomeSlotOccupied
        ring C s hn hbad Z root j e
        hbarrier.spatial.queue hhome
        hsite hnext hoccupied
        localSample hdata hrecord hlane
        hsampleSite hvalue htail hatom
  · by_cases htarget :
        certSite s i.val = ring.rightNeighbor e
    · exact topFreshTailFirstBorderHomeSlotIncoming
        ring C s hn hl Z root i e
        hbarrier.spatial.queue hhome htarget.symm
    · have hsourceAway : certSite s i.val ≠ e := by
        intro heq
        have hindex :=
          topFreshTailCausalSourceSiteInjective
            s hn i j (heq.trans hsite)
        exact hsame hindex
      exact topFreshTailFirstBorderHomeSlotAway
        ring C s Z root i e hbarrier.spatial.queue
        hhome hsourceAway htarget

theorem topFreshTailFirstBorderHomeBarrierInteriorOwner
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (Z : TopFixedTraceState n)
    (root : TopFreshTailCarrier (topClockSpan n))
    (k : Fin (topClockSpan n))
    (sample : DigitSample (compileAdvice (ceilLogTwo n)) n)
    (hbarrier :
      TopFreshTailFirstBorderHomeBarrier
        ring C s Z root k sample)
    (e : Fin n)
    (hsite : e = certSite s k.val)
    (hnext : k.val + 1 < topClockSpan n) :
    ∃ moved : Fin (topClockSpan n),
      TopFreshTailFirstBorderHomeBarrier
        ring C s (topFixedTraceNext ring C Z e)
        root moved sample ∧
      (moved = k ∨ moved.val = k.val + 1) := by
  cases htarget : (Z.1.1 (ring.rightNeighbor e)).qOut with
  | E =>
      exact ⟨(⟨k.val + 1, hnext⟩ : Fin (topClockSpan n)),
        topFreshTailFirstBorderHomeBarrierRootHop
          ring C s hn hbad Z root k sample hbarrier
          e hsite hnext htarget, Or.inr rfl⟩
  | U =>
      have hoccupied :
          (Z.1.1 (ring.rightNeighbor e)).qOut ≠ .E := by
        intro he
        rw [htarget] at he
        cases he
      exact ⟨k,
        topFreshTailFirstBorderHomeBarrierOccupiedStep
          ring C s hn hbad Z root k sample hbarrier
          e hsite hnext hoccupied, Or.inl rfl⟩
  | D value tail =>
      have hoccupied :
          (Z.1.1 (ring.rightNeighbor e)).qOut ≠ .E := by
        intro he
        rw [htarget] at he
        cases he
      exact ⟨k,
        topFreshTailFirstBorderHomeBarrierOccupiedStep
          ring C s hn hbad Z root k sample hbarrier
          e hsite hnext hoccupied, Or.inl rfl⟩

theorem topFreshTailFirstBorderHomeBarrierNonacceptingStep
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (hl : ∀ i : Fin n, (C i).l = false)
    (Z : TopFixedTraceState n)
    (root : TopFreshTailCarrier (topClockSpan n))
    (k : Fin (topClockSpan n))
    (sample : DigitSample (compileAdvice (ceilLogTwo n)) n)
    (hbarrier :
      TopFreshTailFirstBorderHomeBarrier
        ring C s Z root k sample)
    (e : Fin n)
    (hblockIfTerminal :
      e = certSite s k.val →
      k.val + 1 = topClockSpan n →
      (Z.1.1 (ring.rightNeighbor e)).qIn.isE = false ∨
      (Z.1.1 (ring.rightNeighbor e)).qCarry.isOff = false) :
    ∃ moved : Fin (topClockSpan n),
      TopFreshTailFirstBorderHomeBarrier
        ring C s (topFixedTraceNext ring C Z e)
        root moved sample ∧
      (moved = k ∨ moved.val = k.val + 1) := by
  by_cases hsource :
      ∃ j : Fin (topClockSpan n), e = certSite s j.val
  · obtain ⟨j, hsite⟩ := hsource
    by_cases hbelow : j.val < k.val
    · exact ⟨k,
        topFreshTailFirstBorderHomeBarrierBehindStep
          ring C s hn hbad hl Z root k sample hbarrier
          j hbelow e hsite,
        Or.inl rfl⟩
    · by_cases hequal : j.val = k.val
      · have hindex : j = k := Fin.ext hequal
        subst j
        by_cases hnext : k.val + 1 < topClockSpan n
        · exact topFreshTailFirstBorderHomeBarrierInteriorOwner
            ring C s hn hbad Z root k sample
            hbarrier e hsite hnext
        · have hterminal : k.val + 1 = topClockSpan n := by
            have hk := k.isLt
            omega
          exact ⟨k,
            topFreshTailFirstBorderHomeBarrierPortBlocked
              ring C s hn hbad Z root k sample
              hbarrier hterminal e hsite
              (hblockIfTerminal hsite hterminal),
            Or.inl rfl⟩
      · have hahead : k.val < j.val := by omega
        exact ⟨k,
          topFreshTailFirstBorderHomeBarrierAheadStep
            ring C s hn hbad Z root k sample
            hbarrier j hahead e hsite,
          Or.inl rfl⟩
  · by_cases hincoming :
        ∃ j : Fin (topClockSpan n),
          ring.rightNeighbor e = certSite s j.val
    · obtain ⟨j, htarget⟩ := hincoming
      by_cases hjzero : j.val = 0
      · have hzeroIncoming :
            ring.rightNeighbor e = certSite s 0 := by
          rw [htarget, hjzero]
        by_cases hkzero : k.val = 0
        · exact ⟨k,
            topFreshTailFirstBorderHomeBarrierBorderIncoming
              ring C s hn hbad hl Z root k sample
              hbarrier hkzero e
              (by rw [hkzero]; exact hzeroIncoming),
            Or.inl rfl⟩
        · have hkpositive : 0 < k.val := by omega
          exact ⟨k,
            topFreshTailFirstBorderHomeBarrierIncomingZero
              ring C s hn hbad hl Z root k sample
              hbarrier hkpositive e hzeroIncoming,
            Or.inl rfl⟩
      · have hjpositive : 0 < j.val := by omega
        have hpredecessor :=
          topFreshTailCausalIncomingPredecessor
            ring hn s j hjpositive e htarget
        have hprevBound : j.val - 1 < topClockSpan n := by
          have hj := j.isLt
          omega
        exact False.elim (hsource
          ⟨(⟨j.val - 1, hprevBound⟩ :
             Fin (topClockSpan n)), hpredecessor⟩)
    · have hawaySource :
          ∀ j : Fin (topClockSpan n),
            certSite s j.val ≠ e := by
          intro j h
          exact hsource ⟨j, h.symm⟩
      have hawayTarget :
          ∀ j : Fin (topClockSpan n),
            certSite s j.val ≠ ring.rightNeighbor e := by
        intro j h
        exact hincoming ⟨j, h.symm⟩
      exact ⟨k,
        topFreshTailFirstBorderHomeBarrierAwayStep
          ring C s hn hbad Z root k sample
          hbarrier e hawaySource hawayTarget,
        Or.inl rfl⟩

theorem topFreshTailFirstBorderHomeBarrierBlockedWord
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (hl : ∀ i : Fin n, (C i).l = false)
    (word : List (Fin n)) :
    ∀ (Z : TopFixedTraceState n)
      (root : TopFreshTailCarrier (topClockSpan n))
      (k : Fin (topClockSpan n))
      (sample : DigitSample (compileAdvice (ceilLogTwo n)) n),
      TopFreshTailFirstBorderHomeBarrier
        ring C s Z root k sample →
      (∀ (pre suffix : List (Fin n))
          (e : Fin n)
          (position : Fin (topClockSpan n)),
        word = pre ++ e :: suffix →
        TopFreshTailFirstBorderHomeBarrier
          ring C s
          (pre.foldl (topFixedTraceNext ring C) Z)
          root position sample →
        e = certSite s position.val →
        position.val + 1 = topClockSpan n →
        ((pre.foldl (topFixedTraceNext ring C) Z).1.1
          (ring.rightNeighbor e)).qIn.isE = false ∨
        ((pre.foldl (topFixedTraceNext ring C) Z).1.1
          (ring.rightNeighbor e)).qCarry.isOff = false) →
      ∃ finalPosition : Fin (topClockSpan n),
        TopFreshTailFirstBorderHomeBarrier
          ring C s
          (word.foldl (topFixedTraceNext ring C) Z)
          root finalPosition sample ∧
        k.val ≤ finalPosition.val := by
  induction word with
  | nil =>
      intro Z root k sample hbarrier hblocked
      exact ⟨k, hbarrier, Nat.le_refl _⟩
  | cons e rest ih =>
      intro Z root k sample hbarrier hblocked
      have hblockAtRoot :
          e = certSite s k.val →
          k.val + 1 = topClockSpan n →
          (Z.1.1 (ring.rightNeighbor e)).qIn.isE = false ∨
          (Z.1.1 (ring.rightNeighbor e)).qCarry.isOff =
            false := by
        intro hsite hterminal
        exact hblocked [] rest e k rfl
          (by simpa only [List.foldl_nil] using hbarrier)
          hsite hterminal
      obtain ⟨moved, hbarrierNext, hstep⟩ :=
        topFreshTailFirstBorderHomeBarrierNonacceptingStep
          ring C s hn hbad hl Z root k sample
          hbarrier e hblockAtRoot
      have hblockedRest :
          ∀ (pre suffix : List (Fin n))
            (edge : Fin n)
            (position : Fin (topClockSpan n)),
            rest = pre ++ edge :: suffix →
            TopFreshTailFirstBorderHomeBarrier
              ring C s
              (pre.foldl (topFixedTraceNext ring C)
                (topFixedTraceNext ring C Z e))
              root position sample →
            edge = certSite s position.val →
            position.val + 1 = topClockSpan n →
            ((pre.foldl (topFixedTraceNext ring C)
              (topFixedTraceNext ring C Z e)).1.1
              (ring.rightNeighbor edge)).qIn.isE = false ∨
            ((pre.foldl (topFixedTraceNext ring C)
              (topFixedTraceNext ring C Z e)).1.1
              (ring.rightNeighbor edge)).qCarry.isOff =
                false := by
        intro pre suffix edge position hdecomp hprefix
          hsite hterminal
        have hwhole :
            e :: rest = (e :: pre) ++ edge :: suffix := by
          rw [hdecomp]
          rfl
        have hprefixWhole :
            TopFreshTailFirstBorderHomeBarrier
              ring C s
              ((e :: pre).foldl (topFixedTraceNext ring C) Z)
              root position sample := by
          change TopFreshTailFirstBorderHomeBarrier
            ring C s
            (pre.foldl (topFixedTraceNext ring C)
              (topFixedTraceNext ring C Z e))
            root position sample
          exact hprefix
        exact hblocked (e :: pre) suffix edge position
          hwhole hprefixWhole hsite hterminal
      obtain ⟨finalPosition, hfinal, hmonotone⟩ :=
        ih (topFixedTraceNext ring C Z e) root moved sample
          hbarrierNext hblockedRest
      refine ⟨finalPosition, ?_, ?_⟩
      · change TopFreshTailFirstBorderHomeBarrier
          ring C s
          (rest.foldl (topFixedTraceNext ring C)
            (topFixedTraceNext ring C Z e))
          root finalPosition sample
        exact hfinal
      · rcases hstep with hstay | hmove
        · rw [hstay] at hmonotone
          exact hmonotone
        · omega

theorem topFreshTailFirstBorderAcceptedHomeAfterBlockedWord
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (hl : ∀ i : Fin n, (C i).l = false)
    (word : List (Fin n))
    (Z : TopFixedTraceState n)
    (root : TopFreshTailCarrier (topClockSpan n))
    (k : Fin (topClockSpan n))
    (sample : DigitSample (compileAdvice (ceilLogTwo n)) n)
    (hbarrier :
      TopFreshTailFirstBorderHomeBarrier
        ring C s Z root k sample)
    (hblocked :
      ∀ (pfx suffix : List (Fin n))
          (edge : Fin n)
          (position : Fin (topClockSpan n)),
        word = pfx ++ edge :: suffix →
        TopFreshTailFirstBorderHomeBarrier
          ring C s
          (pfx.foldl (topFixedTraceNext ring C) Z)
          root position sample →
        edge = certSite s position.val →
        position.val + 1 = topClockSpan n →
        ((pfx.foldl (topFixedTraceNext ring C) Z).1.1
          (ring.rightNeighbor edge)).qIn.isE = false ∨
        ((pfx.foldl (topFixedTraceNext ring C) Z).1.1
          (ring.rightNeighbor edge)).qCarry.isOff = false)
    (e : Fin n)
    (hport : e = certSite s (topClockSpan n - 1))
    (hterminalSlot :
      (topFreshTailGenealogy ring C s
        (word.foldl (topFixedTraceNext ring C) Z)).slots
        (⟨topClockSpan n - 1,
          show topClockSpan n - 1 < topClockSpan n by
            have hr := cert_rho_ge_three n hn
            change 3 ≤ topClockSpan n at hr
            omega⟩ : Fin (topClockSpan n)) = some root)
    (hxi :
      ((word.foldl (topFixedTraceNext ring C) Z).1.1 e).qIn =
        .E)
    (hxc :
      ((word.foldl (topFixedTraceNext ring C) Z).1.1 e).qCarry =
        .OFF)
    (hyi :
      ((word.foldl (topFixedTraceNext ring C) Z).1.1
        (ring.rightNeighbor e)).qIn = .E)
    (hyc :
      ((word.foldl (topFixedTraceNext ring C) Z).1.1
        (ring.rightNeighbor e)).qCarry = .OFF)
    (exported : DigitExport (compileAdvice (ceilLogTwo n)) n)
    (hevent :
      topFreshTailGenealogyPortExport ring C s
        (word.foldl (topFixedTraceNext ring C) Z) e =
          some exported) :
    topClockGenuineTailAccepted C s
      (topFixedTraceNext ring C
        (word.foldl (topFixedTraceNext ring C) Z) e) ∧
    ∀ j : Fin (topClockSpan n),
      TopFreshTailFirstBorderHomeSlot ring C s
        (topFixedTraceNext ring C
          (word.foldl (topFixedTraceNext ring C) Z) e)
        root j := by
  obtain ⟨finalPosition, hfinal, _⟩ :=
    topFreshTailFirstBorderHomeBarrierBlockedWord
      ring C s hn hbad hl word Z root k sample
      hbarrier hblocked
  have hsamePosition :
      finalPosition =
        (⟨topClockSpan n - 1,
          show topClockSpan n - 1 < topClockSpan n by
            have hr := cert_rho_ge_three n hn
            change 3 ≤ topClockSpan n at hr
            omega⟩ : Fin (topClockSpan n)) :=
    hfinal.spatial.queue.identity
      finalPosition
      (⟨topClockSpan n - 1,
        show topClockSpan n - 1 < topClockSpan n by
          have hr := cert_rho_ge_three n hn
          change 3 ≤ topClockSpan n at hr
          omega⟩ : Fin (topClockSpan n))
      root root hfinal.spatial.rootSlot
      hterminalSlot rfl rfl
  have hvalue := congrArg Fin.val hsamePosition
  change finalPosition.val = topClockSpan n - 1 at hvalue
  have hterminal : finalPosition.val + 1 = topClockSpan n := by
    have hr := cert_rho_ge_three n hn
    change 3 ≤ topClockSpan n at hr
    omega
  have hsite : e = certSite s finalPosition.val := by
    rw [hvalue]
    exact hport
  exact topFreshTailFirstBorderAcceptedHomeStaircase
    ring C s hn hbad
    (word.foldl (topFixedTraceNext ring C) Z)
    root finalPosition sample hfinal hterminal
    e hsite hxi hxc hyi hyc exported hevent

/-- The OLD comparison audit creates exactly this selected
physical frame at one service. The frame is the data used by
topClockConcreteExportsAfter, not a reconstructed receipt or
a genealogy consumed-list entry. Consumer: post-anchor
chronological wave export step. -/
def topFreshTailPostAnchorCurrentFrame
    {n : Nat} (ring : DirectedRing n)
    (Z : TopFixedTraceState n) (e : Fin n) :
    DigitFrame (compileAdvice (ceilLogTwo n)) n :=
  { time := Z.1.2.clock + 1
    edge := e
    old := piD Z.1.1
    oldGhost := Z.1.2.current
    receipt := digitService (Z.1.2.clock + 1)
      e (ring.rightNeighbor e)
      (piD Z.1.1 e)
      (piD Z.1.1 (ring.rightNeighbor e))
      (Z.1.2.current e)
      (Z.1.2.current (ring.rightNeighbor e)) }

/-- The new real frame is prepended to the audit's reverse-time
frame list on every selected OLD service. Consumer: exact
post-anchor chronological export-count update. -/
theorem topFreshTailPostAnchorCurrentFrameNext
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n)
    (Z : TopFixedTraceState n) (e : Fin n) :
    (topFixedTraceNext ring C Z e).1.2.frames =
      topFreshTailPostAnchorCurrentFrame ring Z e ::
        Z.1.2.frames := by
  rfl

/-- The new frame's comparison export, if any, is filtered
against the same pinned anchor clock and port endpoints as
topClockConcreteExportsAfter. At most one entry belongs to
this one OLD service. Consumer: W.export one-edge accounting. -/
def topFreshTailPostAnchorNewEntries
    {n : Nat} (ring : DirectedRing n)
    (s : Fin n) (Z : TopFixedTraceState n)
    (anchorTime : Nat) (e : Fin n) :
    List (DigitExport (compileAdvice (ceilLogTwo n)) n) :=
  (([topFreshTailPostAnchorCurrentFrame ring Z e] :
      List (DigitFrame (compileAdvice (ceilLogTwo n)) n)).filterMap
    (fun frame =>
      (digitReceiptLane .comparison frame.receipt).exported)).filter
    (fun exported =>
      if anchorTime < exported.time ∧
          exported.source = certSite s (topClockSpan n - 1) ∧
          exported.destination = certSite s (topClockSpan n)
      then true else false)

/-- The chronological comparison export list after the actual
fixed-public service is the old concrete filtered list with
the selected OLD frame's zero-or-one qualified export appended.
There is no reordering by birth time or consumed-origin.
Consumer: topFreshTailPostAnchorWaveRun, W.export step. -/
theorem topFreshTailPostAnchorExportsAfterStep
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (Z : TopFixedTraceState n) (anchorTime : Nat)
    (e : Fin n) :
    topClockConcreteExportsAfter s
      (topFixedTraceNext ring C Z e) anchorTime =
      topClockConcreteExportsAfter s Z anchorTime ++
        topFreshTailPostAnchorNewEntries ring s Z anchorTime e := by
  unfold topClockConcreteExportsAfter
    topFreshTailPostAnchorNewEntries
  rw [topFreshTailPostAnchorCurrentFrameNext]
  simp only [List.reverse_cons, List.filterMap_append,
    List.filter_append]

/-- Filtering the one newly selected OLD comparison frame yields
either no post-anchor port export or a singleton containing
the exact qualified receipt. Consumer: post-anchor export-count
zero-or-one accounting for every scheduler edge. -/
theorem topFreshTailPostAnchorNewEntriesShape
    {n : Nat} (ring : DirectedRing n)
    (s : Fin n) (Z : TopFixedTraceState n)
    (anchorTime : Nat) (e : Fin n) :
    topFreshTailPostAnchorNewEntries
      ring s Z anchorTime e = [] ∨
    ∃ exported : DigitExport
        (compileAdvice (ceilLogTwo n)) n,
      topFreshTailPostAnchorNewEntries
        ring s Z anchorTime e = [exported] ∧
      anchorTime < exported.time ∧
      exported.source = certSite s (topClockSpan n - 1) ∧
      exported.destination = certSite s (topClockSpan n) := by
  cases hlocal :
      (digitReceiptLane .comparison
        (topFreshTailPostAnchorCurrentFrame
          ring Z e).receipt).exported with
  | none =>
      apply Or.inl
      simp [topFreshTailPostAnchorNewEntries, hlocal]
  | some exported =>
      by_cases hqual :
          anchorTime < exported.time ∧
          exported.source = certSite s (topClockSpan n - 1) ∧
          exported.destination = certSite s (topClockSpan n)
      · refine Or.inr ⟨exported, ?_, hqual.1,
          hqual.2.1, hqual.2.2⟩
        simp [topFreshTailPostAnchorNewEntries,
          hlocal, hqual]
      · apply Or.inl
        simp [topFreshTailPostAnchorNewEntries,
          hlocal, hqual]

/-- The selected OLD comparison port service contributes
exactly one new export after the anchor. Its time, operand,
source and destination are the actual selected audit fields,
and the consumed genealogy entry records the actual terminal
carrier's origin at that very service clock.
Consumer: W.export/receipt and chronological J2 append row. -/
theorem topFreshTailPostAnchorSelectedPortAppend
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (Z : TopFixedTraceState n)
    (hreach : topClockReached ring C Z)
    (anchorTime : Nat)
    (hanchor : anchorTime ≤ Z.1.2.clock)
    (atom : Option (DigitAtom n))
    (hready : topClockPortReady s atom Z)
    (e : Fin n)
    (exported : DigitExport
      (compileAdvice (ceilLogTwo n)) n)
    (hevent :
      topFreshTailGenealogyPortExport ring C s Z e =
        some exported) :
    topClockConcreteExportsAfter s
      (topFixedTraceNext ring C Z e) anchorTime =
      topClockConcreteExportsAfter s Z anchorTime ++
        [exported] ∧
    DigitRecordedExport
      (topFixedTraceNext ring C Z e).1.2 exported ∧
    exported.time = Z.1.2.clock + 1 ∧
    exported.operand = atom ∧
    ∃ carrier : TopFreshTailCarrier (topClockSpan n),
      (topFreshTailGenealogy ring C s Z).slots
        (⟨topClockSpan n - 1,
          show topClockSpan n - 1 < topClockSpan n by
            have hr := cert_rho_ge_three n hn
            change 3 ≤ topClockSpan n at hr
            omega⟩ : Fin (topClockSpan n)) =
          some carrier ∧
      (topFreshTailGenealogy ring C s
        (topFixedTraceNext ring C Z e)).consumed =
        (topFreshTailGenealogy ring C s Z).consumed ++
          [(exported.time, some carrier.origin)] := by
  obtain ⟨hsite, hneighbor, hrecord, htime, hlane,
    hsource, hdest, hoperand, _⟩ :=
    topFreshTailAuditSelectedPortFrame
      ring C s Z e exported hevent
  have hp :
      e = certSite s (topClockSpan n - 1) ∧
      ring.rightNeighbor e = certSite s (topClockSpan n) :=
    ⟨hsite, hneighbor⟩
  have hlocal :
      (digitReceiptLane .comparison
        (topFreshTailPostAnchorCurrentFrame
          ring Z e).receipt).exported = some exported := by
    change
      (digitService (Z.1.2.clock + 1)
        e (ring.rightNeighbor e)
        (piD Z.1.1 e) (piD Z.1.1 (ring.rightNeighbor e))
        (Z.1.2.current e)
        (Z.1.2.current (ring.rightNeighbor e))).comparison.exported =
          some exported
    simpa only [topFreshTailGenealogyPortExport,
      if_pos hp] using hevent
  have hqualified :
      anchorTime < exported.time ∧
      exported.source = certSite s (topClockSpan n - 1) ∧
      exported.destination = certSite s (topClockSpan n) := by
    exact ⟨by omega, hsource.trans hsite, hdest.trans hneighbor⟩
  have hdelta :
      topFreshTailPostAnchorNewEntries
        ring s Z anchorTime e = [exported] := by
    simp [topFreshTailPostAnchorNewEntries,
      hlocal, hqualified]
  have happend :
      topClockConcreteExportsAfter s
        (topFixedTraceNext ring C Z e) anchorTime =
        topClockConcreteExportsAfter s Z anchorTime ++
          [exported] := by
    rw [topFreshTailPostAnchorExportsAfterStep, hdelta]
  obtain ⟨carrier, hslot, _, _, _, _, _, _,
    hoperandPort, hconsumed⟩ :=
    topFreshTailAuditPortOldCarrierFrame
      ring C s hn hbad Z hreach atom hready
      e exported hevent
  have hconsumedNext :
      (topFreshTailGenealogy ring C s
        (topFixedTraceNext ring C Z e)).consumed =
        (topFreshTailGenealogy ring C s Z).consumed ++
          [(exported.time, some carrier.origin)] := by
    rw [topFreshTailCausalReplayNext]
    rw [htime]
    exact hconsumed
  refine ⟨happend, hrecord, htime, ?_, carrier,
    hslot, hconsumedNext⟩
  exact hoperandPort

/-- An active post-anchor home packet carries its immutable
home index h separately from its current physical position x.
An unread packet must still be at h. A D may have moved right,
but its actual comparison atom names a recorded sample from
exactly the original home, with the frozen digit and the
source-zero-only true tail bit.
Consumer: post-anchor W.current and receipt order. -/
def TopFreshTailPostAnchorActiveHome
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (Z : TopFixedTraceState n)
    (h x : Fin (topClockSpan n))
    (carrier : TopFreshTailCarrier (topClockSpan n)) : Prop :=
  h.val ≤ x.val ∧
  (topFreshTailGenealogy ring C s Z).slots x = some carrier ∧
  (∃ stamp : Nat, carrier.origin = .freshBorder stamp) ∧
  ((x = h ∧
      (Z.1.1 (certSite s x.val)).qOut = .U) ∨
    ∃ localSample :
      DigitSample (compileAdvice (ceilLogTwo n)) n,
      (Z.1.1 (certSite s x.val)).qOut =
        .D (C (certSite s h.val)).d
          (if h.val = 0 then true else false) ∧
      DigitRecordedSample Z.1.2 localSample ∧
      localSample.id.lane = .comparison ∧
      localSample.id.site = certSite s h.val ∧
      localSample.value = (C (certSite s h.val)).d ∧
      localSample.tail =
        (if h.val = 0 then true else false) ∧
      (Z.1.2.current
        (certSite s x.val)).comparison.out.atom =
          some (.sampled localSample.id))

/-- A strengthened post-anchor wave is indexed by the actual
chronological number of comparison port exports strictly
after the fixed anchor. The current active family occupies
increasing sites from source homes 0 through b, while its
source-zero true-tail member builds a second stationary-home
staircase behind it. Every source slot belongs to one of
these families or is physically empty. Past export receipts
retain their exact home/site, value, tail and sample ID.
This is proof-only information on the OLD trace and audit.
Consumer: W.next / W.export one-edge induction. -/
structure TopFreshTailPostAnchorWave
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (Z : TopFixedTraceState n)
    (anchor : DigitExport
      (compileAdvice (ceilLogTwo n)) n) : Prop where
  reached : topClockReached ring C Z
  queue : TopFreshTailCausalQueue ring C s Z
  provenance : TopFreshTailAuditSourceDataProvenance ring C s Z
  anchorRecorded : topClockConcreteTailAnchor s Z anchor
  allFresh :
    ∀ (j : Fin (topClockSpan n))
      (a : TopFreshTailCarrier (topClockSpan n)),
      (topFreshTailGenealogy ring C s Z).slots j = some a →
      ∃ stamp : Nat, a.origin = .freshBorder stamp
  current :
    ∀ h : Fin (topClockSpan n),
      h.val ≤ topClockSpan n - 1 -
        ((topClockConcreteExportsAfter s Z
          anchor.time).length % topClockSpan n) →
      ∃ (x : Fin (topClockSpan n))
        (a : TopFreshTailCarrier (topClockSpan n)),
        TopFreshTailPostAnchorActiveHome ring C s Z h x a
  currentOrder :
    ∀ h i : Fin (topClockSpan n),
      h.val < i.val →
      i.val ≤ topClockSpan n - 1 -
        ((topClockConcreteExportsAfter s Z
          anchor.time).length % topClockSpan n) →
      ∀ (x y : Fin (topClockSpan n))
        (a b : TopFreshTailCarrier (topClockSpan n)),
        TopFreshTailPostAnchorActiveHome ring C s Z h x a →
        TopFreshTailPostAnchorActiveHome ring C s Z i y b →
        x.val < y.val
  rootAndNext :
    ∃ (root : TopFreshTailCarrier (topClockSpan n))
      (k : Fin (topClockSpan n)),
      TopFreshTailPostAnchorActiveHome ring C s Z
        (⟨0, show 0 < topClockSpan n by
          have hr := cert_rho_ge_three n hn
          change 3 ≤ topClockSpan n at hr
          omega⟩ : Fin (topClockSpan n))
        k root ∧
      ((k.val = 0 ∧
        (Z.1.1 (certSite s 0)).qOut = .U) ∨
       ∃ sample :
         DigitSample (compileAdvice (ceilLogTwo n)) n,
         DigitRecordedSample Z.1.2 sample ∧
         sample.id.lane = .comparison ∧
         sample.id.site = certSite s 0 ∧
         sample.tail = true ∧
         (Z.1.1 (certSite s k.val)).qOut =
           .D sample.value true ∧
         (Z.1.2.current
           (certSite s k.val)).comparison.out.atom =
           some (.sampled sample.id) ∧
         ∀ j : Fin (topClockSpan n), j.val < k.val →
           TopFreshTailFirstBorderHomeSlot ring C s Z root j)
  sourceCoverage :
    ∀ j : Fin (topClockSpan n),
      (topFreshTailGenealogy ring C s Z).slots j = none ∨
      (∃ (h : Fin (topClockSpan n))
          (a : TopFreshTailCarrier (topClockSpan n)),
          h.val ≤ topClockSpan n - 1 -
            ((topClockConcreteExportsAfter s Z
              anchor.time).length % topClockSpan n) ∧
          TopFreshTailPostAnchorActiveHome ring C s Z h j a) ∨
      (∃ (root : TopFreshTailCarrier (topClockSpan n))
          (k : Fin (topClockSpan n)),
          j.val < k.val ∧
          TopFreshTailFirstBorderHomeSlot ring C s Z root j)
  exportRecords :
    ∀ i : Fin (topClockConcreteExportsAfter
        s Z anchor.time).length,
      ∃ sample :
        DigitSample (compileAdvice (ceilLogTwo n)) n,
        DigitRecordedSample Z.1.2 sample ∧
        sample.id.lane = .comparison ∧
        sample.id.site =
          certSite s
            (topClockSpan n - 1 -
              (i.val % topClockSpan n)) ∧
        sample.value =
          (C (certSite s
            (topClockSpan n - 1 -
              (i.val % topClockSpan n)))).d ∧
        sample.tail =
          (if i.val % topClockSpan n = topClockSpan n - 1
            then true else false) ∧
        (topClockConcreteExportAt
          s Z anchor.time i).operand =
          some (.sampled sample.id) ∧
        (topClockConcreteExportAt
          s Z anchor.time i).value = sample.value ∧
        (topClockConcreteExportAt
          s Z anchor.time i).tail = sample.tail

/-- The original recorded tail anchor in an actual post-anchor
wave was emitted no later than the OLD audit clock. This is a
concrete frame chronology consequence, not a future purity
hypothesis. Consumer: new accepted-port export append. -/
theorem topFreshTailPostAnchorWaveAnchorClock
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (Z : TopFixedTraceState n)
    (anchor : DigitExport
      (compileAdvice (ceilLogTwo n)) n)
    (hwave : TopFreshTailPostAnchorWave
      ring C s hn Z anchor) :
    anchor.time ≤ Z.1.2.clock := by
  obtain ⟨frame, hmem, htime, _, _⟩ :=
    hwave.anchorRecorded.1
  have horder :=
    (topFreshTailAuditFrameOrderReached
      ring C Z hwave.reached).1 frame hmem
  omega

/-- A non-port OLD service leaves the chronological
post-anchor export list unchanged. The pinned anchor,
causal queue and reached J1 provenance remain valid at
the real successor state, even when QI/QC are updated.
Consumer: W.export silent one-edge row. -/
theorem topFreshTailPostAnchorWaveSilentAuditStep
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (Z : TopFixedTraceState n)
    (anchor : DigitExport
      (compileAdvice (ceilLogTwo n)) n)
    (hwave : TopFreshTailPostAnchorWave
      ring C s hn Z anchor)
    (e : Fin n)
    (hsilent :
      topFreshTailPostAnchorNewEntries
        ring s Z anchor.time e = []) :
    topClockConcreteExportsAfter s
      (topFixedTraceNext ring C Z e) anchor.time =
        topClockConcreteExportsAfter s Z anchor.time ∧
    topClockConcreteTailAnchor s
      (topFixedTraceNext ring C Z e) anchor ∧
    TopFreshTailCausalQueue ring C s
      (topFixedTraceNext ring C Z e) ∧
    TopFreshTailAuditSourceDataProvenance ring C s
      (topFixedTraceNext ring C Z e) := by
  have hqueueNext :=
    topFreshTailCausalQueueStep
      ring C s hn hbad Z e hwave.queue
  have hprovNext :=
    topFreshTailAuditSourceDataReached
      ring C s hn hbad
      (topFixedTraceNext ring C Z e)
      hqueueNext.trace.1
  refine ⟨?_,
    topClockTailAnchorNext ring C s Z e
      anchor hwave.anchorRecorded,
    hqueueNext, hprovNext⟩
  rw [topFreshTailPostAnchorExportsAfterStep, hsilent]
  simp only [List.append_nil]

/-- On an accepted OLD port service, W.export gains exactly
one selected comparison receipt, the OLD terminal genealogy
head is authenticated, and the next audit retains the same
recorded anchor, CQ and J1 provenance. This proves the audit
part of W.next, but not the unfinished physical wave-order
part. Consumer: post-anchor selected acceptance row. -/
theorem topFreshTailPostAnchorWaveSelectedReceipt
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (Z : TopFixedTraceState n)
    (anchor : DigitExport
      (compileAdvice (ceilLogTwo n)) n)
    (hwave : TopFreshTailPostAnchorWave
      ring C s hn Z anchor)
    (atom : Option (DigitAtom n))
    (hready : topClockPortReady s atom Z)
    (e : Fin n)
    (exported : DigitExport
      (compileAdvice (ceilLogTwo n)) n)
    (hevent :
      topFreshTailGenealogyPortExport ring C s Z e =
        some exported) :
    ∃ carrier : TopFreshTailCarrier (topClockSpan n),
      topClockConcreteExportsAfter s
        (topFixedTraceNext ring C Z e) anchor.time =
        topClockConcreteExportsAfter s Z anchor.time ++
          [exported] ∧
      DigitRecordedExport
        (topFixedTraceNext ring C Z e).1.2 exported ∧
      (topFreshTailGenealogy ring C s Z).slots
        (⟨topClockSpan n - 1,
          show topClockSpan n - 1 < topClockSpan n by
            have hr := cert_rho_ge_three n hn
            change 3 ≤ topClockSpan n at hr
            omega⟩ : Fin (topClockSpan n)) =
          some carrier ∧
      (topFreshTailGenealogy ring C s
        (topFixedTraceNext ring C Z e)).consumed =
        (topFreshTailGenealogy ring C s Z).consumed ++
          [(exported.time, some carrier.origin)] ∧
      topClockConcreteTailAnchor s
        (topFixedTraceNext ring C Z e) anchor ∧
      TopFreshTailCausalQueue ring C s
        (topFixedTraceNext ring C Z e) ∧
      TopFreshTailAuditSourceDataProvenance ring C s
        (topFixedTraceNext ring C Z e) := by
  obtain ⟨happend, hrecord, _, _, carrier,
    hslot, hconsumed⟩ :=
    topFreshTailPostAnchorSelectedPortAppend
      ring C s hn hbad Z hwave.reached
      anchor.time
      (topFreshTailPostAnchorWaveAnchorClock
        ring C s hn Z anchor hwave)
      atom hready e exported hevent
  have hqueueNext :=
    topFreshTailCausalQueueStep
      ring C s hn hbad Z e hwave.queue
  have hprovNext :=
    topFreshTailAuditSourceDataReached
      ring C s hn hbad
      (topFixedTraceNext ring C Z e)
      hqueueNext.trace.1
  exact ⟨carrier, happend, hrecord, hslot, hconsumed,
    topClockTailAnchorNext ring C s Z e
      anchor hwave.anchorRecorded,
    hqueueNext, hprovNext⟩

/-- Starting from one actually reached fixed-public cut and
its recorded tail anchor, every finite continuation extends
the chronological post-anchor export list by a suffix built
only from the literal new OLD audit frames. The anchor, CQ
and J1 provenance persist over the same selected word.
This is the audit-count component of W.run; it does not
assert the unproved packet-order component of W.run.
Consumer: post-anchor wave receipt bookkeeping. -/
theorem topFreshTailPostAnchorAuditRun
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (word : List (Fin n)) :
    ∀ (Z : TopFixedTraceState n)
      (anchor : DigitExport
        (compileAdvice (ceilLogTwo n)) n),
      TopFreshTailCausalQueue ring C s Z →
      topClockConcreteTailAnchor s Z anchor →
      ∃ appended :
        List (DigitExport (compileAdvice (ceilLogTwo n)) n),
        topClockConcreteExportsAfter s
          (word.foldl (topFixedTraceNext ring C) Z)
          anchor.time =
          topClockConcreteExportsAfter s Z anchor.time ++
            appended ∧
        topClockConcreteTailAnchor s
          (word.foldl (topFixedTraceNext ring C) Z)
          anchor ∧
        TopFreshTailCausalQueue ring C s
          (word.foldl (topFixedTraceNext ring C) Z) ∧
        TopFreshTailAuditSourceDataProvenance ring C s
          (word.foldl (topFixedTraceNext ring C) Z) := by
  induction word with
  | nil =>
      intro Z anchor hqueue hanchor
      refine ⟨[], ?_, hanchor, hqueue, ?_⟩
      · simp only [List.foldl_nil, List.append_nil]
      · exact topFreshTailAuditSourceDataReached
          ring C s hn hbad Z hqueue.trace.1
  | cons e rest ih =>
      intro Z anchor hqueue hanchor
      have hqueueNext :=
        topFreshTailCausalQueueStep
          ring C s hn hbad Z e hqueue
      have hanchorNext :=
        topClockTailAnchorNext ring C s Z e
          anchor hanchor
      obtain ⟨appended, hword, hanchorRest,
        hqueueRest, hprovRest⟩ :=
        ih (topFixedTraceNext ring C Z e)
          anchor hqueueNext hanchorNext
      refine ⟨topFreshTailPostAnchorNewEntries
        ring s Z anchor.time e ++ appended, ?_,
        hanchorRest, hqueueRest, hprovRest⟩
      calc
        topClockConcreteExportsAfter s
            ((e :: rest).foldl
              (topFixedTraceNext ring C) Z) anchor.time =
          topClockConcreteExportsAfter s
            (topFixedTraceNext ring C Z e) anchor.time ++
              appended := hword
        _ =
          (topClockConcreteExportsAfter s Z anchor.time ++
            topFreshTailPostAnchorNewEntries
              ring s Z anchor.time e) ++ appended := by
                rw [topFreshTailPostAnchorExportsAfterStep]
        _ =
          topClockConcreteExportsAfter s Z anchor.time ++
            (topFreshTailPostAnchorNewEntries
              ring s Z anchor.time e ++ appended) := by
                rw [List.append_assoc]

theorem topFreshTailPostAnchorActiveHomeUnread
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (Z : TopFixedTraceState n)
    (hqueue : TopFreshTailCausalQueue ring C s Z)
    (h x : Fin (topClockSpan n))
    (carrier : TopFreshTailCarrier (topClockSpan n))
    (hactive :
      TopFreshTailPostAnchorActiveHome
        ring C s Z h x carrier)
    (hhome : x = h)
    (e : Fin n)
    (hsite : e = certSite s x.val)
    (hunread : (Z.1.1 e).qOut = .U) :
    ∃ nextCarrier : TopFreshTailCarrier (topClockSpan n),
      TopFreshTailPostAnchorActiveHome ring C s
        (topFixedTraceNext ring C Z e)
        h h nextCarrier := by
  obtain ⟨_, hslot, hfresh, _⟩ := hactive
  obtain ⟨hphysical, nextCarrier, hslotNext, hfreshNext,
    localSample, hrecord, hlane, hsampleSite, hatom,
    hvalue, htail⟩ :=
    topFreshTailFirstBorderFreshUnreadSampleStep
      ring C s hn hbad Z e hqueue x
      hsite hunread carrier hslot hfresh
  have hdigitAtHome :
      (Z.1.1 e).d = (C (certSite s h.val)).d := by
    rw [hsite, hhome]
    exact topFreshTailFirstBorderReachedDigit
      ring C Z hqueue.trace.1 (certSite s h.val)
  have hmarkerAtHome :
      (Z.1.1 e).beta =
        (if h.val = 0 then true else false) := by
    rw [hsite, hhome]
    exact (topFreshTailCausalSourcePublicGeometry
      ring C s hn hbad Z hqueue.trace.1 h).2.2.1
  have hnextData :
      ((topFixedTraceNext ring C Z e).1.1
        (certSite s h.val)).qOut =
        .D (C (certSite s h.val)).d
          (if h.val = 0 then true else false) := by
    have hsourceData := hphysical
    rw [hdigitAtHome, hmarkerAtHome] at hsourceData
    rw [hhome] at hsourceData
    exact hsourceData
  have hnextValue :
      localSample.value = (C (certSite s h.val)).d := by
    exact hvalue.trans hdigitAtHome
  have hnextTail :
      localSample.tail =
        (if h.val = 0 then true else false) := by
    exact htail.trans hmarkerAtHome
  have hnextSite :
      localSample.id.site = certSite s h.val := by
    rw [← hhome]
    exact hsampleSite
  have hnextAtom :
      ((topFixedTraceNext ring C Z e).1.2.current
        (certSite s h.val)).comparison.out.atom =
        some (.sampled localSample.id) := by
    rw [← hhome]
    exact hatom
  have hnextSlotHome :
      (topFreshTailGenealogy ring C s
        (topFixedTraceNext ring C Z e)).slots h =
          some nextCarrier := by
    rw [← hhome]
    exact hslotNext
  exact ⟨nextCarrier, Nat.le_refl _, hnextSlotHome,
    hfreshNext, Or.inr ⟨localSample, hnextData, hrecord,
      hlane, hnextSite, hnextValue,
      hnextTail, hnextAtom⟩⟩

/-- An occupied OLD interior responder blocks a current-wave
D without modifying its carrier, fixed home, recorded sample,
comparison output atom or physical tail bit. This statement
allows either false or true home tails but requires the
interior nonmarker OLD target. Consumer: W.current blocked D
and next-wave stationary blocking. -/
theorem topFreshTailPostAnchorActiveHomeOccupied
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (Z : TopFixedTraceState n)
    (hqueue : TopFreshTailCausalQueue ring C s Z)
    (h x : Fin (topClockSpan n))
    (carrier : TopFreshTailCarrier (topClockSpan n))
    (hactive :
      TopFreshTailPostAnchorActiveHome ring C s Z
        h x carrier)
    (e : Fin n)
    (hsite : e = certSite s x.val)
    (hnext : x.val + 1 < topClockSpan n)
    (hdata :
      (Z.1.1 e).qOut =
        .D (C (certSite s h.val)).d
          (if h.val = 0 then true else false))
    (hoccupied :
      (Z.1.1 (ring.rightNeighbor e)).qOut ≠ .E) :
    TopFreshTailPostAnchorActiveHome ring C s
      (topFixedTraceNext ring C Z e)
      h x carrier := by
  obtain ⟨hhomeLe, hslot, hfresh, hkind⟩ := hactive
  rcases hkind with ⟨_, hunread⟩ |
    ⟨localSample, _, hrecord, hlane, hsampleSite,
      hsampleValue, hsampleTail, hatom⟩
  · have hsourceU : (Z.1.1 e).qOut = .U := by
      rw [hsite]
      exact hunread
    rw [hsourceU] at hdata
    cases hdata
  · obtain ⟨hdataNext, hslotNext, hatomFrame,
      hfreshNext⟩ :=
      topFreshTailFirstBorderFreshOccupiedInteriorStep
        ring C s hn hbad Z e hqueue x hnext hsite
        (C (certSite s h.val)).d
        (if h.val = 0 then true else false)
        hdata hoccupied carrier hslot hfresh
    exact ⟨hhomeLe, hslotNext, hfreshNext,
      Or.inr ⟨localSample, hdataNext,
        digitRecordedSampleStep
          ring (piD Z.1.1) Z.1.2 e
          localSample hrecord,
        hlane, hsampleSite, hsampleValue,
        hsampleTail, hatomFrame.trans hatom⟩⟩

/-- An incoming follower service into the occupied physical
position of a post-anchor home preserves that home's OLD
carrier and, for a D, its exact sampled output atom. For a
waiting U the physical output and the unread home equation
are both retained. Consumer: W.current responder row. -/
theorem topFreshTailPostAnchorActiveHomeIncoming
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hl : ∀ i : Fin n, (C i).l = false)
    (Z : TopFixedTraceState n)
    (hqueue : TopFreshTailCausalQueue ring C s Z)
    (h x : Fin (topClockSpan n))
    (carrier : TopFreshTailCarrier (topClockSpan n))
    (hactive :
      TopFreshTailPostAnchorActiveHome
        ring C s Z h x carrier)
    (e : Fin n)
    (htarget :
      ring.rightNeighbor e = certSite s x.val) :
    TopFreshTailPostAnchorActiveHome
      ring C s (topFixedTraceNext ring C Z e)
      h x carrier := by
  obtain ⟨hhomeLe, hslot, hfresh, hkind⟩ := hactive
  rcases hkind with ⟨hhome, hunread⟩ |
    ⟨localSample, hdata, hrecord, hlane,
      hsampleSite, hsampleValue, hsampleTail, hatom⟩
  · obtain ⟨hnewU, hslotNext⟩ :=
      topFreshTailFirstBorderIncomingUnreadFrame
        ring C s hn Z e hqueue hl x
        htarget hunread carrier hslot
    exact ⟨hhomeLe, hslotNext, hfresh,
      Or.inl ⟨hhome, hnewU⟩⟩
  · obtain ⟨hnewD, hslotNext, hatomFrame⟩ :=
      topFreshTailFirstBorderIncomingDataFrame
        ring C s hn Z e hqueue hl x htarget
        (C (certSite s h.val)).d
        (if h.val = 0 then true else false)
        hdata carrier hslot
    exact ⟨hhomeLe, hslotNext, hfresh,
      Or.inr ⟨localSample, hnewD,
        digitRecordedSampleStep
          ring (piD Z.1.1) Z.1.2 e
          localSample hrecord,
        hlane, hsampleSite, hsampleValue,
        hsampleTail, hatomFrame.trans hatom⟩⟩

/-- A selected physical edge which touches neither endpoint
of an active post-anchor packet preserves its carrier,
position, home index, physical U/D token, recorded sample and
comparison atom. The old audit sample remains recorded.
Consumer: W.current remote/off-source and target-only rows. -/
theorem topFreshTailPostAnchorActiveHomeAway
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (Z : TopFixedTraceState n)
    (hqueue : TopFreshTailCausalQueue ring C s Z)
    (h x : Fin (topClockSpan n))
    (carrier : TopFreshTailCarrier (topClockSpan n))
    (hactive :
      TopFreshTailPostAnchorActiveHome
        ring C s Z h x carrier)
    (e : Fin n)
    (hsource : certSite s x.val ≠ e)
    (htarget :
      certSite s x.val ≠ ring.rightNeighbor e) :
    TopFreshTailPostAnchorActiveHome
      ring C s (topFixedTraceNext ring C Z e)
      h x carrier := by
  obtain ⟨hhomeLe, hslot, hfresh, hkind⟩ := hactive
  have hframe :=
    topFreshTailCausalOffPairSlotAgreement
      ring C s Z e hqueue x hsource htarget
  refine ⟨hhomeLe, ?_, hfresh, ?_⟩
  · rw [hframe.2]
    exact hslot
  · rcases hkind with ⟨hhome, hunread⟩ |
      ⟨localSample, hdata, hrecord, hlane,
        hsampleSite, hsampleValue, hsampleTail, hatom⟩
    · exact Or.inl ⟨hhome, hframe.1.trans hunread⟩
    · have hatomFrame :
          ((topFixedTraceNext ring C Z e).1.2.current
            (certSite s x.val)).comparison.out.atom =
          (Z.1.2.current
            (certSite s x.val)).comparison.out.atom := by
        change
          ((digitAuditStep ring (piD Z.1.1)
            Z.1.2 e).current
              (certSite s x.val)).comparison.out.atom =
          (Z.1.2.current
            (certSite s x.val)).comparison.out.atom
        simp only [digitAuditStep, digitGhostStep,
          if_neg hsource, if_neg htarget]
      exact Or.inr ⟨localSample, hframe.1.trans hdata,
        digitRecordedSampleStep
          ring (piD Z.1.1) Z.1.2 e
          localSample hrecord,
        hlane, hsampleSite, hsampleValue, hsampleTail,
        hatomFrame.trans hatom⟩

/-- The actual source-zero output is never E at a
post-anchor wave cut. When the active true-tail home is U,
it occupies zero. When it is D at zero, that D occupies
zero; after it advances, the complete next-wave home
staircase gives an occupied U or D at zero. Thus the OLD
source-zero marker-bootstrap E row is unavailable.
Consumer: W.cover and exclusion of unbudgeted wave births. -/
theorem topFreshTailPostAnchorWaveZeroOccupied
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (Z : TopFixedTraceState n)
    (anchor : DigitExport
      (compileAdvice (ceilLogTwo n)) n)
    (hwave : TopFreshTailPostAnchorWave
      ring C s hn Z anchor) :
    (Z.1.1 (certSite s 0)).qOut ≠ .E := by
  obtain ⟨root, k, _, hrootKind⟩ := hwave.rootAndNext
  rcases hrootKind with ⟨_, hsourceU⟩ |
    ⟨sample, _, _, _, _, hrootD, _,
      hnextHomes⟩
  · rw [hsourceU]
    intro he
    cases he
  · by_cases hkzero : k.val = 0
    · rw [hkzero] at hrootD
      rw [hrootD]
      intro he
      cases he
    · have hpositive : 0 < k.val := by omega
      have hwidth : 0 < topClockSpan n := by
        have hr := cert_rho_ge_three n hn
        change 3 ≤ topClockSpan n at hr
        omega
      have hhome :=
        hnextHomes
          (⟨0, hwidth⟩ : Fin (topClockSpan n))
          (by simpa only [Fin.val_mk] using hpositive)
      unfold TopFreshTailFirstBorderHomeSlot at hhome
      obtain ⟨child, hslot, hfresh, hparent, hkind⟩ := hhome
      rcases hkind with hunread |
        ⟨localSample, hdata, _, _, _, _, _, _⟩
      · rw [hunread]
        intro he
        cases he
      · rw [hdata]
        intro he
        cases he

end L3

namespace L3

set_option autoImplicit false
set_option Elab.async false

/-- Literal accepted QI/QO/QC owner with unrestricted OLD source input
and checker carry. Consumer: J5 terminal comparison port. -/
theorem topFreshTailAcceptedPortOwnerAllScratch
    (c : Compiled) (x y : Agent c)
    (resolvedX resolvedY : Bool)
    (v : Fin c.topA) (tail : Bool)
    (hxl : x.l = false) (hyl : y.l = false)
    (hxb : x.beta = false) (hyb : y.beta = true)
    (hyi : y.qIn = .E) (hyc : y.qCarry = .OFF)
    (hxo : x.qOut = .D v tail) :
    (liveTopPair c x y resolvedX resolvedY).x.qOut =
        (if tail then .U else .E) ∧
    (liveTopPair c x y resolvedX resolvedY).y.qIn =
        .P v tail ∧
    (liveTopPair c x y resolvedX resolvedY).y.qOut =
        y.qOut ∧
    (liveTopPair c x y resolvedX resolvedY).x.qCarry =
        .OFF := by
  cases hsourceInput : x.qIn <;>
    cases hsourceCarry : x.qCarry <;>
    simp [liveTopPair, hxl, hyl, hxb, hyb, hyi, hyc,
      hxo, hsourceInput, hsourceCarry, topTerminal,
      topBorder, topInternal, QCarry.isOff, QCarry.isL,
      InTok.isE, InTok.isP, InTok.isS, InTok.isX,
      OutTok.isD, outV, outT] <;>
    (try split) <;> (try split) <;> simp

/-- The accepted OLD comparison frame clears its source output
ghost and takes the OLD atom as operand. No same-edge sample.
Consumer: J1/J2 and the J5 source-port genealogy step. -/
theorem topFreshTailAcceptedPortGhostAllScratch
    {c : Compiled} {n : Nat}
    (stamp : Nat) (source destination : Fin n)
    (x y : DigitLaneView c)
    (gx gy : DigitLaneGhost c n)
    (v : Fin c.topA) (tail : Bool)
    (hxl : x.leader = false) (hyl : y.leader = false)
    (hxb : x.marker = false) (hyb : y.marker = true)
    (hyi : y.input = .E) (hyc : y.carryLive = false)
    (hxo : x.out = .D v tail) :
    (digitLaneReplay .comparison stamp source destination
      x y gx gy).x.out =
        (if tail then
          .unread (.afterTail
            { time := stamp, site := source, lane := .comparison }
            gx.out.atom)
         else .empty) ∧
    (digitLaneReplay .comparison stamp source destination
      x y gx gy).y.input = gx.out.atom ∧
    (digitLaneReplay .comparison stamp source destination
      x y gx gy).sample = none ∧
    (digitLaneReplay .comparison stamp source destination
      x y gx gy).exported =
        some { time := stamp, lane := .comparison
               source := source, destination := destination
               operand := gx.out.atom, value := v, tail := tail } := by
  cases hsourceInput : x.input <;>
    cases hsourceCarry : x.carryLive <;>
    simp [digitLaneReplay, hxl, hyl, hxb, hyb, hyi,
      hyc, hxo, hsourceInput, hsourceCarry,
      InTok.isE, InTok.isP, InTok.isS, InTok.isX,
      OutTok.isD, outV, outT] <;>
    (try split) <;> (try split) <;> simp

/-- Source-scratch-independent OLD checker-port acceptance.
Consumer: J5 B.old-front terminal row, B.root exit,
and post-anchor W false/true accepted-port steps. -/
theorem topFreshTailAcceptedPortQOAllSourceScratch
    {n : Nat} (ring : DirectedRing n) (hn : 5 ≤ n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (G : TopFreshTailGenealogyState n)
    (e : Fin n) (j : Fin (topClockSpan n))
    (v : Fin (compileAdvice (ceilLogTwo n)).topA)
    (tail : Bool)
    (parent : TopFreshTailCarrier (topClockSpan n))
    (hsite : e = certSite s j.val)
    (hterminal : j.val + 1 = topClockSpan n)
    (hneighbor :
      ring.rightNeighbor e = certSite s (topClockSpan n))
    (hxl : (G.trace.1.1 e).l = false)
    (hyl : (G.trace.1.1 (ring.rightNeighbor e)).l = false)
    (hxb : (G.trace.1.1 e).beta = false)
    (hyb : (G.trace.1.1 (ring.rightNeighbor e)).beta = true)
    (hyi : (G.trace.1.1 (ring.rightNeighbor e)).qIn = .E)
    (hyc : (G.trace.1.1 (ring.rightNeighbor e)).qCarry = .OFF)
    (hxo : (G.trace.1.1 e).qOut = .D v tail)
    (hslot : G.slots j = some parent) :
    ((topFreshTailGenealogyStep ring C s G e).trace.1.1 e).qOut =
        (if tail then .U else .E) ∧
    ((topFreshTailGenealogyStep ring C s G e).trace.1.1
      (ring.rightNeighbor e)).qIn = .P v tail ∧
    ((topFreshTailGenealogyStep ring C s G e).trace.1.1
      (ring.rightNeighbor e)).qOut =
        (G.trace.1.1 (ring.rightNeighbor e)).qOut ∧
    ((topFreshTailGenealogyStep ring C s G e).trace.1.1 e).qCarry =
        .OFF ∧
    (topFreshTailGenealogyStep ring C s G e).slots j =
        (if tail then
           some (topFreshTailGenealogyRearm j
             (G.trace.1.2.clock + 1) parent)
         else none) ∧
    ((topFreshTailGenealogyStep ring C s G e).trace.1.2.current
      e).comparison.out.atom = none ∧
    ((topFreshTailGenealogyStep ring C s G e).trace.1.2.current
      e).comparison.out =
        (if tail then
           .unread (.afterTail
             { time := G.trace.1.2.clock + 1
               site := e
               lane := .comparison }
             (G.trace.1.2.current e).comparison.out.atom)
         else .empty) ∧
    ((topFreshTailGenealogyStep ring C s G e).trace.1.2.current
      (ring.rightNeighbor e)).comparison.input =
        (G.trace.1.2.current e).comparison.out.atom ∧
    ∃ exported : DigitExport (compileAdvice (ceilLogTwo n)) n,
      topFreshTailGenealogyPortExport ring C s G.trace e =
        some exported ∧
      exported.time = G.trace.1.2.clock + 1 ∧
      exported.lane = .comparison ∧
      exported.source = e ∧
      exported.destination = ring.rightNeighbor e ∧
      exported.operand =
        (G.trace.1.2.current e).comparison.out.atom ∧
      exported.value = v ∧
      exported.tail = tail ∧
      DigitRecordedExport
        (topFreshTailGenealogyStep ring C s G e).trace.1.2
        exported ∧
      (topFreshTailGenealogyStep ring C s G e).consumed =
        G.consumed ++
          [(G.trace.1.2.clock + 1, some parent.origin)] := by
  have howner :
      (topPortLiteralTopOwner ring G.trace.1.1 e).x.qOut =
          (if tail then .U else .E) ∧
      (topPortLiteralTopOwner ring G.trace.1.1 e).y.qIn =
          .P v tail ∧
      (topPortLiteralTopOwner ring G.trace.1.1 e).y.qOut =
          (G.trace.1.1 (ring.rightNeighbor e)).qOut ∧
      (topPortLiteralTopOwner ring G.trace.1.1 e).x.qCarry =
          .OFF := by
    unfold topPortLiteralTopOwner
    exact topFreshTailAcceptedPortOwnerAllScratch
      (compileAdvice (ceilLogTwo n))
      (G.trace.1.1 e) (G.trace.1.1 (ring.rightNeighbor e))
      _ _ v tail hxl hyl hxb hyb hyi hyc hxo
  have hphysicalSource :
      ((topFixedTraceNext ring C G.trace e).1.1 e).qOut =
        (if tail then .U else .E) := by
    change (topFixedPublicNext ring C G.trace.1.1 e e).qOut =
      (if tail then .U else .E)
    exact (topPortLiteralSourceFields
      ring C G.trace.1.1 e).2.2.trans howner.1
  have hphysicalInput :
      ((topFixedTraceNext ring C G.trace e).1.1
        (ring.rightNeighbor e)).qIn = .P v tail := by
    change (topFixedPublicNext ring C G.trace.1.1 e
      (ring.rightNeighbor e)).qIn = .P v tail
    exact (topPortLiteralResponderFields
      ring (by omega : 2 ≤ n) C G.trace.1.1 e).1.trans
        howner.2.1
  have hphysicalResponder :
      ((topFixedTraceNext ring C G.trace e).1.1
        (ring.rightNeighbor e)).qOut =
        (G.trace.1.1 (ring.rightNeighbor e)).qOut := by
    change (topFixedPublicNext ring C G.trace.1.1 e
      (ring.rightNeighbor e)).qOut =
        (G.trace.1.1 (ring.rightNeighbor e)).qOut
    exact (topPortLiteralResponderFields
      ring (by omega : 2 ≤ n) C G.trace.1.1 e).2.2.trans
        howner.2.2.1
  have hphysicalCarry :
      ((topFixedTraceNext ring C G.trace e).1.1 e).qCarry =
        .OFF := by
    change (topFixedPublicNext ring C G.trace.1.1 e e).qCarry =
      .OFF
    exact (topPortLiteralSourceFields
      ring C G.trace.1.1 e).2.1.trans howner.2.2.2
  have hpostSource :
      ((topFixedTraceNext ring C G.trace e).1.1
        (certSite s j.val)).qOut =
        (if tail then .U else .E) := by
    rw [← hsite]
    exact hphysicalSource
  have holdSource :
      (G.trace.1.1 (certSite s j.val)).qOut =
        .D v tail := by
    rw [← hsite]
    exact hxo
  have hphysicalSlot :
      (topFreshTailGenealogyStep ring C s G e).slots j =
        (if tail then
           some (topFreshTailGenealogyRearm j
             (G.trace.1.2.clock + 1) parent)
         else none) := by
    change topFreshTailGenealogyNextSlot ring C s G e j = _
    cases tail with
    | false =>
        simp [topFreshTailGenealogyNextSlot,
          hpostSource, holdSource, hslot]
    | true =>
        simp [topFreshTailGenealogyNextSlot,
          hpostSource, holdSource, hslot]
  have hghostLocal :=
    topFreshTailAcceptedPortGhostAllScratch
      (G.trace.1.2.clock + 1) e (ring.rightNeighbor e)
      (digitLaneView .comparison (piD G.trace.1.1 e)
        (piD G.trace.1.1 e).word.beta)
      (digitLaneView .comparison
        (piD G.trace.1.1 (ring.rightNeighbor e))
        (piD G.trace.1.1 (ring.rightNeighbor e)).word.beta)
      (G.trace.1.2.current e).comparison
      (G.trace.1.2.current (ring.rightNeighbor e)).comparison
      v tail
      (by change (G.trace.1.1 e).l = false; exact hxl)
      (by change (G.trace.1.1 (ring.rightNeighbor e)).l = false; exact hyl)
      (by change (G.trace.1.1 e).beta = false; exact hxb)
      (by change (G.trace.1.1 (ring.rightNeighbor e)).beta = true; exact hyb)
      (by change (G.trace.1.1 (ring.rightNeighbor e)).qIn = .E; exact hyi)
      (by change (G.trace.1.1 (ring.rightNeighbor e)).qCarry.isL = false; rw [hyc]; rfl)
      (by change (G.trace.1.1 e).qOut = .D v tail; exact hxo)
  have hghostSource :
      ((topFixedTraceNext ring C G.trace e).1.2.current
        e).comparison.out =
          (if tail then
            .unread (.afterTail
              { time := G.trace.1.2.clock + 1
                site := e, lane := .comparison }
              (G.trace.1.2.current e).comparison.out.atom)
           else .empty) := by
    change ((digitAuditStep ring (piD G.trace.1.1)
      G.trace.1.2 e).current e).comparison.out = _
    simp only [digitAuditStep, digitGhostStep, if_pos rfl]
    change (digitLaneReplay .comparison (G.trace.1.2.clock + 1)
      e (ring.rightNeighbor e)
      (digitLaneView .comparison (piD G.trace.1.1 e)
        (piD G.trace.1.1 e).word.beta)
      (digitLaneView .comparison
        (piD G.trace.1.1 (ring.rightNeighbor e))
        (piD G.trace.1.1 (ring.rightNeighbor e)).word.beta)
      (G.trace.1.2.current e).comparison
      (G.trace.1.2.current (ring.rightNeighbor e)).comparison).x.out = _
    exact hghostLocal.1
  have hghostAtom :
      ((topFixedTraceNext ring C G.trace e).1.2.current
        e).comparison.out.atom = none := by
    rw [hghostSource]
    cases tail <;> rfl
  have hne : ring.rightNeighbor e ≠ e :=
    EWord.rightNeighborDifferent ring (by omega : 2 ≤ n) e
  have hghostInput :
      ((topFixedTraceNext ring C G.trace e).1.2.current
        (ring.rightNeighbor e)).comparison.input =
          (G.trace.1.2.current e).comparison.out.atom := by
    change ((digitAuditStep ring (piD G.trace.1.1)
      G.trace.1.2 e).current
        (ring.rightNeighbor e)).comparison.input = _
    simp only [digitAuditStep, digitGhostStep,
      if_neg hne, if_pos rfl]
    change (digitLaneReplay .comparison (G.trace.1.2.clock + 1)
      e (ring.rightNeighbor e)
      (digitLaneView .comparison (piD G.trace.1.1 e)
        (piD G.trace.1.1 e).word.beta)
      (digitLaneView .comparison
        (piD G.trace.1.1 (ring.rightNeighbor e))
        (piD G.trace.1.1 (ring.rightNeighbor e)).word.beta)
      (G.trace.1.2.current e).comparison
      (G.trace.1.2.current (ring.rightNeighbor e)).comparison).y.input = _
    exact hghostLocal.2.1
  have hservice :
      (digitService (G.trace.1.2.clock + 1)
        e (ring.rightNeighbor e)
        (piD G.trace.1.1 e)
        (piD G.trace.1.1 (ring.rightNeighbor e))
        (G.trace.1.2.current e)
        (G.trace.1.2.current (ring.rightNeighbor e))
          ).comparison.exported =
        some {
          time := G.trace.1.2.clock + 1, lane := .comparison
          source := e, destination := ring.rightNeighbor e
          operand := (G.trace.1.2.current e).comparison.out.atom
          value := v, tail := tail } := by
    change (digitLaneReplay .comparison (G.trace.1.2.clock + 1)
      e (ring.rightNeighbor e)
      (digitLaneView .comparison (piD G.trace.1.1 e)
        (piD G.trace.1.1 e).word.beta)
      (digitLaneView .comparison
        (piD G.trace.1.1 (ring.rightNeighbor e))
        (piD G.trace.1.1 (ring.rightNeighbor e)).word.beta)
      (G.trace.1.2.current e).comparison
      (G.trace.1.2.current (ring.rightNeighbor e)).comparison).exported = _
    exact hghostLocal.2.2.2
  have hport :
      e = certSite s (topClockSpan n - 1) ∧
      ring.rightNeighbor e = certSite s (topClockSpan n) := by
    have hj : j.val = topClockSpan n - 1 := by omega
    constructor
    · rw [← hj]
      exact hsite
    · exact hneighbor
  have hevent :
      topFreshTailGenealogyPortExport ring C s G.trace e =
        some {
          time := G.trace.1.2.clock + 1, lane := .comparison
          source := e, destination := ring.rightNeighbor e
          operand := (G.trace.1.2.current e).comparison.out.atom
          value := v, tail := tail } := by
    simpa only [topFreshTailGenealogyPortExport, if_pos hport]
      using hservice
  have hrecord :=
    (topFreshTailAuditSelectedPortFrame ring C s G.trace e
      { time := G.trace.1.2.clock + 1, lane := .comparison
        source := e, destination := ring.rightNeighbor e
        operand := (G.trace.1.2.current e).comparison.out.atom
        value := v, tail := tail } hevent).2.2.1
  have hspan : 0 < topClockSpan n := by
    have hr := cert_rho_ge_three n hn
    change 3 ≤ topClockSpan n at hr
    omega
  have hcanonical :
      j = (⟨topClockSpan n - 1,
        show topClockSpan n - 1 < topClockSpan n by omega⟩ :
        Fin (topClockSpan n)) := by
    apply Fin.ext
    change j.val = topClockSpan n - 1
    omega
  have hconsumed :=
    topFreshTailClosePortEventOrigin
      ring C s G e hspan
      { time := G.trace.1.2.clock + 1, lane := .comparison
        source := e, destination := ring.rightNeighbor e
        operand := (G.trace.1.2.current e).comparison.out.atom
        value := v, tail := tail }
      hevent parent (by rw [← hcanonical]; exact hslot)
  refine ⟨hphysicalSource, hphysicalInput, hphysicalResponder,
    hphysicalCarry, hphysicalSlot, hghostAtom, hghostSource,
    hghostInput, ?_⟩
  refine ⟨
    { time := G.trace.1.2.clock + 1, lane := .comparison
      source := e, destination := ring.rightNeighbor e
      operand := (G.trace.1.2.current e).comparison.out.atom
      value := v, tail := tail },
    hevent, rfl, rfl, rfl, rfl, rfl, rfl, rfl, ?_, hconsumed⟩
  change DigitRecordedExport
    (topFixedTraceNext ring C G.trace e).1.2
    { time := G.trace.1.2.clock + 1, lane := .comparison
      source := e, destination := ring.rightNeighbor e
      operand := (G.trace.1.2.current e).comparison.out.atom
      value := v, tail := tail }
  exact hrecord

/-- OLD inherited/oldVisit false-tail terminal service, independent
of source checker scratch. Consumer: J5 B.old-front history. -/
theorem topFreshTailAcceptedPortOldFalseService
    {n : Nat} (ring : DirectedRing n) (hn : 5 ≤ n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (G : TopFreshTailGenealogyState n)
    (e : Fin n) (j : Fin (topClockSpan n))
