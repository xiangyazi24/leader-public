/-- The selected source U records a comparison sample at its literal
old endpoint. Consumer: J1 source U-to-D case. -/
theorem topFreshTailAuditPhysicalUnreadSample
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n)
    (Z : TopFixedTraceState n) (e : Fin n)
    (hxl : (Z.1.1 e).l = false)
    (hyl : (Z.1.1 (ring.rightNeighbor e)).l = false)
    (hu : (Z.1.1 e).qOut = .U) :
    ∃ sample : DigitSample (compileAdvice (ceilLogTwo n)) n,
      DigitRecordedSample (topFixedTraceNext ring C Z e).1.2 sample ∧
      sample.id.lane = .comparison ∧
      sample.id.site = e ∧
      sample.id.time = Z.1.2.clock + 1 ∧
      sample.value = (Z.1.1 e).d ∧
      sample.tail = (Z.1.1 e).beta ∧
      ((topFixedTraceNext ring C Z e).1.2.current
        e).comparison.out.atom = some (.sampled sample.id) := by
  have hlocal :=
    topFreshTailAuditLaneUnreadSample
      (Z.1.2.clock + 1) e (ring.rightNeighbor e)
      (digitLaneView .comparison (piD Z.1.1 e)
        (piD Z.1.1 e).word.beta)
      (digitLaneView .comparison
        (piD Z.1.1 (ring.rightNeighbor e))
        (piD Z.1.1 (ring.rightNeighbor e)).word.beta)
      (Z.1.2.current e).comparison
      (Z.1.2.current (ring.rightNeighbor e)).comparison
      (by change (Z.1.1 e).l = false; exact hxl)
      (by change (Z.1.1 (ring.rightNeighbor e)).l = false; exact hyl)
      (by change (Z.1.1 e).qOut = .U; exact hu)
  refine ⟨
    { id := { time := Z.1.2.clock + 1,
              site := e, lane := .comparison }
      value := (Z.1.1 e).d
      tail := (Z.1.1 e).beta
      cause := (Z.1.2.current e).comparison.out.obligation },
    ?_, rfl, rfl, rfl, rfl, rfl, ?_⟩
  · unfold DigitRecordedSample
    refine ⟨
      { time := Z.1.2.clock + 1
        edge := e
        old := piD Z.1.1
        oldGhost := Z.1.2.current
        receipt := digitService (Z.1.2.clock + 1) e
          (ring.rightNeighbor e)
          (piD Z.1.1 e)
          (piD Z.1.1 (ring.rightNeighbor e))
          (Z.1.2.current e)
          (Z.1.2.current (ring.rightNeighbor e)) },
      ?_, rfl, rfl, ?_, rfl⟩
    · simp only [topFixedTraceNext, digitAuditStep, List.mem_cons]
      exact Or.inl True.intro
    · change (digitLaneReplay .comparison
        (Z.1.2.clock + 1) e (ring.rightNeighbor e)
        (digitLaneView .comparison (piD Z.1.1 e)
          (piD Z.1.1 e).word.beta)
        (digitLaneView .comparison
          (piD Z.1.1 (ring.rightNeighbor e))
          (piD Z.1.1 (ring.rightNeighbor e)).word.beta)
        (Z.1.2.current e).comparison
        (Z.1.2.current (ring.rightNeighbor e)).comparison).sample =
          some
            { id := { time := Z.1.2.clock + 1,
                      site := e, lane := .comparison }
              value := (Z.1.1 e).d
              tail := (Z.1.1 e).beta
              cause := (Z.1.2.current e).comparison.out.obligation }
      exact hlocal.2
  · simp only [topFixedTraceNext, digitAuditStep,
      digitGhostStep]
    change (digitLaneReplay .comparison
      (Z.1.2.clock + 1) e (ring.rightNeighbor e)
      (digitLaneView .comparison (piD Z.1.1 e)
        (piD Z.1.1 e).word.beta)
      (digitLaneView .comparison
        (piD Z.1.1 (ring.rightNeighbor e))
        (piD Z.1.1 (ring.rightNeighbor e)).word.beta)
      (Z.1.2.current e).comparison
      (Z.1.2.current (ring.rightNeighbor e)).comparison).x.out.atom =
        some (.sampled
          { time := Z.1.2.clock + 1, site := e,
            lane := .comparison })
    exact hlocal.1

/-- Every literal port genealogy export is also the exact new
comparison frame, with the OLD output atom as its operand.
Consumer: J2 source-port receipt matching. -/
theorem topFreshTailAuditSelectedPortFrame
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (Z : TopFixedTraceState n) (e : Fin n)
    (exported : DigitExport (compileAdvice (ceilLogTwo n)) n)
    (hevent :
      topFreshTailGenealogyPortExport ring C s Z e =
        some exported) :
    e = certSite s (topClockSpan n - 1) ∧
    ring.rightNeighbor e = certSite s (topClockSpan n) ∧
    DigitRecordedExport (topFixedTraceNext ring C Z e).1.2 exported ∧
    exported.time = Z.1.2.clock + 1 ∧
    exported.lane = .comparison ∧
    exported.source = e ∧
    exported.destination = ring.rightNeighbor e ∧
    exported.operand =
      (Z.1.2.current e).comparison.out.atom ∧
    ∃ frame : DigitFrame (compileAdvice (ceilLogTwo n)) n,
      (topFixedTraceNext ring C Z e).1.2.frames =
        frame :: Z.1.2.frames ∧
      frame.time = Z.1.2.clock + 1 ∧
      frame.edge = e ∧
      (digitReceiptLane .comparison frame.receipt).exported =
        some exported := by
  by_cases hp :
      e = certSite s (topClockSpan n - 1) ∧
      ring.rightNeighbor e = certSite s (topClockSpan n)
  · have hservice :
        (digitService (Z.1.2.clock + 1) e
          (ring.rightNeighbor e)
          (piD Z.1.1 e)
          (piD Z.1.1 (ring.rightNeighbor e))
          (Z.1.2.current e)
          (Z.1.2.current (ring.rightNeighbor e))).comparison.exported =
            some exported := by
      simpa only [topFreshTailGenealogyPortExport, if_pos hp]
        using hevent
    have hcomparison :
        (digitLaneReplay .comparison (Z.1.2.clock + 1) e
          (ring.rightNeighbor e)
          (digitLaneView .comparison (piD Z.1.1 e)
            (piD Z.1.1 e).word.beta)
          (digitLaneView .comparison
            (piD Z.1.1 (ring.rightNeighbor e))
            (piD Z.1.1 (ring.rightNeighbor e)).word.beta)
          (Z.1.2.current e).comparison
          (Z.1.2.current (ring.rightNeighbor e)).comparison).exported =
            some exported := by
      exact hservice
    have hfields :=
      topFreshTailAuditLaneExportFields
        .comparison (Z.1.2.clock + 1) e
        (ring.rightNeighbor e)
        (digitLaneView .comparison (piD Z.1.1 e)
          (piD Z.1.1 e).word.beta)
        (digitLaneView .comparison
          (piD Z.1.1 (ring.rightNeighbor e))
          (piD Z.1.1 (ring.rightNeighbor e)).word.beta)
        (Z.1.2.current e).comparison
        (Z.1.2.current (ring.rightNeighbor e)).comparison
        exported hcomparison
    obtain ⟨htime, hlane, hsource, hdest, hoperand⟩ := hfields
    have hrecord :
        DigitRecordedExport
          (topFixedTraceNext ring C Z e).1.2 exported := by
      unfold DigitRecordedExport
      refine ⟨
        { time := Z.1.2.clock + 1
          edge := e
          old := piD Z.1.1
          oldGhost := Z.1.2.current
          receipt := digitService (Z.1.2.clock + 1) e
            (ring.rightNeighbor e)
            (piD Z.1.1 e)
            (piD Z.1.1 (ring.rightNeighbor e))
            (Z.1.2.current e)
            (Z.1.2.current (ring.rightNeighbor e)) },
        ?_, htime.symm, hsource.symm, ?_⟩
      · simp only [topFixedTraceNext, digitAuditStep,
          List.mem_cons]
        exact Or.inl True.intro
      · rw [hlane]
        change (digitService (Z.1.2.clock + 1) e
          (ring.rightNeighbor e)
          (piD Z.1.1 e)
          (piD Z.1.1 (ring.rightNeighbor e))
          (Z.1.2.current e)
          (Z.1.2.current (ring.rightNeighbor e))).comparison.exported =
            some exported
        exact hservice
    refine ⟨hp.1, hp.2, hrecord, htime, hlane, hsource,
      hdest, hoperand, ?_⟩
    refine ⟨
      { time := Z.1.2.clock + 1
        edge := e
        old := piD Z.1.1
        oldGhost := Z.1.2.current
        receipt := digitService (Z.1.2.clock + 1) e
          (ring.rightNeighbor e)
          (piD Z.1.1 e)
          (piD Z.1.1 (ring.rightNeighbor e))
          (Z.1.2.current e)
          (Z.1.2.current (ring.rightNeighbor e)) },
      rfl, rfl, rfl, ?_⟩
    change (digitService (Z.1.2.clock + 1) e
      (ring.rightNeighbor e)
      (piD Z.1.1 e)
      (piD Z.1.1 (ring.rightNeighbor e))
      (Z.1.2.current e)
      (Z.1.2.current (ring.rightNeighbor e))).comparison.exported =
        some exported
    exact hservice
  · have hnone :
        topFreshTailGenealogyPortExport ring C s Z e =
          none := by
      simp only [topFreshTailGenealogyPortExport, if_neg hp]
    rw [hnone] at hevent
    cases hevent

/-- J2 OLD head: the exact selected export matches the unique
genealogical carrier and appends its origin once. -/
theorem topFreshTailAuditPortOldCarrierFrame
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (Z : TopFixedTraceState n)
    (hreach : topClockReached ring C Z)
    (atom : Option (DigitAtom n))
    (hready : topClockPortReady s atom Z)
    (e : Fin n)
    (exported : DigitExport (compileAdvice (ceilLogTwo n)) n)
    (hevent : topFreshTailGenealogyPortExport ring C s Z e =
      some exported) :
    ∃ carrier : TopFreshTailCarrier (topClockSpan n),
      (topFreshTailGenealogy ring C s Z).slots
        (⟨topClockSpan n - 1,
          show topClockSpan n - 1 < topClockSpan n by
            have hw := cert_rho_ge_three n hn
            change 3 ≤ topClockSpan n at hw
            omega⟩ : Fin (topClockSpan n)) = some carrier ∧
      carrier.born ≤ Z.1.2.clock ∧
      (∀ other : TopFreshTailCarrier (topClockSpan n),
        (topFreshTailGenealogy ring C s Z).slots
          (⟨topClockSpan n - 1,
            show topClockSpan n - 1 < topClockSpan n by
              have hw := cert_rho_ge_three n hn
              change 3 ≤ topClockSpan n at hw
              omega⟩ : Fin (topClockSpan n)) = some other →
        other = carrier) ∧
      DigitRecordedExport
        (topFixedTraceNext ring C Z e).1.2 exported ∧
      exported.time = Z.1.2.clock + 1 ∧
      exported.source = certSite s (topClockSpan n - 1) ∧
      exported.destination = certSite s (topClockSpan n) ∧
      exported.operand = atom ∧
      (topFreshTailGenealogyStep
        ring C s (topFreshTailGenealogy ring C s Z) e).consumed =
        (topFreshTailGenealogy ring C s Z).consumed ++
          [(Z.1.2.clock + 1, some carrier.origin)] := by
  obtain ⟨carrier, hslot, hage, hconsumed⟩ :=
    topFreshTailCloseReadyPortEventOrigin
      ring C s hn hbad Z hreach atom hready e exported hevent
  obtain ⟨hsite, hneighbor, hrecord, htime, _,
    hsource, hdest, hoperand, _⟩ :=
    topFreshTailAuditSelectedPortFrame
      ring C s Z e exported hevent
  obtain ⟨value, tail, _, hatom⟩ := hready
  have hheadOperand : exported.operand = atom := by
    rw [hoperand, hsite]
    exact hatom
  refine ⟨carrier, hslot, hage, ?_, hrecord, htime,
    ?_, ?_, hheadOperand, hconsumed⟩
  · intro other hother
    rw [hslot] at hother
    exact (Option.some.inj hother).symm
  · rw [hsource]
    exact hsite
  · rw [hdest]
    exact hneighbor

/-- Selected U on the source block creates a real sampled D
and a reached genealogy carrier. Consumer: J1 U-case. -/
theorem topFreshTailAuditSourceUnreadStep
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (Z : TopFixedTraceState n)
    (hreach : topClockReached ring C Z)
    (e : Fin n) (j : Fin (topClockSpan n))
    (hsite : e = certSite s j.val)
    (hxl : (Z.1.1 e).l = false)
    (hyl : (Z.1.1 (ring.rightNeighbor e)).l = false)
    (hu : (Z.1.1 e).qOut = .U) :
    ((topFixedTraceNext ring C Z e).1.1
      (certSite s j.val)).qOut =
        .D (Z.1.1 e).d (Z.1.1 e).beta ∧
    ∃ carrier : TopFreshTailCarrier (topClockSpan n),
      (topFreshTailGenealogy ring C s
        (topFixedTraceNext ring C Z e)).slots j =
          some carrier ∧
      ∃ (sample : DigitSample (compileAdvice (ceilLogTwo n)) n),
        DigitRecordedSample
          (topFixedTraceNext ring C Z e).1.2 sample ∧
        sample.id.lane = .comparison ∧
        sample.id.site = certSite s j.val ∧
        ((topFixedTraceNext ring C Z e).1.2.current
          (certSite s j.val)).comparison.out.atom =
          some (.sampled sample.id) ∧
        sample.value = (Z.1.1 e).d ∧
        sample.tail = (Z.1.1 e).beta := by
  have hnewD :=
    topFreshTailFifoUnreadSamples ring C Z e hxl hyl hu
  have hsiteD :
      ((topFixedTraceNext ring C Z e).1.1
        (certSite s j.val)).qOut =
          .D (Z.1.1 e).d (Z.1.1 e).beta := by
    rw [← hsite]
    exact hnewD
  have hnextReach :=
    topClockReachedNext ring C Z e hreach
  obtain ⟨carrier, hslot, _⟩ :=
    topFreshTailAuditReachedDataCarrier ring C s hn hbad
      (topFixedTraceNext ring C Z e) hnextReach j
      (Z.1.1 e).d (Z.1.1 e).beta hsiteD
  obtain ⟨sample, hrecord, hlane, hsampleSite, _, hvalue,
    htail, hatom⟩ :=
    topFreshTailAuditPhysicalUnreadSample
      ring C Z e hxl hyl hu
  refine ⟨hsiteD, carrier, hslot, sample, hrecord,
    hlane, ?_, ?_, hvalue, htail⟩
  · exact hsampleSite.trans hsite
  · rw [← hsite]
    exact hatom


/-- P.3 J1: transport an OLD source D proof to an occupied new
source slot when both its causal carrier and comparison operand
travel unchanged. The recorded sample is persisted by the real
digitAuditStep, not re-created.
Consumer: source and responder arms of J1 preservation. -/
theorem topFreshTailAuditDataTransport
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (Z : TopFixedTraceState n) (e : Fin n)
    (hprov : TopFreshTailAuditSourceDataProvenance ring C s Z)
    (i j : Fin (topClockSpan n))
    (v : Fin (compileAdvice (ceilLogTwo n)).topA)
    (tail : Bool)
    (hold : (Z.1.1 (certSite s i.val)).qOut = .D v tail)
    (hslot :
      (topFreshTailGenealogy ring C s
        (topFixedTraceNext ring C Z e)).slots j =
      (topFreshTailGenealogy ring C s Z).slots i)
    (hatom :
      ((topFixedTraceNext ring C Z e).1.2.current
        (certSite s j.val)).comparison.out.atom =
      (Z.1.2.current
        (certSite s i.val)).comparison.out.atom) :
    ∃ carrier : TopFreshTailCarrier (topClockSpan n),
      (topFreshTailGenealogy ring C s
        (topFixedTraceNext ring C Z e)).slots j = some carrier ∧
      ((∃ initial : Fin (topClockSpan n),
          carrier.origin = .inherited initial ∧
          ((topFixedTraceNext ring C Z e).1.2.current
            (certSite s j.val)).comparison.out.atom =
            some (.inherited .comparison
              (certSite s initial.val) .output)) ∨
       ∃ (k : Fin (topClockSpan n))
         (sample : DigitSample (compileAdvice (ceilLogTwo n)) n),
          DigitRecordedSample
            (topFixedTraceNext ring C Z e).1.2 sample ∧
          sample.id.lane = .comparison ∧
          sample.id.site = certSite s k.val ∧
          ((topFixedTraceNext ring C Z e).1.2.current
            (certSite s j.val)).comparison.out.atom =
            some (.sampled sample.id) ∧
          sample.value = v ∧ sample.tail = tail) := by
  obtain ⟨carrier, hcarrier, hkind⟩ := hprov i v tail hold
  refine ⟨carrier, hslot.trans hcarrier, ?_⟩
  rcases hkind with hinherited | hsample
  · obtain ⟨initial, horigin, hoperand⟩ := hinherited
    exact Or.inl ⟨initial, horigin, hatom.trans hoperand⟩
  · obtain ⟨k, sample, hrecord, hlane, hsite,
      hoperand, hvalue, htail⟩ := hsample
    refine Or.inr ⟨k, sample, ?_, hlane, hsite,
      hatom.trans hoperand, hvalue, htail⟩
    exact digitRecordedSampleStep ring (piD Z.1.1)
      Z.1.2 e sample hrecord


end L3

