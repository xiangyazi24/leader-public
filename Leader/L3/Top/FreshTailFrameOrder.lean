/-!
J1 provenance induction, consumer: TopClockFreshTailPhase /
TopFreshTailBackwardsPurity.
-/

theorem topFreshTailAuditLaneBlockedInteriorAtom
    {c : Compiled} {n : Nat}
    (stamp : Nat) (source destination : Fin n)
    (x y : DigitLaneView c)
    (gx gy : DigitLaneGhost c n)
    (v : Fin c.topA) (tail : Bool)
    (hxl : x.leader = false) (hyl : y.leader = false)
    (hxo : x.out = .D v tail)
    (hmark : y.marker = false)
    (hoccupied : y.out ≠ .E) :
    (digitLaneReplay .comparison stamp source destination
      x y gx gy).x.out.atom = gx.out.atom := by
  cases hyo : y.out with
  | E => exact False.elim (hoccupied hyo)
  | U =>
      simp [digitLaneReplay, hxl, hyl, hxo, hmark,
        hyo, OutTok.isD, OutTok.isE, OutTok.isU]
  | D w t =>
      simp [digitLaneReplay, hxl, hyl, hxo, hmark,
        hyo, OutTok.isD, OutTok.isE, OutTok.isU]

/-- A physically blocked nonmarker source-D service also retains
the OLD comparison atom in the actual audit.
Consumer: J1 source initiator D-stay case. -/
theorem topFreshTailAuditPhysicalBlockedInteriorAtom
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n)
    (Z : TopFixedTraceState n) (e : Fin n)
    (v : Fin (compileAdvice (ceilLogTwo n)).topA)
    (tail : Bool)
    (hxl : (Z.1.1 e).l = false)
    (hyl : (Z.1.1 (ring.rightNeighbor e)).l = false)
    (hxo : (Z.1.1 e).qOut = .D v tail)
    (hmark : (Z.1.1 (ring.rightNeighbor e)).beta = false)
    (hoccupied :
      (Z.1.1 (ring.rightNeighbor e)).qOut ≠ .E) :
    ((topFixedTraceNext ring C Z e).1.2.current
      e).comparison.out.atom =
    (Z.1.2.current e).comparison.out.atom := by
  have hlocal := topFreshTailAuditLaneBlockedInteriorAtom
    (Z.1.2.clock + 1) e (ring.rightNeighbor e)
    (digitLaneView .comparison (piD Z.1.1 e)
      (piD Z.1.1 e).word.beta)
    (digitLaneView .comparison
      (piD Z.1.1 (ring.rightNeighbor e))
      (piD Z.1.1 (ring.rightNeighbor e)).word.beta)
    (Z.1.2.current e).comparison
    (Z.1.2.current (ring.rightNeighbor e)).comparison
    v tail
    (by change (Z.1.1 e).l = false; exact hxl)
    (by change (Z.1.1 (ring.rightNeighbor e)).l = false; exact hyl)
    (by change (Z.1.1 e).qOut = .D v tail; exact hxo)
    (by change (Z.1.1 (ring.rightNeighbor e)).beta = false; exact hmark)
    (by change (Z.1.1 (ring.rightNeighbor e)).qOut ≠ .E; exact hoccupied)
  simp only [topFixedTraceNext, digitAuditStep, digitGhostStep]
  change (digitLaneReplay .comparison (Z.1.2.clock + 1)
    e (ring.rightNeighbor e)
    (digitLaneView .comparison (piD Z.1.1 e)
      (piD Z.1.1 e).word.beta)
    (digitLaneView .comparison
      (piD Z.1.1 (ring.rightNeighbor e))
      (piD Z.1.1 (ring.rightNeighbor e)).word.beta)
    (Z.1.2.current e).comparison
    (Z.1.2.current (ring.rightNeighbor e)).comparison).x.out.atom =
    (Z.1.2.current e).comparison.out.atom
  exact hlocal

/-- A beta-marked OLD blocked port preserves the comparison
output atom independent of simultaneous QI/QC owner actions.
Consumer: J1 source initiator D-stay case. -/
theorem topFreshTailAuditPhysicalBlockedPortAtom
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n)
    (Z : TopFixedTraceState n) (e : Fin n)
    (v : Fin (compileAdvice (ceilLogTwo n)).topA)
    (tail : Bool)
    (hxl : (Z.1.1 e).l = false)
    (hyl : (Z.1.1 (ring.rightNeighbor e)).l = false)
    (hxo : (Z.1.1 e).qOut = .D v tail)
    (hmark : (Z.1.1 (ring.rightNeighbor e)).beta = true)
    (hblocked :
      (Z.1.1 (ring.rightNeighbor e)).qIn.isE = false ∨
      (Z.1.1 (ring.rightNeighbor e)).qCarry.isOff = false) :
    ((topFixedTraceNext ring C Z e).1.2.current
      e).comparison.out.atom =
    (Z.1.2.current e).comparison.out.atom := by
  have hblockView :
      (digitLaneView .comparison
        (piD Z.1.1 (ring.rightNeighbor e))
        (piD Z.1.1 (ring.rightNeighbor e)).word.beta).input.isE =
          false ∨
      (digitLaneView .comparison
        (piD Z.1.1 (ring.rightNeighbor e))
        (piD Z.1.1 (ring.rightNeighbor e)).word.beta).carryLive =
          true := by
    rcases hblocked with hinput | hcarry
    · exact Or.inl hinput
    · apply Or.inr
      cases hc : (Z.1.1 (ring.rightNeighbor e)).qCarry with
      | OFF =>
          rw [hc] at hcarry
          cases hcarry
      | L bit err =>
          change (Z.1.1 (ring.rightNeighbor e)).qCarry.isL = true
          rw [hc]
          rfl
  have hlocal := topFreshTailAuditLaneBlockedPortAtom
    (Z.1.2.clock + 1) e (ring.rightNeighbor e)
    (digitLaneView .comparison (piD Z.1.1 e)
      (piD Z.1.1 e).word.beta)
    (digitLaneView .comparison
      (piD Z.1.1 (ring.rightNeighbor e))
      (piD Z.1.1 (ring.rightNeighbor e)).word.beta)
    (Z.1.2.current e).comparison
    (Z.1.2.current (ring.rightNeighbor e)).comparison
    v tail
    (by change (Z.1.1 e).l = false; exact hxl)
    (by change (Z.1.1 (ring.rightNeighbor e)).l = false; exact hyl)
    (by change (Z.1.1 e).qOut = .D v tail; exact hxo)
    (by change (Z.1.1 (ring.rightNeighbor e)).beta = true; exact hmark)
    hblockView
  simp only [topFixedTraceNext, digitAuditStep, digitGhostStep]
  change (digitLaneReplay .comparison (Z.1.2.clock + 1)
    e (ring.rightNeighbor e)
    (digitLaneView .comparison (piD Z.1.1 e)
      (piD Z.1.1 e).word.beta)
    (digitLaneView .comparison
      (piD Z.1.1 (ring.rightNeighbor e))
      (piD Z.1.1 (ring.rightNeighbor e)).word.beta)
    (Z.1.2.current e).comparison
    (Z.1.2.current (ring.rightNeighbor e)).comparison).x.out.atom =
    (Z.1.2.current e).comparison.out.atom
  exact hlocal

/-- On the OLD comparison marker port, an empty/carry-free
responder necessarily consumes the OLD D in the physical QO
owner. Its departure rules out the source-D-stay case of J1.
Consumer: topFreshTailAuditPhysicalOldSourceAtom. -/
theorem topFreshTailAuditPhysicalPortDeparts
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n)
    (Z : TopFixedTraceState n) (e : Fin n)
    (v : Fin (compileAdvice (ceilLogTwo n)).topA)
    (tail : Bool)
    (hxl : (Z.1.1 e).l = false)
    (hyl : (Z.1.1 (ring.rightNeighbor e)).l = false)
    (hxo : (Z.1.1 e).qOut = .D v tail)
    (hmark : (Z.1.1 (ring.rightNeighbor e)).beta = true)
    (hyi : (Z.1.1 (ring.rightNeighbor e)).qIn = .E)
    (hyc : (Z.1.1 (ring.rightNeighbor e)).qCarry = .OFF) :
    ((topFixedTraceNext ring C Z e).1.1 e).qOut =
      (if tail then .U else .E) := by
  have howner :
      (topPortLiteralTopOwner ring Z.1.1 e).x.qOut =
        (if tail then .U else .E) := by
    unfold topPortLiteralTopOwner
    cases hsourceInput : (Z.1.1 e).qIn <;>
      cases hsourceCarry : (Z.1.1 e).qCarry <;>
      simp [liveTopPair, hxl, hyl, hxo, hmark,
        hyi, hyc, hsourceInput, hsourceCarry, inT,
        OutTok.isD, OutTok.isE,
        InTok.isE, InTok.isP, InTok.isS, InTok.isX,
        QCarry.isOff, QCarry.isL,
        topInternal, topTerminal, outV, outT] <;>
      (try split) <;> (try split) <;> simp
  change (topFixedPublicNext ring C Z.1.1 e e).qOut =
    (if tail then .U else .E)
  exact (topPortLiteralSourceFields
    ring C Z.1.1 e).2.2.trans howner


/-- A selected source retaining its OLD physical D also retains
the OLD audit atom. The other possibilities are an internal D
move or a successful beta-port departure, both of which leave
E/U rather than D at this source.
Consumer: J1 initiator arm of the real-edge induction. -/
theorem topFreshTailAuditPhysicalOldSourceAtom
    {n : Nat} (ring : DirectedRing n) (hn : 2 ≤ n)
    (C : HeadlineConfiguration n)
    (Z : TopFixedTraceState n) (e : Fin n)
    (v : Fin (compileAdvice (ceilLogTwo n)).topA)
    (tail : Bool)
    (hxl : (Z.1.1 e).l = false)
    (hyl : (Z.1.1 (ring.rightNeighbor e)).l = false)
    (hxo : (Z.1.1 e).qOut = .D v tail)
    (hnew :
      ((topFixedTraceNext ring C Z e).1.1 e).qOut =
        .D v tail) :
    ((topFixedTraceNext ring C Z e).1.2.current
      e).comparison.out.atom =
    (Z.1.2.current e).comparison.out.atom := by
  cases hmarker : (Z.1.1 (ring.rightNeighbor e)).beta with
  | false =>
      cases hyo : (Z.1.1 (ring.rightNeighbor e)).qOut with
      | E =>
          have hmove := (topFreshTailFifoDataMove
            ring hn C Z e v tail hxl hyl hxo hyo hmarker).1
          rw [hnew] at hmove
          cases tail <;> cases hmove
      | U =>
          exact topFreshTailAuditPhysicalBlockedInteriorAtom
            ring C Z e v tail hxl hyl hxo hmarker
            (by intro h; rw [hyo] at h; cases h)
      | D w t =>
          exact topFreshTailAuditPhysicalBlockedInteriorAtom
            ring C Z e v tail hxl hyl hxo hmarker
            (by intro h; rw [hyo] at h; cases h)
  | true =>
      cases hyi : (Z.1.1 (ring.rightNeighbor e)).qIn with
      | E =>
          cases hyc : (Z.1.1 (ring.rightNeighbor e)).qCarry with
          | OFF =>
              have hdeparture := topFreshTailAuditPhysicalPortDeparts
                ring C Z e v tail hxl hyl hxo hmarker hyi hyc
              rw [hnew] at hdeparture
              cases tail <;> cases hdeparture
          | L bit err =>
              exact topFreshTailAuditPhysicalBlockedPortAtom
                ring C Z e v tail hxl hyl hxo hmarker
                (Or.inr (by simp [hyc, QCarry.isOff]))
      | P a t =>
          exact topFreshTailAuditPhysicalBlockedPortAtom
            ring C Z e v tail hxl hyl hxo hmarker
            (Or.inl (by simp [hyi, InTok.isE]))
      | S a t =>
          exact topFreshTailAuditPhysicalBlockedPortAtom
            ring C Z e v tail hxl hyl hxo hmarker
            (Or.inl (by simp [hyi, InTok.isE]))
      | X =>
          exact topFreshTailAuditPhysicalBlockedPortAtom
            ring C Z e v tail hxl hyl hxo hmarker
            (Or.inl (by simp [hyi, InTok.isE]))

/-- A pre-existing responder D is not overwritten by a selected
source's transport and keeps the comparison atom in the same
physical/audit service. Consumer: J1 responder old-D branch. -/
theorem topFreshTailAuditPhysicalResponderDataKeep
    {n : Nat} (ring : DirectedRing n) (hn : 2 ≤ n)
    (C : HeadlineConfiguration n)
    (Z : TopFixedTraceState n) (e : Fin n)
    (v : Fin (compileAdvice (ceilLogTwo n)).topA)
    (tail : Bool)
    (hxl : (Z.1.1 e).l = false)
    (hyl : (Z.1.1 (ring.rightNeighbor e)).l = false)
    (hyo : (Z.1.1 (ring.rightNeighbor e)).qOut =
      .D v tail) :
    ((topFixedTraceNext ring C Z e).1.1
      (ring.rightNeighbor e)).qOut = .D v tail ∧
    ((topFixedTraceNext ring C Z e).1.2.current
      (ring.rightNeighbor e)).comparison.out.atom =
      (Z.1.2.current (ring.rightNeighbor e)).comparison.out.atom := by
  have hphysical :=
    topFreshTailCausalResponderPhysicalOutput ring hn C Z e
  have hnew : ((topFixedTraceNext ring C Z e).1.1
      (ring.rightNeighbor e)).qOut = .D v tail := by
    simpa [hxl, hyl, hyo, OutTok.isE] using hphysical
  have hne : ring.rightNeighbor e ≠ e :=
    EWord.rightNeighborDifferent ring hn e
  have hxlView :
      (digitLaneView .comparison (piD Z.1.1 e)
        (piD Z.1.1 e).word.beta).leader = false := by
    change (Z.1.1 e).l = false
    exact hxl
  have hylView :
      (digitLaneView .comparison
        (piD Z.1.1 (ring.rightNeighbor e))
        (piD Z.1.1 (ring.rightNeighbor e)).word.beta).leader =
        false := by
    change (Z.1.1 (ring.rightNeighbor e)).l = false
    exact hyl
  have hyoView :
      (digitLaneView .comparison
        (piD Z.1.1 (ring.rightNeighbor e))
        (piD Z.1.1 (ring.rightNeighbor e)).word.beta).out =
        .D v tail := by
    change (Z.1.1 (ring.rightNeighbor e)).qOut = .D v tail
    exact hyo
  have hghost :
      (digitLaneReplay .comparison (Z.1.2.clock + 1)
        e (ring.rightNeighbor e)
        (digitLaneView .comparison (piD Z.1.1 e)
          (piD Z.1.1 e).word.beta)
        (digitLaneView .comparison
          (piD Z.1.1 (ring.rightNeighbor e))
          (piD Z.1.1 (ring.rightNeighbor e)).word.beta)
        (Z.1.2.current e).comparison
        (Z.1.2.current (ring.rightNeighbor e)).comparison).y.out.atom =
      (Z.1.2.current (ring.rightNeighbor e)).comparison.out.atom := by
    simp [digitLaneReplay, hxlView, hylView, hyoView,
      OutTok.isD, OutTok.isE]
  constructor
  · exact hnew
  · simp only [topFixedTraceNext, digitAuditStep, digitGhostStep,
      if_neg hne]
    change (digitLaneReplay .comparison (Z.1.2.clock + 1)
      e (ring.rightNeighbor e)
      (digitLaneView .comparison (piD Z.1.1 e)
        (piD Z.1.1 e).word.beta)
      (digitLaneView .comparison
        (piD Z.1.1 (ring.rightNeighbor e))
        (piD Z.1.1 (ring.rightNeighbor e)).word.beta)
      (Z.1.2.current e).comparison
      (Z.1.2.current (ring.rightNeighbor e)).comparison).y.out.atom =
      (Z.1.2.current (ring.rightNeighbor e)).comparison.out.atom
    exact hghost


/-- J1 initiator case: the selected source slot can gain a
recorded sample from OLD U, retain an OLD D with its carrier
and audit atom, or cease to hold D. No other source-row creates
a packet. Consumer: topFreshTailAuditSourceDataStep. -/
theorem topFreshTailAuditSourceDataInitiatorStep
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (Z : TopFixedTraceState n) (e : Fin n)
    (hqueue : TopFreshTailCausalQueue ring C s Z)
    (hprov : TopFreshTailAuditSourceDataProvenance ring C s Z)
    (j : Fin (topClockSpan n))
    (hsite : e = certSite s j.val)
    (v : Fin (compileAdvice (ceilLogTwo n)).topA)
    (tail : Bool)
    (hnewD :
      ((topFixedTraceNext ring C Z e).1.1
        (certSite s j.val)).qOut = .D v tail) :
    ∃ carrier : TopFreshTailCarrier (topClockSpan n),
      (topFreshTailGenealogy ring C s
        (topFixedTraceNext ring C Z e)).slots j = some carrier ∧
      ((∃ initial : Fin (topClockSpan n),
          carrier.origin = .inherited initial ∧
          ((topFixedTraceNext ring C Z e).1.2.current
            (certSite s j.val)).comparison.out.atom =
            some (.inherited .comparison
              (certSite s initial.val) .output)) ∨
       ∃ (k : Fin (topClockSpan n))
         (sample : DigitSample (compileAdvice (ceilLogTwo n)) n),
          DigitRecordedSample
            (topFixedTraceNext ring C Z e).1.2 sample ∧
          sample.id.lane = .comparison ∧
          sample.id.site = certSite s k.val ∧
          ((topFixedTraceNext ring C Z e).1.2.current
            (certSite s j.val)).comparison.out.atom =
            some (.sampled sample.id) ∧
          sample.value = v ∧ sample.tail = tail) := by
  subst e
  have hgeom := topFreshTailCausalSourcePublicGeometry
    ring C s hn hbad Z hqueue.trace.1 j
  have hxl := hgeom.1
  have hyl := hgeom.2.1
  cases hold : (Z.1.1 (certSite s j.val)).qOut with
  | E =>
      by_cases hj : j.val = 0
      · have hbirth := topFreshTailCausalBadBorderBirthStep
          ring C s hn hbad Z (certSite s j.val)
          hqueue j hj rfl hold
        rw [hbirth.1] at hnewD
        cases hnewD
      · have hpositive : 0 < j.val := by omega
        have hempty := topFreshTailCausalBadInteriorEmptyStep
          ring C s hn hbad Z (certSite s j.val)
          hqueue j hpositive rfl hold
        rw [hempty.1] at hnewD
        cases hnewD
  | U =>
      obtain ⟨hnew, carrier, hslot, sample, hrecord,
        hlane, hsampleSite, hatom, hvalue, htail⟩ :=
        topFreshTailAuditSourceUnreadStep
          ring C s hn hbad Z hqueue.trace.1
          (certSite s j.val) j rfl hxl hyl hold
      have hboth :
          OutTok.D (Z.1.1 (certSite s j.val)).d
            (Z.1.1 (certSite s j.val)).beta =
          OutTok.D v tail := hnew.symm.trans hnewD
      have hv : (Z.1.1 (certSite s j.val)).d = v := by
        have h := congrArg
          (outV (compileAdvice (ceilLogTwo n))) hboth
        simpa [outV] using h
      have ht : (Z.1.1 (certSite s j.val)).beta = tail := by
        have h := congrArg outT hboth
        simpa [outT] using h
      refine ⟨carrier, hslot, Or.inr ?_⟩
      exact ⟨j, sample, hrecord, hlane, hsampleSite,
        hatom, hvalue.trans hv, htail.trans ht⟩
  | D oldV oldTail =>
      have hpossible :=
        topFreshTailCausalDSourceOutcomes
          ring C Z (certSite s j.val) oldV oldTail
          hxl hyl hold
      rcases hpossible with hstay | hdeparture
      · have hboth :
            OutTok.D oldV oldTail = OutTok.D v tail :=
          hstay.symm.trans hnewD
        have hv : oldV = v := by
          have h := congrArg
            (outV (compileAdvice (ceilLogTwo n))) hboth
          simpa [outV] using h
        have ht : oldTail = tail := by
          have h := congrArg outT hboth
          simpa [outT] using h
        have hoperand := topFreshTailAuditPhysicalOldSourceAtom
          ring (by omega : 2 ≤ n) C Z (certSite s j.val)
          oldV oldTail hxl hyl hold hstay
        have hslot :
            (topFreshTailGenealogy ring C s
              (topFixedTraceNext ring C Z
                (certSite s j.val))).slots j =
            (topFreshTailGenealogy ring C s Z).slots j := by
          rw [topFreshTailCausalReplayNext]
          change
            topFreshTailGenealogyNextSlot ring C s
              (topFreshTailGenealogy ring C s Z)
              (certSite s j.val) j =
            (topFreshTailGenealogy ring C s Z).slots j
          simp [topFreshTailGenealogyNextSlot,
            hqueue.trace.2, hstay, hold]
        obtain ⟨carrier, hcarrier, hkind⟩ :=
          topFreshTailAuditDataTransport
            ring C s Z (certSite s j.val)
            hprov j j oldV oldTail hold hslot hoperand
        refine ⟨carrier, hcarrier, ?_⟩
        rcases hkind with hinherited | hsample
        · exact Or.inl hinherited
        · obtain ⟨k, sample, hrecord, hlane, hsiteSample,
            hatom, hvalue, htail⟩ := hsample
          exact Or.inr ⟨k, sample, hrecord, hlane,
            hsiteSample, hatom, hvalue.trans hv, htail.trans ht⟩
      · rw [hdeparture] at hnewD
        cases oldTail <;> cases hnewD


/-- J1 responder case: an OLD occupied D survives unchanged,
or a new D enters an OLD empty nonmarker source slot from its
immediate predecessor. In the latter case genealogy and audit
both copy the same OLD parent. The incoming border case cannot
create D because that responder is a marker.
Consumer: topFreshTailAuditSourceDataStep. -/
theorem topFreshTailAuditSourceDataResponderStep
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (Z : TopFixedTraceState n) (e : Fin n)
    (hqueue : TopFreshTailCausalQueue ring C s Z)
    (hprov : TopFreshTailAuditSourceDataProvenance ring C s Z)
    (j : Fin (topClockSpan n))
    (hincoming : ring.rightNeighbor e = certSite s j.val)
    (v : Fin (compileAdvice (ceilLogTwo n)).topA)
    (tail : Bool)
    (hnewD :
      ((topFixedTraceNext ring C Z e).1.1
        (certSite s j.val)).qOut = .D v tail) :
    ∃ carrier : TopFreshTailCarrier (topClockSpan n),
      (topFreshTailGenealogy ring C s
        (topFixedTraceNext ring C Z e)).slots j = some carrier ∧
      ((∃ initial : Fin (topClockSpan n),
          carrier.origin = .inherited initial ∧
          ((topFixedTraceNext ring C Z e).1.2.current
            (certSite s j.val)).comparison.out.atom =
            some (.inherited .comparison
              (certSite s initial.val) .output)) ∨
       ∃ (k : Fin (topClockSpan n))
         (sample : DigitSample (compileAdvice (ceilLogTwo n)) n),
          DigitRecordedSample
            (topFixedTraceNext ring C Z e).1.2 sample ∧
          sample.id.lane = .comparison ∧
          sample.id.site = certSite s k.val ∧
          ((topFixedTraceNext ring C Z e).1.2.current
            (certSite s j.val)).comparison.out.atom =
            some (.sampled sample.id) ∧
          sample.value = v ∧ sample.tail = tail) := by
  have hgeom := topFreshTailCausalSourcePublicGeometry
    ring C s hn hbad Z hqueue.trace.1 j
  have hyl : (Z.1.1 (certSite s j.val)).l = false :=
    hgeom.1
  have hphysical :=
    topFreshTailCausalResponderPhysicalOutput
      ring (by omega : 2 ≤ n) C Z e
  rw [hincoming] at hphysical
  cases hxl : (Z.1.1 e).l with
  | true =>
      have hE :
          ((topFixedTraceNext ring C Z e).1.1
            (certSite s j.val)).qOut = .E := by
        simpa [hxl] using hphysical
      rw [hE] at hnewD
      cases hnewD
  | false =>
      cases hold : (Z.1.1 (certSite s j.val)).qOut with
      | D oldV oldTail =>
          have hsame :
              ((topFixedTraceNext ring C Z e).1.1
                (certSite s j.val)).qOut =
                .D oldV oldTail := by
            simpa [hxl, hyl, hold, OutTok.isE] using hphysical
          have heq : OutTok.D oldV oldTail = .D v tail :=
            hsame.symm.trans hnewD
          have hv : oldV = v := by
            have h := congrArg
              (outV (compileAdvice (ceilLogTwo n))) heq
            simpa [outV] using h
          have ht : oldTail = tail := by
            have h := congrArg outT heq
            simpa [outT] using h
          have hresponderOld :
              (Z.1.1 (ring.rightNeighbor e)).qOut =
                .D oldV oldTail := by
            rw [hincoming]
            exact hold
          have hkeep := topFreshTailAuditPhysicalResponderDataKeep
            ring (by omega : 2 ≤ n) C Z e
            oldV oldTail hxl
            (by rw [hincoming]; exact hyl)
            hresponderOld
          have hatom :
              ((topFixedTraceNext ring C Z e).1.2.current
                (certSite s j.val)).comparison.out.atom =
              (Z.1.2.current
                (certSite s j.val)).comparison.out.atom := by
            rw [← hincoming]
            exact hkeep.2
          have hslot :
              (topFreshTailGenealogy ring C s
                (topFixedTraceNext ring C Z e)).slots j =
              (topFreshTailGenealogy ring C s Z).slots j := by
            rw [topFreshTailCausalReplayNext]
            change topFreshTailGenealogyNextSlot ring C s
              (topFreshTailGenealogy ring C s Z) e j =
              (topFreshTailGenealogy ring C s Z).slots j
            simp [topFreshTailGenealogyNextSlot,
              hqueue.trace.2, hsame, hold]
          obtain ⟨carrier, hcarrier, hkind⟩ :=
            topFreshTailAuditDataTransport
              ring C s Z e hprov j j oldV oldTail
              hold hslot hatom
          refine ⟨carrier, hcarrier, ?_⟩
          rcases hkind with hinherited | hsample
          · exact Or.inl hinherited
          · obtain ⟨k, sample, hrecord, hlane, hsampleSite,
              hoperand, hvalue, htail⟩ := hsample
            exact Or.inr ⟨k, sample, hrecord, hlane,
              hsampleSite, hoperand,
              hvalue.trans hv, htail.trans ht⟩
      | U =>
          have hsame :
              ((topFixedTraceNext ring C Z e).1.1
                (certSite s j.val)).qOut = .U := by
            simpa [hxl, hyl, hold, OutTok.isE] using hphysical
          rw [hsame] at hnewD
          cases hnewD
      | E =>
          by_cases hzero : j.val = 0
          · have hmarker :
                (Z.1.1 (certSite s j.val)).beta =
                  true := by
              simpa [hzero] using hgeom.2.2.1
            have hsame :
                ((topFixedTraceNext ring C Z e).1.1
                  (certSite s j.val)).qOut = .E := by
              simpa [hxl, hyl, hmarker, hold,
                OutTok.isD, OutTok.isE] using hphysical
            rw [hsame] at hnewD
            cases hnewD
          · have hpositive : 0 < j.val := by omega
            have hmarker :
                (Z.1.1 (certSite s j.val)).beta =
                  false := by
              simpa [hzero] using hgeom.2.2.1
            have hpredecessor :=
              topFreshTailCausalIncomingPredecessor
                ring hn s j hpositive e hincoming
            cases hsource : (Z.1.1 e).qOut with
            | E =>
                have hsame :
                    ((topFixedTraceNext ring C Z e).1.1
                      (certSite s j.val)).qOut = .E := by
                  simpa [hxl, hyl, hmarker, hold, hsource,
                    OutTok.isD, OutTok.isE] using hphysical
                rw [hsame] at hnewD
                cases hnewD
            | U =>
                have hsame :
                    ((topFixedTraceNext ring C Z e).1.1
                      (certSite s j.val)).qOut = .E := by
                  simpa [hxl, hyl, hmarker, hold, hsource,
                    OutTok.isD, OutTok.isE] using hphysical
                rw [hsame] at hnewD
                cases hnewD
            | D oldV oldTail =>
                have hnewSource :
                    ((topFixedTraceNext ring C Z e).1.1
                      (certSite s j.val)).qOut =
                        .D oldV oldTail := by
                  simpa [hxl, hyl, hmarker, hold, hsource,
                    OutTok.isD, OutTok.isE, outV, outT]
                    using hphysical
                have heq : OutTok.D oldV oldTail = .D v tail :=
                  hnewSource.symm.trans hnewD
                have hv : oldV = v := by
                  have h := congrArg
                    (outV (compileAdvice (ceilLogTwo n))) heq
                  simpa [outV] using h
                have ht : oldTail = tail := by
                  have h := congrArg outT heq
                  simpa [outT] using h
                have holdSource :
                    (Z.1.1 (certSite s (j.val - 1))).qOut =
                      .D oldV oldTail := by
                  rw [← hpredecessor]
                  exact hsource
                have hslot :
                    (topFreshTailGenealogy ring C s
                      (topFixedTraceNext ring C Z e)).slots j =
                    (topFreshTailGenealogy ring C s Z).slots
                      (⟨j.val - 1,
                        show j.val - 1 < topClockSpan n by omega⟩ :
                        Fin (topClockSpan n)) := by
                  rw [topFreshTailCausalReplayNext]
                  change topFreshTailGenealogyNextSlot ring C s
                    (topFreshTailGenealogy ring C s Z) e j =
                    (topFreshTailGenealogy ring C s Z).slots
                      (⟨j.val - 1,
                        show j.val - 1 < topClockSpan n by omega⟩ :
                        Fin (topClockSpan n))
                  unfold topFreshTailGenealogyNextSlot
                  rw [hqueue.trace.2]
                  rw [hpredecessor] at hnewSource
                  rw [hpredecessor]
                  rw [hnewSource, hold]
                  simp only [dif_pos hpositive, if_true]
                have hmove := topFreshTailAuditPhysicalMoveAtom
                  ring (by omega : 2 ≤ n) C Z e
                  oldV oldTail
                  hxl
                  (by rw [hincoming]; exact hyl)
                  hsource
                  (by rw [hincoming]; exact hmarker)
                  (by rw [hincoming]; exact hold)
                have hatom :
                    ((topFixedTraceNext ring C Z e).1.2.current
                      (certSite s j.val)).comparison.out.atom =
                    (Z.1.2.current
                      (certSite s (j.val - 1))).comparison.out.atom := by
                  rw [← hincoming, ← hpredecessor]
                  exact hmove
                obtain ⟨carrier, hcarrier, hkind⟩ :=
                  topFreshTailAuditDataTransport ring C s Z e hprov
                    (⟨j.val - 1,
                      show j.val - 1 < topClockSpan n by omega⟩ :
                      Fin (topClockSpan n))
                    j oldV oldTail holdSource hslot hatom
                refine ⟨carrier, hcarrier, ?_⟩
                rcases hkind with hinherited | hsample
                · exact Or.inl hinherited
                · obtain ⟨k, sample, hrecord, hlane, hsampleSite,
                    hoperand, hvalue, htail⟩ := hsample
                  exact Or.inr ⟨k, sample, hrecord, hlane,
                    hsampleSite, hoperand,
                    hvalue.trans hv, htail.trans ht⟩


/-- J1 selected-edge preservation on the actual fixed-public
physical/audit scheduler. The three cases are: selected source
initiator, selected responder, or an untouched source output.
Consumer: TopClockFreshTailPhase and J2 source-port provenance. -/
theorem topFreshTailAuditSourceDataStep
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (Z : TopFixedTraceState n) (e : Fin n)
    (hreach : topClockReached ring C Z)
    (hprov : TopFreshTailAuditSourceDataProvenance ring C s Z) :
    TopFreshTailAuditSourceDataProvenance ring C s
      (topFixedTraceNext ring C Z e) := by
  have hqueue :=
    topFreshTailCloseReachedQueue ring C s hn hbad Z hreach
  unfold TopFreshTailAuditSourceDataProvenance
  intro j v tail hnewD
  by_cases hsource : certSite s j.val = e
  · exact topFreshTailAuditSourceDataInitiatorStep
      ring C s hn hbad Z e hqueue hprov
      j hsource.symm v tail hnewD
  · by_cases htarget :
        certSite s j.val = ring.rightNeighbor e
    · exact topFreshTailAuditSourceDataResponderStep
        ring C s hn hbad Z e hqueue hprov
        j htarget.symm v tail hnewD
    · have hframe :=
        (topPortLiteralAwayFields ring C Z.1.1 e
          (certSite s j.val) hsource htarget).2.2
      have hOldD :
          (Z.1.1 (certSite s j.val)).qOut =
            .D v tail := by
        change
          ((topFixedTraceNext ring C Z e).1.1
            (certSite s j.val)).qOut =
          (Z.1.1 (certSite s j.val)).qOut at hframe
        rw [hframe] at hnewD
        exact hnewD
      obtain ⟨_, carrier, hslot, hkind⟩ :=
        topFreshTailAuditSourceDataAwayStep
          ring C s Z e hreach hprov j v tail
          hsource htarget hOldD
      exact ⟨carrier, hslot, hkind⟩

/-- J1 induction over a concrete scheduler word from any reached
prefix, preserving the entire physical/audit source provenance.
Consumer: topFreshTailAuditSourceDataReached. -/
private theorem topFreshTailAuditSourceDataFold
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (word : List (Fin n)) :
    ∀ Z : TopFixedTraceState n,
      topClockReached ring C Z →
      TopFreshTailAuditSourceDataProvenance ring C s Z →
      TopFreshTailAuditSourceDataProvenance ring C s
        (word.foldl (topFixedTraceNext ring C) Z) := by
  induction word with
  | nil =>
      intro Z _ hprov
      exact hprov
  | cons e rest ih =>
      intro Z hreach hprov
      change TopFreshTailAuditSourceDataProvenance ring C s
        (rest.foldl (topFixedTraceNext ring C)
          (topFixedTraceNext ring C Z e))
      exact ih (topFixedTraceNext ring C Z e)
        (topClockReachedNext ring C Z e hreach)
        (topFreshTailAuditSourceDataStep
          ring C s hn hbad Z e hreach hprov)

/-- P.3 J1: every reached fixed-public scheduler trace has
source-D genealogy carriers and matching inherited-or-recorded
sample operands at all source offsets. This is an invariant of
actual replay, not an independently chosen ghost history.
Consumer: TopClockFreshTailPhase / TopFreshTailBackwardsPurity. -/
theorem topFreshTailAuditSourceDataReached
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (Z : TopFixedTraceState n)
    (hreach : topClockReached ring C Z) :
    TopFreshTailAuditSourceDataProvenance ring C s Z := by
  have hrun :=
    topFreshTailAuditSourceDataFold
      ring C s hn hbad Z.2
      ((C, digitAuditInitial (piD C)), [])
      (by rfl)
      (topFreshTailAuditSourceDataInitial ring C s)
  change
    TopFreshTailAuditSourceDataProvenance ring C s
      (topFixedTraceRun ring C Z.2) at hrun
  rw [← hreach] at hrun
  exact hrun

end L3

namespace L3

/-- J2 base: neither the replayed genealogy nor the literal comparison
audit has any source-port receipt before a scheduler service.
Consumer: TopClockFreshTailPhase, historical port matching. -/
theorem topFreshTailAuditPortHistoryInitial
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n) :
    (topFreshTailGenealogy ring C s
      ((C, digitAuditInitial (piD C)), [])).consumed = [] ∧
    topClockConcreteExportsAfter s
      ((C, digitAuditInitial (piD C)), []) 0 = [] := by
  constructor <;> rfl

/-- A comparison export also reports the OLD physical output payload,
not merely the old output atom. Consumer: J2 port payload matching. -/
theorem topFreshTailAuditLaneExportPayload
    {c : Compiled} {n : Nat}
    (lane : DigitLane) (stamp : Nat)
    (source destination : Fin n)
    (x y : DigitLaneView c) (gx gy : DigitLaneGhost c n)
    (exported : DigitExport c n)
    (hevent :
      (digitLaneReplay lane stamp source destination
        x y gx gy).exported = some exported) :
    exported.value = outV c x.out ∧
    exported.tail = outT x.out := by
  rw [topFreshTailAuditLaneExportEquation] at hevent
  split at hevent
  · cases hevent
    exact ⟨rfl, rfl⟩
  · cases hevent

/-- On a selected source-port export, the value and tail in the
comparison receipt are those of the OLD source D byte. This also
allows inherited initial source outputs. Consumer: J2 and J3. -/
theorem topFreshTailAuditPortOldPayload
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (Z : TopFixedTraceState n) (e : Fin n)
    (atom : Option (DigitAtom n))
    (hready : topClockPortReady s atom Z)
    (exported : DigitExport (compileAdvice (ceilLogTwo n)) n)
    (hevent :
      topFreshTailGenealogyPortExport ring C s Z e =
        some exported) :
    ∃ (value : Fin (compileAdvice (ceilLogTwo n)).topA)
      (tail : Bool),
      (Z.1.1 (certSite s (topClockSpan n - 1))).qOut =
        .D value tail ∧
      exported.value = value ∧ exported.tail = tail := by
  obtain ⟨value, tail, houtput, _⟩ := hready
  obtain ⟨hsite, hnext, _, _, _, _, _, _, _⟩ :=
    topFreshTailAuditSelectedPortFrame
      ring C s Z e exported hevent
  have hp :
      e = certSite s (topClockSpan n - 1) ∧
      ring.rightNeighbor e = certSite s (topClockSpan n) :=
    ⟨hsite, hnext⟩
  have hservice :
      (digitService (Z.1.2.clock + 1) e
        (ring.rightNeighbor e)
        (piD Z.1.1 e)
        (piD Z.1.1 (ring.rightNeighbor e))
        (Z.1.2.current e)
        (Z.1.2.current (ring.rightNeighbor e))).comparison.exported =
          some exported := by
    simpa only [topFreshTailGenealogyPortExport, if_pos hp]
      using hevent
  have hlocal :
      (digitLaneReplay .comparison (Z.1.2.clock + 1) e
        (ring.rightNeighbor e)
        (digitLaneView .comparison (piD Z.1.1 e)
          (piD Z.1.1 e).word.beta)
        (digitLaneView .comparison
          (piD Z.1.1 (ring.rightNeighbor e))
          (piD Z.1.1 (ring.rightNeighbor e)).word.beta)
        (Z.1.2.current e).comparison
        (Z.1.2.current (ring.rightNeighbor e)).comparison).exported =
          some exported := by
    exact hservice
  obtain ⟨hv, ht⟩ :=
    topFreshTailAuditLaneExportPayload
      .comparison (Z.1.2.clock + 1) e
      (ring.rightNeighbor e)
      (digitLaneView .comparison (piD Z.1.1 e)
        (piD Z.1.1 e).word.beta)
      (digitLaneView .comparison
        (piD Z.1.1 (ring.rightNeighbor e))
        (piD Z.1.1 (ring.rightNeighbor e)).word.beta)
      (Z.1.2.current e).comparison
      (Z.1.2.current (ring.rightNeighbor e)).comparison
      exported hlocal
  have hsource :
      (Z.1.1 e).qOut = .D value tail := by
    rw [hsite]
    exact houtput
  refine ⟨value, tail, houtput, ?_, ?_⟩
  · rw [hv]
    change outV (compileAdvice (ceilLogTwo n))
      (Z.1.1 e).qOut = value
    rw [hsource]
    rfl
  · rw [ht]
    change outT (Z.1.1 e).qOut = tail
    rw [hsource]
    rfl

/-- A comparison receipt already in the audit remains recorded
after any physical scheduler service, including independent owner
writes and blocked offers. Consumer: J2 historical forward map. -/
theorem topFreshTailAuditRecordedExportNext
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n)
    (Z : TopFixedTraceState n) (e : Fin n)
    (exported : DigitExport (compileAdvice (ceilLogTwo n)) n)
    (hrecord : DigitRecordedExport Z.1.2 exported) :
    DigitRecordedExport
      (topFixedTraceNext ring C Z e).1.2 exported := by
  obtain ⟨frame, hmem, htime, hsource, hreceipt⟩ := hrecord
  refine ⟨frame, ?_, htime, hsource, hreceipt⟩
  change frame ∈
    (digitAuditStep ring (piD Z.1.1) Z.1.2 e).frames
  simp only [digitAuditStep, List.mem_cons]
  exact Or.inr hmem

/-- A recorded export persists through a literal suffix word.
Consumer: J2 matching for an event followed by arbitrary services. -/
private theorem topFreshTailAuditRecordedExportFold
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n)
    (word : List (Fin n)) :
    ∀ (Z : TopFixedTraceState n)
      (exported : DigitExport (compileAdvice (ceilLogTwo n)) n),
      DigitRecordedExport Z.1.2 exported →
      DigitRecordedExport
        (word.foldl (topFixedTraceNext ring C) Z).1.2 exported := by
  induction word with
  | nil =>
      intro Z exported hrecord
      exact hrecord
  | cons e rest ih =>
      intro Z exported hrecord
      change DigitRecordedExport
        (rest.foldl (topFixedTraceNext ring C)
          (topFixedTraceNext ring C Z e)).1.2 exported
      exact ih (topFixedTraceNext ring C Z e) exported
        (topFreshTailAuditRecordedExportNext
          ring C Z e exported hrecord)

/-- An authenticated comparison receipt at the NEW audit clock
must belong to the uniquely prepended selected physical frame.
An older frame cannot have that clock. Consumer: J2 converse. -/
theorem topFreshTailAuditFreshComparisonIsSelected
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n)
    (Z : TopFixedTraceState n) (e : Fin n)
    (hreach : topClockReached ring C Z)
    (exported : DigitExport (compileAdvice (ceilLogTwo n)) n)
    (hrecord :
      DigitRecordedExport
        (topFixedTraceNext ring C Z e).1.2 exported)
    (htime : exported.time = Z.1.2.clock + 1)
    (hlane : exported.lane = .comparison) :
    (digitService (Z.1.2.clock + 1) e
      (ring.rightNeighbor e)
      (piD Z.1.1 e)
      (piD Z.1.1 (ring.rightNeighbor e))
      (Z.1.2.current e)
      (Z.1.2.current (ring.rightNeighbor e))).comparison.exported =
        some exported := by
  have horder :=
    topFreshTailAuditFrameOrderReached ring C Z hreach
  obtain ⟨frame, hmem, hframeTime, _, hreceipt⟩ := hrecord
  change frame ∈
    (digitAuditStep ring (piD Z.1.1) Z.1.2 e).frames at hmem
  simp only [digitAuditStep, List.mem_cons] at hmem
  rcases hmem with hnew | hold
  · rw [hnew, hlane] at hreceipt
    change
      (digitService (Z.1.2.clock + 1) e
        (ring.rightNeighbor e)
        (piD Z.1.1 e)
        (piD Z.1.1 (ring.rightNeighbor e))
        (Z.1.2.current e)
        (Z.1.2.current (ring.rightNeighbor e))).comparison.exported =
          some exported at hreceipt
    exact hreceipt
  · have hb := horder.1 frame hold
    omega

/-- Every comparison receipt at the NEW clock and nominated
port endpoints is the genuine OLD genealogy port event; no
unselected old frame can forge the event. Consumer: J2 converse. -/
theorem topFreshTailAuditFreshPortConverse
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (Z : TopFixedTraceState n) (e : Fin n)
    (hreach : topClockReached ring C Z)
    (exported : DigitExport (compileAdvice (ceilLogTwo n)) n)
    (hrecord :
      DigitRecordedExport
        (topFixedTraceNext ring C Z e).1.2 exported)
    (htime : exported.time = Z.1.2.clock + 1)
    (hlane : exported.lane = .comparison)
    (hsource :
      exported.source = certSite s (topClockSpan n - 1))
    (hdestination :
      exported.destination = certSite s (topClockSpan n)) :
    topFreshTailGenealogyPortExport ring C s Z e =
      some exported := by
  have hservice :=
    topFreshTailAuditFreshComparisonIsSelected
      ring C Z e hreach exported hrecord htime hlane
  have hlocal :
      (digitLaneReplay .comparison (Z.1.2.clock + 1) e
        (ring.rightNeighbor e)
        (digitLaneView .comparison (piD Z.1.1 e)
          (piD Z.1.1 e).word.beta)
        (digitLaneView .comparison
          (piD Z.1.1 (ring.rightNeighbor e))
          (piD Z.1.1 (ring.rightNeighbor e)).word.beta)
        (Z.1.2.current e).comparison
        (Z.1.2.current (ring.rightNeighbor e)).comparison).exported =
          some exported := by
    exact hservice
  obtain ⟨_, _, hsite, hnext, _⟩ :=
    topFreshTailAuditLaneExportFields
      .comparison (Z.1.2.clock + 1) e
      (ring.rightNeighbor e)
      (digitLaneView .comparison (piD Z.1.1 e)
        (piD Z.1.1 e).word.beta)
      (digitLaneView .comparison
        (piD Z.1.1 (ring.rightNeighbor e))
        (piD Z.1.1 (ring.rightNeighbor e)).word.beta)
      (Z.1.2.current e).comparison
      (Z.1.2.current (ring.rightNeighbor e)).comparison
      exported hlocal
  have hp :
      e = certSite s (topClockSpan n - 1) ∧
      ring.rightNeighbor e = certSite s (topClockSpan n) :=
    ⟨hsite.symm.trans hsource,
      hnext.symm.trans hdestination⟩
  simpa only [topFreshTailGenealogyPortExport, if_pos hp]
    using hservice

/-- J2 exact single-edge port comparison:
at the NEW clock, port-authenticated records are equivalent to
the OLD genealogy export event. Consumer: chronological bijection. -/
theorem topFreshTailAuditPortReceiptStepIff
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (Z : TopFixedTraceState n) (e : Fin n)
    (hreach : topClockReached ring C Z)
    (exported : DigitExport (compileAdvice (ceilLogTwo n)) n)
    (htime : exported.time = Z.1.2.clock + 1)
    (hlane : exported.lane = .comparison)
    (hsource :
      exported.source = certSite s (topClockSpan n - 1))
    (hdestination :
      exported.destination = certSite s (topClockSpan n)) :
    (topFreshTailGenealogyPortExport ring C s Z e =
      some exported) ↔
    DigitRecordedExport
      (topFixedTraceNext ring C Z e).1.2 exported := by
  constructor
  · intro hevent
    obtain ⟨_, _, hrecord, _, _, _, _, _, _⟩ :=
      topFreshTailAuditSelectedPortFrame
        ring C s Z e exported hevent
    exact hrecord
  · intro hrecord
    exact topFreshTailAuditFreshPortConverse
      ring C s Z e hreach exported hrecord
      htime hlane hsource hdestination

/-- A fixed real service has at most one comparison export
at its own new clock, even if another lane also exports.
Consumer: J2 one-to-one receipt matching. -/
theorem topFreshTailAuditFreshComparisonUnique
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n)
    (Z : TopFixedTraceState n) (e : Fin n)
    (hreach : topClockReached ring C Z)
    (first second :
      DigitExport (compileAdvice (ceilLogTwo n)) n)
    (hfirst :
      DigitRecordedExport
        (topFixedTraceNext ring C Z e).1.2 first)
    (hsecond :
      DigitRecordedExport
        (topFixedTraceNext ring C Z e).1.2 second)
    (htimeFirst : first.time = Z.1.2.clock + 1)
    (htimeSecond : second.time = Z.1.2.clock + 1)
    (hlaneFirst : first.lane = .comparison)
    (hlaneSecond : second.lane = .comparison) :
    first = second := by
  have hf := topFreshTailAuditFreshComparisonIsSelected
    ring C Z e hreach first hfirst htimeFirst hlaneFirst
  have hg := topFreshTailAuditFreshComparisonIsSelected
    ring C Z e hreach second hsecond htimeSecond hlaneSecond
  exact Option.some.inj (hf.symm.trans hg)

/-- Each OLD genealogy port export owns the unique comparison
receipt at its selected service clock. Consumer: J2 injection. -/
theorem topFreshTailAuditPortReceiptUnique
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (Z : TopFixedTraceState n) (e : Fin n)
    (hreach : topClockReached ring C Z)
    (exported :
      DigitExport (compileAdvice (ceilLogTwo n)) n)
    (hevent :
      topFreshTailGenealogyPortExport ring C s Z e =
        some exported)
    (other :
      DigitExport (compileAdvice (ceilLogTwo n)) n)
    (hother :
      DigitRecordedExport
        (topFixedTraceNext ring C Z e).1.2 other)
    (htime : other.time = Z.1.2.clock + 1)
    (hlane : other.lane = .comparison) :
    other = exported := by
  obtain ⟨_, _, hrecord, hfirstTime, hfirstLane,
    _, _, _, _⟩ :=
    topFreshTailAuditSelectedPortFrame
      ring C s Z e exported hevent
  exact (topFreshTailAuditFreshComparisonUnique
    ring C Z e hreach exported other
    hrecord hother hfirstTime htime hfirstLane hlane).symm

/-- The real fixed-public trace respects word concatenation at
each historical selected edge. Consumer: J2 reached word positions. -/
theorem topFreshTailAuditTraceAppend
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n)
    (pre suffix : List (Fin n)) (e : Fin n) :
    topFixedTraceRun ring C (pre ++ [e] ++ suffix) =
      suffix.foldl (topFixedTraceNext ring C)
        (topFixedTraceNext ring C
          (topFixedTraceRun ring C pre) e) := by
  have hfold :
      ∀ (w v : List (Fin n)) (Z : TopFixedTraceState n),
        (w ++ v).foldl (topFixedTraceNext ring C) Z =
          v.foldl (topFixedTraceNext ring C)
            (w.foldl (topFixedTraceNext ring C) Z) := by
    intro w
    induction w with
    | nil =>
        intro v Z
        rfl
    | cons item rest ih =>
        intro v Z
        change
          (rest ++ v).foldl (topFixedTraceNext ring C)
            (topFixedTraceNext ring C Z item) =
          v.foldl (topFixedTraceNext ring C)
            (rest.foldl (topFixedTraceNext ring C)
              (topFixedTraceNext ring C Z item))
        exact ih v (topFixedTraceNext ring C Z item)
  change
    (pre ++ [e] ++ suffix).foldl
      (topFixedTraceNext ring C)
      ((C, digitAuditInitial (piD C)), []) =
    suffix.foldl (topFixedTraceNext ring C)
      (topFixedTraceNext ring C
        (pre.foldl (topFixedTraceNext ring C)
          ((C, digitAuditInitial (piD C)), [])) e)
  rw [hfold (pre ++ [e]) suffix
    ((C, digitAuditInitial (piD C)), [])]
  rw [hfold pre [e] ((C, digitAuditInitial (piD C)), [])]
  rfl


end L3

namespace L3

open Classical

set_option autoImplicit false
set_option Elab.async false

/-- A literal OLD comparison-port export persists in the final
audit, with its OLD source atom and physical endpoints.
Consumer: J2 historical port/receipt forward map. -/
theorem topFreshTailAuditHistoricalPortExportRecorded
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (pre suffix : List (Fin n)) (e : Fin n)
    (exported :
      DigitExport (compileAdvice (ceilLogTwo n)) n)
    (hevent :
      topFreshTailGenealogyPortExport ring C s
        (topFixedTraceRun ring C pre) e = some exported) :
    DigitRecordedExport
      (topFixedTraceRun ring C
        (pre ++ [e] ++ suffix)).1.2 exported ∧
    exported.time =
      (topFixedTraceRun ring C pre).1.2.clock + 1 ∧
    exported.source = certSite s (topClockSpan n - 1) ∧
    exported.destination = certSite s (topClockSpan n) ∧
    exported.operand =
      ((topFixedTraceRun ring C pre).1.2.current e).comparison.out.atom := by
  obtain ⟨hsite, hnext, hrecord, htime, _, hsource,
    hdestination, hoperand, _⟩ :=
    topFreshTailAuditSelectedPortFrame
      ring C s (topFixedTraceRun ring C pre)
      e exported hevent
  refine ⟨?_, htime, ?_, ?_, hoperand⟩
  · rw [topFreshTailAuditTraceAppend ring C pre suffix e]
    exact topFreshTailAuditRecordedExportFold ring C suffix
      (topFixedTraceNext ring C
        (topFixedTraceRun ring C pre) e) exported hrecord
  · rw [hsource]
    exact hsite
  · rw [hdestination]
    exact hnext

/-- The scheduler word is exactly the history stored in the real
physical/audit fold. Consumer: J2 reached-prefix reconstruction. -/
theorem topFreshTailAuditRunWord
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n)
    (word : List (Fin n)) :
    (topFixedTraceRun ring C word).2 = word := by
  have hfold :
      ∀ (w : List (Fin n)) (Z : TopFixedTraceState n),
        (w.foldl (topFixedTraceNext ring C) Z).2 =
          Z.2 ++ w := by
    intro w
    induction w with
    | nil =>
        intro Z
        simp only [List.foldl_nil, List.append_nil]
    | cons edge rest ih =>
        intro Z
        change
          (rest.foldl (topFixedTraceNext ring C)
            (topFixedTraceNext ring C Z edge)).2 =
          Z.2 ++ (edge :: rest)
        rw [ih (topFixedTraceNext ring C Z edge)]
        change (Z.2 ++ [edge]) ++ rest = Z.2 ++ (edge :: rest)
        simp only [List.append_assoc]
        rfl
  have h := hfold word ((C, digitAuditInitial (piD C)), [])
  change (topFixedTraceRun ring C word).2 = [] ++ word at h
  simpa only [List.nil_append] using h

/-- Every concrete prefix is a reached fixed-public trace.
Consumer: J2 converse and J3 old-head provenance. -/
theorem topFreshTailAuditRunReached
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n)
    (word : List (Fin n)) :
    topClockReached ring C (topFixedTraceRun ring C word) := by
  unfold topClockReached
  rw [topFreshTailAuditRunWord ring C word]

/-- At a historical OLD output, the selected source carrier, the
comparison receipt, its operand, and the consumed origin agree;
the receipt persists across the suffix. Consumer: J3 charging. -/
theorem topFreshTailAuditHistoricalPortOldHead
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (pre suffix : List (Fin n)) (e : Fin n)
    (atom : Option (DigitAtom n))
    (hready : topClockPortReady s atom
      (topFixedTraceRun ring C pre))
    (exported :
      DigitExport (compileAdvice (ceilLogTwo n)) n)
    (hevent :
      topFreshTailGenealogyPortExport ring C s
        (topFixedTraceRun ring C pre) e = some exported) :
    ∃ (value : Fin (compileAdvice (ceilLogTwo n)).topA)
      (tail : Bool)
      (carrier : TopFreshTailCarrier (topClockSpan n)),
      ((topFixedTraceRun ring C pre).1.1
        (certSite s (topClockSpan n - 1))).qOut =
          .D value tail ∧
      (topFreshTailGenealogy ring C s
        (topFixedTraceRun ring C pre)).slots
          (⟨topClockSpan n - 1,
            show topClockSpan n - 1 < topClockSpan n by
              have hw := cert_rho_ge_three n hn
              change 3 ≤ topClockSpan n at hw
              omega⟩ : Fin (topClockSpan n)) = some carrier ∧
      exported.value = value ∧
      exported.tail = tail ∧
      exported.operand = atom ∧
      DigitRecordedExport
        (topFixedTraceRun ring C
          (pre ++ [e] ++ suffix)).1.2 exported ∧
      (topFreshTailGenealogy ring C s
        (topFixedTraceNext ring C
          (topFixedTraceRun ring C pre) e)).consumed =
        (topFreshTailGenealogy ring C s
          (topFixedTraceRun ring C pre)).consumed ++
          [((topFixedTraceRun ring C pre).1.2.clock + 1,
             some carrier.origin)] := by
  obtain ⟨value, tail, houtput, hv, ht⟩ :=
    topFreshTailAuditPortOldPayload
      ring C s (topFixedTraceRun ring C pre) e
      atom hready exported hevent
  obtain ⟨carrier, hslot, _, _, hrecord, _, _, _,
    hoperand, hconsumed⟩ :=
    topFreshTailAuditPortOldCarrierFrame
      ring C s hn hbad
      (topFixedTraceRun ring C pre)
      (topFreshTailAuditRunReached ring C pre)
      atom hready e exported hevent
  refine ⟨value, tail, carrier, houtput, hslot,
    hv, ht, hoperand, ?_, ?_⟩
  · rw [topFreshTailAuditTraceAppend ring C pre suffix e]
    exact topFreshTailAuditRecordedExportFold ring C suffix
      (topFixedTraceNext ring C
        (topFixedTraceRun ring C pre) e) exported hrecord
  · rw [topFreshTailCausalReplayNext]
    exact hconsumed

/-- During a real scheduler suffix, each recorded comparison-port
receipt is either inherited from the starting audit or comes
from one OLD-prefix port event in this suffix. The proof uses
the single new frame and its strict frame clock.
Consumer: J2 historical receipt converse. -/
private theorem topFreshTailAuditHistoricalPortConverseFold
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (word : List (Fin n)) :
    ∀ (Z : TopFixedTraceState n)
      (exported : DigitExport (compileAdvice (ceilLogTwo n)) n),
      topClockReached ring C Z →
      DigitRecordedExport
        (word.foldl (topFixedTraceNext ring C) Z).1.2 exported →
      exported.lane = .comparison →
      exported.source = certSite s (topClockSpan n - 1) →
      exported.destination = certSite s (topClockSpan n) →
      DigitRecordedExport Z.1.2 exported ∨
      ∃ (pre suffix : List (Fin n)) (edge : Fin n),
        word = pre ++ [edge] ++ suffix ∧
        topFreshTailGenealogyPortExport ring C s
          (pre.foldl (topFixedTraceNext ring C) Z) edge =
            some exported := by
  induction word with
  | nil =>
      intro Z exported _ hrecord _ _ _
      exact Or.inl hrecord
  | cons selected rest ih =>
      intro Z exported hreach hrecord hlane hsource hdestination
      have hstep :=
        ih (topFixedTraceNext ring C Z selected)
          exported (topClockReachedNext ring C Z selected hreach)
          hrecord hlane hsource hdestination
      rcases hstep with hrecent | hlater
      · have hcurrent := hrecent
        obtain ⟨frame, hmem, hframeTime,
          hframeSource, hreceipt⟩ := hrecent
        change frame ∈
          (digitAuditStep ring (piD Z.1.1)
            Z.1.2 selected).frames at hmem
        simp only [digitAuditStep, List.mem_cons] at hmem
        rcases hmem with hselected | hprior
        · have htime : exported.time = Z.1.2.clock + 1 := by
            rw [hselected] at hframeTime
            dsimp only at hframeTime
            omega
          apply Or.inr
          refine ⟨[], rest, selected, ?_, ?_⟩
          · rfl
          · change
              topFreshTailGenealogyPortExport ring C s Z selected =
                some exported
            exact topFreshTailAuditFreshPortConverse
              ring C s Z selected hreach exported hcurrent
              htime hlane hsource hdestination
        · exact Or.inl
            ⟨frame, hprior, hframeTime, hframeSource, hreceipt⟩
      · obtain ⟨pre, suffix, edge, hword, hevent⟩ := hlater
        apply Or.inr
        refine ⟨selected :: pre, suffix, edge, ?_, ?_⟩
        · rw [hword]
          rfl
        · exact hevent

/-- Every port-authenticated comparison receipt in the final audit
was created by the OLD-prefix genealogy event of a genuine
physical word position. Consumer: J2 surjectivity. -/
theorem topFreshTailAuditHistoricalPortReceiptConverse
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (word : List (Fin n))
    (exported :
      DigitExport (compileAdvice (ceilLogTwo n)) n)
    (hrecord :
      DigitRecordedExport
        (topFixedTraceRun ring C word).1.2 exported)
    (hlane : exported.lane = .comparison)
    (hsource :
      exported.source = certSite s (topClockSpan n - 1))
    (hdestination :
      exported.destination = certSite s (topClockSpan n)) :
    ∃ (pre suffix : List (Fin n)) (edge : Fin n),
      word = pre ++ [edge] ++ suffix ∧
      topFreshTailGenealogyPortExport ring C s
        (topFixedTraceRun ring C pre) edge =
          some exported := by
  have hfold :=
    topFreshTailAuditHistoricalPortConverseFold
      ring C s word ((C, digitAuditInitial (piD C)), [])
      exported (by rfl) hrecord hlane hsource hdestination
  rcases hfold with hbase | hposition
  · obtain ⟨frame, hmem, _, _, _⟩ := hbase
    change frame ∈
      ([] : List (DigitFrame (compileAdvice (ceilLogTwo n)) n))
      at hmem
    cases hmem
  · obtain ⟨pre, suffix, edge, hword, hevent⟩ := hposition
    exact ⟨pre, suffix, edge, hword, hevent⟩

/-- Actual audit time increases once per scheduler service.
Consumer: J2 positional uniqueness. -/
private theorem topFreshTailAuditClockFold
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n)
    (word : List (Fin n)) :
    ∀ Z : TopFixedTraceState n,
      (word.foldl (topFixedTraceNext ring C) Z).1.2.clock =
        Z.1.2.clock + word.length := by
  induction word with
  | nil =>
      intro Z
      simp only [List.foldl_nil, List.length_nil, Nat.add_zero]
  | cons edge rest ih =>
      intro Z
      change
        (rest.foldl (topFixedTraceNext ring C)
          (topFixedTraceNext ring C Z edge)).1.2.clock =
        Z.1.2.clock + (edge :: rest).length
      rw [ih (topFixedTraceNext ring C Z edge)]
      change Z.1.2.clock + 1 + rest.length =
        Z.1.2.clock + (rest.length + 1)
      omega

/-- A reached real word has audit clock equal to the count of
its selected physical services. Consumer: J2 event positions. -/
theorem topFreshTailAuditRunClock
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n)
    (word : List (Fin n)) :
    (topFixedTraceRun ring C word).1.2.clock =
      word.length := by
  have hfold :=
    topFreshTailAuditClockFold ring C word
      ((C, digitAuditInitial (piD C)), [])
  change
    (topFixedTraceRun ring C word).1.2.clock =
      0 + word.length at hfold
  simpa only [Nat.zero_add] using hfold

/-- Each real OLD-prefix port event stamps its export at the
position immediately following that prefix. Consumer: J2
uniqueness of the historical service position. -/
theorem topFreshTailAuditHistoricalPortStamp
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (pre : List (Fin n)) (edge : Fin n)
    (exported :
      DigitExport (compileAdvice (ceilLogTwo n)) n)
    (hevent :
      topFreshTailGenealogyPortExport ring C s
        (topFixedTraceRun ring C pre) edge = some exported) :
    exported.time = pre.length + 1 := by
  obtain ⟨_, _, _, htime, _, _, _, _, _⟩ :=
    topFreshTailAuditSelectedPortFrame
      ring C s (topFixedTraceRun ring C pre)
      edge exported hevent
  rw [topFreshTailAuditRunClock ring C pre] at htime
  exact htime

/-- The selected OLD-prefix port event at a zero-based scheduler
position. This is a predicate on the actual physical word, not
on an independently chosen ghost history. Consumer: J2. -/
noncomputable def TopFreshTailAuditHistoricalPortAt
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (word : List (Fin n)) (index : Nat)
    (exported :
      DigitExport (compileAdvice (ceilLogTwo n)) n) : Prop :=
  ∃ (pre suffix : List (Fin n)) (edge : Fin n),
    word = pre ++ [edge] ++ suffix ∧
    pre.length = index ∧
    topFreshTailGenealogyPortExport ring C s
      (topFixedTraceRun ring C pre) edge =
        some exported

/-- A final authenticated comparison-port receipt has exactly
one OLD-prefix service position. Consumer: J2 inverse map. -/
theorem topFreshTailAuditHistoricalPortReceiptPosition
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (word : List (Fin n))
    (exported :
      DigitExport (compileAdvice (ceilLogTwo n)) n)
    (hrecord :
      DigitRecordedExport
        (topFixedTraceRun ring C word).1.2 exported)
    (hlane : exported.lane = .comparison)
    (hsource :
      exported.source = certSite s (topClockSpan n - 1))
    (hdestination :
      exported.destination = certSite s (topClockSpan n)) :
    ∃ index : Nat,
      TopFreshTailAuditHistoricalPortAt
        ring C s word index exported ∧
      ∀ other : Nat,
        TopFreshTailAuditHistoricalPortAt
          ring C s word other exported → other = index := by
  obtain ⟨pre, suffix, edge, hword, hevent⟩ :=
    topFreshTailAuditHistoricalPortReceiptConverse
      ring C s word exported hrecord hlane hsource hdestination
  refine ⟨pre.length, ?_, ?_⟩
  · exact ⟨pre, suffix, edge, hword, rfl, hevent⟩
  · intro index hposition
    unfold TopFreshTailAuditHistoricalPortAt at hposition
    obtain ⟨otherPre, otherSuffix, otherEdge,
      _, hindex, otherEvent⟩ := hposition
    have htime :=
      topFreshTailAuditHistoricalPortStamp
        ring C s pre edge exported hevent
    have hotherTime :=
      topFreshTailAuditHistoricalPortStamp
        ring C s otherPre otherEdge exported otherEvent
    omega

/-- At one scheduler position there is only one selected OLD
genealogy export, hence no two distinct comparison-port receipts
can claim it. Consumer: J2 injection. -/
theorem topFreshTailAuditHistoricalPortIndexInjective
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (word : List (Fin n)) (index : Nat)
    (first second :
      DigitExport (compileAdvice (ceilLogTwo n)) n)
    (hfirst :
      TopFreshTailAuditHistoricalPortAt
        ring C s word index first)
    (hsecond :
      TopFreshTailAuditHistoricalPortAt
        ring C s word index second) :
    first = second := by
  unfold TopFreshTailAuditHistoricalPortAt at hfirst hsecond
  obtain ⟨pre, suffix, edge, hword, hlen, hevent⟩ := hfirst
  obtain ⟨otherPre, otherSuffix, otherEdge,
    hotherWord, hotherLen, hotherEvent⟩ := hsecond
  have hsameLen : pre.length = otherPre.length := by omega
  have hsameWord :
      pre ++ (edge :: suffix) =
        otherPre ++ (otherEdge :: otherSuffix) := by
    simpa only [List.append_assoc, List.singleton_append] using hword.symm.trans hotherWord
  have hsplit :
      ∀ (left right otherLeft otherRight : List (Fin n))
        (a b : Fin n),
        left.length = otherLeft.length →
        left ++ (a :: right) = otherLeft ++ (b :: otherRight) →
        left = otherLeft ∧ a = b := by
    intro left
    induction left with
    | nil =>
        intro right otherLeft otherRight a b hlength heq
        cases otherLeft with
        | nil =>
            change a :: right = b :: otherRight at heq
            exact ⟨rfl, (List.cons.inj heq).1⟩
        | cons head rest =>
            simp only [List.length_nil, List.length_cons] at hlength
            omega
    | cons head rest ih =>
        intro right otherLeft otherRight a b hlength heq
        cases otherLeft with
        | nil =>
            simp only [List.length_cons, List.length_nil] at hlength
            omega
        | cons otherHead otherRest =>
            change
              head :: (rest ++ a :: right) =
                otherHead :: (otherRest ++ b :: otherRight)
              at heq
            have hhead : head = otherHead :=
              (List.cons.inj heq).1
            have hrest :
                rest ++ a :: right =
                  otherRest ++ b :: otherRight :=
              (List.cons.inj heq).2
            have hlengthRest : rest.length = otherRest.length := by
              simp only [List.length_cons] at hlength
              omega
            obtain ⟨hbefore, hselected⟩ :=
              ih right otherRest otherRight a b
                hlengthRest hrest
            exact ⟨by rw [hhead, hbefore], hselected⟩
  obtain ⟨hpre, hedge⟩ :=
    hsplit pre suffix otherPre otherSuffix
      edge otherEdge hsameLen hsameWord
  rw [← hpre, ← hedge] at hotherEvent
  exact Option.some.inj (hevent.symm.trans hotherEvent)

/-- J2: the final authenticated comparison-port receipts are in
one-to-one correspondence with OLD-prefix selected port events:
each receipt has a unique position, and an event at any position
gives that very receipt. Injectivity at a position is the
separate topFreshTailAuditHistoricalPortIndexInjective lemma.
Consumer: J3 inherited/visit/fresh charging. -/
theorem topFreshTailAuditHistoricalPortReceiptBijection
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (word : List (Fin n))
    (exported :
      DigitExport (compileAdvice (ceilLogTwo n)) n)
    (hlane : exported.lane = .comparison)
    (hsource :
      exported.source = certSite s (topClockSpan n - 1))
    (hdestination :
      exported.destination = certSite s (topClockSpan n)) :
    DigitRecordedExport
      (topFixedTraceRun ring C word).1.2 exported ↔
    ∃ index : Nat,
      TopFreshTailAuditHistoricalPortAt
        ring C s word index exported ∧
      ∀ other : Nat,
        TopFreshTailAuditHistoricalPortAt
          ring C s word other exported → other = index := by
  constructor
  · intro hrecord
    exact topFreshTailAuditHistoricalPortReceiptPosition
      ring C s word exported hrecord hlane hsource hdestination
  · intro hposition
    obtain ⟨index, hselected, _⟩ := hposition
    unfold TopFreshTailAuditHistoricalPortAt at hselected
    obtain ⟨pre, suffix, edge, hword, _, hevent⟩ := hselected
    rw [hword]
    exact (topFreshTailAuditHistoricalPortExportRecorded
      ring C s pre suffix edge exported hevent).1

end L3

namespace L3

/-- The selected physical border U sample installs the first tracked
fresh root at offset zero, with its actual audit operand and no OLD
carrier at or behind that root.  This is the border-birth row of
the J5 barrier; the later "earliest exporting root" argument is
separate.  Consumer: J5 barrier initialization. -/
theorem topFreshTailFirstBorderSampleRoot
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (Z : TopFixedTraceState n)
    (hreach : topClockReached ring C Z)
    (e : Fin n)
    (hborder : e = certSite s 0)
    (hunread : (Z.1.1 e).qOut = .U) :
    ∃ sample : DigitSample (compileAdvice (ceilLogTwo n)) n,
      DigitRecordedSample
        (topFixedTraceNext ring C Z e).1.2 sample ∧
      sample.id.lane = .comparison ∧
      sample.id.site = certSite s 0 ∧
      sample.id.time = Z.1.2.clock + 1 ∧
      sample.value = (Z.1.1 e).d ∧
      sample.tail = true ∧
      ((topFixedTraceNext ring C Z e).1.2.current
        (certSite s 0)).comparison.out.atom =
          some (.sampled sample.id) ∧
      ((topFixedTraceNext ring C Z e).1.1
        (certSite s 0)).qOut = .D (Z.1.1 e).d true ∧
      (topFreshTailGenealogy ring C s
        (topFixedTraceNext ring C Z e)).slots
          (⟨0, show 0 < topClockSpan n by
            have hr := cert_rho_ge_three n hn
            change 3 ≤ topClockSpan n at hr
            omega⟩ : Fin (topClockSpan n)) =
        some { origin := .freshBorder (Z.1.2.clock + 1),
               born := Z.1.2.clock + 1 } ∧
      (∀ (j : Fin (topClockSpan n))
          (a : TopFreshTailCarrier (topClockSpan n)),
        (topFreshTailGenealogy ring C s
          (topFixedTraceNext ring C Z e)).slots j = some a →
        ((∃ i : Fin (topClockSpan n),
            a.origin = .inherited i) ∨
         (∃ i k : Fin (topClockSpan n),
            a.origin = .oldVisit i k)) →
        0 < j.val) ∧
      TopFreshTailCausalQueue ring C s
        (topFixedTraceNext ring C Z e) ∧
      TopFreshTailAuditSourceDataProvenance ring C s
        (topFixedTraceNext ring C Z e) := by
  have hw : 0 < topClockSpan n := by
    have hr := cert_rho_ge_three n hn
    change 3 ≤ topClockSpan n at hr
    omega
  have hgeometry :=
    topFreshTailCausalSourcePublicGeometry
      ring C s hn hbad Z hreach
      (⟨0, hw⟩ : Fin (topClockSpan n))
  have hxl : (Z.1.1 e).l = false := by
    rw [hborder]
    exact hgeometry.1
  have hyl :
      (Z.1.1 (ring.rightNeighbor e)).l = false := by
    rw [hborder]
    exact hgeometry.2.1
  have hmarker : (Z.1.1 e).beta = true := by
    rw [hborder]
    simpa only [Fin.val_mk, if_true] using
      hgeometry.2.2.1
  have htrace :=
    topFreshTailGenealogyTraceReached ring C s Z hreach
  have hbirth :=
    topFreshTailCausalUnreadBorder
      ring C s (topFreshTailGenealogy ring C s Z)
      e (⟨0, hw⟩ : Fin (topClockSpan n))
      hborder rfl
      (by rw [htrace]; exact hunread)
      (by rw [htrace]; exact hxl)
      (by rw [htrace]; exact hyl)
  rw [htrace] at hbirth
  have hroot :
      (topFreshTailGenealogy ring C s
        (topFixedTraceNext ring C Z e)).slots
          (⟨0, hw⟩ : Fin (topClockSpan n)) =
        some { origin := .freshBorder (Z.1.2.clock + 1),
               born := Z.1.2.clock + 1 } := by
    rw [topFreshTailCausalReplayNext]
    exact hbirth
  have hphysical :
      ((topFixedTraceNext ring C Z e).1.1
        (certSite s 0)).qOut =
          .D (Z.1.1 e).d true := by
    rw [← hborder]
    simpa only [hmarker] using
      (topFreshTailFifoUnreadSamples
        ring C Z e hxl hyl hunread)
  obtain ⟨sample, hrecord, hlane, hsite, htime,
    hvalue, htail, hatom⟩ :=
    topFreshTailAuditPhysicalUnreadSample
      ring C Z e hxl hyl hunread
  have hqueueNext :=
    topFreshTailCausalQueueStep ring C s hn hbad Z e
      (topFreshTailCloseReachedQueue
        ring C s hn hbad Z hreach)
  have hprovenanceNext :=
    topFreshTailAuditSourceDataReached
      ring C s hn hbad
      (topFixedTraceNext ring C Z e)
      (topClockReachedNext ring C Z e hreach)
  refine ⟨sample, hrecord, hlane, hsite.trans hborder,
    htime, hvalue, htail.trans hmarker, ?_,
    hphysical, hroot, ?_, hqueueNext, hprovenanceNext⟩
  · rw [← hborder]
    exact hatom
  · intro j a hslot hold
    by_cases hj : 0 < j.val
    · exact hj
    · have hjzero : j.val = 0 := by omega
      have hindex :
          j = (⟨0, hw⟩ : Fin (topClockSpan n)) := by
        apply Fin.ext
        exact hjzero
      rw [hindex, hroot] at hslot
      have hcarrier :
          a = ({ origin := .freshBorder (Z.1.2.clock + 1),
                 born := Z.1.2.clock + 1 } :
               TopFreshTailCarrier (topClockSpan n)) :=
        (Option.some.inj hslot).symm
      have horigin :
          a.origin = .freshBorder (Z.1.2.clock + 1) := by
        rw [hcarrier]
      rcases hold with ⟨i, hold⟩ | ⟨i, k, hold⟩
      · rw [horigin] at hold
        cases hold
      · rw [horigin] at hold
        cases hold

/-- For every selected OLD edge, an already-born OLD carrier can
only persist in its slot or arrive from the immediate predecessor.
Thus no surviving OLD carrier can cross behind the tracked root.
The NEW oldVisit-birth case is NOT discharged here and must be
combined with the true-tail rearm row before claiming full B.step.
Consumer: J5 old-front step, surviving-identity subcase. -/
theorem topFreshTailFirstBorderOldFrontStep
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (Z : TopFixedTraceState n) (e : Fin n)
    (k : Fin (topClockSpan n))
    (hqueue : TopFreshTailCausalQueue ring C s Z)
    (hfront :
      ∀ (j : Fin (topClockSpan n))
        (a : TopFreshTailCarrier (topClockSpan n)),
        (topFreshTailGenealogy ring C s Z).slots j = some a →
        ((∃ i : Fin (topClockSpan n),
            a.origin = .inherited i) ∨
         (∃ i t : Fin (topClockSpan n),
            a.origin = .oldVisit i t)) →
        k.val < j.val)
    (j : Fin (topClockSpan n))
    (a : TopFreshTailCarrier (topClockSpan n))
    (hnew :
      (topFreshTailGenealogy ring C s
        (topFixedTraceNext ring C Z e)).slots j = some a)
    (hage : a.born ≤ Z.1.2.clock)
    (hold :
      (∃ i : Fin (topClockSpan n),
        a.origin = .inherited i) ∨
      (∃ i t : Fin (topClockSpan n),
        a.origin = .oldVisit i t)) :
    k.val < j.val := by
  have hstep := hnew
  rw [topFreshTailCausalReplayNext] at hstep
  have hageGhost :
      a.born ≤
        (topFreshTailGenealogy ring C s Z).trace.1.2.clock := by
    rw [hqueue.trace.2]
    exact hage
  rcases topFreshTailCausalOlderCarrierPlacementExact
      ring C s (topFreshTailGenealogy ring C s Z)
      e j a hstep hageGhost with
    hstay | ⟨_, _, hprevious, _⟩
  · exact hfront j a hstay hold
  · have hfrontPrevious :=
      hfront
        (⟨j.val - 1, show j.val - 1 < topClockSpan n by omega⟩ :
          Fin (topClockSpan n))
        a hprevious hold
    change k.val < j.val - 1 at hfrontPrevious
    omega

/-- The literal enabled D(true) interior move retains the tracked
root and its sampled comparison operand at the right-hand slot,
and inserts a fresh rearm child at the departed slot.  This is
the root-move row of the staircase induction; other owner rows
are not claimed by this declaration.
Consumer: J5 staircase-step induction. -/
theorem topFreshTailFirstBorderStaircaseStep
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (Z : TopFixedTraceState n) (e : Fin n)
    (j : Fin (topClockSpan n))
    (hnext : j.val + 1 < topClockSpan n)
    (hsite : e = certSite s j.val)
    (root : TopFreshTailCarrier (topClockSpan n))
    (hroot :
      (topFreshTailGenealogy ring C s Z).slots j =
        some root)
    (hfresh : ∃ birth : Nat, root.origin = .freshBorder birth)
    (sample : DigitSample (compileAdvice (ceilLogTwo n)) n)
    (hrecord : DigitRecordedSample Z.1.2 sample)
    (hatom : (Z.1.2.current e).comparison.out.atom =
      some (.sampled sample.id))
    (value : Fin (compileAdvice (ceilLogTwo n)).topA)
    (hsource : (Z.1.1 e).qOut = .D value true)
    (htarget :
      (Z.1.1 (ring.rightNeighbor e)).qOut = .E)
    (hxl : (Z.1.1 e).l = false)
    (hyl : (Z.1.1 (ring.rightNeighbor e)).l = false)
    (hyb : (Z.1.1 (ring.rightNeighbor e)).beta = false)
    (hqueue : TopFreshTailCausalQueue ring C s Z) :
    (topFreshTailGenealogy ring C s
      (topFixedTraceNext ring C Z e)).slots j =
      some (topFreshTailGenealogyRearm j
        (Z.1.2.clock + 1) root) ∧
    (topFreshTailGenealogy ring C s
      (topFixedTraceNext ring C Z e)).slots
        (⟨j.val + 1,
          show j.val + 1 < topClockSpan n by omega⟩ :
          Fin (topClockSpan n)) = some root ∧
    ((topFixedTraceNext ring C Z e).1.1 e).qOut = .U ∧
    ((topFixedTraceNext ring C Z e).1.1
      (ring.rightNeighbor e)).qOut = .D value true ∧
    ((topFixedTraceNext ring C Z e).1.2.current
      (ring.rightNeighbor e)).comparison.out.atom =
        some (.sampled sample.id) ∧
    DigitRecordedSample (topFixedTraceNext ring C Z e).1.2
      sample ∧
    (∃ birth : Nat,
      (topFreshTailGenealogyRearm j
        (Z.1.2.clock + 1) root).origin = .freshBorder birth) ∧
    TopFreshTailCausalQueue ring C s
      (topFixedTraceNext ring C Z e) := by
  have htrace := hqueue.trace.2
  have hmoveCarrier :=
    topFreshTailCausalRearmBehindMovedParent
      ring (by omega : 2 ≤ n) C s
      (topFreshTailGenealogy ring C s Z)
      e j value root hnext hsite
      (by rw [htrace]; exact hsource)
      (by rw [htrace]; exact htarget)
      (by rw [htrace]; exact hxl)
      (by rw [htrace]; exact hyl)
      (by rw [htrace]; exact hyb)
      hroot
  rw [htrace] at hmoveCarrier
  have hchild :
      (topFreshTailGenealogy ring C s
        (topFixedTraceNext ring C Z e)).slots j =
        some (topFreshTailGenealogyRearm j
          (Z.1.2.clock + 1) root) := by
    rw [topFreshTailCausalReplayNext]
    exact hmoveCarrier.1
  have hparent :
      (topFreshTailGenealogy ring C s
        (topFixedTraceNext ring C Z e)).slots
        (⟨j.val + 1,
          show j.val + 1 < topClockSpan n by omega⟩ :
          Fin (topClockSpan n)) = some root := by
    rw [topFreshTailCausalReplayNext]
    exact hmoveCarrier.2
  have hmove :=
    topFreshTailFifoDataMove
      ring (by omega : 2 ≤ n) C Z e value true
      hxl hyl hsource htarget hyb
  have hsourceNew :
      ((topFixedTraceNext ring C Z e).1.1 e).qOut = .U := by
    simpa only [ite_true] using hmove.1
  have hatomTransport :=
    topFreshTailAuditPhysicalMoveAtom
      ring (by omega : 2 ≤ n) C Z e value true
      hxl hyl hsource hyb htarget
  have hatomNew :
      ((topFixedTraceNext ring C Z e).1.2.current
        (ring.rightNeighbor e)).comparison.out.atom =
          some (.sampled sample.id) := by
    rw [hatomTransport]
    exact hatom
  have hrecordNext :=
    digitRecordedSampleStep
      ring (piD Z.1.1) Z.1.2 e sample hrecord
  have hchildFresh :
      ∃ birth : Nat,
        (topFreshTailGenealogyRearm j
          (Z.1.2.clock + 1) root).origin =
            .freshBorder birth := by
    obtain ⟨birth, horigin⟩ := hfresh
    by_cases hj : j.val = 0
    · refine ⟨Z.1.2.clock + 1, ?_⟩
      simp [topFreshTailGenealogyRearm, hj]
    · refine ⟨birth, ?_⟩
      simp [topFreshTailGenealogyRearm, hj, horigin]
  exact ⟨hchild, hparent, hsourceNew, hmove.2,
    hatomNew, hrecordNext, hchildFresh,
    topFreshTailCausalQueueStep
      ring C s hn hbad Z e hqueue⟩

/-- The consumed OLD head at a real terminal service is identified
at its OLD physical slot, not from the optional origin in the
consumed list alone.  The same exported receipt has exactly one
actual scheduler index by J2 and the selected head's origin is
recorded at that service clock.
Consumer: first-border family historical service accounting. -/
theorem topFreshTailHistoricalOldFamilyService
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (pre suffix : List (Fin n)) (e : Fin n)
    (atom : Option (DigitAtom n))
    (hready :
      topClockPortReady s atom
        (topFixedTraceRun ring C pre))
    (exported :
      DigitExport (compileAdvice (ceilLogTwo n)) n)
    (hevent :
      topFreshTailGenealogyPortExport ring C s
        (topFixedTraceRun ring C pre) e = some exported)
    (carrier : TopFreshTailCarrier (topClockSpan n))
    (hhead :
      (topFreshTailGenealogy ring C s
        (topFixedTraceRun ring C pre)).slots
          (⟨topClockSpan n - 1,
            show topClockSpan n - 1 < topClockSpan n by
              have hr := cert_rho_ge_three n hn
              change 3 ≤ topClockSpan n at hr
              omega⟩ : Fin (topClockSpan n)) = some carrier)
    (hold :
      (∃ i : Fin (topClockSpan n),
        carrier.origin = .inherited i) ∨
      (∃ i t : Fin (topClockSpan n),
        carrier.origin = .oldVisit i t)) :
    ∃ (value : Fin (compileAdvice (ceilLogTwo n)).topA)
      (tail : Bool),
      ((topFixedTraceRun ring C pre).1.1
        (certSite s (topClockSpan n - 1))).qOut =
          .D value tail ∧
      exported.value = value ∧
      exported.tail = tail ∧
      exported.operand = atom ∧
      DigitRecordedExport
        (topFixedTraceRun ring C
          (pre ++ [e] ++ suffix)).1.2 exported ∧
      TopFreshTailAuditHistoricalPortAt
        ring C s (pre ++ [e] ++ suffix)
        pre.length exported ∧
      (∀ other : Nat,
        TopFreshTailAuditHistoricalPortAt
          ring C s (pre ++ [e] ++ suffix) other exported →
        other = pre.length) ∧
      exported.time = pre.length + 1 ∧
      (topFreshTailGenealogy ring C s
        (topFixedTraceNext ring C
          (topFixedTraceRun ring C pre) e)).consumed =
        (topFreshTailGenealogy ring C s
          (topFixedTraceRun ring C pre)).consumed ++
          [(exported.time, some carrier.origin)] := by
  obtain ⟨value, tail, witness, hsourceOld, hslotOld,
    hvalue, htail, hoperand, hrecord, hconsumed⟩ :=
    topFreshTailAuditHistoricalPortOldHead
      ring C s hn hbad pre suffix e atom hready
      exported hevent
  have hsame : witness = carrier := by
    rw [hhead] at hslotOld
    exact (Option.some.inj hslotOld).symm
  rw [hsame] at hconsumed
  obtain ⟨hsite, hneighbor, _, _, hlane, hsource,
    hdestination, _, _⟩ :=
    topFreshTailAuditSelectedPortFrame
      ring C s (topFixedTraceRun ring C pre)
      e exported hevent
  have hportSource :
      exported.source = certSite s (topClockSpan n - 1) :=
    hsource.trans hsite
  have hportDestination :
      exported.destination = certSite s (topClockSpan n) :=
    hdestination.trans hneighbor
  have hposition :
      TopFreshTailAuditHistoricalPortAt
        ring C s (pre ++ [e] ++ suffix) pre.length
        exported :=
    ⟨pre, suffix, e, rfl, rfl, hevent⟩
  obtain ⟨index, _, huniqueIndex⟩ :=
    (topFreshTailAuditHistoricalPortReceiptBijection
      ring C s (pre ++ [e] ++ suffix)
      exported hlane hportSource hportDestination).mp hrecord
  have hindex : pre.length = index :=
    huniqueIndex pre.length hposition
  have hunique :
      ∀ other : Nat,
        TopFreshTailAuditHistoricalPortAt
          ring C s (pre ++ [e] ++ suffix) other exported →
        other = pre.length := by
    intro other hother
    exact (huniqueIndex other hother).trans hindex.symm
  have hstamp :=
    topFreshTailAuditHistoricalPortStamp
      ring C s pre e exported hevent
  rw [topFreshTailAuditRunClock ring C pre] at hconsumed
  rw [← hstamp] at hconsumed
  exact ⟨value, tail, hsourceOld, hvalue, htail,
    hoperand, hrecord, hposition, hunique, hstamp,
    hconsumed⟩

end L3

namespace L3

structure TopFreshTailFirstBorderSpatialBarrier
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (Z : TopFixedTraceState n)
    (root : TopFreshTailCarrier (topClockSpan n))
    (k : Fin (topClockSpan n))
    (sample : DigitSample (compileAdvice (ceilLogTwo n)) n) :
    Prop where
  queue : TopFreshTailCausalQueue ring C s Z
  provenance : TopFreshTailAuditSourceDataProvenance ring C s Z
  rootFresh : ∃ stamp : Nat, root.origin = .freshBorder stamp
  sampleRecorded : DigitRecordedSample Z.1.2 sample
  sampleLane : sample.id.lane = .comparison
  sampleSite : sample.id.site = certSite s 0
  sampleTail : sample.tail = true
  samplePositive : 0 < sample.id.time
  rootSlot :
    (topFreshTailGenealogy ring C s Z).slots k = some root
  rootData :
    (Z.1.1 (certSite s k.val)).qOut = .D sample.value true
  rootAtom :
    (Z.1.2.current (certSite s k.val)).comparison.out.atom =
      some (.sampled sample.id)
  behind :
    ∀ j : Fin (topClockSpan n), j.val < k.val →
      ∃ a : TopFreshTailCarrier (topClockSpan n),
        (topFreshTailGenealogy ring C s Z).slots j = some a ∧
        ∃ stamp : Nat, a.origin = .freshBorder stamp
  oldFront :
    ∀ (j : Fin (topClockSpan n))
      (a : TopFreshTailCarrier (topClockSpan n)),
      (topFreshTailGenealogy ring C s Z).slots j = some a →
      ((∃ i : Fin (topClockSpan n),
          a.origin = .inherited i) ∨
       (∃ i t : Fin (topClockSpan n),
          a.origin = .oldVisit i t)) →
      k.val < j.val

theorem topFreshTailFirstBorderTrackedRootReceipt
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (Z : TopFixedTraceState n)
    (root : TopFreshTailCarrier (topClockSpan n))
    (k : Fin (topClockSpan n))
    (sample : DigitSample (compileAdvice (ceilLogTwo n)) n)
    (hbarrier :
      TopFreshTailFirstBorderSpatialBarrier
        ring C s Z root k sample)
    (hterminal : k.val + 1 = topClockSpan n)
    (e : Fin n)
    (exported :
      DigitExport (compileAdvice (ceilLogTwo n)) n)
    (hevent :
      topFreshTailGenealogyPortExport ring C s Z e =
        some exported) :
    DigitRecordedExport
      (topFixedTraceNext ring C Z e).1.2 exported ∧
    exported.time = Z.1.2.clock + 1 ∧
    exported.source = certSite s (topClockSpan n - 1) ∧
    exported.destination = certSite s (topClockSpan n) ∧
    exported.operand = some (.sampled sample.id) ∧
    exported.lane = .comparison := by
  obtain ⟨hsource, hneighbor, hrecord, htime, hlane,
    hportSource, hportDestination, hoperand, _⟩ :=
    topFreshTailAuditSelectedPortFrame
      ring C s Z e exported hevent
  have hindex : k.val = topClockSpan n - 1 := by
    omega
  have hsampleOperand :
      exported.operand = some (.sampled sample.id) := by
    calc
      exported.operand =
        (Z.1.2.current e).comparison.out.atom := hoperand
      _ =
        (Z.1.2.current
          (certSite s k.val)).comparison.out.atom := by
          rw [hsource, hindex]
      _ = some (.sampled sample.id) := hbarrier.rootAtom
  exact ⟨hrecord, htime, hportSource.trans hsource,
    hportDestination.trans hneighbor, hsampleOperand, hlane⟩

/-- A real fresh-origin OLD terminal D and its accepted port
event have a genuinely recorded comparison sample, with exact
value, tail, operand, physical endpoints and new receipt.
J1 excludes the inherited-atom alternative; J2 authenticates
the selected export.  The sample SITE is some source offset,
not yet the backwards-sequence offset: that missing equality
is a separate FIFO/cohort obligation.
Consumer: topFreshTailPostAnchorReceiptFidelity. -/
theorem topFreshTailPostAnchorFreshReceiptFields
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (Z : TopFixedTraceState n)
    (hreach : topClockReached ring C Z)
    (atom : Option (DigitAtom n))
    (hready : topClockPortReady s atom Z)
    (e : Fin n)
    (exported :
      DigitExport (compileAdvice (ceilLogTwo n)) n)
    (hevent :
      topFreshTailGenealogyPortExport ring C s Z e =
        some exported)
    (carrier : TopFreshTailCarrier (topClockSpan n))
    (hhead :
      (topFreshTailGenealogy ring C s Z).slots
        (⟨topClockSpan n - 1,
          show topClockSpan n - 1 < topClockSpan n by
            have hr := cert_rho_ge_three n hn
            change 3 ≤ topClockSpan n at hr
            omega⟩ : Fin (topClockSpan n)) = some carrier)
    (hfresh : ∃ stamp : Nat, carrier.origin = .freshBorder stamp) :
    ∃ (k : Fin (topClockSpan n))
      (sample : DigitSample (compileAdvice (ceilLogTwo n)) n),
      DigitRecordedSample
        (topFixedTraceNext ring C Z e).1.2 sample ∧
      DigitRecordedExport
        (topFixedTraceNext ring C Z e).1.2 exported ∧
      sample.id.lane = .comparison ∧
      sample.id.site = certSite s k.val ∧
      exported.operand = some (.sampled sample.id) ∧
      exported.value = sample.value ∧
      exported.tail = sample.tail := by
  obtain ⟨value, tail, hdata, hvalue, htail⟩ :=
    topFreshTailAuditPortOldPayload
      ring C s Z e atom hready exported hevent
  obtain ⟨witness, hslot, hkind⟩ :=
    (topFreshTailAuditSourceDataReached
      ring C s hn hbad Z hreach)
      (⟨topClockSpan n - 1,
        show topClockSpan n - 1 < topClockSpan n by
          have hr := cert_rho_ge_three n hn
          change 3 ≤ topClockSpan n at hr
          omega⟩ : Fin (topClockSpan n))
      value tail hdata
  have hequal : witness = carrier := by
    rw [hhead] at hslot
    exact (Option.some.inj hslot).symm
  rcases hkind with hinherited | hsampled
  · obtain ⟨i, hinheritedOrigin, _⟩ := hinherited
    obtain ⟨stamp, hfreshOrigin⟩ := hfresh
    have hlabel : witness.origin = .freshBorder stamp := by
      rw [hequal]
      exact hfreshOrigin
    rw [hlabel] at hinheritedOrigin
    cases hinheritedOrigin
  · obtain ⟨k, sample, hrecordSample, hlane, hsite,
      hoperandSample, hsampleValue, hsampleTail⟩ := hsampled
    obtain ⟨hsource, _, hrecordExport, _, _, _, _,
      hoperand, _⟩ :=
      topFreshTailAuditSelectedPortFrame
        ring C s Z e exported hevent
    have hrecordSampleNext :=
      digitRecordedSampleStep
        ring (piD Z.1.1) Z.1.2 e sample hrecordSample
    have hoperandExact :
        exported.operand = some (.sampled sample.id) := by
      rw [hoperand, hsource]
      exact hoperandSample
    exact ⟨k, sample, hrecordSampleNext, hrecordExport,
      hlane, hsite, hoperandExact,
      hvalue.trans hsampleValue.symm,
      htail.trans hsampleTail.symm⟩

end L3

namespace L3

/-- A rearm whose origin is still OLD has a strictly interior
birth site and an OLD parent.  This reads the literal
TopFreshTailGenealogyRearm constructor, not a birth-time FIFO
surrogate. Consumer: first-border B.birth-barrier. -/
theorem topFreshTailFirstBorderOldRearmParent
    {r : Nat} (j : Fin r) (stamp : Nat)
    (parent : TopFreshTailCarrier r)
    (hchild :
      (∃ i : Fin r,
        (topFreshTailGenealogyRearm j stamp parent).origin =
          .inherited i) ∨
      (∃ i t : Fin r,
        (topFreshTailGenealogyRearm j stamp parent).origin =
          .oldVisit i t)) :
    0 < j.val ∧
    ((∃ i : Fin r, parent.origin = .inherited i) ∨
     (∃ i t : Fin r, parent.origin = .oldVisit i t)) := by
  by_cases hzero : j.val = 0
  · rcases hchild with ⟨i, hi⟩ | ⟨i, t, ht⟩
    · simp [topFreshTailGenealogyRearm, hzero] at hi
    · simp [topFreshTailGenealogyRearm, hzero] at ht
  · have hpositive : 0 < j.val := by omega
    constructor
    · exact hpositive
    · cases horigin : parent.origin with
      | inherited i =>
          exact Or.inl ⟨i, rfl⟩
      | oldVisit i t =>
          exact Or.inr ⟨i, t, rfl⟩
      | freshBorder birth =>
          rcases hchild with ⟨i, hi⟩ | ⟨i, t, ht⟩
          · simp [topFreshTailGenealogyRearm,
              hzero, horigin] at hi
          · simp [topFreshTailGenealogyRearm,
              hzero, horigin] at ht

/-- A newly born OLD genealogy identity in one literal selected
service must be a rearm child at the SAME slot of an OLD parent.
In particular an inherited identity cannot be born anew.
The OLD fields are read through topFreshTailGenealogyNextSlot,
and the age premise excludes fabricated old-state copies.
Consumer: B.birth-barrier, the missing old-front branch. -/
theorem topFreshTailFirstBorderOldVisitNewborn
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (G : TopFreshTailGenealogyState n)
    (e : Fin n)
    (hage :
      ∀ (j : Fin (topClockSpan n))
        (a : TopFreshTailCarrier (topClockSpan n)),
        G.slots j = some a →
        a.born ≤ G.trace.1.2.clock)
    (j : Fin (topClockSpan n))
    (a : TopFreshTailCarrier (topClockSpan n))
    (hnew :
      (topFreshTailGenealogyStep ring C s G e).slots j =
        some a)
    (hborn : a.born = G.trace.1.2.clock + 1)
    (hold :
      (∃ i : Fin (topClockSpan n),
        a.origin = .inherited i) ∨
      (∃ i t : Fin (topClockSpan n),
        a.origin = .oldVisit i t)) :
    ∃ parent : TopFreshTailCarrier (topClockSpan n),
      G.slots j = some parent ∧
      ((∃ i : Fin (topClockSpan n),
        parent.origin = .inherited i) ∨
       (∃ i t : Fin (topClockSpan n),
        parent.origin = .oldVisit i t)) ∧
      a = topFreshTailGenealogyRearm j
        (G.trace.1.2.clock + 1) parent ∧
      0 < j.val := by
  change topFreshTailGenealogyNextSlot ring C s G e j =
    some a at hnew
  unfold topFreshTailGenealogyNextSlot at hnew
  cases hpost :
      ((topFixedTraceNext ring C G.trace e).1.1
        (certSite s j.val)).qOut with
  | E =>
      simp [hpost] at hnew
  | U =>
      simp only [hpost] at hnew
      cases hprior :
          (G.trace.1.1 (certSite s j.val)).qOut with
      | E =>
          simp only [hprior] at hnew
          split at hnew
          · cases hnew
            rcases hold with ⟨i, hi⟩ | ⟨i, t, ht⟩
            · cases hi
            · cases ht
          · cases hnew
      | U =>
          have hslot : G.slots j = some a := by
            simpa only [hprior] using hnew
          have hb := hage j a hslot
          omega
      | D value tail =>
          cases tail with
          | false =>
              simp [hprior] at hnew
          | true =>
              cases hslot : G.slots j with
              | none =>
                  simp [hprior, hslot] at hnew
              | some parent =>
                  have hchild :
                      topFreshTailGenealogyRearm j
                        (G.trace.1.2.clock + 1) parent = a := by
                    simpa [hprior, hslot] using hnew
                  have hparent :=
                    topFreshTailFirstBorderOldRearmParent
                      j (G.trace.1.2.clock + 1) parent
                      (by rw [hchild]; exact hold)
                  exact ⟨parent, rfl, hparent.2,
                    hchild.symm, hparent.1⟩
  | D value tail =>
      simp only [hpost] at hnew
      cases hprior :
          (G.trace.1.1 (certSite s j.val)).qOut with
      | E =>
          simp only [hprior] at hnew
          split at hnew
          · split at hnew
            · have hb :=
                hage
                  (⟨j.val - 1,
                    show j.val - 1 < topClockSpan n by omega⟩ :
                    Fin (topClockSpan n)) a hnew
              omega
            · cases hnew
          · cases hnew
      | U =>
          simp only [hprior] at hnew
          split at hnew
          · cases hnew
            rcases hold with ⟨i, hi⟩ | ⟨i, t, ht⟩
            · cases hi
            · cases ht
          · have hb := hage j a hnew
            omega
      | D oldValue oldTail =>
          have hslot : G.slots j = some a := by
            simpa only [hprior] using hnew
          have hb := hage j a hslot
          omega

/-- Complete pointwise B.old-front preservation for a FIXED root
offset k, including the oldVisit child newly minted at this very
service. The earlier theorem handles the pre-existing
identity branch; the newborn branch above handles every remaining
match outcome, including simultaneous owner writes.
Consumer: the stationary-root rows of the J5 barrier induction. -/
theorem topFreshTailFirstBorderOldFrontAllRows
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (Z : TopFixedTraceState n) (e : Fin n)
    (k : Fin (topClockSpan n))
    (hqueue : TopFreshTailCausalQueue ring C s Z)
    (hfront :
      ∀ (j : Fin (topClockSpan n))
        (a : TopFreshTailCarrier (topClockSpan n)),
        (topFreshTailGenealogy ring C s Z).slots j = some a →
        ((∃ i : Fin (topClockSpan n),
            a.origin = .inherited i) ∨
         (∃ i t : Fin (topClockSpan n),
            a.origin = .oldVisit i t)) →
        k.val < j.val) :
    ∀ (j : Fin (topClockSpan n))
      (a : TopFreshTailCarrier (topClockSpan n)),
      (topFreshTailGenealogy ring C s
        (topFixedTraceNext ring C Z e)).slots j = some a →
      ((∃ i : Fin (topClockSpan n),
          a.origin = .inherited i) ∨
       (∃ i t : Fin (topClockSpan n),
          a.origin = .oldVisit i t)) →
      k.val < j.val := by
  intro j a hslot hold
  by_cases hbornOld : a.born ≤ Z.1.2.clock
  · exact topFreshTailFirstBorderOldFrontStep
      ring C s Z e k hqueue hfront j a hslot hbornOld hold
  · have hqueueNext :=
      topFreshTailCausalQueueStep
        ring C s hn hbad Z e hqueue
    have hageNext := hqueueNext.age j a hslot
    have hclock :
        (topFixedTraceNext ring C Z e).1.2.clock =
          Z.1.2.clock + 1 := by
      rfl
    rw [hclock] at hageNext
    have hborn : a.born = Z.1.2.clock + 1 := by
      omega
    have hghostAge :
        ∀ (i : Fin (topClockSpan n))
          (b : TopFreshTailCarrier (topClockSpan n)),
          (topFreshTailGenealogy ring C s Z).slots i = some b →
          b.born ≤
            (topFreshTailGenealogy ring C s Z).trace.1.2.clock := by
      intro i b hi
      rw [hqueue.trace.2]
      exact hqueue.age i b hi
    have hghostBorn :
        a.born =
          (topFreshTailGenealogy ring C s Z).trace.1.2.clock + 1 := by
      rw [hqueue.trace.2]
      exact hborn
    have hstep := hslot
    rw [topFreshTailCausalReplayNext] at hstep
    obtain ⟨parent, hparentSlot, hparentOld, _, _⟩ :=
      topFreshTailFirstBorderOldVisitNewborn
        ring C s (topFreshTailGenealogy ring C s Z)
        e hghostAge j a hstep hghostBorn hold
    exact hfront j parent hparentSlot hparentOld

/-- The real source-chain neighbor identity used in the selected
root-hop row. The prior theorem named
topFreshTailCausalNeighborSite is private to
TopFreshTailGenealogy.lean, so it cannot be called here.
Consumer: first-border B.root and occupied-source row. -/
theorem topFreshTailFirstBorderNeighborSite
    {n : Nat} (ring : DirectedRing n) (s : Fin n)
    (k : Nat) :
    ring.rightNeighbor (certSite s k) =
      certSite s (k + 1) := by
  apply Fin.ext
  change ((s.val + k) % n + 1) % n =
    (s.val + (k + 1)) % n
  calc
    ((s.val + k) % n + 1) % n =
        (s.val + k + 1) % n :=
      Nat.mod_add_mod (s.val + k) n 1
    _ = (s.val + (k + 1)) % n := by
      congr 1

/-- An earlier source slot cannot be the successor site
of the tracked root. The named Fin.val equality is essential:
omega does not look through an anonymous Fin constructor.
Consumer: B.root-hop and B.occupied off-pair framing. -/
theorem topFreshTailFirstBorderEarlierSourceSiteDistinctSuccessor
    {n : Nat} (s : Fin n) (hn : 5 ≤ n)
    (j k : Fin (topClockSpan n))
    (hbelow : j.val < k.val)
    (hnext : k.val + 1 < topClockSpan n) :
    certSite s j.val ≠ certSite s (k.val + 1) := by
  intro hsite
  have hindex :=
    topFreshTailCausalSourceSiteInjective
      s hn j
      (⟨k.val + 1, hnext⟩ : Fin (topClockSpan n))
      hsite
  have hvalue := congrArg Fin.val hindex
  change j.val = k.val + 1 at hvalue
  omega

/-- The earlier real border U sample initializes the live spatial
barrier at k=0, including the exact sample atom, source D,
initial OLD front, reached CQ and J1.  Behind is empty, not
an assumption about the initial private outputs.
Consumer: J5 barrier base. -/
theorem topFreshTailFirstBorderSpatialBarrierInitial
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (Z : TopFixedTraceState n)
    (hreach : topClockReached ring C Z)
    (e : Fin n)
    (hborder : e = certSite s 0)
    (hunread : (Z.1.1 e).qOut = .U) :
    ∃ sample : DigitSample (compileAdvice (ceilLogTwo n)) n,
      TopFreshTailFirstBorderSpatialBarrier
        ring C s (topFixedTraceNext ring C Z e)
        { origin := .freshBorder (Z.1.2.clock + 1),
          born := Z.1.2.clock + 1 }
        (⟨0, show 0 < topClockSpan n by
          have hr := cert_rho_ge_three n hn
          change 3 ≤ topClockSpan n at hr
          omega⟩ : Fin (topClockSpan n)) sample := by
  obtain ⟨sample, hrecord, hlane, hsite, htime,
    hvalue, htail, hatom, hphysical, hroot,
    hfront, hqueue, hprovenance⟩ :=
    topFreshTailFirstBorderSampleRoot
      ring C s hn hbad Z hreach e hborder hunread
  refine ⟨sample, {
    queue := hqueue
    provenance := hprovenance
    rootFresh := ⟨Z.1.2.clock + 1, rfl⟩
    sampleRecorded := hrecord
    sampleLane := hlane
    sampleSite := hsite
    sampleTail := htail
    samplePositive := ?_
    rootSlot := hroot
    rootData := ?_
    rootAtom := hatom
    behind := ?_
    oldFront := ?_ }⟩
  · rw [htime]
    omega
  · rw [hvalue]
    exact hphysical
  · intro j hj
    have hNoEarlierSourceSlot : False := by
      change j.val < 0 at hj
      omega
    exact False.elim hNoEarlierSourceSlot
  · intro j a hslot hold
    exact hfront j a hslot hold

/-- The enabled OLD interior true-tail move advances the tracked
root exactly one slot, inserts one fresh child at its departure
slot, and preserves all previously occupied fresh slots behind
it.  J1, the audit atom, and the entire OLD front advance with
the root; new oldVisit descendants are covered by AllRows.
Consumer: moving-root row of J5 B.step. -/
theorem topFreshTailFirstBorderSpatialBarrierRootHop
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (Z : TopFixedTraceState n)
    (root : TopFreshTailCarrier (topClockSpan n))
    (k : Fin (topClockSpan n))
    (sample : DigitSample (compileAdvice (ceilLogTwo n)) n)
    (hbarrier :
      TopFreshTailFirstBorderSpatialBarrier
        ring C s Z root k sample)
    (e : Fin n)
    (hsite : e = certSite s k.val)
    (hnext : k.val + 1 < topClockSpan n)
    (hempty :
      (Z.1.1 (ring.rightNeighbor e)).qOut = .E) :
    TopFreshTailFirstBorderSpatialBarrier
      ring C s (topFixedTraceNext ring C Z e)
      root
      (⟨k.val + 1,
        show k.val + 1 < topClockSpan n by omega⟩ :
        Fin (topClockSpan n))
      sample := by
  have hgeometry :=
    topFreshTailCausalSourcePublicGeometry
      ring C s hn hbad Z hbarrier.queue.trace.1 k
  have hxl : (Z.1.1 e).l = false := by
    rw [hsite]
    exact hgeometry.1
  have hyl :
      (Z.1.1 (ring.rightNeighbor e)).l = false := by
    rw [hsite]
    exact hgeometry.2.1
  have hmarker :
      (Z.1.1 (ring.rightNeighbor e)).beta = false := by
    have hneq : k.val + 1 ≠ topClockSpan n := by omega
    have hg := hgeometry.2.2.2
    rw [if_neg hneq] at hg
    rw [hsite]
    exact hg
  have hsource : (Z.1.1 e).qOut =
      .D sample.value true := by
    rw [hsite]
    exact hbarrier.rootData
  have hsourceAtom :
      (Z.1.2.current e).comparison.out.atom =
        some (.sampled sample.id) := by
    rw [hsite]
    exact hbarrier.rootAtom
  obtain ⟨hchild, hparent, hnewU, hnewD, hnewAtom,
    hnewRecord, hnewChildFresh, hqueueNext⟩ :=
    topFreshTailFirstBorderStaircaseStep
      ring C s hn hbad Z e k hnext hsite
      root hbarrier.rootSlot hbarrier.rootFresh
      sample hbarrier.sampleRecorded hsourceAtom
      sample.value hsource hempty hxl hyl hmarker
      hbarrier.queue
  have hneighbor :
      ring.rightNeighbor e = certSite s (k.val + 1) := by
    rw [hsite]
    exact topFreshTailFirstBorderNeighborSite ring s k.val
  have hprovenanceNext :=
    topFreshTailAuditSourceDataReached
      ring C s hn hbad
      (topFixedTraceNext ring C Z e)
      hqueueNext.trace.1
  have hfrontStationary :=
    topFreshTailFirstBorderOldFrontAllRows
      ring C s hn hbad Z e k
      hbarrier.queue hbarrier.oldFront
  have hfrontMoved :
      ∀ (j : Fin (topClockSpan n))
        (a : TopFreshTailCarrier (topClockSpan n)),
        (topFreshTailGenealogy ring C s
          (topFixedTraceNext ring C Z e)).slots j = some a →
        ((∃ i : Fin (topClockSpan n),
            a.origin = .inherited i) ∨
         (∃ i t : Fin (topClockSpan n),
            a.origin = .oldVisit i t)) →
        k.val + 1 < j.val := by
    intro j a hslot hold
    have hbefore := hfrontStationary j a hslot hold
    by_cases hcollision : j.val = k.val + 1
    · have hindex :
          j = (⟨k.val + 1,
            show k.val + 1 < topClockSpan n by omega⟩ :
            Fin (topClockSpan n)) := by
        apply Fin.ext
        exact hcollision
      rw [hindex, hparent] at hslot
      have hequal : a = root :=
        (Option.some.inj hslot).symm
      obtain ⟨stamp, hfresh⟩ := hbarrier.rootFresh
      have ha : a.origin = .freshBorder stamp := by
        rw [hequal]
        exact hfresh
      rcases hold with ⟨i, hi⟩ | ⟨i, t, ht⟩
      · rw [ha] at hi
        cases hi
      · rw [ha] at ht
        cases ht
    · omega
  have hbehindMoved :
      ∀ j : Fin (topClockSpan n), j.val < k.val + 1 →
        ∃ a : TopFreshTailCarrier (topClockSpan n),
          (topFreshTailGenealogy ring C s
            (topFixedTraceNext ring C Z e)).slots j = some a ∧
          ∃ stamp : Nat, a.origin = .freshBorder stamp := by
    intro j hj
    by_cases hbelow : j.val < k.val
    · obtain ⟨a, hslot, hfresh⟩ :=
        hbarrier.behind j hbelow
      have hnotSource : certSite s j.val ≠ e := by
        intro hequal
        have hsame :=
          topFreshTailCausalSourceSiteInjective
            s hn j k (hequal.trans hsite)
        have hval := congrArg Fin.val hsame
        omega
      have hnotTarget :
          certSite s j.val ≠ ring.rightNeighbor e := by
        rw [hneighbor]
        exact topFreshTailFirstBorderEarlierSourceSiteDistinctSuccessor
          s hn j k hbelow hnext
      have hframe :=
        topFreshTailCausalOffPairSlotAgreement
          ring C s Z e hbarrier.queue j
          hnotSource hnotTarget
      refine ⟨a, ?_, hfresh⟩
      rw [hframe.2]
      exact hslot
    · have hsameValue : j.val = k.val := by omega
      have hsame : j = k := Fin.ext hsameValue
      rw [hsame]
      exact ⟨topFreshTailGenealogyRearm k
        (Z.1.2.clock + 1) root, hchild, hnewChildFresh⟩
  refine {
    queue := hqueueNext
    provenance := hprovenanceNext
    rootFresh := hbarrier.rootFresh
    sampleRecorded := hnewRecord
    sampleLane := hbarrier.sampleLane
    sampleSite := hbarrier.sampleSite
    sampleTail := hbarrier.sampleTail
    samplePositive := hbarrier.samplePositive
    rootSlot := hparent
    rootData := ?_
    rootAtom := ?_
    behind := hbehindMoved
    oldFront := hfrontMoved }
  · rw [← hneighbor]
    exact hnewD
  · rw [← hneighbor]
    exact hnewAtom

/-- At terminal offset the spatial old-front rule leaves no room
for any inherited or oldVisit carrier, including an OLD U
rearm child. Every occupied actual genealogy slot must instead
have a freshBorder origin. This is LIVE family exhaustion; the
historical serviced clause and the post-port sample staircase
are NOT consequences of this lemma alone.
Consumer: firstBorderFamilyExhaustion, J5. -/
theorem topFreshTailFirstBorderTerminalOldAbsence
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (Z : TopFixedTraceState n)
    (root : TopFreshTailCarrier (topClockSpan n))
    (k : Fin (topClockSpan n))
    (sample : DigitSample (compileAdvice (ceilLogTwo n)) n)
    (hbarrier :
      TopFreshTailFirstBorderSpatialBarrier
        ring C s Z root k sample)
    (hterminal : k.val + 1 = topClockSpan n) :
    ∀ (j : Fin (topClockSpan n))
      (a : TopFreshTailCarrier (topClockSpan n)),
      (topFreshTailGenealogy ring C s Z).slots j = some a →
      ∃ stamp : Nat, a.origin = .freshBorder stamp := by
  intro j a hslot
  cases horigin : a.origin with
  | freshBorder stamp =>
      exact ⟨stamp, rfl⟩
  | inherited i =>
      have hfront :=
        hbarrier.oldFront j a hslot (Or.inl ⟨i, horigin⟩)
      have hbound := j.isLt
      omega
  | oldVisit i t =>
      have hfront :=
        hbarrier.oldFront j a hslot
          (Or.inr ⟨i, t, horigin⟩)
      have hbound := j.isLt
      omega

/-- Every off-pair selected OLD service outside the physical
source block preserves the same root carrier, its sampled
comparison atom, the fresh children behind it and the OLD
family front.  The audit and genealogy advance together.
Consumer: J5 B.step, remote owner row. -/
theorem topFreshTailFirstBorderSpatialBarrierAwayStep
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (Z : TopFixedTraceState n)
    (root : TopFreshTailCarrier (topClockSpan n))
    (k : Fin (topClockSpan n))
    (sample : DigitSample (compileAdvice (ceilLogTwo n)) n)
    (hbarrier :
      TopFreshTailFirstBorderSpatialBarrier
        ring C s Z root k sample)
    (e : Fin n)
    (hawaySource :
      ∀ j : Fin (topClockSpan n), certSite s j.val ≠ e)
    (hawayTarget :
      ∀ j : Fin (topClockSpan n),
        certSite s j.val ≠ ring.rightNeighbor e) :
    TopFreshTailFirstBorderSpatialBarrier
      ring C s (topFixedTraceNext ring C Z e)
      root k sample := by
  have hqueueNext :=
    topFreshTailCausalQueueStep
      ring C s hn hbad Z e hbarrier.queue
  have hprovenanceNext :=
    topFreshTailAuditSourceDataReached
      ring C s hn hbad
      (topFixedTraceNext ring C Z e)
      hqueueNext.trace.1
  have hframe :=
    topFreshTailCausalOffPairSlotAgreement
      ring C s Z e hbarrier.queue k
      (hawaySource k) (hawayTarget k)
  have hatomFrame :
      ((topFixedTraceNext ring C Z e).1.2.current
        (certSite s k.val)).comparison.out.atom =
      (Z.1.2.current
        (certSite s k.val)).comparison.out.atom := by
    change
      ((digitAuditStep ring (piD Z.1.1) Z.1.2 e).current
        (certSite s k.val)).comparison.out.atom =
      (Z.1.2.current
        (certSite s k.val)).comparison.out.atom
    simp only [digitAuditStep, digitGhostStep,
      if_neg (hawaySource k), if_neg (hawayTarget k)]
  refine {
    queue := hqueueNext
    provenance := hprovenanceNext
    rootFresh := hbarrier.rootFresh
    sampleRecorded := digitRecordedSampleStep
      ring (piD Z.1.1) Z.1.2 e sample
        hbarrier.sampleRecorded
    sampleLane := hbarrier.sampleLane
    sampleSite := hbarrier.sampleSite
    sampleTail := hbarrier.sampleTail
    samplePositive := hbarrier.samplePositive
    rootSlot := ?_
    rootData := ?_
    rootAtom := ?_
    behind := ?_
    oldFront :=
      topFreshTailFirstBorderOldFrontAllRows
        ring C s hn hbad Z e k hbarrier.queue
        hbarrier.oldFront }
  · rw [hframe.2]
    exact hbarrier.rootSlot
  · rw [hframe.1]
    exact hbarrier.rootData
  · rw [hatomFrame]
    exact hbarrier.rootAtom
  · intro j hbelow
    obtain ⟨child, hslot, hfresh⟩ :=
      hbarrier.behind j hbelow
    have hchildFrame :=
      topFreshTailCausalOffPairSlotAgreement
        ring C s Z e hbarrier.queue j
        (hawaySource j) (hawayTarget j)
    refine ⟨child, ?_, hfresh⟩
    rw [hchildFrame.2]
    exact hslot

/-- The occupied OLD interior responder blocks the tracked
root at the actual source site.  The QO owner and audit atom
remain unchanged, with each previously fresh child framed
off both endpoints. Consumer: J5 B.step, occupied row. -/
theorem topFreshTailFirstBorderSpatialBarrierOccupiedStep
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (Z : TopFixedTraceState n)
    (root : TopFreshTailCarrier (topClockSpan n))
    (k : Fin (topClockSpan n))
    (sample : DigitSample (compileAdvice (ceilLogTwo n)) n)
    (hbarrier :
      TopFreshTailFirstBorderSpatialBarrier
        ring C s Z root k sample)
    (e : Fin n)
    (hsite : e = certSite s k.val)
    (hnext : k.val + 1 < topClockSpan n)
    (hoccupied :
      (Z.1.1 (ring.rightNeighbor e)).qOut ≠ .E) :
    TopFreshTailFirstBorderSpatialBarrier
      ring C s (topFixedTraceNext ring C Z e)
      root k sample := by
  have hgeometry :=
    topFreshTailCausalSourcePublicGeometry
      ring C s hn hbad Z hbarrier.queue.trace.1 k
  have hleft : (Z.1.1 e).l = false := by
    rw [hsite]
    exact hgeometry.1
  have hright :
      (Z.1.1 (ring.rightNeighbor e)).l = false := by
    rw [hsite]
    exact hgeometry.2.1
  have hmarker :
      (Z.1.1 (ring.rightNeighbor e)).beta = false := by
    have hnotBorder : k.val + 1 ≠ topClockSpan n := by
      omega
    have hm := hgeometry.2.2.2
    rw [if_neg hnotBorder] at hm
    rw [hsite]
    exact hm
  have houtput :
      (Z.1.1 e).qOut = .D sample.value true := by
    rw [hsite]
    exact hbarrier.rootData
  have hneighbor :
      ring.rightNeighbor e = certSite s (k.val + 1) := by
    rw [hsite]
    exact topFreshTailFirstBorderNeighborSite ring s k.val
  have hqueueNext :=
    topFreshTailCausalQueueStep
      ring C s hn hbad Z e hbarrier.queue
  have hprovenanceNext :=
    topFreshTailAuditSourceDataReached
      ring C s hn hbad
      (topFixedTraceNext ring C Z e)
      hqueueNext.trace.1
  have hghost :=
    topFreshTailCausalOccupiedBlock
      ring C s (topFreshTailGenealogy ring C s Z)
      e k sample.value true root hsite
      (by rw [hbarrier.queue.trace.2]; exact houtput)
      (by rw [hbarrier.queue.trace.2]; exact hleft)
      (by rw [hbarrier.queue.trace.2]; exact hright)
      (by rw [hbarrier.queue.trace.2]; exact hmarker)
      (by rw [hbarrier.queue.trace.2]; exact hoccupied)
      hbarrier.rootSlot
  have hrootNew :
      (topFreshTailGenealogy ring C s
        (topFixedTraceNext ring C Z e)).slots k =
          some root := by
    rw [topFreshTailCausalReplayNext]
    exact hghost
  have hdataNew :
      ((topFixedTraceNext ring C Z e).1.1
        (certSite s k.val)).qOut =
          .D sample.value true := by
    rw [← hsite]
    exact topFreshTailFifoOccupiedFrame
      ring C Z e sample.value true
      hleft hright houtput hmarker hoccupied
  have hatomNew :
      ((topFixedTraceNext ring C Z e).1.2.current
        (certSite s k.val)).comparison.out.atom =
          some (.sampled sample.id) := by
    rw [← hsite]
    rw [topFreshTailAuditPhysicalBlockedInteriorAtom
      ring C Z e sample.value true
        hleft hright houtput hmarker hoccupied]
    rw [hsite]
    exact hbarrier.rootAtom
  have hbehindNext :
      ∀ j : Fin (topClockSpan n), j.val < k.val →
        ∃ child : TopFreshTailCarrier (topClockSpan n),
          (topFreshTailGenealogy ring C s
            (topFixedTraceNext ring C Z e)).slots j =
              some child ∧
          ∃ stamp : Nat, child.origin = .freshBorder stamp := by
    intro j hbelow
    obtain ⟨child, hslot, hfresh⟩ :=
      hbarrier.behind j hbelow
    have hnotSource : certSite s j.val ≠ e := by
      intro hequal
      have hsame :=
        topFreshTailCausalSourceSiteInjective
          s hn j k (hequal.trans hsite)
      have hvalue := congrArg Fin.val hsame
      omega
    have hnotTarget :
        certSite s j.val ≠ ring.rightNeighbor e := by
      rw [hneighbor]
      exact topFreshTailFirstBorderEarlierSourceSiteDistinctSuccessor
        s hn j k hbelow hnext
    have hframe :=
      topFreshTailCausalOffPairSlotAgreement
        ring C s Z e hbarrier.queue j
        hnotSource hnotTarget
    refine ⟨child, ?_, hfresh⟩
    rw [hframe.2]
    exact hslot
  exact {
    queue := hqueueNext
    provenance := hprovenanceNext
    rootFresh := hbarrier.rootFresh
    sampleRecorded := digitRecordedSampleStep
      ring (piD Z.1.1) Z.1.2 e sample
        hbarrier.sampleRecorded
    sampleLane := hbarrier.sampleLane
    sampleSite := hbarrier.sampleSite
    sampleTail := hbarrier.sampleTail
    samplePositive := hbarrier.samplePositive
    rootSlot := hrootNew
    rootData := hdataNew
    rootAtom := hatomNew
    behind := hbehindNext
    oldFront :=
      topFreshTailFirstBorderOldFrontAllRows
        ring C s hn hbad Z e k hbarrier.queue
        hbarrier.oldFront }

end L3

namespace L3

/-- The target-border vertex is never among the r source
positions of a complete pair.  The strict separation follows
from the actual certificate width, not merely r <= n.
Consumer: port-blocking and port-acceptance B.step. -/
theorem topFreshTailFirstBorderPortOutsideSource
    {n : Nat} (s : Fin n) (hn : 5 ≤ n)
    (j : Fin (topClockSpan n)) :
    certSite s j.val ≠ certSite s (topClockSpan n) := by
  have hcapacity := cert_n_ge_t_add_r n hn
  have ht :=
    compileAdvice_t_ge_two (ceilLogTwo n) (ringQ_facts n hn).1
  change (compileAdvice (ceilLogTwo n)).t +
      topClockSpan n ≤ n at hcapacity
  have hspan : topClockSpan n < n := by omega
  have hj : j.val < n := by
    have hjbound := j.isLt
    omega
  intro hsite
  have h := congrArg Fin.val hsite
  change (s.val + j.val) % n =
    (s.val + topClockSpan n) % n at h
  have hs := s.isLt
  by_cases hleft : s.val + j.val < n
  · rw [Nat.mod_eq_of_lt hleft] at h
    by_cases hright : s.val + topClockSpan n < n
    · rw [Nat.mod_eq_of_lt hright] at h
      omega
    · have hge : n ≤ s.val + topClockSpan n := by omega
      have hrem : s.val + topClockSpan n - n < n := by omega
      rw [Nat.mod_eq_sub_mod hge,
        Nat.mod_eq_of_lt hrem] at h
      omega
  · have hge : n ≤ s.val + j.val := by omega
    have hrem : s.val + j.val - n < n := by omega
    rw [Nat.mod_eq_sub_mod hge,
      Nat.mod_eq_of_lt hrem] at h
    by_cases hright : s.val + topClockSpan n < n
    · rw [Nat.mod_eq_of_lt hright] at h
      omega
    · have hge' : n ≤ s.val + topClockSpan n := by omega
      have hrem' : s.val + topClockSpan n - n < n := by omega
      rw [Nat.mod_eq_sub_mod hge',
        Nat.mod_eq_of_lt hrem'] at h
      omega

/-- The root at a source interior site faces exactly the OLD
empty/occupied responder dichotomy: either it takes one true
tail hop and leaves its fresh child, or the occupied responder
keeps its exact root and audit atom in place.  This combines
the two separately proved literal owner rows rather than
inventing a nonatomic protocol transition.
Consumer: J5 B.step for selected root interior service. -/
theorem topFreshTailFirstBorderSpatialBarrierInteriorOwner
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (Z : TopFixedTraceState n)
    (root : TopFreshTailCarrier (topClockSpan n))
    (k : Fin (topClockSpan n))
    (sample : DigitSample (compileAdvice (ceilLogTwo n)) n)
    (hbarrier :
      TopFreshTailFirstBorderSpatialBarrier
        ring C s Z root k sample)
    (e : Fin n)
    (hsite : e = certSite s k.val)
    (hnext : k.val + 1 < topClockSpan n) :
    ∃ moved : Fin (topClockSpan n),
      TopFreshTailFirstBorderSpatialBarrier
        ring C s (topFixedTraceNext ring C Z e)
        root moved sample ∧
      (moved = k ∨ moved.val = k.val + 1) := by
  cases htarget : (Z.1.1 (ring.rightNeighbor e)).qOut with
  | E =>
      refine ⟨(⟨k.val + 1, hnext⟩ : Fin (topClockSpan n)),
        topFreshTailFirstBorderSpatialBarrierRootHop
          ring C s hn hbad Z root k sample hbarrier
          e hsite hnext htarget, Or.inr rfl⟩
  | U =>
      have hoccupied :
          (Z.1.1 (ring.rightNeighbor e)).qOut ≠ .E := by
        intro he
        rw [htarget] at he
        cases he
      exact ⟨k,
        topFreshTailFirstBorderSpatialBarrierOccupiedStep
          ring C s hn hbad Z root k sample hbarrier
          e hsite hnext hoccupied, Or.inl rfl⟩
  | D value tail =>
      have hoccupied :
          (Z.1.1 (ring.rightNeighbor e)).qOut ≠ .E := by
        intro he
        rw [htarget] at he
        cases he
      exact ⟨k,
        topFreshTailFirstBorderSpatialBarrierOccupiedStep
          ring C s hn hbad Z root k sample hbarrier
          e hsite hnext hoccupied, Or.inl rfl⟩

theorem topFreshTailFirstBorderFreshUnreadSampleStep
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (Z : TopFixedTraceState n) (e : Fin n)
    (hqueue : TopFreshTailCausalQueue ring C s Z)
    (j : Fin (topClockSpan n))
    (hsite : e = certSite s j.val)
    (hunread : (Z.1.1 e).qOut = .U)
    (carrier : TopFreshTailCarrier (topClockSpan n))
    (hslot :
      (topFreshTailGenealogy ring C s Z).slots j =
        some carrier)
    (hfresh : ∃ stamp : Nat,
      carrier.origin = .freshBorder stamp) :
    ((topFixedTraceNext ring C Z e).1.1
      (certSite s j.val)).qOut =
        .D (Z.1.1 e).d (Z.1.1 e).beta ∧
    ∃ nextCarrier : TopFreshTailCarrier (topClockSpan n),
      (topFreshTailGenealogy ring C s
        (topFixedTraceNext ring C Z e)).slots j =
          some nextCarrier ∧
      (∃ stamp : Nat, nextCarrier.origin = .freshBorder stamp) ∧
      ∃ sample :
        DigitSample (compileAdvice (ceilLogTwo n)) n,
        DigitRecordedSample
          (topFixedTraceNext ring C Z e).1.2 sample ∧
        sample.id.lane = .comparison ∧
        sample.id.site = certSite s j.val ∧
        ((topFixedTraceNext ring C Z e).1.2.current
          (certSite s j.val)).comparison.out.atom =
          some (.sampled sample.id) ∧
        sample.value = (Z.1.1 e).d ∧
        sample.tail = (Z.1.1 e).beta := by
  have hgeometry :=
    topFreshTailCausalSourcePublicGeometry
      ring C s hn hbad Z hqueue.trace.1 j
  have hxl : (Z.1.1 e).l = false := by
    rw [hsite]
    exact hgeometry.1
  have hyl :
      (Z.1.1 (ring.rightNeighbor e)).l = false := by
    rw [hsite]
    exact hgeometry.2.1
  obtain ⟨hdata, _, _, sample, hrecord,
    hlane, hsampleSite, hatom, hvalue, htail⟩ :=
    topFreshTailAuditSourceUnreadStep
      ring C s hn hbad Z hqueue.trace.1
      e j hsite hxl hyl hunread
  have hghostSource :
      ((topFreshTailGenealogy ring C s Z).trace.1.1 e).qOut =
        .U := by
    rw [hqueue.trace.2]
    exact hunread
  have hghostLeft :
      ((topFreshTailGenealogy ring C s Z).trace.1.1 e).l =
        false := by
    rw [hqueue.trace.2]
    exact hxl
  have hghostRight :
      ((topFreshTailGenealogy ring C s Z).trace.1.1
        (ring.rightNeighbor e)).l = false := by
    rw [hqueue.trace.2]
    exact hyl
  have hnewFresh :
      ∃ nextCarrier : TopFreshTailCarrier (topClockSpan n),
        (topFreshTailGenealogy ring C s
          (topFixedTraceNext ring C Z e)).slots j =
            some nextCarrier ∧
        ∃ stamp : Nat,
          nextCarrier.origin = .freshBorder stamp := by
    by_cases hzero : j.val = 0
    · have hbirth :=
        topFreshTailCausalUnreadBorder
          ring C s (topFreshTailGenealogy ring C s Z)
          e j hsite hzero hghostSource
          hghostLeft hghostRight
      rw [hqueue.trace.2] at hbirth
      refine ⟨{ origin := .freshBorder (Z.1.2.clock + 1),
                born := Z.1.2.clock + 1 }, ?_,
        Z.1.2.clock + 1, rfl⟩
      rw [topFreshTailCausalReplayNext]
      exact hbirth
    · have hpositive : 0 < j.val := by omega
      have hstay :=
        topFreshTailCausalUnreadInterior
          ring C s (topFreshTailGenealogy ring C s Z)
          e j carrier hsite hpositive
          hghostSource hghostLeft hghostRight hslot
      refine ⟨carrier, ?_, hfresh⟩
      rw [topFreshTailCausalReplayNext]
      exact hstay
  obtain ⟨nextCarrier, hslotNext, hfreshNext⟩ := hnewFresh
  exact ⟨hdata, nextCarrier, hslotNext, hfreshNext,
    sample, hrecord, hlane, hsampleSite,
    hatom, hvalue, htail⟩

/-- A D carrying a fresh source genealogy identity cannot cross
an occupied OLD nonmarker responder. Its physical D byte,
comparison atom, and exact fresh carrier all remain in place
through the same simultaneous selected service.
Consumer: J5 B.behind occupied-child row and cohort FIFO. -/
theorem topFreshTailFirstBorderFreshOccupiedInteriorStep
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (Z : TopFixedTraceState n)
    (e : Fin n)
    (hqueue : TopFreshTailCausalQueue ring C s Z)
    (j : Fin (topClockSpan n))
    (hnext : j.val + 1 < topClockSpan n)
    (hsite : e = certSite s j.val)
    (value : Fin (compileAdvice (ceilLogTwo n)).topA)
    (tail : Bool)
    (hdata : (Z.1.1 e).qOut = .D value tail)
    (hoccupied :
      (Z.1.1 (ring.rightNeighbor e)).qOut ≠ .E)
    (carrier : TopFreshTailCarrier (topClockSpan n))
    (hslot :
      (topFreshTailGenealogy ring C s Z).slots j = some carrier)
    (hfresh : ∃ stamp : Nat,
      carrier.origin = .freshBorder stamp) :
    ((topFixedTraceNext ring C Z e).1.1
      (certSite s j.val)).qOut = .D value tail ∧
    (topFreshTailGenealogy ring C s
      (topFixedTraceNext ring C Z e)).slots j =
        some carrier ∧
    ((topFixedTraceNext ring C Z e).1.2.current
      (certSite s j.val)).comparison.out.atom =
      (Z.1.2.current
        (certSite s j.val)).comparison.out.atom ∧
    (∃ stamp : Nat, carrier.origin = .freshBorder stamp) := by
  have hgeometry :=
    topFreshTailCausalSourcePublicGeometry
      ring C s hn hbad Z hqueue.trace.1 j
  have hxl : (Z.1.1 e).l = false := by
    rw [hsite]
    exact hgeometry.1
  have hyl :
      (Z.1.1 (ring.rightNeighbor e)).l = false := by
    rw [hsite]
    exact hgeometry.2.1
  have hnotTerminal : j.val + 1 ≠ topClockSpan n := by
    omega
  have hmarker :
      (Z.1.1 (ring.rightNeighbor e)).beta = false := by
    have hm := hgeometry.2.2.2
    rw [if_neg hnotTerminal] at hm
    rw [hsite]
    exact hm
  have hphysical :=
    topFreshTailFifoOccupiedFrame
      ring C Z e value tail
      hxl hyl hdata hmarker hoccupied
  have hghost :=
    topFreshTailCausalOccupiedBlock
      ring C s (topFreshTailGenealogy ring C s Z)
      e j value tail carrier hsite
      (by rw [hqueue.trace.2]; exact hdata)
      (by rw [hqueue.trace.2]; exact hxl)
      (by rw [hqueue.trace.2]; exact hyl)
      (by rw [hqueue.trace.2]; exact hmarker)
      (by rw [hqueue.trace.2]; exact hoccupied)
      hslot
  have hslotNext :
      (topFreshTailGenealogy ring C s
        (topFixedTraceNext ring C Z e)).slots j =
        some carrier := by
    rw [topFreshTailCausalReplayNext]
    exact hghost
  have hatomNext :=
    topFreshTailAuditPhysicalBlockedInteriorAtom
      ring C Z e value tail
      hxl hyl hdata hmarker hoccupied
  refine ⟨?_, hslotNext, ?_, hfresh⟩
  · rw [← hsite]
    exact hphysical
  · rw [← hsite]
    exact hatomNext

/-- A source site strictly earlier than the selected source
site is off BOTH physical endpoints. At the terminal selected
source this uses the strict complete-pair width to exclude the
port marker, rather than applying source-site injectivity to
an out-of-range Fin literal.
Consumer: J5 spatial barrier, OLD services ahead of the root. -/
theorem topFreshTailFirstBorderEarlierSiteOffSelectedPair
    {n : Nat} (ring : DirectedRing n)
    (s : Fin n) (hn : 5 ≤ n)
    (i j : Fin (topClockSpan n))
    (hearlier : i.val < j.val)
    (e : Fin n)
    (hsite : e = certSite s j.val) :
    certSite s i.val ≠ e ∧
    certSite s i.val ≠ ring.rightNeighbor e := by
  have hsource : certSite s i.val ≠ e := by
    intro heq
    have hsame :=
      topFreshTailCausalSourceSiteInjective
        s hn i j (heq.trans hsite)
    have hv := congrArg Fin.val hsame
    omega
  have hneighbor :
      ring.rightNeighbor e = certSite s (j.val + 1) := by
    rw [hsite]
    exact topFreshTailFirstBorderNeighborSite ring s j.val
  have htarget :
      certSite s i.val ≠ ring.rightNeighbor e := by
    rw [hneighbor]
    by_cases hinterior : j.val + 1 < topClockSpan n
    · exact topFreshTailFirstBorderEarlierSourceSiteDistinctSuccessor
        s hn i j hearlier hinterior
    · have hterminal : j.val + 1 = topClockSpan n := by
        have hj := j.isLt
        omega
      rw [hterminal]
      exact topFreshTailFirstBorderPortOutsideSource s hn i
  exact ⟨hsource, htarget⟩

/-- The spatial B invariant needs only the tracked root and
all strictly earlier slots to be off the selected pair. The
selected service may affect other source positions, including
the old terminal port and old true-tail rearm children. J1/CQ
are re-established at the actual successor and B.old-front
uses the newborn-inclusive all-rows theorem.
Consumer: J5 B.step for OLD service beyond the root. -/
theorem topFreshTailFirstBorderSpatialBarrierPrefixFrame
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (Z : TopFixedTraceState n)
    (root : TopFreshTailCarrier (topClockSpan n))
    (k : Fin (topClockSpan n))
    (sample : DigitSample (compileAdvice (ceilLogTwo n)) n)
    (hbarrier :
      TopFreshTailFirstBorderSpatialBarrier
        ring C s Z root k sample)
    (e : Fin n)
    (hrootSource : certSite s k.val ≠ e)
    (hrootTarget :
      certSite s k.val ≠ ring.rightNeighbor e)
    (hbehindAway :
      ∀ j : Fin (topClockSpan n), j.val < k.val →
        certSite s j.val ≠ e ∧
        certSite s j.val ≠ ring.rightNeighbor e) :
    TopFreshTailFirstBorderSpatialBarrier
      ring C s (topFixedTraceNext ring C Z e)
      root k sample := by
  have hqueueNext :=
    topFreshTailCausalQueueStep
      ring C s hn hbad Z e hbarrier.queue
  have hprovenanceNext :=
    topFreshTailAuditSourceDataReached
      ring C s hn hbad
      (topFixedTraceNext ring C Z e)
      hqueueNext.trace.1
  have hrootFrame :=
    topFreshTailCausalOffPairSlotAgreement
      ring C s Z e hbarrier.queue k
      hrootSource hrootTarget
  have hrootAtomFrame :
      ((topFixedTraceNext ring C Z e).1.2.current
        (certSite s k.val)).comparison.out.atom =
      (Z.1.2.current
        (certSite s k.val)).comparison.out.atom := by
    change
      ((digitAuditStep ring (piD Z.1.1) Z.1.2 e).current
        (certSite s k.val)).comparison.out.atom =
      (Z.1.2.current
        (certSite s k.val)).comparison.out.atom
    simp only [digitAuditStep, digitGhostStep,
      if_neg hrootSource, if_neg hrootTarget]
  refine {
    queue := hqueueNext
    provenance := hprovenanceNext
    rootFresh := hbarrier.rootFresh
    sampleRecorded := digitRecordedSampleStep
      ring (piD Z.1.1) Z.1.2 e sample
        hbarrier.sampleRecorded
    sampleLane := hbarrier.sampleLane
    sampleSite := hbarrier.sampleSite
    sampleTail := hbarrier.sampleTail
    samplePositive := hbarrier.samplePositive
    rootSlot := ?_
    rootData := ?_
    rootAtom := ?_
    behind := ?_
    oldFront :=
      topFreshTailFirstBorderOldFrontAllRows
        ring C s hn hbad Z e k hbarrier.queue
        hbarrier.oldFront }
  · rw [hrootFrame.2]
    exact hbarrier.rootSlot
  · rw [hrootFrame.1]
    exact hbarrier.rootData
  · rw [hrootAtomFrame]
    exact hbarrier.rootAtom
  · intro j hbelow
    obtain ⟨child, hslot, hfresh⟩ :=
      hbarrier.behind j hbelow
    obtain ⟨hnotSource, hnotTarget⟩ :=
      hbehindAway j hbelow
    have hframe :=
      topFreshTailCausalOffPairSlotAgreement
        ring C s Z e hbarrier.queue j
        hnotSource hnotTarget
    exact ⟨child, hframe.2.trans hslot, hfresh⟩

/-- Every selected source service *ahead* of the live fresh
root preserves the root, all fresh slots behind it, J1,
the causal queue and the full old-front invariant. This
includes a terminal OLD false/true port acceptance; the
disappearing OLD head's historical receipt is treated by J2
and topFreshTailHistoricalOldFamilyService separately.
Consumer: J5 B.step, old-family ahead row. -/
theorem topFreshTailFirstBorderSpatialBarrierAheadStep
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (Z : TopFixedTraceState n)
    (root : TopFreshTailCarrier (topClockSpan n))
    (k : Fin (topClockSpan n))
    (sample : DigitSample (compileAdvice (ceilLogTwo n)) n)
    (hbarrier :
      TopFreshTailFirstBorderSpatialBarrier
        ring C s Z root k sample)
    (j : Fin (topClockSpan n))
    (hahead : k.val < j.val)
    (e : Fin n)
    (hsite : e = certSite s j.val) :
    TopFreshTailFirstBorderSpatialBarrier
      ring C s (topFixedTraceNext ring C Z e)
      root k sample := by
  have hrootAway :=
    topFreshTailFirstBorderEarlierSiteOffSelectedPair
      ring s hn k j hahead e hsite
  have hbehindAway :
      ∀ i : Fin (topClockSpan n), i.val < k.val →
        certSite s i.val ≠ e ∧
        certSite s i.val ≠ ring.rightNeighbor e := by
    intro i hbehind
    have hearlier : i.val < j.val := by omega
    exact topFreshTailFirstBorderEarlierSiteOffSelectedPair
      ring s hn i j hearlier e hsite
  exact topFreshTailFirstBorderSpatialBarrierPrefixFrame
    ring C s hn hbad Z root k sample hbarrier
    e hrootAway.1 hrootAway.2 hbehindAway

end L3

namespace L3

/-- The fixed-public trace has no leader at any reached cut
when its original public configuration has no leader.  The
physical next state reads its leader bit from C, not from the
evolving private qOut/qIn/qCarry registers. Consumer: J5
incoming source-zero responder branch. -/
theorem topFreshTailFirstBorderReachedNoLeader
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n)
    (hl : ∀ i : Fin n, (C i).l = false)
    (Z : TopFixedTraceState n)
    (hreach : topClockReached ring C Z) :
    ∀ i : Fin n, (Z.1.1 i).l = false := by
  intro i
  exact (topFreshTailCausalReachedPublicMask
    ring C Z hreach i).1.trans (hl i)

/-- The preceding property is uniform across ALL finite
scheduler words from the fixed-public entrance. There is
no selected leader source on this reached trace.
Consumer: the complete J5 B.step partition. -/
theorem topFreshTailFirstBorderRunNoLeader
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n)
    (hl : ∀ i : Fin n, (C i).l = false)
    (word : List (Fin n)) :
    ∀ i : Fin n,
      ((topFixedTraceRun ring C word).1.1 i).l = false := by
  exact topFreshTailFirstBorderReachedNoLeader
    ring C hl (topFixedTraceRun ring C word)
    (topFreshTailAuditRunReached ring C word)

/-- Even from a raw, not necessarily reached trace state,
one selected fixed-public step overwrites every leader bit
with the corresponding bit of the fixed public C.
Consumer: J5 no-leader forward induction. -/
theorem topFreshTailFirstBorderNextNoLeader
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n)
    (hl : ∀ i : Fin n, (C i).l = false)
    (Z : TopFixedTraceState n)
    (e : Fin n) :
    ∀ i : Fin n,
      ((topFixedTraceNext ring C Z e).1.1 i).l = false := by
  intro i
  exact (topPortFixedPublicMaskStep ring C Z e i).1.trans (hl i)

theorem topFreshTailFirstBorderBlockedOwner
    (c : Compiled) (x y : Agent c) (betaX betaY : Bool)
    (v : Fin c.topA) (tail : Bool)
    (hxl : x.l = false) (hyl : y.l = false)
    (hyb : y.beta = true)
    (hxo : x.qOut = .D v tail)
    (hblock : y.qIn.isE = false ∨ y.qCarry.isOff = false) :
    (liveTopPair c x y betaX betaY).x.qOut = .D v tail := by
  rcases hblock with hinput | hcarry
  · cases hiy : y.qIn with
    | E =>
        simp [hiy, InTok.isE] at hinput
    | P value stamp =>
        simp [liveTopPair, hxl, hyl, hyb, hxo, hiy,
          OutTok.isD, InTok.isE]
    | S value stamp =>
        simp [liveTopPair, hxl, hyl, hyb, hxo, hiy,
          OutTok.isD, InTok.isE]
    | X =>
        simp [liveTopPair, hxl, hyl, hyb, hxo, hiy,
          OutTok.isD, InTok.isE]
  · cases hcy : y.qCarry with
    | OFF =>
        simp [hcy, QCarry.isOff] at hcarry
    | L carry error =>
        simp [liveTopPair, hxl, hyl, hyb, hxo, hcy,
          OutTok.isD, QCarry.isOff]

/-- A terminal true-tail root survives a blocked OLD port offer
without moving or losing its sampled operand.  Every earlier
fresh source carrier is off both physical endpoints; even the
last target marker cannot alias a source slot.  The same CQ/J1
and old-front witnesses persist after the selected service.
Consumer: J5 B.step, terminal blocked port row. -/
theorem topFreshTailFirstBorderSpatialBarrierPortBlocked
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (Z : TopFixedTraceState n)
    (root : TopFreshTailCarrier (topClockSpan n))
    (k : Fin (topClockSpan n))
    (sample : DigitSample (compileAdvice (ceilLogTwo n)) n)
    (hbarrier :
      TopFreshTailFirstBorderSpatialBarrier
        ring C s Z root k sample)
    (hterminal : k.val + 1 = topClockSpan n)
    (e : Fin n)
    (hsite : e = certSite s k.val)
    (hblocked :
      (Z.1.1 (ring.rightNeighbor e)).qIn.isE = false ∨
      (Z.1.1 (ring.rightNeighbor e)).qCarry.isOff = false) :
    TopFreshTailFirstBorderSpatialBarrier
      ring C s (topFixedTraceNext ring C Z e)
      root k sample := by
  have hgeometry :=
    topFreshTailCausalSourcePublicGeometry
      ring C s hn hbad Z hbarrier.queue.trace.1 k
  have hleft : (Z.1.1 e).l = false := by
    rw [hsite]
    exact hgeometry.1
  have hright :
      (Z.1.1 (ring.rightNeighbor e)).l = false := by
    rw [hsite]
    exact hgeometry.2.1
  have hmarker :
      (Z.1.1 (ring.rightNeighbor e)).beta = true := by
    have hm := hgeometry.2.2.2
    rw [if_pos hterminal] at hm
    rw [hsite]
    exact hm
  have houtput :
      (Z.1.1 e).qOut = .D sample.value true := by
    rw [hsite]
    exact hbarrier.rootData
  have hneighbor :
      ring.rightNeighbor e = certSite s (topClockSpan n) := by
    calc
      ring.rightNeighbor e =
          certSite s (k.val + 1) := by
            rw [hsite]
            exact topFreshTailFirstBorderNeighborSite ring s k.val
      _ = certSite s (topClockSpan n) := by
            rw [hterminal]
  have hqueueNext :=
    topFreshTailCausalQueueStep
      ring C s hn hbad Z e hbarrier.queue
  have hprovenanceNext :=
    topFreshTailAuditSourceDataReached
      ring C s hn hbad
      (topFixedTraceNext ring C Z e)
      hqueueNext.trace.1
  have hghost :=
    topFreshTailCausalPortBlocked
      ring C s (topFreshTailGenealogy ring C s Z)
      e k sample.value true root hsite
      (by rw [hbarrier.queue.trace.2]; exact hleft)
      (by rw [hbarrier.queue.trace.2]; exact hright)
      (by rw [hbarrier.queue.trace.2]; exact hmarker)
      (by rw [hbarrier.queue.trace.2]; exact houtput)
      (by rw [hbarrier.queue.trace.2]; exact hblocked)
      hbarrier.rootSlot
  have hrootNext :
      (topFreshTailGenealogy ring C s
        (topFixedTraceNext ring C Z e)).slots k =
          some root := by
    rw [topFreshTailCausalReplayNext]
    exact hghost
  have howner :
      (topPortLiteralTopOwner ring Z.1.1 e).x.qOut =
        .D sample.value true := by
    unfold topPortLiteralTopOwner
    exact topFreshTailFirstBorderBlockedOwner
      (compileAdvice (ceilLogTwo n))
      (Z.1.1 e) (Z.1.1 (ring.rightNeighbor e))
      _ _ sample.value true
      hleft hright hmarker houtput hblocked
  have hdataNext :
      ((topFixedTraceNext ring C Z e).1.1
        (certSite s k.val)).qOut =
          .D sample.value true := by
    rw [← hsite]
    change
      (topFixedPublicNext ring C Z.1.1 e e).qOut =
        .D sample.value true
    exact (topPortLiteralSourceFields
      ring C Z.1.1 e).2.2.trans howner
  have hatomNext :
      ((topFixedTraceNext ring C Z e).1.2.current
        (certSite s k.val)).comparison.out.atom =
          some (.sampled sample.id) := by
    rw [← hsite]
    rw [topFreshTailAuditPhysicalBlockedPortAtom
      ring C Z e sample.value true
      hleft hright houtput hmarker hblocked]
    rw [hsite]
    exact hbarrier.rootAtom
  have hbehindNext :
      ∀ j : Fin (topClockSpan n), j.val < k.val →
        ∃ child : TopFreshTailCarrier (topClockSpan n),
          (topFreshTailGenealogy ring C s
            (topFixedTraceNext ring C Z e)).slots j =
            some child ∧
          ∃ stamp : Nat, child.origin = .freshBorder stamp := by
    intro j hbelow
    obtain ⟨child, hslot, hfresh⟩ :=
      hbarrier.behind j hbelow
    have hnotSource : certSite s j.val ≠ e := by
      intro hequal
      have hsame :=
        topFreshTailCausalSourceSiteInjective
          s hn j k (hequal.trans hsite)
      have hvalue := congrArg Fin.val hsame
      omega
    have hnotTarget :
        certSite s j.val ≠ ring.rightNeighbor e := by
      rw [hneighbor]
      exact topFreshTailFirstBorderPortOutsideSource s hn j
    have hframe :=
      topFreshTailCausalOffPairSlotAgreement
        ring C s Z e hbarrier.queue j
        hnotSource hnotTarget
    exact ⟨child, hframe.2.trans hslot, hfresh⟩
  exact {
    queue := hqueueNext
    provenance := hprovenanceNext
    rootFresh := hbarrier.rootFresh
    sampleRecorded := digitRecordedSampleStep
      ring (piD Z.1.1) Z.1.2 e sample
        hbarrier.sampleRecorded
    sampleLane := hbarrier.sampleLane
    sampleSite := hbarrier.sampleSite
    sampleTail := hbarrier.sampleTail
    samplePositive := hbarrier.samplePositive
    rootSlot := hrootNext
    rootData := hdataNext
    rootAtom := hatomNext
    behind := hbehindNext
    oldFront :=
      topFreshTailFirstBorderOldFrontAllRows
        ring C s hn hbad Z e k hbarrier.queue
        hbarrier.oldFront }

/-- An enabled OLD true-tail terminal service leaves the exact
fresh rearm of the tracked root at the last source slot.
Every earlier slot is unchanged and still has a fresh carrier.
The post-service source is fully occupied by fresh U/D slots;
this does not yet assert the home-sample fidelity needed for
the periodic backwards-value stream.
Consumer: J5 first-border family exhaustion, post-port half. -/
theorem topFreshTailFirstBorderAcceptedFreshOccupancy
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (Z : TopFixedTraceState n)
    (root : TopFreshTailCarrier (topClockSpan n))
    (k : Fin (topClockSpan n))
    (sample : DigitSample (compileAdvice (ceilLogTwo n)) n)
    (hbarrier :
      TopFreshTailFirstBorderSpatialBarrier
        ring C s Z root k sample)
    (hterminal : k.val + 1 = topClockSpan n)
    (e : Fin n)
    (hsite : e = certSite s k.val)
    (hxi : (Z.1.1 e).qIn = .E)
    (hxc : (Z.1.1 e).qCarry = .OFF)
    (hyi : (Z.1.1 (ring.rightNeighbor e)).qIn = .E)
    (hyc : (Z.1.1 (ring.rightNeighbor e)).qCarry = .OFF)
    (exported : DigitExport (compileAdvice (ceilLogTwo n)) n)
    (hevent :
      topFreshTailGenealogyPortExport ring C s Z e =
        some exported) :
    DigitRecordedExport
      (topFixedTraceNext ring C Z e).1.2 exported ∧
    exported.time = Z.1.2.clock + 1 ∧
    exported.operand = some (.sampled sample.id) ∧
    ((topFixedTraceNext ring C Z e).1.1
      (certSite s (topClockSpan n))).qIn =
        .P sample.value true ∧
    ((topFixedTraceNext ring C Z e).1.1
      (certSite s k.val)).qOut = .U ∧
    ∀ j : Fin (topClockSpan n),
      ∃ carrier : TopFreshTailCarrier (topClockSpan n),
        (topFreshTailGenealogy ring C s
          (topFixedTraceNext ring C Z e)).slots j =
          some carrier ∧
        (∃ stamp : Nat, carrier.origin = .freshBorder stamp) ∧
        (((topFixedTraceNext ring C Z e).1.1
          (certSite s j.val)).qOut = .U ∨
         ∃ (value : Fin (compileAdvice (ceilLogTwo n)).topA)
           (tail : Bool),
           ((topFixedTraceNext ring C Z e).1.1
             (certSite s j.val)).qOut = .D value tail) := by
  obtain ⟨hrecord, htime, _, _, hoperand, _⟩ :=
    topFreshTailFirstBorderTrackedRootReceipt
      ring C s Z root k sample hbarrier hterminal
      e exported hevent
  have hgeometry :=
    topFreshTailCausalSourcePublicGeometry
      ring C s hn hbad Z hbarrier.queue.trace.1 k
  have hxl : (Z.1.1 e).l = false := by
    rw [hsite]
    exact hgeometry.1
  have hyl :
      (Z.1.1 (ring.rightNeighbor e)).l = false := by
    rw [hsite]
    exact hgeometry.2.1
  have hmarker :
      (Z.1.1 (ring.rightNeighbor e)).beta = true := by
    have hmark := hgeometry.2.2.2
    rw [if_pos hterminal] at hmark
    rw [hsite]
    exact hmark
  have houtput :
      (Z.1.1 e).qOut = .D sample.value true := by
    rw [hsite]
    exact hbarrier.rootData
  have hneighbor :
      ring.rightNeighbor e = certSite s (topClockSpan n) := by
    calc
      ring.rightNeighbor e =
          certSite s (k.val + 1) := by
            rw [hsite]
            exact topFreshTailFirstBorderNeighborSite ring s k.val
      _ = certSite s (topClockSpan n) := by
            rw [hterminal]
  have hphysical :=
    topFreshTailFifoPortTailRearms
      ring (by omega : 2 ≤ n) C Z e sample.value
      hxl hyl hxi hxc hyi hyc hmarker houtput
  have hghost :=
    topFreshTailCausalPortDeparture
      ring (by omega : 2 ≤ n) C s
      (topFreshTailGenealogy ring C s Z)
      e k sample.value root hsite
      (by rw [hbarrier.queue.trace.2]; exact hxl)
      (by rw [hbarrier.queue.trace.2]; exact hyl)
      (by rw [hbarrier.queue.trace.2]; exact hxi)
      (by rw [hbarrier.queue.trace.2]; exact hxc)
      (by rw [hbarrier.queue.trace.2]; exact hyi)
      (by rw [hbarrier.queue.trace.2]; exact hyc)
      (by rw [hbarrier.queue.trace.2]; exact hmarker)
      (by rw [hbarrier.queue.trace.2]; exact houtput)
      hbarrier.rootSlot
  have hlast :
      (topFreshTailGenealogy ring C s
        (topFixedTraceNext ring C Z e)).slots k =
          some (topFreshTailGenealogyRearm k
            (Z.1.2.clock + 1) root) := by
    rw [topFreshTailCausalReplayNext]
    rw [hbarrier.queue.trace.2] at hghost
    exact hghost.1
  have hlastFresh :
      ∃ stamp : Nat,
        (topFreshTailGenealogyRearm k
          (Z.1.2.clock + 1) root).origin =
          .freshBorder stamp := by
    obtain ⟨birth, hfresh⟩ := hbarrier.rootFresh
    by_cases hzero : k.val = 0
    · exact ⟨Z.1.2.clock + 1,
        by simp [topFreshTailGenealogyRearm, hzero]⟩
    · exact ⟨birth,
        by simp [topFreshTailGenealogyRearm, hzero, hfresh]⟩
  have hqueueNext :=
    topFreshTailCausalQueueStep
      ring C s hn hbad Z e hbarrier.queue
  have hsourceU :
      ((topFixedTraceNext ring C Z e).1.1
        (certSite s k.val)).qOut = .U := by
    rw [← hsite]
    exact hphysical.1
  have htargetP :
      ((topFixedTraceNext ring C Z e).1.1
        (certSite s (topClockSpan n))).qIn =
          .P sample.value true := by
    rw [← hneighbor]
    exact hphysical.2
  have hoccupancy :
      ∀ j : Fin (topClockSpan n),
        ∃ carrier : TopFreshTailCarrier (topClockSpan n),
          (topFreshTailGenealogy ring C s
            (topFixedTraceNext ring C Z e)).slots j =
              some carrier ∧
          ∃ stamp : Nat,
            carrier.origin = .freshBorder stamp := by
    intro j
    by_cases hbelow : j.val < k.val
    · obtain ⟨child, hslot, hfresh⟩ :=
        hbarrier.behind j hbelow
      have hnotSource : certSite s j.val ≠ e := by
        intro hequal
        have hsame :=
          topFreshTailCausalSourceSiteInjective
            s hn j k (hequal.trans hsite)
        have hv := congrArg Fin.val hsame
        omega
      have hnotTarget :
          certSite s j.val ≠ ring.rightNeighbor e := by
        rw [hneighbor]
        exact topFreshTailFirstBorderPortOutsideSource s hn j
      have hframe :=
        topFreshTailCausalOffPairSlotAgreement
          ring C s Z e hbarrier.queue j
          hnotSource hnotTarget
      exact ⟨child, hframe.2.trans hslot, hfresh⟩
    · have hindex : j = k := by
        apply Fin.ext
        have hj := j.isLt
        omega
      subst j
      exact ⟨topFreshTailGenealogyRearm k
        (Z.1.2.clock + 1) root, hlast, hlastFresh⟩
  refine ⟨hrecord, htime, hoperand,
    htargetP, hsourceU, ?_⟩
  intro j
  obtain ⟨carrier, hslot, hfresh⟩ := hoccupancy j
  have hnotEmpty :
      ((topFixedTraceNext ring C Z e).1.1
        (certSite s j.val)).qOut ≠ .E := by
    intro hE
    have hnone := (hqueueNext.slot j).1 hE
    rw [hslot] at hnone
    cases hnone
  refine ⟨carrier, hslot, hfresh, ?_⟩
  cases htok :
      ((topFixedTraceNext ring C Z e).1.1
        (certSite s j.val)).qOut with
  | E =>
      exact False.elim (hnotEmpty htok)
  | U =>
      exact Or.inl rfl
  | D value tail =>
      exact Or.inr ⟨value, tail, rfl⟩

/-- Whenever the tracked sampled source-zero root reaches its
terminal port and the OLD comparison service accepts it, the
end-of-service trace satisfies the *actual*
topClockGenuineTailAccepted predicate.  No earliest-root claim
is made here; this establishes the forward identification needed
by firstBorderRootIsFirstExport. Consumer: J5 first-export step. -/
theorem topFreshTailFirstBorderTrackedRootGenuineOnPort
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (Z : TopFixedTraceState n)
    (root : TopFreshTailCarrier (topClockSpan n))
    (k : Fin (topClockSpan n))
    (sample : DigitSample (compileAdvice (ceilLogTwo n)) n)
    (hbarrier :
      TopFreshTailFirstBorderSpatialBarrier
        ring C s Z root k sample)
    (hterminal : k.val + 1 = topClockSpan n)
    (e : Fin n)
    (hsite : e = certSite s k.val)
    (hxi : (Z.1.1 e).qIn = .E)
    (hxc : (Z.1.1 e).qCarry = .OFF)
    (hyi : (Z.1.1 (ring.rightNeighbor e)).qIn = .E)
    (hyc : (Z.1.1 (ring.rightNeighbor e)).qCarry = .OFF)
    (exported : DigitExport (compileAdvice (ceilLogTwo n)) n)
    (hevent :
      topFreshTailGenealogyPortExport ring C s Z e =
        some exported) :
    topClockGenuineTailAccepted C s
      (topFixedTraceNext ring C Z e) := by
  obtain ⟨hrecordExport, hstamp, hoperand,
    htargetP, _, _⟩ :=
    topFreshTailFirstBorderAcceptedFreshOccupancy
      ring C s hn hbad Z root k sample hbarrier
      hterminal e hsite hxi hxc hyi hyc exported hevent
  obtain ⟨_, _, hsourceSite, hdestination,
    _, hlane⟩ :=
    topFreshTailFirstBorderTrackedRootReceipt
      ring C s Z root k sample hbarrier hterminal
      e exported hevent
  have hk : k.val = topClockSpan n - 1 := by omega
  have hsourceData :
      (Z.1.1 (certSite s (topClockSpan n - 1))).qOut =
        .D sample.value true := by
    rw [← hk]
    exact hbarrier.rootData
  have hsourceAtom :
      (Z.1.2.current
        (certSite s (topClockSpan n - 1))).comparison.out.atom =
          some (.sampled sample.id) := by
    rw [← hk]
    exact hbarrier.rootAtom
  have hready :
      topClockPortReady s (some (.sampled sample.id)) Z :=
    ⟨sample.value, true, hsourceData, hsourceAtom⟩
  obtain ⟨value, tail, hOldSource, hvalue, htail⟩ :=
    topFreshTailAuditPortOldPayload
      ring C s Z e (some (.sampled sample.id))
      hready exported hevent
  rw [hsourceData] at hOldSource
  cases hOldSource
  have hrecordSample :=
    digitRecordedSampleStep
      ring (piD Z.1.1) Z.1.2 e sample
      hbarrier.sampleRecorded
  have hcurrent :
      exported.time =
        (topFixedTraceNext ring C Z e).1.2.clock := by
    change exported.time = Z.1.2.clock + 1
    exact hstamp
  exact ⟨sample, exported, hrecordSample, hrecordExport,
    hbarrier.sampleLane, hbarrier.sampleSite,
    hbarrier.samplePositive, hbarrier.sampleTail,
    hcurrent, hlane, hsourceSite, hdestination,
    hoperand, hvalue, htail, htargetP⟩

/-- An occupied responder D is not overwritten by an
incoming follower service, even at the source-zero marker.
The physical output and audit atom remain exactly the OLD
ones, and the genealogy reuses the same occupied slot.
Consumer: J5 B.step incoming-arc and blocked child rows. -/
theorem topFreshTailFirstBorderIncomingDataFrame
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (Z : TopFixedTraceState n)
    (e : Fin n)
    (hqueue : TopFreshTailCausalQueue ring C s Z)
    (hl : ∀ i : Fin n, (C i).l = false)
    (j : Fin (topClockSpan n))
    (htarget : ring.rightNeighbor e = certSite s j.val)
    (value : Fin (compileAdvice (ceilLogTwo n)).topA)
    (tail : Bool)
    (hdata :
      (Z.1.1 (certSite s j.val)).qOut = .D value tail)
    (carrier : TopFreshTailCarrier (topClockSpan n))
    (hslot :
      (topFreshTailGenealogy ring C s Z).slots j =
        some carrier) :
    ((topFixedTraceNext ring C Z e).1.1
      (certSite s j.val)).qOut = .D value tail ∧
    (topFreshTailGenealogy ring C s
      (topFixedTraceNext ring C Z e)).slots j = some carrier ∧
    ((topFixedTraceNext ring C Z e).1.2.current
      (certSite s j.val)).comparison.out.atom =
      (Z.1.2.current
        (certSite s j.val)).comparison.out.atom := by
  have hnoLeader :=
    topFreshTailFirstBorderReachedNoLeader
      ring C hl Z hqueue.trace.1
  have hxl : (Z.1.1 e).l = false := hnoLeader e
  have hyl :
      (Z.1.1 (ring.rightNeighbor e)).l = false :=
    hnoLeader (ring.rightNeighbor e)
  have htargetData :
      (Z.1.1 (ring.rightNeighbor e)).qOut =
        .D value tail := by
    rw [htarget]
    exact hdata
  have hphysical :=
    topFreshTailAuditPhysicalResponderDataKeep
      ring (by omega : 2 ≤ n) C Z e value tail
      hxl hyl htargetData
  have hnewTarget :
      ((topFixedTraceNext ring C Z e).1.1
        (certSite s j.val)).qOut =
        .D value tail := by
    rw [← htarget]
    exact hphysical.1
  have holdGhost :
      ((topFreshTailGenealogy ring C s Z).trace.1.1
        (certSite s j.val)).qOut = .D value tail := by
    rw [hqueue.trace.2]
    exact hdata
  have hpostGhost :
      ((topFixedTraceNext ring C
        (topFreshTailGenealogy ring C s Z).trace e).1.1
        (certSite s j.val)).qOut = .D value tail := by
    rw [hqueue.trace.2]
    exact hnewTarget
  have hnewSlot :
      (topFreshTailGenealogy ring C s
        (topFixedTraceNext ring C Z e)).slots j =
          some carrier := by
    rw [topFreshTailCausalReplayNext]
    change topFreshTailGenealogyNextSlot ring C s
      (topFreshTailGenealogy ring C s Z) e j = some carrier
    simp [topFreshTailGenealogyNextSlot,
      hpostGhost, holdGhost, hslot]
  refine ⟨hnewTarget, hnewSlot, ?_⟩
  rw [← htarget]
  exact hphysical.2

/-- On an incoming follower edge, an OLD unread responder U
cannot become a D by receiving an output: that move requires
responder E. Its U byte and its exact carrier are preserved.
Consumer: J5 B.step incoming border and fresh-child U rows. -/
theorem topFreshTailFirstBorderIncomingUnreadFrame
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (Z : TopFixedTraceState n)
    (e : Fin n)
    (hqueue : TopFreshTailCausalQueue ring C s Z)
    (hl : ∀ i : Fin n, (C i).l = false)
    (j : Fin (topClockSpan n))
    (htarget : ring.rightNeighbor e = certSite s j.val)
    (hunread :
      (Z.1.1 (certSite s j.val)).qOut = .U)
    (carrier : TopFreshTailCarrier (topClockSpan n))
    (hslot :
      (topFreshTailGenealogy ring C s Z).slots j =
        some carrier) :
    ((topFixedTraceNext ring C Z e).1.1
      (certSite s j.val)).qOut = .U ∧
    (topFreshTailGenealogy ring C s
      (topFixedTraceNext ring C Z e)).slots j =
        some carrier := by
  have hnoLeader :=
    topFreshTailFirstBorderReachedNoLeader
      ring C hl Z hqueue.trace.1
  have hxl : (Z.1.1 e).l = false := hnoLeader e
  have hyl :
      (Z.1.1 (ring.rightNeighbor e)).l = false :=
    hnoLeader (ring.rightNeighbor e)
  have htargetU :
      (Z.1.1 (ring.rightNeighbor e)).qOut = .U := by
    rw [htarget]
    exact hunread
  have hphysical :=
    topFreshTailCausalResponderPhysicalOutput
      ring (by omega : 2 ≤ n) C Z e
  have hnewU :
      ((topFixedTraceNext ring C Z e).1.1
        (certSite s j.val)).qOut = .U := by
    rw [← htarget]
    simpa [hxl, hyl, htargetU, OutTok.isE] using hphysical
  have hpreGhost :
      ((topFreshTailGenealogy ring C s Z).trace.1.1
        (certSite s j.val)).qOut = .U := by
    rw [hqueue.trace.2]
    exact hunread
  have hnewGhost :
      ((topFixedTraceNext ring C
        (topFreshTailGenealogy ring C s Z).trace e).1.1
        (certSite s j.val)).qOut = .U := by
    rw [hqueue.trace.2]
    exact hnewU
  have hslotNext :
      (topFreshTailGenealogy ring C s
        (topFixedTraceNext ring C Z e)).slots j =
          some carrier := by
    rw [topFreshTailCausalReplayNext]
    change topFreshTailGenealogyNextSlot ring C s
      (topFreshTailGenealogy ring C s Z) e j = some carrier
    simp [topFreshTailGenealogyNextSlot,
      hnewGhost, hpreGhost, hslot]
  exact ⟨hnewU, hslotNext⟩

/-- The incoming edge to source offset zero cannot erase the
tracked border D when the fixed public C has no leader.
Its OLD responder D, ghost carrier and comparison operand
are all unchanged, and the empty behind-root segment makes
the spatial barrier invariant immediate. Consumer: J5
incoming boundary row, repairing the missing leader case. -/
theorem topFreshTailFirstBorderSpatialBarrierBorderIncoming
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (hl : ∀ i : Fin n, (C i).l = false)
    (Z : TopFixedTraceState n)
    (root : TopFreshTailCarrier (topClockSpan n))
    (k : Fin (topClockSpan n))
    (sample : DigitSample (compileAdvice (ceilLogTwo n)) n)
    (hbarrier :
      TopFreshTailFirstBorderSpatialBarrier
        ring C s Z root k sample)
    (hzero : k.val = 0)
    (e : Fin n)
    (hincoming :
      ring.rightNeighbor e = certSite s k.val) :
    TopFreshTailFirstBorderSpatialBarrier
      ring C s (topFixedTraceNext ring C Z e)
      root k sample := by
  obtain ⟨hdata, hslot, hatom⟩ :=
    topFreshTailFirstBorderIncomingDataFrame
      ring C s hn Z e hbarrier.queue hl
      k hincoming sample.value true
      hbarrier.rootData root hbarrier.rootSlot
  have hqueueNext :=
    topFreshTailCausalQueueStep
      ring C s hn hbad Z e hbarrier.queue
  have hprovNext :=
    topFreshTailAuditSourceDataReached
      ring C s hn hbad
      (topFixedTraceNext ring C Z e)
      hqueueNext.trace.1
  refine {
    queue := hqueueNext
    provenance := hprovNext
    rootFresh := hbarrier.rootFresh
    sampleRecorded := digitRecordedSampleStep
      ring (piD Z.1.1) Z.1.2 e sample
      hbarrier.sampleRecorded
    sampleLane := hbarrier.sampleLane
    sampleSite := hbarrier.sampleSite
    sampleTail := hbarrier.sampleTail
    samplePositive := hbarrier.samplePositive
    rootSlot := hslot
    rootData := hdata
    rootAtom := ?_
    behind := ?_
    oldFront :=
      topFreshTailFirstBorderOldFrontAllRows
        ring C s hn hbad Z e k
        hbarrier.queue hbarrier.oldFront }
  · rw [hatom]
    exact hbarrier.rootAtom
  · intro j hj
    have hnone : False := by
      rw [hzero] at hj
      omega
    exact False.elim hnone

/-- A source slot with a causal carrier is a genuine
nonempty OLD output. Consumer: J5 selected-behind-root
source and successor occupancy rows. -/
theorem topFreshTailFirstBorderOccupiedOfCarrier
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (Z : TopFixedTraceState n)
    (hqueue : TopFreshTailCausalQueue ring C s Z)
    (j : Fin (topClockSpan n))
    (carrier : TopFreshTailCarrier (topClockSpan n))
    (hslot :
      (topFreshTailGenealogy ring C s Z).slots j =
        some carrier) :
    (Z.1.1 (certSite s j.val)).qOut ≠ .E := by
  intro hempty
  have hnone := (hqueue.slot j).1 hempty
  rw [hslot] at hnone
  cases hnone

/-- A selected OLD source slot strictly behind the tracked
root cannot move past the occupied right-hand source slot.
Its own fresh U may sample locally; its D is blocked.
If its responder is another fresh child or the root, the
responder's OLD occupied token/atom and genealogy persist.
All earlier slots are framed. Consumer: J5 spatial B.step
for every source owner behind the tracked root. -/
theorem topFreshTailFirstBorderSpatialBarrierBehindStep
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (hl : ∀ i : Fin n, (C i).l = false)
    (Z : TopFixedTraceState n)
    (root : TopFreshTailCarrier (topClockSpan n))
    (k : Fin (topClockSpan n))
    (sample : DigitSample (compileAdvice (ceilLogTwo n)) n)
    (hbarrier :
      TopFreshTailFirstBorderSpatialBarrier
        ring C s Z root k sample)
    (j : Fin (topClockSpan n))
    (hbelow : j.val < k.val)
    (e : Fin n)
    (hsite : e = certSite s j.val) :
    TopFreshTailFirstBorderSpatialBarrier
      ring C s (topFixedTraceNext ring C Z e)
      root k sample := by
  have hnext : j.val + 1 < topClockSpan n := by
    have hk := k.isLt
    omega
  have hneighbor :
      ring.rightNeighbor e = certSite s (j.val + 1) := by
    rw [hsite]
    exact topFreshTailFirstBorderNeighborSite ring s j.val
  have hrootSource : certSite s k.val ≠ e := by
    intro hcollision
    have hsame :=
      topFreshTailCausalSourceSiteInjective
        s hn k j (hcollision.trans hsite)
    have hv := congrArg Fin.val hsame
    omega
  have hnextIndex :
      (⟨j.val + 1, hnext⟩ : Fin (topClockSpan n)).val =
        j.val + 1 := rfl
  have hnextCarrier :
      ∃ carrier : TopFreshTailCarrier (topClockSpan n),
        (topFreshTailGenealogy ring C s Z).slots
          (⟨j.val + 1, hnext⟩ :
            Fin (topClockSpan n)) = some carrier := by
    by_cases hbeforeRoot : j.val + 1 < k.val
    · obtain ⟨carrier, hslot, _⟩ :=
        hbarrier.behind
          (⟨j.val + 1, hnext⟩ :
            Fin (topClockSpan n))
          hbeforeRoot
      exact ⟨carrier, hslot⟩
    · have heq : (⟨j.val + 1, hnext⟩ :
          Fin (topClockSpan n)) = k := by
        apply Fin.ext
        omega
      rw [heq]
      exact ⟨root, hbarrier.rootSlot⟩
  have htargetOccupied :
      (Z.1.1 (ring.rightNeighbor e)).qOut ≠ .E := by
    obtain ⟨carrier, hslot⟩ := hnextCarrier
    rw [hneighbor]
    exact topFreshTailFirstBorderOccupiedOfCarrier
      ring C s Z hbarrier.queue
      (⟨j.val + 1, hnext⟩ :
        Fin (topClockSpan n)) carrier hslot
  have hrootKeep :
      (topFreshTailGenealogy ring C s
        (topFixedTraceNext ring C Z e)).slots k =
          some root ∧
      ((topFixedTraceNext ring C Z e).1.1
        (certSite s k.val)).qOut =
          .D sample.value true ∧
      ((topFixedTraceNext ring C Z e).1.2.current
        (certSite s k.val)).comparison.out.atom =
          some (.sampled sample.id) := by
    by_cases hrootTarget :
        certSite s k.val = ring.rightNeighbor e
    · obtain ⟨hdata, hslot, hatom⟩ :=
        topFreshTailFirstBorderIncomingDataFrame
          ring C s hn Z e hbarrier.queue hl
          k hrootTarget.symm sample.value true
          hbarrier.rootData root hbarrier.rootSlot
      refine ⟨hslot, hdata, ?_⟩
      rw [hatom]
      exact hbarrier.rootAtom
    · have hframe :=
        topFreshTailCausalOffPairSlotAgreement
          ring C s Z e hbarrier.queue k
          hrootSource hrootTarget
      have hatomFrame :
          ((topFixedTraceNext ring C Z e).1.2.current
            (certSite s k.val)).comparison.out.atom =
          (Z.1.2.current
            (certSite s k.val)).comparison.out.atom := by
        change
          ((digitAuditStep ring (piD Z.1.1)
            Z.1.2 e).current
            (certSite s k.val)).comparison.out.atom =
          (Z.1.2.current
            (certSite s k.val)).comparison.out.atom
        simp only [digitAuditStep, digitGhostStep,
          if_neg hrootSource, if_neg hrootTarget]
      refine ⟨?_, ?_, ?_⟩
      · rw [hframe.2]
        exact hbarrier.rootSlot
      · rw [hframe.1]
        exact hbarrier.rootData
      · rw [hatomFrame]
        exact hbarrier.rootAtom
  have hqueueNext :=
    topFreshTailCausalQueueStep
      ring C s hn hbad Z e hbarrier.queue
  have hprovNext :=
    topFreshTailAuditSourceDataReached
      ring C s hn hbad
      (topFixedTraceNext ring C Z e)
      hqueueNext.trace.1
  have hbehindNext :
      ∀ i : Fin (topClockSpan n), i.val < k.val →
        ∃ carrier : TopFreshTailCarrier (topClockSpan n),
          (topFreshTailGenealogy ring C s
            (topFixedTraceNext ring C Z e)).slots i =
              some carrier ∧
          ∃ stamp : Nat,
            carrier.origin = .freshBorder stamp := by
    intro i hi
    obtain ⟨carrier, hslot, hfresh⟩ :=
      hbarrier.behind i hi
    by_cases hisource : i = j
    · subst i
      have hnotEmpty :=
        topFreshTailFirstBorderOccupiedOfCarrier
          ring C s Z hbarrier.queue j carrier hslot
      cases htok : (Z.1.1 e).qOut with
      | E =>
          have hE :
              (Z.1.1 (certSite s j.val)).qOut = .E := by
            rw [← hsite]
            exact htok
          exact False.elim (hnotEmpty hE)
      | U =>
          obtain ⟨_, nextCarrier, hslotNext,
            hfreshNext, _, _, _, _, _, _, _⟩ :=
            topFreshTailFirstBorderFreshUnreadSampleStep
              ring C s hn hbad Z e hbarrier.queue
              j hsite htok carrier hslot hfresh
          exact ⟨nextCarrier, hslotNext, hfreshNext⟩
      | D value tail =>
          obtain ⟨_, hslotNext, _, hfreshNext⟩ :=
            topFreshTailFirstBorderFreshOccupiedInteriorStep
              ring C s hn hbad Z e hbarrier.queue
              j hnext hsite value tail htok
              htargetOccupied carrier hslot hfresh
          exact ⟨carrier, hslotNext, hfreshNext⟩
    · by_cases htarget :
          certSite s i.val = ring.rightNeighbor e
      · have hnotEmpty :=
          topFreshTailFirstBorderOccupiedOfCarrier
            ring C s Z hbarrier.queue i carrier hslot
        cases htok :
            (Z.1.1 (certSite s i.val)).qOut with
        | E =>
            exact False.elim (hnotEmpty htok)
        | U =>
            obtain ⟨_, hslotNext⟩ :=
              topFreshTailFirstBorderIncomingUnreadFrame
                ring C s hn Z e hbarrier.queue hl
                i htarget.symm htok carrier hslot
            exact ⟨carrier, hslotNext, hfresh⟩
        | D value tail =>
            obtain ⟨_, hslotNext, _⟩ :=
              topFreshTailFirstBorderIncomingDataFrame
                ring C s hn Z e hbarrier.queue hl
                i htarget.symm value tail htok
                carrier hslot
            exact ⟨carrier, hslotNext, hfresh⟩
      · have hnotSource : certSite s i.val ≠ e := by
          intro hequal
          have hsame :=
            topFreshTailCausalSourceSiteInjective
              s hn i j (hequal.trans hsite)
          exact hisource hsame
        have hframe :=
          topFreshTailCausalOffPairSlotAgreement
            ring C s Z e hbarrier.queue i
            hnotSource htarget
        exact ⟨carrier, hframe.2.trans hslot, hfresh⟩
  exact {
    queue := hqueueNext
    provenance := hprovNext
    rootFresh := hbarrier.rootFresh
    sampleRecorded := digitRecordedSampleStep
      ring (piD Z.1.1) Z.1.2 e sample
      hbarrier.sampleRecorded
    sampleLane := hbarrier.sampleLane
    sampleSite := hbarrier.sampleSite
    sampleTail := hbarrier.sampleTail
    samplePositive := hbarrier.samplePositive
    rootSlot := hrootKeep.1
    rootData := hrootKeep.2.1
    rootAtom := hrootKeep.2.2
    behind := hbehindNext
    oldFront :=
      topFreshTailFirstBorderOldFrontAllRows
        ring C s hn hbad Z e k hbarrier.queue
        hbarrier.oldFront }

/-- A physical predecessor service into the source-zero marker
cannot itself be a selected source-arc edge: the source arc
is shorter than the whole ring and the target border at r
is also distinct from source zero. This uses the literal
rightNeighbor equation and source-site injectivity.
Consumer: J5 outside-to-border incoming row. -/
theorem topFreshTailFirstBorderIncomingZeroOutsideSource
    {n : Nat} (ring : DirectedRing n)
    (s : Fin n) (hn : 5 ≤ n)
    (e : Fin n)
    (hincoming : ring.rightNeighbor e = certSite s 0) :
    ∀ j : Fin (topClockSpan n),
      certSite s j.val ≠ e := by
  intro j hsource
  have hnext :
      certSite s (j.val + 1) = certSite s 0 := by
    calc
      certSite s (j.val + 1) =
          ring.rightNeighbor (certSite s j.val) :=
        (topFreshTailFirstBorderNeighborSite
          ring s j.val).symm
      _ = ring.rightNeighbor e := by rw [hsource]
      _ = certSite s 0 := hincoming
  have hpositive : 0 < topClockSpan n := by
    have hr := cert_rho_ge_three n hn
    change 3 ≤ topClockSpan n at hr
    omega
  by_cases hinterior : j.val + 1 < topClockSpan n
  · have heq :=
      topFreshTailCausalSourceSiteInjective
        s hn
        (⟨j.val + 1, hinterior⟩ :
          Fin (topClockSpan n))
        (⟨0, hpositive⟩ : Fin (topClockSpan n))
        hnext
    have hvalue := congrArg Fin.val heq
    change j.val + 1 = 0 at hvalue
    omega
  · have hlast : j.val + 1 = topClockSpan n := by
      have hbound := j.isLt
      omega
    rw [hlast] at hnext
    exact (topFreshTailFirstBorderPortOutsideSource
      s hn (⟨0, hpositive⟩ :
        Fin (topClockSpan n))) hnext.symm

/-- An incoming follower service from outside the source arc
can only touch the source-zero responder. If the tracked
root has already advanced to k>0, it and all other fresh
source slots are framed. The fresh source-zero U or D keeps
its carrier, since the responder is occupied and no leader
is present. Consumer: J5 external incoming row after birth. -/
theorem topFreshTailFirstBorderSpatialBarrierIncomingZero
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (hl : ∀ i : Fin n, (C i).l = false)
    (Z : TopFixedTraceState n)
    (root : TopFreshTailCarrier (topClockSpan n))
    (k : Fin (topClockSpan n))
    (sample : DigitSample (compileAdvice (ceilLogTwo n)) n)
    (hbarrier :
      TopFreshTailFirstBorderSpatialBarrier
        ring C s Z root k sample)
    (hpositive : 0 < k.val)
    (e : Fin n)
    (hincoming : ring.rightNeighbor e = certSite s 0) :
    TopFreshTailFirstBorderSpatialBarrier
      ring C s (topFixedTraceNext ring C Z e)
      root k sample := by
  have hawaySource :=
    topFreshTailFirstBorderIncomingZeroOutsideSource
      ring s hn e hincoming
  have hwidth : 0 < topClockSpan n := by
    have hr := cert_rho_ge_three n hn
    change 3 ≤ topClockSpan n at hr
    omega
  have htargetDifferent :
      ∀ j : Fin (topClockSpan n),
        0 < j.val →
        certSite s j.val ≠ ring.rightNeighbor e := by
    intro j hj
    rw [hincoming]
    intro hequal
    have heq :=
      topFreshTailCausalSourceSiteInjective
        s hn j
        (⟨0, hwidth⟩ : Fin (topClockSpan n)) hequal
    have hv := congrArg Fin.val heq
    change j.val = 0 at hv
    omega
  have hrootFrame :=
    topFreshTailCausalOffPairSlotAgreement
      ring C s Z e hbarrier.queue k
      (hawaySource k)
      (htargetDifferent k hpositive)
  have hrootAtomFrame :
      ((topFixedTraceNext ring C Z e).1.2.current
        (certSite s k.val)).comparison.out.atom =
        (Z.1.2.current
          (certSite s k.val)).comparison.out.atom := by
    change
      ((digitAuditStep ring (piD Z.1.1) Z.1.2 e).current
        (certSite s k.val)).comparison.out.atom =
        (Z.1.2.current
          (certSite s k.val)).comparison.out.atom
    simp only [digitAuditStep, digitGhostStep,
      if_neg (hawaySource k),
      if_neg (htargetDifferent k hpositive)]
  have hqueueNext :=
    topFreshTailCausalQueueStep
      ring C s hn hbad Z e hbarrier.queue
  have hprovNext :=
    topFreshTailAuditSourceDataReached
      ring C s hn hbad
      (topFixedTraceNext ring C Z e)
      hqueueNext.trace.1
  have hbehindNext :
      ∀ j : Fin (topClockSpan n), j.val < k.val →
        ∃ carrier : TopFreshTailCarrier (topClockSpan n),
          (topFreshTailGenealogy ring C s
            (topFixedTraceNext ring C Z e)).slots j =
              some carrier ∧
          ∃ stamp : Nat,
            carrier.origin = .freshBorder stamp := by
    intro j hj
    obtain ⟨carrier, hslot, hfresh⟩ :=
      hbarrier.behind j hj
    by_cases hzero : j.val = 0
    · have hnotEmpty :=
        topFreshTailFirstBorderOccupiedOfCarrier
          ring C s Z hbarrier.queue j carrier hslot
      cases htok :
          (Z.1.1 (certSite s j.val)).qOut with
      | E =>
          exact False.elim (hnotEmpty htok)
      | U =>
          obtain ⟨_, hslotNext⟩ :=
            topFreshTailFirstBorderIncomingUnreadFrame
              ring C s hn Z e hbarrier.queue hl j
              (by rw [hzero]; exact hincoming)
              htok carrier hslot
          exact ⟨carrier, hslotNext, hfresh⟩
      | D value tail =>
          obtain ⟨_, hslotNext, _⟩ :=
            topFreshTailFirstBorderIncomingDataFrame
              ring C s hn Z e hbarrier.queue hl j
              (by rw [hzero]; exact hincoming)
              value tail htok carrier hslot
          exact ⟨carrier, hslotNext, hfresh⟩
    · have hframe :=
        topFreshTailCausalOffPairSlotAgreement
          ring C s Z e hbarrier.queue j
          (hawaySource j)
          (htargetDifferent j (by omega))
      exact ⟨carrier, hframe.2.trans hslot, hfresh⟩
  refine {
    queue := hqueueNext
    provenance := hprovNext
    rootFresh := hbarrier.rootFresh
    sampleRecorded := digitRecordedSampleStep
      ring (piD Z.1.1) Z.1.2 e sample
        hbarrier.sampleRecorded
    sampleLane := hbarrier.sampleLane
    sampleSite := hbarrier.sampleSite
    sampleTail := hbarrier.sampleTail
    samplePositive := hbarrier.samplePositive
    rootSlot := ?_
    rootData := ?_
    rootAtom := ?_
    behind := hbehindNext
    oldFront :=
      topFreshTailFirstBorderOldFrontAllRows
        ring C s hn hbad Z e k hbarrier.queue
        hbarrier.oldFront }
  · rw [hrootFrame.2]
    exact hbarrier.rootSlot
  · rw [hrootFrame.1]
    exact hbarrier.rootData
  · rw [hrootAtomFrame]
    exact hbarrier.rootAtom


end L3

namespace L3

theorem topFreshTailFirstBorderSpatialBarrierNonacceptingStep
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (hl : ∀ i : Fin n, (C i).l = false)
    (Z : TopFixedTraceState n)
    (root : TopFreshTailCarrier (topClockSpan n))
    (k : Fin (topClockSpan n))
    (sample : DigitSample (compileAdvice (ceilLogTwo n)) n)
    (hbarrier :
      TopFreshTailFirstBorderSpatialBarrier
        ring C s Z root k sample)
    (e : Fin n)
    (hblockIfTerminal :
      e = certSite s k.val →
      k.val + 1 = topClockSpan n →
      (Z.1.1 (ring.rightNeighbor e)).qIn.isE = false ∨
      (Z.1.1 (ring.rightNeighbor e)).qCarry.isOff = false) :
    ∃ moved : Fin (topClockSpan n),
      TopFreshTailFirstBorderSpatialBarrier
        ring C s (topFixedTraceNext ring C Z e)
        root moved sample ∧
      (moved = k ∨ moved.val = k.val + 1) := by
  by_cases hsource :
      ∃ j : Fin (topClockSpan n), e = certSite s j.val
  · obtain ⟨j, hsite⟩ := hsource
    by_cases hbelow : j.val < k.val
    · exact ⟨k,
        topFreshTailFirstBorderSpatialBarrierBehindStep
          ring C s hn hbad hl Z root k sample hbarrier
          j hbelow e hsite,
        Or.inl rfl⟩
    · by_cases hequal : j.val = k.val
      · have hindex : j = k := Fin.ext hequal
        subst j
        by_cases hnext : k.val + 1 < topClockSpan n
        · exact topFreshTailFirstBorderSpatialBarrierInteriorOwner
            ring C s hn hbad Z root k sample
            hbarrier e hsite hnext
        · have hterminal : k.val + 1 = topClockSpan n := by
            have hk := k.isLt
            omega
          exact ⟨k,
            topFreshTailFirstBorderSpatialBarrierPortBlocked
              ring C s hn hbad Z root k sample
              hbarrier hterminal e hsite
              (hblockIfTerminal hsite hterminal),
            Or.inl rfl⟩
      · have hahead : k.val < j.val := by omega
        exact ⟨k,
          topFreshTailFirstBorderSpatialBarrierAheadStep
            ring C s hn hbad Z root k sample
            hbarrier j hahead e hsite,
          Or.inl rfl⟩
  · by_cases hincoming :
        ∃ j : Fin (topClockSpan n),
          ring.rightNeighbor e = certSite s j.val
    · obtain ⟨j, htarget⟩ := hincoming
      by_cases hjzero : j.val = 0
      · have hzeroIncoming :
            ring.rightNeighbor e = certSite s 0 := by
          rw [htarget, hjzero]
        by_cases hkzero : k.val = 0
        · exact ⟨k,
            topFreshTailFirstBorderSpatialBarrierBorderIncoming
              ring C s hn hbad hl Z root k sample
              hbarrier hkzero e
              (by rw [hkzero]; exact hzeroIncoming),
            Or.inl rfl⟩
        · have hkpositive : 0 < k.val := by omega
          exact ⟨k,
            topFreshTailFirstBorderSpatialBarrierIncomingZero
              ring C s hn hbad hl Z root k sample
              hbarrier hkpositive e hzeroIncoming,
            Or.inl rfl⟩
      · have hjpositive : 0 < j.val := by omega
        have hpredecessor :=
          topFreshTailCausalIncomingPredecessor
            ring hn s j hjpositive e htarget
        have hprevBound : j.val - 1 < topClockSpan n := by
          have hj := j.isLt
          omega
        exact False.elim (hsource
          ⟨(⟨j.val - 1, hprevBound⟩ :
             Fin (topClockSpan n)), hpredecessor⟩)
    · have hawaySource :
          ∀ j : Fin (topClockSpan n),
            certSite s j.val ≠ e := by
          intro j h
          exact hsource ⟨j, h.symm⟩
      have hawayTarget :
          ∀ j : Fin (topClockSpan n),
            certSite s j.val ≠ ring.rightNeighbor e := by
        intro j h
        exact hincoming ⟨j, h.symm⟩
      exact ⟨k,
        topFreshTailFirstBorderSpatialBarrierAwayStep
          ring C s hn hbad Z root k sample
          hbarrier e hawaySource hawayTarget,
        Or.inl rfl⟩

theorem topFreshTailFirstBorderSpatialBarrierBlockedWord
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (hl : ∀ i : Fin n, (C i).l = false)
    (word : List (Fin n)) :
    ∀ (Z : TopFixedTraceState n)
      (root : TopFreshTailCarrier (topClockSpan n))
      (k : Fin (topClockSpan n))
      (sample : DigitSample (compileAdvice (ceilLogTwo n)) n),
      TopFreshTailFirstBorderSpatialBarrier
        ring C s Z root k sample →
      (∀ (pre suffix : List (Fin n))
          (e : Fin n)
          (position : Fin (topClockSpan n)),
        word = pre ++ e :: suffix →
        TopFreshTailFirstBorderSpatialBarrier
          ring C s
          (pre.foldl (topFixedTraceNext ring C) Z)
          root position sample →
        e = certSite s position.val →
        position.val + 1 = topClockSpan n →
        ((pre.foldl (topFixedTraceNext ring C) Z).1.1
          (ring.rightNeighbor e)).qIn.isE = false ∨
        ((pre.foldl (topFixedTraceNext ring C) Z).1.1
          (ring.rightNeighbor e)).qCarry.isOff = false) →
      ∃ finalPosition : Fin (topClockSpan n),
        TopFreshTailFirstBorderSpatialBarrier
          ring C s
          (word.foldl (topFixedTraceNext ring C) Z)
          root finalPosition sample ∧
        k.val ≤ finalPosition.val := by
  induction word with
  | nil =>
      intro Z root k sample hbarrier hblocked
      exact ⟨k, hbarrier, Nat.le_refl _⟩
  | cons e rest ih =>
      intro Z root k sample hbarrier hblocked
      have hblockAtRoot :
          e = certSite s k.val →
          k.val + 1 = topClockSpan n →
          (Z.1.1 (ring.rightNeighbor e)).qIn.isE = false ∨
          (Z.1.1 (ring.rightNeighbor e)).qCarry.isOff =
            false := by
        intro hsite hterminal
        exact hblocked [] rest e k rfl
          (by simpa only [List.foldl_nil] using hbarrier)
          hsite hterminal
      obtain ⟨moved, hbarrierNext, hstep⟩ :=
        topFreshTailFirstBorderSpatialBarrierNonacceptingStep
          ring C s hn hbad hl Z root k sample
          hbarrier e hblockAtRoot
      have hblockedRest :
          ∀ (pre suffix : List (Fin n))
            (edge : Fin n)
            (position : Fin (topClockSpan n)),
            rest = pre ++ edge :: suffix →
            TopFreshTailFirstBorderSpatialBarrier
              ring C s
              (pre.foldl (topFixedTraceNext ring C)
                (topFixedTraceNext ring C Z e))
              root position sample →
            edge = certSite s position.val →
            position.val + 1 = topClockSpan n →
            ((pre.foldl (topFixedTraceNext ring C)
              (topFixedTraceNext ring C Z e)).1.1
              (ring.rightNeighbor edge)).qIn.isE = false ∨
            ((pre.foldl (topFixedTraceNext ring C)
              (topFixedTraceNext ring C Z e)).1.1
              (ring.rightNeighbor edge)).qCarry.isOff =
                false := by
        intro pre suffix edge position hdecomp hprefix
          hsite hterminal
        have hwhole :
            e :: rest = (e :: pre) ++ edge :: suffix := by
          rw [hdecomp]
          rfl
        have hprefixWhole :
            TopFreshTailFirstBorderSpatialBarrier
              ring C s
              ((e :: pre).foldl (topFixedTraceNext ring C) Z)
              root position sample := by
          change TopFreshTailFirstBorderSpatialBarrier
            ring C s
            (pre.foldl (topFixedTraceNext ring C)
              (topFixedTraceNext ring C Z e))
            root position sample
          exact hprefix
        exact hblocked (e :: pre) suffix edge position
          hwhole hprefixWhole hsite hterminal
      obtain ⟨finalPosition, hfinal, hmonotone⟩ :=
        ih (topFixedTraceNext ring C Z e) root moved sample
          hbarrierNext hblockedRest
      refine ⟨finalPosition, ?_, ?_⟩
      · change TopFreshTailFirstBorderSpatialBarrier
          ring C s
          (rest.foldl (topFixedTraceNext ring C)
            (topFixedTraceNext ring C Z e))
          root finalPosition sample
        exact hfinal
      · rcases hstep with hstay | hmove
        · rw [hstay] at hmonotone
          exact hmonotone
        · omega

theorem topFreshTailFirstBorderFreshFamilyClosedStep
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (Z : TopFixedTraceState n)
    (hqueue : TopFreshTailCausalQueue ring C s Z)
    (hfresh :
      ∀ (j : Fin (topClockSpan n))
        (a : TopFreshTailCarrier (topClockSpan n)),
        (topFreshTailGenealogy ring C s Z).slots j = some a →
        ∃ stamp : Nat, a.origin = .freshBorder stamp)
    (e : Fin n) :
    ∀ (j : Fin (topClockSpan n))
      (a : TopFreshTailCarrier (topClockSpan n)),
      (topFreshTailGenealogy ring C s
        (topFixedTraceNext ring C Z e)).slots j = some a →
      ∃ stamp : Nat, a.origin = .freshBorder stamp := by
  have hnoOld :
      ∀ (j : Fin (topClockSpan n))
        (a : TopFreshTailCarrier (topClockSpan n)),
        (topFreshTailGenealogy ring C s Z).slots j = some a →
        ((∃ i : Fin (topClockSpan n),
            a.origin = .inherited i) ∨
         (∃ i t : Fin (topClockSpan n),
            a.origin = .oldVisit i t)) →
        False := by
    intro j a hslot hold
    obtain ⟨stamp, hfreshOrigin⟩ := hfresh j a hslot
    rcases hold with ⟨i, hi⟩ | ⟨i, t, ht⟩
    · rw [hfreshOrigin] at hi
      cases hi
    · rw [hfreshOrigin] at ht
      cases ht
  have hnoOldNext :
      ∀ (j : Fin (topClockSpan n))
        (a : TopFreshTailCarrier (topClockSpan n)),
        (topFreshTailGenealogy ring C s
          (topFixedTraceNext ring C Z e)).slots j = some a →
        ((∃ i : Fin (topClockSpan n),
            a.origin = .inherited i) ∨
         (∃ i t : Fin (topClockSpan n),
            a.origin = .oldVisit i t)) →
        False := by
    intro j a hnew hold
    by_cases hbornOld : a.born ≤ Z.1.2.clock
    · have hghostBirth :
          a.born ≤
            (topFreshTailGenealogy ring C s Z).trace.1.2.clock := by
        rw [hqueue.trace.2]
        exact hbornOld
      have hstep := hnew
      rw [topFreshTailCausalReplayNext] at hstep
      rcases topFreshTailCausalOlderCarrierPlacementExact
          ring C s (topFreshTailGenealogy ring C s Z)
          e j a hstep hghostBirth with
        hstay | ⟨_, _, hprevious, _⟩
      · exact hnoOld j a hstay hold
      · exact hnoOld
          (⟨j.val - 1,
            show j.val - 1 < topClockSpan n by omega⟩ :
            Fin (topClockSpan n))
          a hprevious hold
    · have hqueueNext :=
        topFreshTailCausalQueueStep
          ring C s hn hbad Z e hqueue
      have hage := hqueueNext.age j a hnew
      have hclock :
          (topFixedTraceNext ring C Z e).1.2.clock =
            Z.1.2.clock + 1 := rfl
      rw [hclock] at hage
      have hbornNew : a.born = Z.1.2.clock + 1 := by
        omega
      have hbornGhost :
          a.born =
            (topFreshTailGenealogy ring C s Z).trace.1.2.clock + 1 := by
        rw [hqueue.trace.2]
        exact hbornNew
      have hghostAge :
          ∀ (i : Fin (topClockSpan n))
            (parent : TopFreshTailCarrier (topClockSpan n)),
            (topFreshTailGenealogy ring C s Z).slots i =
              some parent →
            parent.born ≤
              (topFreshTailGenealogy ring C s Z).trace.1.2.clock := by
        intro i parent hslot
        rw [hqueue.trace.2]
        exact hqueue.age i parent hslot
      have hstep := hnew
      rw [topFreshTailCausalReplayNext] at hstep
      obtain ⟨parent, hparentSlot, hparentOld, _, _⟩ :=
        topFreshTailFirstBorderOldVisitNewborn
          ring C s (topFreshTailGenealogy ring C s Z)
          e hghostAge j a hstep hbornGhost hold
      exact hnoOld j parent hparentSlot hparentOld
  intro j a hnew
  cases horigin : a.origin with
  | freshBorder stamp =>
      exact ⟨stamp, rfl⟩
  | inherited i =>
      exact False.elim
        (hnoOldNext j a hnew (Or.inl ⟨i, horigin⟩))
  | oldVisit i t =>
      exact False.elim
        (hnoOldNext j a hnew (Or.inr ⟨i, t, horigin⟩))

theorem topFreshTailFirstBorderFreshFamilyClosedWord
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (word : List (Fin n)) :
    ∀ (Z : TopFixedTraceState n),
      TopFreshTailCausalQueue ring C s Z →
      (∀ (j : Fin (topClockSpan n))
        (a : TopFreshTailCarrier (topClockSpan n)),
        (topFreshTailGenealogy ring C s Z).slots j = some a →
        ∃ stamp : Nat, a.origin = .freshBorder stamp) →
      ∀ (j : Fin (topClockSpan n))
        (a : TopFreshTailCarrier (topClockSpan n)),
        (topFreshTailGenealogy ring C s
          (word.foldl (topFixedTraceNext ring C) Z)).slots j =
            some a →
        ∃ stamp : Nat, a.origin = .freshBorder stamp := by
  induction word with
  | nil =>
      intro Z hqueue hfresh
      exact hfresh
  | cons e rest ih =>
      intro Z hqueue hfresh
      change
        ∀ (j : Fin (topClockSpan n))
          (a : TopFreshTailCarrier (topClockSpan n)),
          (topFreshTailGenealogy ring C s
            (rest.foldl (topFixedTraceNext ring C)
              (topFixedTraceNext ring C Z e))).slots j =
                some a →
          ∃ stamp : Nat, a.origin = .freshBorder stamp
      exact ih (topFixedTraceNext ring C Z e)
        (topFreshTailCausalQueueStep
          ring C s hn hbad Z e hqueue)
        (topFreshTailFirstBorderFreshFamilyClosedStep
          ring C s hn hbad Z hqueue hfresh e)

theorem topFreshTailFirstBorderAcceptedNoFutureOld
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (Z : TopFixedTraceState n)
    (root : TopFreshTailCarrier (topClockSpan n))
    (k : Fin (topClockSpan n))
    (sample : DigitSample (compileAdvice (ceilLogTwo n)) n)
    (hbarrier :
      TopFreshTailFirstBorderSpatialBarrier
        ring C s Z root k sample)
    (hterminal : k.val + 1 = topClockSpan n)
    (e : Fin n)
    (hsite : e = certSite s k.val)
    (hxi : (Z.1.1 e).qIn = .E)
    (hxc : (Z.1.1 e).qCarry = .OFF)
    (hyi : (Z.1.1 (ring.rightNeighbor e)).qIn = .E)
    (hyc : (Z.1.1 (ring.rightNeighbor e)).qCarry = .OFF)
    (exported : DigitExport (compileAdvice (ceilLogTwo n)) n)
    (hevent :
      topFreshTailGenealogyPortExport ring C s Z e =
        some exported)
    (word : List (Fin n)) :
    ∀ (j : Fin (topClockSpan n))
      (a : TopFreshTailCarrier (topClockSpan n)),
      (topFreshTailGenealogy ring C s
        (word.foldl (topFixedTraceNext ring C)
          (topFixedTraceNext ring C Z e))).slots j = some a →
      ∃ stamp : Nat, a.origin = .freshBorder stamp := by
  obtain ⟨_, _, _, _, _, hpostFresh⟩ :=
    topFreshTailFirstBorderAcceptedFreshOccupancy
      ring C s hn hbad Z root k sample hbarrier
      hterminal e hsite hxi hxc hyi hyc exported hevent
  have hfresh :
      ∀ (j : Fin (topClockSpan n))
        (a : TopFreshTailCarrier (topClockSpan n)),
        (topFreshTailGenealogy ring C s
          (topFixedTraceNext ring C Z e)).slots j = some a →
        ∃ stamp : Nat, a.origin = .freshBorder stamp := by
    intro j a hslot
    obtain ⟨carrier, hcarrier, hfresh, _⟩ := hpostFresh j
    rw [hcarrier] at hslot
    have heq : a = carrier :=
      (Option.some.inj hslot).symm
    rw [heq]
    exact hfresh
  exact topFreshTailFirstBorderFreshFamilyClosedWord
    ring C s hn hbad word
    (topFixedTraceNext ring C Z e)
    (topFreshTailCausalQueueStep
      ring C s hn hbad Z e hbarrier.queue)
    hfresh

theorem topFreshTailPostAnchorFreshReceiptForEveryPrefix
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (Z : TopFixedTraceState n)
    (hqueue : TopFreshTailCausalQueue ring C s Z)
    (hfresh :
      ∀ (j : Fin (topClockSpan n))
        (a : TopFreshTailCarrier (topClockSpan n)),
        (topFreshTailGenealogy ring C s Z).slots j = some a →
        ∃ stamp : Nat, a.origin = .freshBorder stamp)
    (pfx : List (Fin n))
    (atom : Option (DigitAtom n))
    (hready :
      topClockPortReady s atom
        (pfx.foldl (topFixedTraceNext ring C) Z))
    (e : Fin n)
    (exported : DigitExport (compileAdvice (ceilLogTwo n)) n)
    (hevent :
      topFreshTailGenealogyPortExport ring C s
        (pfx.foldl (topFixedTraceNext ring C) Z) e =
          some exported) :
    ∃ (k : Fin (topClockSpan n))
      (sample : DigitSample (compileAdvice (ceilLogTwo n)) n),
      DigitRecordedSample
        (topFixedTraceNext ring C
          (pfx.foldl (topFixedTraceNext ring C) Z)
          e).1.2 sample ∧
      DigitRecordedExport
        (topFixedTraceNext ring C
          (pfx.foldl (topFixedTraceNext ring C) Z)
          e).1.2 exported ∧
      sample.id.lane = .comparison ∧
      sample.id.site = certSite s k.val ∧
      exported.operand = some (.sampled sample.id) ∧
      exported.value = sample.value ∧
      exported.tail = sample.tail := by
  have hqueuePrefix :=
    topFreshTailCausalQueueRunFromCut
      ring C s hn hbad Z hqueue pfx
  have hfreshPrefix :=
    topFreshTailFirstBorderFreshFamilyClosedWord
      ring C s hn hbad pfx Z hqueue hfresh
  obtain ⟨carrier, hslot, _⟩ :=
    topFreshTailCloseReadyCarrier
      ring C s hn hbad
      (pfx.foldl (topFixedTraceNext ring C) Z)
      hqueuePrefix.trace.1 atom hready
  have hterminalFresh :
      ∃ stamp : Nat, carrier.origin = .freshBorder stamp := by
    exact hfreshPrefix
      (⟨topClockSpan n - 1,
        show topClockSpan n - 1 < topClockSpan n by
          have hr := cert_rho_ge_three n hn
          change 3 ≤ topClockSpan n at hr
          omega⟩ : Fin (topClockSpan n))
      carrier hslot
  exact topFreshTailPostAnchorFreshReceiptFields
    ring C s hn hbad
    (pfx.foldl (topFixedTraceNext ring C) Z)
    hqueuePrefix.trace.1 atom hready e exported
    hevent carrier hslot hterminalFresh

/-- The fixed-public trace retains each committed digit
of the entrance C at every reached cut. The induction is on
the actual topFixedTraceRun scheduler fold.
Consumer: J5 stationary-home sample/value fidelity. -/
theorem topFreshTailFirstBorderReachedDigit
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n)
    (Z : TopFixedTraceState n)
    (hreach : topClockReached ring C Z)
    (i : Fin n) :
    (Z.1.1 i).d = (C i).d := by
  have hfold :
      ∀ (word : List (Fin n)) (F : TopFixedTraceState n),
        (F.1.1 i).d = (C i).d →
        ((word.foldl (topFixedTraceNext ring C) F).1.1 i).d =
          (C i).d := by
    intro word
    induction word with
    | nil =>
        intro F h
        exact h
    | cons edge rest ih =>
        intro F _
        change
          ((rest.foldl (topFixedTraceNext ring C)
            (topFixedTraceNext ring C F edge)).1.1 i).d =
              (C i).d
        exact ih (topFixedTraceNext ring C F edge) rfl
  have hrun :=
    hfold Z.2 ((C, digitAuditInitial (piD C)), []) rfl
  change
    ((topFixedTraceRun ring C Z.2).1.1 i).d = (C i).d
    at hrun
  rw [← hreach] at hrun
  exact hrun

/-- A source-home carrier is fresh. If it is a D, its
comparison output atom witnesses a real sample from the
same home offset, with exactly the frozen digit and marker.
Every positive-offset child has an exact rearm carrier
identity from the tracked root with its own birth stamp.
Consumer: J5 source-home staircase and later cohort order. -/
def TopFreshTailFirstBorderHomeSlot
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (Z : TopFixedTraceState n)
    (root : TopFreshTailCarrier (topClockSpan n))
    (j : Fin (topClockSpan n)) : Prop :=
  ∃ carrier : TopFreshTailCarrier (topClockSpan n),
    (topFreshTailGenealogy ring C s Z).slots j = some carrier ∧
    (∃ stamp : Nat, carrier.origin = .freshBorder stamp) ∧
    (0 < j.val →
      ∃ birth : Nat,
        carrier = topFreshTailGenealogyRearm j birth root) ∧
    ((Z.1.1 (certSite s j.val)).qOut = .U ∨
      ∃ localSample :
        DigitSample (compileAdvice (ceilLogTwo n)) n,
        (Z.1.1 (certSite s j.val)).qOut =
          .D (C (certSite s j.val)).d
            (if j.val = 0 then true else false) ∧
        DigitRecordedSample Z.1.2 localSample ∧
        localSample.id.lane = .comparison ∧
        localSample.id.site = certSite s j.val ∧
        localSample.value = (C (certSite s j.val)).d ∧
        localSample.tail = (if j.val = 0 then true else false) ∧
        (Z.1.2.current
          (certSite s j.val)).comparison.out.atom =
          some (.sampled localSample.id))

/-- The strengthened root barrier uses the exact prior
spatial invariants and adds one stationary-home sample
certificate for EACH source site strictly behind the
moving root. Each such site is occupied by its own child:
a sampled D cannot have moved from another home.
Consumer: J5 first root, exhaustion, and renewal waves. -/
structure TopFreshTailFirstBorderHomeBarrier
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (Z : TopFixedTraceState n)
    (root : TopFreshTailCarrier (topClockSpan n))
    (k : Fin (topClockSpan n))
    (sample : DigitSample (compileAdvice (ceilLogTwo n)) n) :
    Prop where
  spatial :
    TopFreshTailFirstBorderSpatialBarrier
      ring C s Z root k sample
  home :
    ∀ j : Fin (topClockSpan n), j.val < k.val →
      TopFreshTailFirstBorderHomeSlot
        ring C s Z root j

/-- The real source-zero U-to-D root birth installs the
strong home barrier. At birth the root occupies offset 0
and the stationary-home segment has no sites.
Consumer: J5 enhanced barrier initial row. -/
theorem topFreshTailFirstBorderHomeBarrierInitial
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (Z : TopFixedTraceState n)
    (hreach : topClockReached ring C Z)
    (e : Fin n)
    (hborder : e = certSite s 0)
    (hunread : (Z.1.1 e).qOut = .U) :
    ∃ sample : DigitSample (compileAdvice (ceilLogTwo n)) n,
      TopFreshTailFirstBorderHomeBarrier
        ring C s (topFixedTraceNext ring C Z e)
        { origin := .freshBorder (Z.1.2.clock + 1),
          born := Z.1.2.clock + 1 }
        (⟨0, show 0 < topClockSpan n by
          have hr := cert_rho_ge_three n hn
          change 3 ≤ topClockSpan n at hr
          omega⟩ : Fin (topClockSpan n))
        sample := by
  obtain ⟨sample, hspatial⟩ :=
    topFreshTailFirstBorderSpatialBarrierInitial
      ring C s hn hbad Z hreach e hborder hunread
  refine ⟨sample, {
    spatial := hspatial
    home := ?_ }⟩
  intro j hj
  have hnone : False := by
    change j.val < 0 at hj
    omega
  exact False.elim hnone

/-- Every selected physical edge outside both endpoints of
a home site frames its carrier and output byte and preserves
the exact recorded sample and atom if that home is D.
This uses the OLD audit, not a new claim about ticket time.
Consumer: home staircase under root motion and remote rows. -/
theorem topFreshTailFirstBorderHomeSlotAway
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (Z : TopFixedTraceState n)
    (root : TopFreshTailCarrier (topClockSpan n))
    (j : Fin (topClockSpan n)) (e : Fin n)
    (hqueue : TopFreshTailCausalQueue ring C s Z)
    (hhome :
      TopFreshTailFirstBorderHomeSlot ring C s Z root j)
    (hsource : certSite s j.val ≠ e)
    (htarget :
      certSite s j.val ≠ ring.rightNeighbor e) :
    TopFreshTailFirstBorderHomeSlot
      ring C s (topFixedTraceNext ring C Z e) root j := by
  unfold TopFreshTailFirstBorderHomeSlot at hhome ⊢
  obtain ⟨carrier, hslot, hfresh, hparentOrigin, hkind⟩ := hhome
  have hframe :=
    topFreshTailCausalOffPairSlotAgreement
      ring C s Z e hqueue j hsource htarget
  refine ⟨carrier, ?_, hfresh, hparentOrigin, ?_⟩
  · rw [hframe.2]
    exact hslot
  · rcases hkind with hunread |
      ⟨localSample, hdata, hrecord, hlane, hsite,
       hvalue, htail, hatom⟩
    · exact Or.inl (hframe.1.trans hunread)
    · have hatomFrame :
          ((topFixedTraceNext ring C Z e).1.2.current
            (certSite s j.val)).comparison.out.atom =
            (Z.1.2.current
              (certSite s j.val)).comparison.out.atom := by
        change
          ((digitAuditStep ring (piD Z.1.1) Z.1.2 e).current
            (certSite s j.val)).comparison.out.atom =
          (Z.1.2.current
            (certSite s j.val)).comparison.out.atom
        simp only [digitAuditStep, digitGhostStep,
          if_neg hsource, if_neg htarget]
      exact Or.inr ⟨localSample,
        hframe.1.trans hdata,
        digitRecordedSampleStep
          ring (piD Z.1.1) Z.1.2 e localSample hrecord,
        hlane, hsite, hvalue, htail,
        hatomFrame.trans hatom⟩

theorem topFreshTailFirstBorderHomeSlotIncoming
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hl : ∀ i : Fin n, (C i).l = false)
    (Z : TopFixedTraceState n)
    (root : TopFreshTailCarrier (topClockSpan n))
    (j : Fin (topClockSpan n))
    (e : Fin n)
    (hqueue : TopFreshTailCausalQueue ring C s Z)
    (hhome :
      TopFreshTailFirstBorderHomeSlot ring C s Z root j)
    (htarget :
      ring.rightNeighbor e = certSite s j.val) :
    TopFreshTailFirstBorderHomeSlot
      ring C s (topFixedTraceNext ring C Z e) root j := by
  unfold TopFreshTailFirstBorderHomeSlot at hhome ⊢
  obtain ⟨carrier, hslot, hfresh, hparent, hkind⟩ := hhome
  rcases hkind with hunread |
    ⟨localSample, hdata, hrecord, hlane,
     hsite, hvalue, htail, hatom⟩
  · obtain ⟨hnewU, hnewSlot⟩ :=
      topFreshTailFirstBorderIncomingUnreadFrame
        ring C s hn Z e hqueue hl j
        htarget hunread carrier hslot
    exact ⟨carrier, hnewSlot, hfresh, hparent,
      Or.inl hnewU⟩
  · obtain ⟨hnewData, hnewSlot, hatomFrame⟩ :=
      topFreshTailFirstBorderIncomingDataFrame
        ring C s hn Z e hqueue hl j htarget
        (C (certSite s j.val)).d
        (if j.val = 0 then true else false)
        hdata carrier hslot
    exact ⟨carrier, hnewSlot, hfresh, hparent,
      Or.inr ⟨localSample, hnewData,
        digitRecordedSampleStep
          ring (piD Z.1.1) Z.1.2 e
          localSample hrecord,
        hlane, hsite, hvalue, htail,
        hatomFrame.trans hatom⟩⟩

/-- An occupied right-hand source slot blocks a sampled
fresh D in its home, retaining the recorded sample ID,
frozen value, true/false delimiter and child identity.
Consumer: J5 stationary-home blocked child row. -/
theorem topFreshTailFirstBorderHomeSlotOccupied
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (Z : TopFixedTraceState n)
    (root : TopFreshTailCarrier (topClockSpan n))
    (j : Fin (topClockSpan n))
    (e : Fin n)
    (hqueue : TopFreshTailCausalQueue ring C s Z)
    (hhome :
      TopFreshTailFirstBorderHomeSlot ring C s Z root j)
    (hsite : e = certSite s j.val)
    (hnext : j.val + 1 < topClockSpan n)
    (hoccupied :
      (Z.1.1 (ring.rightNeighbor e)).qOut ≠ .E)
    (localSample :
      DigitSample (compileAdvice (ceilLogTwo n)) n)
    (hdata :
      (Z.1.1 (certSite s j.val)).qOut =
        .D (C (certSite s j.val)).d
          (if j.val = 0 then true else false))
    (hrecord : DigitRecordedSample Z.1.2 localSample)
    (hlane : localSample.id.lane = .comparison)
    (hsampleSite : localSample.id.site = certSite s j.val)
    (hvalue : localSample.value = (C (certSite s j.val)).d)
    (htail :
      localSample.tail = (if j.val = 0 then true else false))
    (hatom :
      (Z.1.2.current (certSite s j.val)).comparison.out.atom =
        some (.sampled localSample.id)) :
    TopFreshTailFirstBorderHomeSlot
      ring C s (topFixedTraceNext ring C Z e) root j := by
  unfold TopFreshTailFirstBorderHomeSlot at hhome ⊢
  obtain ⟨carrier, hslot, hfresh, hparent, _⟩ := hhome
  have hsource :
      (Z.1.1 e).qOut =
        .D (C (certSite s j.val)).d
          (if j.val = 0 then true else false) := by
    rw [hsite]
    exact hdata
  obtain ⟨hdataNext, hslotNext, hatomFrame, hfreshNext⟩ :=
    topFreshTailFirstBorderFreshOccupiedInteriorStep
      ring C s hn hbad Z e hqueue j hnext hsite
      (C (certSite s j.val)).d
      (if j.val = 0 then true else false)
      hsource hoccupied carrier hslot hfresh
  exact ⟨carrier, hslotNext, hfreshNext, hparent,
    Or.inr ⟨localSample, hdataNext,
      digitRecordedSampleStep
        ring (piD Z.1.1) Z.1.2 e
        localSample hrecord,
      hlane, hsampleSite, hvalue, htail,
      hatomFrame.trans hatom⟩⟩

theorem topFreshTailFirstBorderHomeBarrierFrame
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (Z : TopFixedTraceState n)
    (root : TopFreshTailCarrier (topClockSpan n))
    (k : Fin (topClockSpan n))
    (sample : DigitSample (compileAdvice (ceilLogTwo n)) n)
    (hbarrier :
      TopFreshTailFirstBorderHomeBarrier
        ring C s Z root k sample)
    (e : Fin n)
    (hspatialNext :
      TopFreshTailFirstBorderSpatialBarrier
        ring C s (topFixedTraceNext ring C Z e)
        root k sample)
    (haway :
      ∀ j : Fin (topClockSpan n), j.val < k.val →
        certSite s j.val ≠ e ∧
        certSite s j.val ≠ ring.rightNeighbor e) :
    TopFreshTailFirstBorderHomeBarrier
      ring C s (topFixedTraceNext ring C Z e)
      root k sample := by
  refine { spatial := hspatialNext, home := ?_ }
  intro j hj
  obtain ⟨hsource, htarget⟩ := haway j hj
  exact topFreshTailFirstBorderHomeSlotAway
    ring C s Z root j e hbarrier.spatial.queue
    (hbarrier.home j hj) hsource htarget

/-- A remote edge outside all source vertices and their
responders preserves the enhanced home staircase.
Consumer: J5 off-source and target-only frame rows. -/
theorem topFreshTailFirstBorderHomeBarrierAwayStep
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (Z : TopFixedTraceState n)
    (root : TopFreshTailCarrier (topClockSpan n))
    (k : Fin (topClockSpan n))
    (sample : DigitSample (compileAdvice (ceilLogTwo n)) n)
    (hbarrier :
      TopFreshTailFirstBorderHomeBarrier
        ring C s Z root k sample)
    (e : Fin n)
    (hsource :
      ∀ j : Fin (topClockSpan n), certSite s j.val ≠ e)
    (htarget :
      ∀ j : Fin (topClockSpan n),
        certSite s j.val ≠ ring.rightNeighbor e) :
    TopFreshTailFirstBorderHomeBarrier
      ring C s (topFixedTraceNext ring C Z e)
      root k sample := by
  apply topFreshTailFirstBorderHomeBarrierFrame
    ring C s Z root k sample hbarrier e
    (topFreshTailFirstBorderSpatialBarrierAwayStep
      ring C s hn hbad Z root k sample
      hbarrier.spatial e hsource htarget)
  intro j _
  exact ⟨hsource j, htarget j⟩

/-- Any OLD selected source ahead of the live fresh root
cannot touch a stationary home behind it. In particular
the old true-tail port-rearm and accepted old-port rows
do not change these local recorded samples.
Consumer: J5 old-family front services. -/
theorem topFreshTailFirstBorderHomeBarrierAheadStep
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (Z : TopFixedTraceState n)
    (root : TopFreshTailCarrier (topClockSpan n))
    (k : Fin (topClockSpan n))
    (sample : DigitSample (compileAdvice (ceilLogTwo n)) n)
    (hbarrier :
      TopFreshTailFirstBorderHomeBarrier
        ring C s Z root k sample)
    (j : Fin (topClockSpan n))
    (hahead : k.val < j.val)
    (e : Fin n)
    (hsite : e = certSite s j.val) :
    TopFreshTailFirstBorderHomeBarrier
      ring C s (topFixedTraceNext ring C Z e)
      root k sample := by
  apply topFreshTailFirstBorderHomeBarrierFrame
    ring C s Z root k sample hbarrier e
    (topFreshTailFirstBorderSpatialBarrierAheadStep
      ring C s hn hbad Z root k sample
      hbarrier.spatial j hahead e hsite)
  intro i hbehind
  have hearlier : i.val < j.val := by omega
  exact topFreshTailFirstBorderEarlierSiteOffSelectedPair
    ring s hn i j hearlier e hsite

/-- When the moving root faces an occupied OLD nonmarker
responder, its D and the stationary homes are both blocked
and retain their real sample records.
Consumer: J5 root interior occupied row. -/
theorem topFreshTailFirstBorderHomeBarrierOccupiedStep
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (Z : TopFixedTraceState n)
    (root : TopFreshTailCarrier (topClockSpan n))
    (k : Fin (topClockSpan n))
    (sample : DigitSample (compileAdvice (ceilLogTwo n)) n)
    (hbarrier :
      TopFreshTailFirstBorderHomeBarrier
        ring C s Z root k sample)
    (e : Fin n)
    (hsite : e = certSite s k.val)
    (hnext : k.val + 1 < topClockSpan n)
    (hoccupied :
      (Z.1.1 (ring.rightNeighbor e)).qOut ≠ .E) :
    TopFreshTailFirstBorderHomeBarrier
      ring C s (topFixedTraceNext ring C Z e)
      root k sample := by
  apply topFreshTailFirstBorderHomeBarrierFrame
    ring C s Z root k sample hbarrier e
    (topFreshTailFirstBorderSpatialBarrierOccupiedStep
      ring C s hn hbad Z root k sample
      hbarrier.spatial e hsite hnext hoccupied)
  intro j hbelow
  exact topFreshTailFirstBorderEarlierSiteOffSelectedPair
    ring s hn j k hbelow e hsite

/-- A blocked selected true-tail terminal root cannot
destroy, move or alter the recorded sample at any home
behind it. The stationary suffix remains unchanged while
the target port input/carry clears independently.
Consumer: J5 terminal blocked port row. -/
theorem topFreshTailFirstBorderHomeBarrierPortBlocked
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (Z : TopFixedTraceState n)
    (root : TopFreshTailCarrier (topClockSpan n))
    (k : Fin (topClockSpan n))
    (sample : DigitSample (compileAdvice (ceilLogTwo n)) n)
    (hbarrier :
      TopFreshTailFirstBorderHomeBarrier
        ring C s Z root k sample)
    (hterminal : k.val + 1 = topClockSpan n)
    (e : Fin n)
    (hsite : e = certSite s k.val)
    (hblocked :
      (Z.1.1 (ring.rightNeighbor e)).qIn.isE = false ∨
      (Z.1.1 (ring.rightNeighbor e)).qCarry.isOff = false) :
    TopFreshTailFirstBorderHomeBarrier
      ring C s (topFixedTraceNext ring C Z e)
      root k sample := by
  apply topFreshTailFirstBorderHomeBarrierFrame
    ring C s Z root k sample hbarrier e
    (topFreshTailFirstBorderSpatialBarrierPortBlocked
      ring C s hn hbad Z root k sample
      hbarrier.spatial hterminal e hsite hblocked)
  intro j hbelow
  exact topFreshTailFirstBorderEarlierSiteOffSelectedPair
    ring s hn j k hbelow e hsite

/-- A leader-free incoming edge to source zero at the
instant of the first root birth cannot touch any home
behind the root, since there are none. The root D itself
is protected by the actual incoming-responder D frame.
Consumer: stationary-home border-incoming OLD row. -/
theorem topFreshTailFirstBorderHomeBarrierBorderIncoming
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (hl : ∀ i : Fin n, (C i).l = false)
    (Z : TopFixedTraceState n)
    (root : TopFreshTailCarrier (topClockSpan n))
    (k : Fin (topClockSpan n))
    (sample : DigitSample (compileAdvice (ceilLogTwo n)) n)
    (hbarrier :
      TopFreshTailFirstBorderHomeBarrier
        ring C s Z root k sample)
    (hzero : k.val = 0)
    (e : Fin n)
    (hincoming : ring.rightNeighbor e = certSite s k.val) :
    TopFreshTailFirstBorderHomeBarrier
      ring C s (topFixedTraceNext ring C Z e)
      root k sample := by
  refine {
    spatial :=
      topFreshTailFirstBorderSpatialBarrierBorderIncoming
        ring C s hn hbad hl Z root k sample
        hbarrier.spatial hzero e hincoming
    home := ?_ }
  intro j hj
  have hnone : False := by
    rw [hzero] at hj
    omega
  exact False.elim hnone

/-- Outside-to-source-zero incoming service after the root
has advanced preserves the local U/D witness at home zero;
every positive stationary home is off both physical
endpoints. No carrier may be imported from outside the
fixed source arc. Consumer: J5 source-zero boundary row. -/
theorem topFreshTailFirstBorderHomeBarrierIncomingZero
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (hl : ∀ i : Fin n, (C i).l = false)
    (Z : TopFixedTraceState n)
    (root : TopFreshTailCarrier (topClockSpan n))
    (k : Fin (topClockSpan n))
    (sample : DigitSample (compileAdvice (ceilLogTwo n)) n)
    (hbarrier :
      TopFreshTailFirstBorderHomeBarrier
        ring C s Z root k sample)
    (hpositive : 0 < k.val)
    (e : Fin n)
    (hincoming :
      ring.rightNeighbor e = certSite s 0) :
    TopFreshTailFirstBorderHomeBarrier
      ring C s (topFixedTraceNext ring C Z e)
      root k sample := by
  have hawaySource :=
    topFreshTailFirstBorderIncomingZeroOutsideSource
      ring s hn e hincoming
  have hwidth : 0 < topClockSpan n := by
    have hr := cert_rho_ge_three n hn
    change 3 ≤ topClockSpan n at hr
    omega
  have htargetDifferent :
      ∀ j : Fin (topClockSpan n), 0 < j.val →
        certSite s j.val ≠ ring.rightNeighbor e := by
    intro j hj
    rw [hincoming]
    intro heq
    have hindex :=
      topFreshTailCausalSourceSiteInjective
        s hn j (⟨0, hwidth⟩ : Fin (topClockSpan n)) heq
    have hvalue := congrArg Fin.val hindex
    change j.val = 0 at hvalue
    omega
  refine {
    spatial :=
      topFreshTailFirstBorderSpatialBarrierIncomingZero
        ring C s hn hbad hl Z root k sample
        hbarrier.spatial hpositive e hincoming
    home := ?_ }
  intro j hj
  by_cases hzero : j.val = 0
  · have hsite : ring.rightNeighbor e = certSite s j.val := by
      rw [hzero]
      exact hincoming
    exact topFreshTailFirstBorderHomeSlotIncoming
      ring C s hn hl Z root j e
      hbarrier.spatial.queue
      (hbarrier.home j hj) hsite
  · exact topFreshTailFirstBorderHomeSlotAway
      ring C s Z root j e hbarrier.spatial.queue
      (hbarrier.home j hj)
      (hawaySource j)
      (htargetDifferent j (by omega))



theorem topFreshTailFirstBorderAcceptedHomeStaircase
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (hn : 5 ≤ n)
    (hbad : HeadlineDigit.BadCompletePair C s)
    (Z : TopFixedTraceState n)
    (root : TopFreshTailCarrier (topClockSpan n))
    (k : Fin (topClockSpan n))
    (sample : DigitSample (compileAdvice (ceilLogTwo n)) n)
    (hbarrier :
      TopFreshTailFirstBorderHomeBarrier
        ring C s Z root k sample)
    (hterminal : k.val + 1 = topClockSpan n)
    (e : Fin n)
    (hsite : e = certSite s k.val)
    (hxi : (Z.1.1 e).qIn = .E)
    (hxc : (Z.1.1 e).qCarry = .OFF)
    (hyi : (Z.1.1 (ring.rightNeighbor e)).qIn = .E)
    (hyc : (Z.1.1 (ring.rightNeighbor e)).qCarry = .OFF)
    (exported : DigitExport (compileAdvice (ceilLogTwo n)) n)
    (hevent :
      topFreshTailGenealogyPortExport ring C s Z e =
        some exported) :
    topClockGenuineTailAccepted C s
      (topFixedTraceNext ring C Z e) ∧
    ∀ j : Fin (topClockSpan n),
      TopFreshTailFirstBorderHomeSlot
        ring C s (topFixedTraceNext ring C Z e)
        root j := by
  have hgenuine :=
    topFreshTailFirstBorderTrackedRootGenuineOnPort
      ring C s hn hbad Z root k sample
      hbarrier.spatial hterminal e hsite
      hxi hxc hyi hyc exported hevent
  obtain ⟨_, _, _, _, hsourceU, _⟩ :=
    topFreshTailFirstBorderAcceptedFreshOccupancy
      ring C s hn hbad Z root k sample
      hbarrier.spatial hterminal e hsite
      hxi hxc hyi hyc exported hevent
  have hgeom :=
    topFreshTailCausalSourcePublicGeometry
      ring C s hn hbad Z hbarrier.spatial.queue.trace.1 k
  have hxl : (Z.1.1 e).l = false := by
    rw [hsite]
    exact hgeom.1
  have hyl :
      (Z.1.1 (ring.rightNeighbor e)).l = false := by
    rw [hsite]
    exact hgeom.2.1
  have hmarker :
      (Z.1.1 (ring.rightNeighbor e)).beta = true := by
    have hm := hgeom.2.2.2
    rw [if_pos hterminal] at hm
    rw [hsite]
    exact hm
  have hsource :
      (Z.1.1 e).qOut = .D sample.value true := by
    rw [hsite]
    exact hbarrier.spatial.rootData
  have hghost :=
    topFreshTailCausalPortDeparture
      ring (by omega : 2 ≤ n) C s
      (topFreshTailGenealogy ring C s Z)
      e k sample.value root hsite
      (by rw [hbarrier.spatial.queue.trace.2]; exact hxl)
      (by rw [hbarrier.spatial.queue.trace.2]; exact hyl)
      (by rw [hbarrier.spatial.queue.trace.2]; exact hxi)
      (by rw [hbarrier.spatial.queue.trace.2]; exact hxc)
      (by rw [hbarrier.spatial.queue.trace.2]; exact hyi)
      (by rw [hbarrier.spatial.queue.trace.2]; exact hyc)
      (by rw [hbarrier.spatial.queue.trace.2]; exact hmarker)
      (by rw [hbarrier.spatial.queue.trace.2]; exact hsource)
      hbarrier.spatial.rootSlot
  have hlast :
      (topFreshTailGenealogy ring C s
        (topFixedTraceNext ring C Z e)).slots k =
        some (topFreshTailGenealogyRearm k
          (Z.1.2.clock + 1) root) := by
    rw [topFreshTailCausalReplayNext]
    rw [hbarrier.spatial.queue.trace.2] at hghost
    exact hghost.1
  have hlastFresh :
      ∃ stamp : Nat,
        (topFreshTailGenealogyRearm k
          (Z.1.2.clock + 1) root).origin =
          .freshBorder stamp := by
    obtain ⟨stamp, hfresh⟩ := hbarrier.spatial.rootFresh
    by_cases hzero : k.val = 0
    · exact ⟨Z.1.2.clock + 1,
        by simp [topFreshTailGenealogyRearm, hzero]⟩
    · exact ⟨stamp,
        by simp [topFreshTailGenealogyRearm, hzero, hfresh]⟩
  have hlastOrigin :
      0 < k.val →
      ∃ birth : Nat,
        topFreshTailGenealogyRearm k
          (Z.1.2.clock + 1) root =
          topFreshTailGenealogyRearm k birth root := by
    intro _
    exact ⟨Z.1.2.clock + 1, rfl⟩
  refine ⟨hgenuine, ?_⟩
  intro j
  by_cases hbelow : j.val < k.val
  · obtain ⟨hawaySource, hawayTarget⟩ :=
      topFreshTailFirstBorderEarlierSiteOffSelectedPair
        ring s hn j k hbelow e hsite
    exact topFreshTailFirstBorderHomeSlotAway
      ring C s Z root j e hbarrier.spatial.queue
      (hbarrier.home j hbelow)
      hawaySource hawayTarget
  · have heq : j = k := by
      apply Fin.ext
      have hj := j.isLt
      omega
    subst j
    unfold TopFreshTailFirstBorderHomeSlot
    exact ⟨topFreshTailGenealogyRearm k
      (Z.1.2.clock + 1) root,
      hlast, hlastFresh, hlastOrigin, Or.inl hsourceU⟩


end L3

