    ((topFreshTailGenealogyStep ring C s G e).trace.1.2.current
      e).comparison.out.atom = none ∧
    ∃ exported : DigitExport (compileAdvice (ceilLogTwo n)) n,
      DigitRecordedExport
        (topFreshTailGenealogyStep ring C s G e).trace.1.2
        exported ∧
      exported.tail = false ∧
      (topFreshTailGenealogyStep ring C s G e).consumed =
        G.consumed ++
          [(G.trace.1.2.clock + 1, some parent.origin)] := by
  obtain ⟨hq, _, _, _, hs, ha, _, _, hexport⟩ :=
    topFreshTailAcceptedPortQOAllSourceScratch
      ring hn C s G e j v false parent hsite hterminal
      hneighbor hxl hyl hxb hyb hyi hyc hxo hslot
  obtain ⟨exported, _, _, _, _, _, _, _, ht, hrecord, hconsumed⟩ :=
    hexport
  exact ⟨by simpa using hq, by simpa using hs, ha,
    exported, hrecord, ht, hconsumed⟩

/-- OLD true-tail parent is serviced while its newborn oldVisit
child stays at the OLD terminal home. -/
theorem topFreshTailAcceptedPortOldTrueVisit
    {n : Nat} (ring : DirectedRing n) (hn : 5 ≤ n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (G : TopFreshTailGenealogyState n)
    (e : Fin n) (j : Fin (topClockSpan n))
    (v : Fin (compileAdvice (ceilLogTwo n)).topA)
    (parent : TopFreshTailCarrier (topClockSpan n))
    (hsite : e = certSite s j.val)
    (hterminal : j.val + 1 = topClockSpan n)
    (hneighbor :
      ring.rightNeighbor e = certSite s (topClockSpan n))
    (hxl : (G.trace.1.1 e).l = false)
    (hyl : (G.trace.1.1 (ring.rightNeighbor e)).l = false)
    (hxb : (G.trace.1.1 e).beta = false)
    (hyb : (G.trace.1.1 (ring.rightNeighbor e)).beta = true)
    (hyi : (G.trace.1.1 (ring.rightNeighbor e)).qIn = .E)
    (hyc : (G.trace.1.1 (ring.rightNeighbor e)).qCarry = .OFF)
    (hxo : (G.trace.1.1 e).qOut = .D v true)
    (hslot : G.slots j = some parent)
    (hOld :
      (∃ i : Fin (topClockSpan n), parent.origin = .inherited i) ∨
      (∃ i k : Fin (topClockSpan n),
        parent.origin = .oldVisit i k)) :
    ∃ child : TopFreshTailCarrier (topClockSpan n),
      (topFreshTailGenealogyStep ring C s G e).slots j =
        some child ∧
      (∃ i k : Fin (topClockSpan n),
        child.origin = .oldVisit i k) ∧
      child.born = G.trace.1.2.clock + 1 ∧
      ((topFreshTailGenealogyStep ring C s G e).trace.1.1
        e).qOut = .U ∧
      ∃ exported : DigitExport (compileAdvice (ceilLogTwo n)) n,
        DigitRecordedExport
          (topFreshTailGenealogyStep ring C s G e).trace.1.2
          exported ∧
        exported.tail = true ∧
        (topFreshTailGenealogyStep ring C s G e).consumed =
          G.consumed ++
            [(G.trace.1.2.clock + 1, some parent.origin)] := by
  obtain ⟨hq, _, _, _, hs, _, _, _, hexport⟩ :=
    topFreshTailAcceptedPortQOAllSourceScratch
      ring hn C s G e j v true parent hsite hterminal
      hneighbor hxl hyl hxb hyb hyi hyc hxo hslot
  have hpositive : j.val ≠ 0 := by
    have hr := cert_rho_ge_three n hn
    change 3 ≤ topClockSpan n at hr
    omega
  have hchildOld :
      ∃ i k : Fin (topClockSpan n),
        (topFreshTailGenealogyRearm j
          (G.trace.1.2.clock + 1) parent).origin =
            .oldVisit i k := by
    rcases hOld with ⟨i, hi⟩ | ⟨i, k, hk⟩
    · exact ⟨i, j, by simp [topFreshTailGenealogyRearm, hpositive, hi]⟩
    · exact ⟨i, k, by simp [topFreshTailGenealogyRearm, hpositive, hk]⟩
  obtain ⟨exported, _, _, _, _, _, _, _, ht, hrecord, hconsumed⟩ :=
    hexport
  refine ⟨topFreshTailGenealogyRearm j
    (G.trace.1.2.clock + 1) parent, ?_,
    hchildOld, rfl, ?_, exported, hrecord, ht, hconsumed⟩
  · simpa using hs
  · simpa using hq

/-- A genuinely source-zero-sampled fresh root has the exact
unread fresh terminal rearm and a matching OLD sampled export.
Consumer: first-border post-port staircase. -/
theorem topFreshTailAcceptedPortFreshRootService
    {n : Nat} (ring : DirectedRing n) (hn : 5 ≤ n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (G : TopFreshTailGenealogyState n)
    (e : Fin n) (j : Fin (topClockSpan n))
    (v : Fin (compileAdvice (ceilLogTwo n)).topA)
    (parent : TopFreshTailCarrier (topClockSpan n))
    (hsite : e = certSite s j.val)
    (hterminal : j.val + 1 = topClockSpan n)
    (hneighbor :
      ring.rightNeighbor e = certSite s (topClockSpan n))
    (hxl : (G.trace.1.1 e).l = false)
    (hyl : (G.trace.1.1 (ring.rightNeighbor e)).l = false)
    (hxb : (G.trace.1.1 e).beta = false)
    (hyb : (G.trace.1.1 (ring.rightNeighbor e)).beta = true)
    (hyi : (G.trace.1.1 (ring.rightNeighbor e)).qIn = .E)
    (hyc : (G.trace.1.1 (ring.rightNeighbor e)).qCarry = .OFF)
    (hxo : (G.trace.1.1 e).qOut = .D v true)
    (hslot : G.slots j = some parent)
    (birth : Nat) (hfresh : parent.origin = .freshBorder birth)
    (sample : DigitSample (compileAdvice (ceilLogTwo n)) n)
    (hrecord : DigitRecordedSample G.trace.1.2 sample)
    (hatom :
      (G.trace.1.2.current e).comparison.out.atom =
        some (.sampled sample.id)) :
    ((topFreshTailGenealogyStep ring C s G e).trace.1.1 e).qOut =
      .U ∧
    (topFreshTailGenealogyStep ring C s G e).slots j =
      some { origin := .freshBorder birth
             born := G.trace.1.2.clock + 1 } ∧
    ((topFreshTailGenealogyStep ring C s G e).trace.1.2.current
      e).comparison.out.atom = none ∧
    DigitRecordedSample
      (topFreshTailGenealogyStep ring C s G e).trace.1.2
      sample ∧
    ∃ exported : DigitExport (compileAdvice (ceilLogTwo n)) n,
      DigitRecordedExport
        (topFreshTailGenealogyStep ring C s G e).trace.1.2
        exported ∧
      exported.operand = some (.sampled sample.id) ∧
      exported.value = v ∧ exported.tail = true ∧
      (topFreshTailGenealogyStep ring C s G e).consumed =
        G.consumed ++
          [(G.trace.1.2.clock + 1, some parent.origin)] := by
  obtain ⟨hq, _, _, _, hs, ha, _, _, hexport⟩ :=
    topFreshTailAcceptedPortQOAllSourceScratch
      ring hn C s G e j v true parent hsite hterminal
      hneighbor hxl hyl hxb hyb hyi hyc hxo hslot
  have hpositive : j.val ≠ 0 := by
    have hr := cert_rho_ge_three n hn
    change 3 ≤ topClockSpan n at hr
    omega
  have hchild :
      topFreshTailGenealogyRearm j
        (G.trace.1.2.clock + 1) parent =
        { origin := .freshBorder birth
          born := G.trace.1.2.clock + 1 } := by
    simp [topFreshTailGenealogyRearm, hpositive, hfresh]
  have hsFresh :
      (topFreshTailGenealogyStep ring C s G e).slots j =
        some { origin := .freshBorder birth
               born := G.trace.1.2.clock + 1 } := by
    simpa [hchild] using hs
  have hrecordNext :=
    digitRecordedSampleStep ring (piD G.trace.1.1)
      G.trace.1.2 e sample hrecord
  obtain ⟨exported, _, _, _, _, _, hoperand, hvalue, htail,
    hrecordExport, hconsumed⟩ := hexport
  refine ⟨by simpa using hq, hsFresh, ha, hrecordNext,
    exported, hrecordExport, ?_, hvalue, htail, hconsumed⟩
  exact hoperand.trans hatom

/-- A real accepted comparison port appears at the END of the
filtered chronological audit list, not at its front. Consumer:
the two W current-wave accepted-port rows. -/
theorem topFreshTailAcceptedPortChronologicalAppend
    {n : Nat} (ring : DirectedRing n)
    (C : HeadlineConfiguration n) (s : Fin n)
    (Z : TopFixedTraceState n) (e : Fin n)
    (anchorTime : Nat)
    (exported : DigitExport (compileAdvice (ceilLogTwo n)) n)
    (hevent :
      topFreshTailGenealogyPortExport ring C s Z e =
        some exported)
    (hafter : anchorTime < exported.time) :
    topClockConcreteExportsAfter s
      (topFixedTraceNext ring C Z e) anchorTime =
    topClockConcreteExportsAfter s Z anchorTime ++ [exported] := by
  obtain ⟨hsite, hneighbor, _, _, _, hsource, hdestination,
