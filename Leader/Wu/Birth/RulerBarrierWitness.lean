import Leader.Wu.Birth.RulerBarrierHost
import Init.Data.Vector.OfFn

set_option autoImplicit false

namespace BirthRulerBarrier

open PPLL PPLLResearchFormulation PPLLExpiringComparisonRepair
  PPLLAuthorizedComparisonRepair PPLLNoCheckBirthOutputLegitimacy
  PPLLLeaderCreationCleanupRepair PPLLWriteSeqRulerBridge PPLLWallSweepFinite
  BirthDisposalRouteInvariant BirthMismatchDisposalProducer BirthArrivalCaptureRepair

theorem ringSixteen : DirectedRing 16 := ⟨by decide⟩

/-- A complete correct ruler relative to leader twelve. The emitting group
at fourteen has ID zero; the next group at zero has ID one. All comparison
fields start empty; WAIT must run before the actual generation event. -/
def rulerCore (i : Fin 16) : AgentState 2 :=
  { trapCore (by decide) i with
    leader := decide (i = 12)
    bit := decide (i = 1 ∨ i = 4 ∨ i = 9)
    wait := true }

theorem rulerCore_domain (kappa : Nat) (i : Fin 16) :
    (rulerCore i).inProtocolDomain kappa := by
  simpa [rulerCore, AgentState.inProtocolDomain] using
    (trapCore_domain (κ := kappa) (by decide : 0 < 2) i)

/-- No additional history or episode fields are stored in the physical state. -/
def rulerInitial (i : Fin 16) : ExpiringAgentState 2 2 64 :=
  ⟨⟨BoundedAgentState.ofDomain (rulerCore i) (rulerCore_domain 2 i), false⟩, 0⟩

theorem rulerCore_stable : isStableIDSequence (by decide) ringSixteen rulerCore := by
  refine ⟨12, by decide, by decide, ?_, ?_⟩
  · have h : ∀ k : Fin 16,
        (rulerCore ⟨(12 + k.val) % 16, by omega⟩).label = ⟨k.val % 2, by omega⟩ := by
      decide
    intro k hk
    exact h ⟨k, hk⟩
  · intro i hi hib
    have hc : i = 1 ∨ i = 2 ∨ i = 3 ∨ i = 4 ∨ i = 5 ∨ i = 6 ∨ i = 7 := by omega
    rcases hc with rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
      simp [groupID, List.range_succ, rulerCore, trailingZeros] <;> decide

theorem rulerInitial_erase : (fun i => (rulerInitial i).core.erase.core) = rulerCore := by
  funext i
  change (BoundedAgentState.ofDomain (rulerCore i) (rulerCore_domain 2 i)).erase = _
  exact BoundedAgentState.erase_ofDomain _ (rulerCore_domain 2 i)

/-- Every comparison/control field is initially empty; all source history in
the witness is generated by the literal host schedule below. -/
theorem rulerInitial_empty : ∀ i : Fin 16,
    (rulerInitial i).core.erase.core.path = .bot ∧
      (rulerInitial i).core.erase.core.path2 = none ∧
      (rulerInitial i).core.erase.core.state = .none ∧
      (rulerInitial i).core.path0Crossed = false ∧
      (rulerInitial i).core.erase.core.count = 0 ∧
      (rulerInitial i).core.erase.core.wait = true := by decide

private theorem vector_get_ofFn {n : Nat} {Q : Type} (C : Fin n → Q) :
    (Vector.ofFn C).get = C := by
  funext i
  simp [Vector.get]
  apply congrArg C
  apply Fin.ext
  rfl

/-- Evaluation cache for the unchanged finite original-scheduler semantics. -/
def cachedRun {n : Nat} {Q : Type} (ring : DirectedRing n)
    (T : Q → Q → Q × Q) : DetSchedule n → Vector Q n → Vector Q n
  | [], C => C
  | e :: rest, C => cachedRun ring T rest (Vector.ofFn (localStep ring T C.get e))

theorem cachedRun_correct {n : Nat} {Q : Type} (ring : DirectedRing n)
    (T : Q → Q → Q × Q) (C : Fin n → Q) (word : DetSchedule n) :
    (cachedRun ring T word (Vector.ofFn C)).get = runLocalSchedule ring T C word := by
  induction word generalizing C with
  | nil => exact vector_get_ofFn C
  | cons e rest ih =>
      simp only [cachedRun, vector_get_ofFn, runLocalSchedule]
      exact ih _

/-- WAIT emits at the ID-zero group fourteen/fifteen. Its coherent word then
reaches the next, strictly larger ID-one group zero/one, and is deleted there. -/
def barrierWord : DetSchedule 16 :=
  List.replicate 8 14 ++ [15, 14, 0, 15, 0, 1, 0, 15]

def barrierPrefix (t : Nat) : Fin 16 → ExpiringAgentState 2 2 64 :=
  runLocalSchedule ringSixteen (actionOneFullTransition (by decide) 2 64)
    rulerInitial (barrierWord.take t)

set_option maxRecDepth 8192 in
set_option maxHeartbeats 16000000 in
/-- The actual WAIT, GENSIG and movement events produce the source payloads
and the crossing permit. No equality or source tag is installed by hand. -/
theorem barrier_generation_and_arrival :
    (∀ t : Fin 8, ∀ i : Fin 16, (barrierPrefix t.val i).core.erase.core.path = .bot) ∧
      (barrierPrefix 7 15).core.erase.core.count = 1 ∧
      (barrierPrefix 8 15).core.erase.core.count = 2 ∧
      (barrierPrefix 8 14).core.erase.core.path = .some 0 0 ∧
      (barrierPrefix 8 15).core.erase.core.path = .some 1 0 ∧
      (barrierPrefix 8 14).core.erase.core.path2 = none ∧
      (barrierPrefix 8 15).core.erase.core.path2 = none ∧
      (barrierPrefix 12 0).core.erase.core.path = .some 0 0 ∧
      (barrierPrefix 12 1).core.erase.core.path = .some 1 0 ∧
      (barrierPrefix 12 0).core.path0Crossed = true ∧
      (barrierPrefix 12 0).core.erase.core.state = .CHECK_ready ∧
      (barrierPrefix 12 1).core.erase.core.state = .CHECK_ready := by
  unfold barrierPrefix
  simp only [← cachedRun_correct]
  decide

set_option maxRecDepth 8192 in
set_option maxHeartbeats 16000000 in
/-- The certificate is obtained from the actual prefix-twelve CHECK input,
using the physical resident and emitted bits of this correct ruler. -/
theorem barrier_actual_prefix_record :
    InspectedPrefix (by decide) (fun k => (rulerCore (groupOffset ringSixteen 14 k)).bit)
      (fun k => (rulerCore (groupOffset ringSixteen 0 k)).bit) 0
      (actualLeftInspection (by decide) 2 (barrierPrefix 12 0).core.erase
        (barrierPrefix 12 1).core.erase) := by
  apply record_actual_first
  all_goals try simp only [barrierPrefix]
  all_goals try simp only [← cachedRun_correct]
  all_goals decide

set_option maxRecDepth 8192 in
set_option maxHeartbeats 16000000 in
theorem barrier_actual_complete_inspection :
    InspectedPrefix (by decide) (fun k => (rulerCore (groupOffset ringSixteen 14 k)).bit)
      (fun k => (rulerCore (groupOffset ringSixteen 0 k)).bit) 1
      (actualRightInspection (by decide) 2 (barrierPrefix 12 0).core.erase
        (barrierPrefix 12 1).core.erase) := by
  apply record_actual_next (by decide) 2 _ _ _ _ 0 barrier_actual_prefix_record
  all_goals simp only [barrierPrefix, ← cachedRun_correct]
  all_goals decide

set_option maxRecDepth 8192 in
set_option maxHeartbeats 16000000 in
/-- The structural no-CHECK-birth consumer is also instantiated on that same
real generation and arrival, rather than on a manually supplied equal prefix. -/
theorem barrier_structural_check_no_birth :
    (actualCheckOutput (by decide) 2 (barrierPrefix 12 0).core.erase
      (barrierPrefix 12 1).core.erase).2.core.leader =
    (actualCheckInput (by decide) 2 (barrierPrefix 12 0).core.erase
      (barrierPrefix 12 1).core.erase).2.core.leader := by
  apply actual_larger_group_check_no_birth (by decide) ringSixteen rulerCore 14 0
    (by decide) 2 _ _ barrier_actual_complete_inspection
  all_goals simp only [barrierPrefix, ← cachedRun_correct]
  all_goals decide

set_option maxRecDepth 8192 in
set_option maxHeartbeats 16000000 in
/-- The general inspected-prefix theorem is instantiated on an actual run;
every current-row guard is discharged by evaluating its true host boundary. -/
theorem barrier_general_theorem_produces_due :
    DisposalDue (by decide)
      (actionOneFullTransition (by decide) 2 64 (barrierPrefix 12 0) (barrierPrefix 12 1)).2.core.erase := by
  apply actual_inspected_terminal_due (by decide) 2 64 (barrierPrefix 12 0) (barrierPrefix 12 1)
    (fun k => (rulerCore (groupOffset ringSixteen 14 k)).bit)
    (fun k => (rulerCore (groupOffset ringSixteen 0 k)).bit) 0 (by decide)
    barrier_actual_prefix_record
  · intro a ha
    have : a = 0 := by omega
    subst a
    decide
  all_goals try simp only [barrierPrefix]
  all_goals try simp only [← cachedRun_correct]
  all_goals decide

set_option maxRecDepth 8192 in
set_option maxHeartbeats 16000000 in
/-- Real outgoing pinning followed by predecessor deletion, preserving the
source-zero/target-one ruler comparison and every original leader bit. -/
theorem barrier_complete_physical_trace :
    groupID ringSixteen.hn rulerCore 14 = 0 ∧ groupID ringSixteen.hn rulerCore 0 = 1 ∧
      (barrierPrefix 13 1).core.erase.core.path2 = some ⟨0, 0, 0, 4⟩ ∧
      (barrierPrefix 14 1).core.erase.core.path = .some 1 0 ∧
      (barrierPrefix 14 1).core.erase.core.state = .eliminate_signal ∧
      (barrierPrefix 14 2).core.erase.core.path = .bot ∧
      (barrierPrefix 15 1).core.erase.core.path = .bot ∧
      (barrierPrefix 16 0).core.erase.core.path = .bot ∧
      (∀ t : Fin 17, ∀ i : Fin 16,
        (barrierPrefix t.val i).core.erase.core.leader = decide (i = 12) ∧
        (barrierPrefix t.val i).core.erase.core.bit = (rulerCore i).bit ∧
        (barrierPrefix t.val i).core.erase.core.label = (rulerCore i).label) := by
  unfold barrierPrefix
  simp only [← cachedRun_correct]
  decide

end BirthRulerBarrier
