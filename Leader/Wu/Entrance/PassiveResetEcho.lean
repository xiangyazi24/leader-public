variable {n psi : Nat}
variable {ring : DirectedRing n}


/-- Whole-ring strengthening of the B6 collar handoff. -/
def FinalResetEchoClear
    (C : Config n psi psi (16 * psi)) : Prop :=
  ∀ i : Fin n, ResetEchoClearCell (finalBase C i)


/-- The generic clean fixture initializes both Algorithm-14 traffic bits to zero. -/
theorem clean_resetEcho_clear
    (hpsi : 0 < psi) (old : Fin psi → Bool) (i : Fin psi) :
    ResetEchoClearCell (WriterProducerRegression.clean hpsi old i).base := by
  unfold ResetEchoClearCell B6Sanitation.rawCell
  simp only [WriterProducerRegression.clean,
    AuthorizedBoundedAgentState.erase, BoundedAgentState.erase]
  exact ⟨True.intro, True.intro⟩


/-- The literal passive follower fixture changes only leader/shield/gen_ws. -/
theorem quietBase_resetEcho_clear (i : Fin 3) :
    ResetEchoClearCell (QuietPairCounterexample.quietBase i) := by
  unfold ResetEchoClearCell B6Sanitation.rawCell
  simp only [QuietPairCounterexample.quietBase,
    WriterProducerRegression.clean,
    AuthorizedBoundedAgentState.erase, BoundedAgentState.erase]
  exact ⟨True.intro, True.intro⟩


/-- Pointwise family generated by the literal passive follower fixture. -/
def QuietBaseFamily (f : Fin n → Fin 3) :
    BirthCheckPermitRepairLeaf.FC n 3 3 48 :=
  fun i => QuietPairCounterexample.quietBase (f i)


theorem quietBaseFamily_resetEcho_clear (f : Fin n → Fin 3) :
    ∀ i : Fin n, ResetEchoClearCell (QuietBaseFamily f i) := by
  intro i
  exact quietBase_resetEcho_clear (f i)


/-- Any full final fixture projecting pointwise to quietBase is globally clear. -/
theorem finalResetEchoClear_of_quietBaseFamily
    (C : Config n 3 3 48) (f : Fin n → Fin 3)
    (hC : finalBase C = QuietBaseFamily f) :
    FinalResetEchoClear C := by
  unfold FinalResetEchoClear
  intro i
  rw [hC]
  exact quietBase_resetEcho_clear (f i)


private theorem step1_resetEchoClear
    (hpsi : 0 < psi) (h2 : 2 ≤ psi)
    (C : BirthCheckPermitRepairLeaf.FC n psi psi (16 * psi))
    (e : Fin n)
    (hL : BirthShortDoneTerminalFirstHit.Leaderless C)
    (hClear : ∀ i : Fin n, ResetEchoClearCell (C i)) :
    ∀ i : Fin n,
      ResetEchoClearCell
        (BirthCheckPermitRepairLeaf.step1 hpsi h2 ring C e i) := by
  have hl := hClear e
  have hr := hClear (ring.rightNeighbor e)
  unfold ResetEchoClearCell at hl hr
  have hlF : (B6Sanitation.rawCell (C e)).leader = false := by
    change (C e).core.core.leader = false
    exact hL e
  have hrF :
      (B6Sanitation.rawCell (C (ring.rightNeighbor e))).leader = false := by
    change (C (ring.rightNeighbor e)).core.core.leader = false
    exact hL (ring.rightNeighbor e)
  have hp := B6TrafficPairFrame.r1_follower_resetEcho_frame
    (kappa := psi) (tau := 16 * psi) hpsi h2
    (C e) (C (ring.rightNeighbor e))
    hlF hrF hl.1 hl.2 hr.1 hr.2
  dsimp only at hp
  have hstep :
      BirthCheckPermitRepairLeaf.step1 hpsi h2 ring C e =
        B9Host.hostStep
          (B9Host.r1Host
            (kappa := psi) (tau := 16 * psi) hpsi h2)
          ring C e := by
    rfl
  rw [hstep]
  intro i
  by_cases hie : i = e
  · subst i
    unfold ResetEchoClearCell
    simpa only [B9Host.hostStep, if_pos] using
      (show
        (B6Sanitation.rawCell
          ((B9Host.r1Host
            (kappa := psi) (tau := 16 * psi) hpsi h2).row
            (C e) (C (ring.rightNeighbor e))).1).reset_cmd = false ∧
        (B6Sanitation.rawCell
          ((B9Host.r1Host
            (kappa := psi) (tau := 16 * psi) hpsi h2).row
            (C e) (C (ring.rightNeighbor e))).1).echo = false from
        ⟨hp.1, hp.2.1⟩)
  · by_cases hir : i = ring.rightNeighbor e
    · subst i
      unfold ResetEchoClearCell
      simpa only [B9Host.hostStep, if_neg hie, if_pos] using
        (show
          (B6Sanitation.rawCell
            ((B9Host.r1Host
              (kappa := psi) (tau := 16 * psi) hpsi h2).row
              (C e) (C (ring.rightNeighbor e))).2).reset_cmd = false ∧
          (B6Sanitation.rawCell
            ((B9Host.r1Host
              (kappa := psi) (tau := 16 * psi) hpsi h2).row
              (C e) (C (ring.rightNeighbor e))).2).echo = false from
          ⟨hp.2.2.1, hp.2.2.2⟩)
    · simpa only [B9Host.hostStep, if_neg hie, if_neg hir] using hClear i


/-- One passive leaderless concrete HOST letter preserves the invariant. -/
theorem finalResetEchoClear_stepConcrete
    (hpsi : 0 < psi) (h2 : 2 ≤ psi) (hn : 2 ≤ n)
    (hR2 : R2Coherence.R2R1AgreementObligation
      (κ := psi) (τ := 16 * psi) hpsi h2 ring)
    (C : Config n psi psi (16 * psi)) (e : Fin n)
    (hA : ConcreteB7AdmittedPassive hpsi h2 ring C)
    (hL : FinalLeaderless C)
    (hClear : FinalResetEchoClear C) :
    FinalResetEchoClear
      (stepConcrete (κ := psi) (τ := 16 * psi) hpsi h2 ring C e) := by
  have hEq := stepConcrete_base_eq_step1_of_passive_admitted
    hpsi h2 ring hn hR2 C e hA hL
  unfold FinalResetEchoClear at hClear ⊢
  rw [hEq]
  have hBaseL :
      BirthShortDoneTerminalFirstHit.Leaderless (finalBase C) := by
    intro i
    change FinalCandidateR2C.FinalCandidateR2C.outputFinal (C i) = false
    exact hL i
  exact step1_resetEchoClear hpsi h2 (C := finalBase C) e hBaseL hClear



/-- Every letter of a leaderless passive HOST word preserves global clearance. -/
theorem finalResetEchoClear_passiveWord
    (hpsi : 0 < psi) (h2 : 2 ≤ psi) (hn : 2 ≤ n)
    (hClosed : ConcreteB7AdmittedPassiveClosedObligation
      (κ := psi) (τ := 16 * psi) hpsi h2 ring)
    (hR2 : R2Coherence.R2R1AgreementObligation
      (κ := psi) (τ := 16 * psi) hpsi h2 ring)
    (C : Config n psi psi (16 * psi)) (u : List (Fin n))
    (hA : ConcreteB7AdmittedPassive hpsi h2 ring C)
    (hAlive : AliveAlong
      (stepConcrete (κ := psi) (τ := 16 * psi) hpsi h2 ring)
      FinalLeaderless C u)
    (hClear : FinalResetEchoClear C) :
    FinalResetEchoClear
      (u.foldl
        (stepConcrete (κ := psi) (τ := 16 * psi) hpsi h2 ring) C) := by
  induction u generalizing C with
  | nil => exact hClear
  | cons e rest ih =>
      have hAliveCons :
          FinalLeaderless C ∧
            AliveAlong
              (stepConcrete (κ := psi) (τ := 16 * psi) hpsi h2 ring)
              FinalLeaderless
              (stepConcrete (κ := psi) (τ := 16 * psi) hpsi h2 ring C e)
              rest := hAlive
      have hStepClear := finalResetEchoClear_stepConcrete
        (ring := ring) hpsi h2 hn hR2 C e hA hAliveCons.1 hClear
      have hAliveRest := hAliveCons.2
      have hLnext :
          FinalLeaderless
            (stepConcrete (κ := psi) (τ := 16 * psi) hpsi h2 ring C e) :=
        aliveAlong_good hAliveRest
      have hnext := hClosed C e hA hAliveCons.1
      have hA' :
          ConcreteB7AdmittedPassive hpsi h2 ring
            (stepConcrete (κ := psi) (τ := 16 * psi) hpsi h2 ring C e) := by
        rcases hnext with hLead | hAdm
        · rcases hLead with ⟨i, hi⟩
          have hf := hLnext i
          rw [hf] at hi
          cases hi
        · exact hAdm
      simpa only [List.foldl_cons] using
        ih (C := stepConcrete
          (κ := psi) (τ := 16 * psi) hpsi h2 ring C e)
          hA' hAliveRest hStepClear


/-- Whole-ring clearance implies the B6 collar premise for every workspace. -/
theorem r1CollarClearAtEntry_of_finalResetEchoClear
    (X : Workspace ring psi)
    (C : Config n psi psi (16 * psi))
    (hClear : FinalResetEchoClear C) :
    R1CollarClearAtEntry X (finalBase C) := by
  unfold R1CollarClearAtEntry EnvelopeBoundaryResetEchoClear
  unfold FinalResetEchoClear at hClear
  intro i _hiEnv _hiCore
  exact hClear i


end B4PassiveResetEcho
