import Leader.Wu.PartialProtocol.RawZeroLeaderCounterfamily

/-!
# Necessary reset interface beyond the factor-eight iid repair

R94/R96 prove iid Definition-1 stabilization on a closed authorized domain,
but arbitrary initialization may forge every lock, seal, birth-barrier, and
new reset bit.  This module isolates the exact obligation that such a reset
layer cannot avoid.

For any endpoint-local transition, a nonempty local state class whose full
shift is transition-closed and whose outputs are all followers is an
all-schedules obstruction: every finite prefix remains outside Definition-1
safety.  We instantiate this observation on the proposed factor-sixteen
carrier

`((((ExpiringAgentState 1 0 0 × Bool) × Bool) × Bool) × Bool)`.

The physical projection exposes R97's four raw follower states `N`, `R`, `H`,
and `RH`; the remaining four Booleans are the existing lock, seal, and birth
barrier together with the prospective reset bit.  An arbitrary-initialization
producer therefore has to break every nonempty forged control band over the
raw alphabet.  Two concrete consequences are proved:

* across all sixteen control words, some local transition must move a physical
  endpoint outside the raw four-state alphabet; merely shuffling control bits
  cannot suffice;
* on every fixed control word, at least one of the sixteen exact raw table
  entries must change.  A reset bit with any uniform passthrough epoch embeds
  the R97 trap unchanged.

These are necessary conditions, not a proof that one further Boolean is
impossible and not a sufficient reset construction.
-/

namespace PPLLCompleteMultiLeaderCleanup
namespace PPartialRawLiftBoolResetNoGoSol

open PPLL PPLLResearchFormulation PPLLTraceConvergence
open PPLLExpiringComparisonRepair

set_option autoImplicit false

variable {n : Nat}

/-! ## Generic pointwise zero-output traps -/

/-- Every nonsafe configuration in `Domain` has a safe schedule of length at
most `L`.  Kept local so the obstruction does not depend on a particular
positive scheduler-amplification construction. -/
def BoundedSafeScheduleProducer {Q : Type} {n : Nat}
    (ring : DirectedRing n) (T : Q → Q → Q × Q)
    (Domain Safe : (Fin n → Q) → Prop) (L : Nat) : Prop :=
  ∀ C, Domain C → ¬ Safe C →
    ∃ word : DetSchedule n,
      word.length ≤ L ∧ Safe (runLocalSchedule ring T C word)

/-- A local state class is closed when every interaction between two members
returns two members. -/
def LocalPairClosed {Q : Type}
    (T : Q → Q → Q × Q) (Bad : Q → Prop) : Prop :=
  ∀ l r, Bad l → Bad r →
    let q := T l r
    Bad q.1 ∧ Bad q.2

/-- The full shift generated by a local state predicate. -/
def PointwiseClass {Q : Type}
    (Bad : Q → Prop) (C : Fin n → Q) : Prop :=
  ∀ i : Fin n, Bad (C i)

/-- Endpoint-local closure lifts to the full shift on every directed ring. -/
theorem PointwiseClass.localStep
    {Q : Type} (ring : DirectedRing n)
    (T : Q → Q → Q × Q) (Bad : Q → Prop)
    (hpair : LocalPairClosed T Bad)
    (C : Fin n → Q) (hC : PointwiseClass Bad C) (e : Fin n) :
    PointwiseClass Bad (localStep ring T C e) := by
  let j := ring.rightNeighbor e
  have hq := hpair (C e) (C j) (hC e) (hC j)
  intro i
  by_cases hie : i = e
  · subst i
    simpa only [PPLLResearchFormulation.localStep, if_pos] using hq.1
  · by_cases hij : i = j
    · subst i
      simpa only [PPLLResearchFormulation.localStep, j, if_neg hie, if_pos]
        using hq.2
    · simpa only [PPLLResearchFormulation.localStep, j, if_neg hie, if_neg hij]
        using hC i

/-- The pointwise class remains closed under every finite scheduler word. -/
theorem pointwiseClass_run
    {Q : Type} (ring : DirectedRing n)
    (T : Q → Q → Q × Q) (Bad : Q → Prop)
    (hpair : LocalPairClosed T Bad)
    (C : Fin n → Q) (hC : PointwiseClass Bad C)
    (word : DetSchedule n) :
    PointwiseClass Bad (runLocalSchedule ring T C word) := by
  induction word generalizing C with
  | nil => exact hC
  | cons e rest ih =>
      simp only [runLocalSchedule]
      exact ih _ (PointwiseClass.localStep ring T Bad hpair C hC e)

/-- A pointwise class of follower-output states contains no Definition-1 safe
configuration. -/
theorem pointwiseClass_not_isSafe
    (P : PopulationProtocol) (ring : DirectedRing n)
    (isLeader : P.Y → Bool) (Bad : P.Q → Prop)
    (hzero : ∀ q, Bad q → isLeader (P.output q) = false)
    (C : P.Configuration n) (hC : PointwiseClass Bad C) :
    ¬ PopulationProtocol.IsSafe P ring C isLeader := by
  intro hsafe
  rcases hsafe.1 with ⟨i, hi, _⟩
  rw [hzero (C i) (hC i)] at hi
  contradiction

/-- Every finite word from a closed follower class misses genuine semantic
safety.  This is stronger than failure of one proposed bounded producer. -/
theorem pointwiseClass_no_finite_safe
    (P : PopulationProtocol) (ring : DirectedRing n)
    (isLeader : P.Y → Bool) (Bad : P.Q → Prop)
    (hpair : LocalPairClosed P.transition Bad)
    (hzero : ∀ q, Bad q → isLeader (P.output q) = false)
    (C : P.Configuration n) (hC : PointwiseClass Bad C) :
    ¬ ∃ word : DetSchedule n,
      PopulationProtocol.IsSafe P ring
        (runLocalSchedule ring P.transition C word) isLeader := by
  rintro ⟨word, hsafe⟩
  exact pointwiseClass_not_isSafe P ring isLeader Bad hzero _
    (pointwiseClass_run ring P.transition Bad hpair C hC word) hsafe

/-- Consequently no finite scheduler prefix, including any prefix of an iid
outcome, reaches Definition-1 safety from the trap. -/
theorem pointwiseClass_never_reachesSafeWithinSchedule
    (P : PopulationProtocol) (ring : DirectedRing n)
    (isLeader : P.Y → Bool) (Bad : P.Q → Prop)
    (hpair : LocalPairClosed P.transition Bad)
    (hzero : ∀ q, Bad q → isLeader (P.output q) = false)
    (C : P.Configuration n) (hC : PointwiseClass Bad C)
    (word : DetSchedule n) :
    ¬ ReachesSafeWithinSchedule P ring isLeader C word := by
  rintro ⟨k, _hk, hsafe⟩
  have hrun := pointwiseClass_no_finite_safe
    P ring isLeader Bad hpair hzero C hC
  apply hrun
  refine ⟨word.take k, ?_⟩
  simpa only [runLocalSchedule_eq_runSchedule] using hsafe

/-- The genuine Definition-1 scheduler count is exactly zero from a closed
follower full shift. -/
theorem pointwiseClass_stabilizingScheduleCount_zero
    (P : PopulationProtocol) (ring : DirectedRing n)
    (isLeader : P.Y → Bool) (Bad : P.Q → Prop)
    (hpair : LocalPairClosed P.transition Bad)
    (hzero : ∀ q, Bad q → isLeader (P.output q) = false)
    (C : P.Configuration n) (hC : PointwiseClass Bad C)
    (t : Nat) :
    stabilizingScheduleCount P ring isLeader C t = 0 := by
  classical
  unfold stabilizingScheduleCount
  apply List.countP_eq_zero.mpr
  intro word _hword hcounted
  change (if ReachesSafeWithinSchedule P ring isLeader C word then true
    else false) = true at hcounted
  rw [if_neg (pointwiseClass_never_reachesSafeWithinSchedule
    P ring isLeader Bad hpair hzero C hC word)] at hcounted
  contradiction

/-- Hence every all-configuration finite-horizon iid claim must spend its
entire failure budget on the closed follower full shift. -/
theorem nonemptyZeroClass_uniformFiniteHorizonSSLE_spends_full_budget
    (P : PopulationProtocol) (ring : DirectedRing n)
    (isLeader : P.Y → Bool) (Bad : P.Q → Prop)
    (hbad : ∃ q, Bad q)
    (hpair : LocalPairClosed P.transition Bad)
    (hzero : ∀ q, Bad q → isLeader (P.output q) = false)
    (t allowedFailures : Nat)
    (hssle : UniformFiniteHorizonSSLE P ring isLeader t allowedFailures) :
    (allSchedules n t).length ≤ allowedFailures := by
  obtain ⟨q, hq⟩ := hbad
  let C : P.Configuration n := fun _ => q
  have hC : PointwiseClass Bad C := by
    intro i
    exact hq
  have hcount := pointwiseClass_stabilizingScheduleCount_zero
    P ring isLeader Bad hpair hzero C hC t
  have hbound := hssle C
  rw [hcount, Nat.zero_add] at hbound
  exact hbound

/-- In particular, no all-configuration finite `c/n` Definition-1 iid bound
is compatible with a nonempty transition-closed follower class. -/
theorem nonemptyZeroClass_not_uniformOneOverNFailure
    (P : PopulationProtocol) (ring : DirectedRing n)
    (isLeader : P.Y → Bool) (Bad : P.Q → Prop)
    (hbad : ∃ q, Bad q)
    (hpair : LocalPairClosed P.transition Bad)
    (hzero : ∀ q, Bad q → isLeader (P.output q) = false)
    (c t : Nat) :
    ¬ UniformOneOverNFailureAtHorizon P ring isLeader c t := by
  intro hfailure
  have hfull := nonemptyZeroClass_uniformFiniteHorizonSSLE_spends_full_budget
    P ring isLeader Bad hbad hpair hzero t (c * n ^ (t - 1))
    hfailure.2.2
  have hstrict := oneOverNFailure_budget_lt_total
    ring c t hfailure.1 hfailure.2.1
  exact (Nat.not_le_of_gt hstrict) hfull

/-- If a nonempty follower class is locally closed, an all-configuration
bounded safe producer is impossible for every proposed block length. -/
theorem nonemptyZeroClass_not_allConfig_boundedSafeProducer
    (P : PopulationProtocol) (ring : DirectedRing n)
    (isLeader : P.Y → Bool) (Bad : P.Q → Prop)
    (hbad : ∃ q, Bad q)
    (hpair : LocalPairClosed P.transition Bad)
    (hzero : ∀ q, Bad q → isLeader (P.output q) = false)
    (L : Nat) :
    ¬ BoundedSafeScheduleProducer ring P.transition
      (fun _ : P.Configuration n => True)
      (fun C => PopulationProtocol.IsSafe P ring C isLeader) L := by
  intro hproducer
  obtain ⟨q, hq⟩ := hbad
  let C : P.Configuration n := fun _ => q
  have hC : PointwiseClass Bad C := by
    intro i
    exact hq
  have hnotSafe := pointwiseClass_not_isSafe
    P ring isLeader Bad hzero C hC
  obtain ⟨word, _hlength, hsafe⟩ :=
    hproducer C trivial hnotSafe
  exact pointwiseClass_no_finite_safe
    P ring isLeader Bad hpair hzero C hC ⟨word, hsafe⟩

/-- Necessary local interface: an all-configuration producer forces some
interaction of two members of every nonempty follower class to leave that
class. -/
theorem allConfigProducer_forces_local_escape
    (P : PopulationProtocol) (ring : DirectedRing n)
    (isLeader : P.Y → Bool) (Bad : P.Q → Prop)
    (hbad : ∃ q, Bad q)
    (hzero : ∀ q, Bad q → isLeader (P.output q) = false)
    (L : Nat)
    (hproducer : BoundedSafeScheduleProducer ring P.transition
      (fun _ : P.Configuration n => True)
      (fun C => PopulationProtocol.IsSafe P ring C isLeader) L) :
    ∃ l r, Bad l ∧ Bad r ∧
      let q := P.transition l r
      ¬ (Bad q.1 ∧ Bad q.2) := by
  classical
  have hnotClosed : ¬ LocalPairClosed P.transition Bad := by
    intro hclosed
    exact nonemptyZeroClass_not_allConfig_boundedSafeProducer
      P ring isLeader Bad hbad hclosed hzero L hproducer
  by_cases hex : ∃ l r, Bad l ∧ Bad r ∧
      let q := P.transition l r
      ¬ (Bad q.1 ∧ Bad q.2)
  · exact hex
  · have hclosed : LocalPairClosed P.transition Bad := by
      intro l r hl hr
      let q := P.transition l r
      by_cases hout : Bad q.1 ∧ Bad q.2
      · exact hout
      · exact (hex ⟨l, r, hl, hr, hout⟩).elim
    exact (hnotClosed hclosed).elim

/-- The same local escape condition follows directly from an arbitrary-state
finite `c/n` Definition-1 iid theorem, without assuming a bounded producer. -/
theorem uniformOneOverNFailure_forces_local_escape
    (P : PopulationProtocol) (ring : DirectedRing n)
    (isLeader : P.Y → Bool) (Bad : P.Q → Prop)
    (hbad : ∃ q, Bad q)
    (hzero : ∀ q, Bad q → isLeader (P.output q) = false)
    (c t : Nat)
    (hfailure : UniformOneOverNFailureAtHorizon P ring isLeader c t) :
    ∃ l r, Bad l ∧ Bad r ∧
      let q := P.transition l r
      ¬ (Bad q.1 ∧ Bad q.2) := by
  by_cases hex : ∃ l r, Bad l ∧ Bad r ∧
      let q := P.transition l r
      ¬ (Bad q.1 ∧ Bad q.2)
  · exact hex
  · have hclosed : LocalPairClosed P.transition Bad := by
      intro l r hl hr
      let q := P.transition l r
      by_cases hout : Bad q.1 ∧ Bad q.2
      · exact hout
      · exact (hex ⟨l, r, hl, hr, hout⟩).elim
    exact (nonemptyZeroClass_not_uniformOneOverNFailure
      P ring isLeader Bad hbad hclosed hzero c t hfailure).elim

/-! ## Exact semantic consequence for raw `P_partial` -/

/-- Every member of R97's raw four-state alphabet has follower output under
the exact packaged unmodified protocol. -/
theorem rawZeroAlphabet_output_false
    (q : RawZeroAlphabetState) (hq : InRawZeroAlphabet q) :
    isLeaderOutput
      ((P_partialProtocolUnconditional rawZeroClosed_hpsi 0 0).output q) =
        false := by
  have hleader := hq.leader_false q
  simp [P_partialProtocolUnconditional, P_partialProtocol,
    hleader, isLeaderOutput]

/-- R97's closed full shift has exactly zero genuine Definition-1 stabilizing
scheduler words at every finite horizon. -/
theorem rawZeroAlphabet_stabilizingScheduleCount_zero
    (ring : DirectedRing n) (C : PPartialConfig n 1 0 0)
    (hC : RawZeroAlphabetConfig C) (t : Nat) :
    stabilizingScheduleCount
      (P_partialProtocolUnconditional rawZeroClosed_hpsi 0 0)
      ring isLeaderOutput C t = 0 := by
  exact pointwiseClass_stabilizingScheduleCount_zero
    (P_partialProtocolUnconditional rawZeroClosed_hpsi 0 0)
    ring isLeaderOutput InRawZeroAlphabet
    rawZeroAlphabet_transition_closed rawZeroAlphabet_output_false C hC t

/-- The unmodified raw protocol consequently fails every arbitrary-state
finite `c/n` Definition-1 iid statement on every directed ring. -/
theorem rawPPartial_not_uniformOneOverNFailure
    (ring : DirectedRing n) (c t : Nat) :
    ¬ UniformOneOverNFailureAtHorizon
      (P_partialProtocolUnconditional rawZeroClosed_hpsi 0 0)
      ring isLeaderOutput c t := by
  exact nonemptyZeroClass_not_uniformOneOverNFailure
    (P_partialProtocolUnconditional rawZeroClosed_hpsi 0 0)
    ring isLeaderOutput InRawZeroAlphabet ⟨rawZeroClosedN, .ofN⟩
    rawZeroAlphabet_transition_closed rawZeroAlphabet_output_false c t

/-! ## The actual factor-sixteen candidate carrier -/

/-- One prospective reset bit beyond R94/R96's exact factor-eight carrier. -/
abbrev FactorSixteenState :=
  ((((ExpiringAgentState 1 0 0 × Bool) × Bool) × Bool) × Bool)

abbrev FactorSixteenConfig (n : Nat) := Fin n → FactorSixteenState

/-- The prospective carrier is definitionally four Boolean products over the
physical state, hence factor sixteen whenever the physical carrier is finite. -/
theorem factorSixteenState_exact_factor_sixteen :
    FactorSixteenState =
      ((((ExpiringAgentState 1 0 0 × Bool) × Bool) × Bool) × Bool) := by
  rfl

/-- The four current Boolean controls, separated from the physical expiring
state only for audit purposes. -/
structure FactorSixteenControl where
  lockBit : Bool
  sealBit : Bool
  birthBit : Bool
  resetBit : Bool
  deriving DecidableEq, Repr

/-- Forget the lock, seal, birth, and prospective reset controls. -/
def factorSixteenRaw (u : FactorSixteenState) : RawZeroAlphabetState :=
  u.1.1.1.1

/-- Read the complete four-bit control word. -/
def factorSixteenControl (u : FactorSixteenState) : FactorSixteenControl :=
  ⟨u.1.1.1.2, u.1.1.2, u.1.2, u.2⟩

/-- Embed a raw physical state under a chosen forged control word. -/
def factorSixteenEmbed
    (u : RawZeroAlphabetState) (c : FactorSixteenControl) :
    FactorSixteenState :=
  ((((u, c.lockBit), c.sealBit), c.birthBit), c.resetBit)

@[simp] theorem factorSixteenRaw_embed
    (u : RawZeroAlphabetState) (c : FactorSixteenControl) :
    factorSixteenRaw (factorSixteenEmbed u c) = u := by
  rfl

@[simp] theorem factorSixteenControl_embed
    (u : RawZeroAlphabetState) (c : FactorSixteenControl) :
    factorSixteenControl (factorSixteenEmbed u c) = c := by
  cases c
  rfl

/-- Every factor-sixteen state is recovered from its physical projection and
four control bits. -/
theorem factorSixteen_embed_eta (u : FactorSixteenState) :
    factorSixteenEmbed (factorSixteenRaw u) (factorSixteenControl u) = u := by
  rcases u with
    ⟨⟨⟨⟨physical, lockValue⟩, sealValue⟩, birthValue⟩, resetValue⟩
  rfl

/-- Package an arbitrary candidate transition with the unchanged physical
leader output used by the factor-eight repair. -/
def factorSixteenProtocol
    (T : FactorSixteenState → FactorSixteenState →
      FactorSixteenState × FactorSixteenState) : PopulationProtocol where
  Q := FactorSixteenState
  Y := LeaderOutput
  transition := T
  output := fun s =>
    if (factorSixteenRaw s).core.core.leader then .leader else .follower

/-- A forged control band over the complete R97 raw follower alphabet. -/
def FactorSixteenRawBand
    (Allowed : FactorSixteenControl → Prop)
    (u : FactorSixteenState) : Prop :=
  InRawZeroAlphabet (factorSixteenRaw u) ∧ Allowed (factorSixteenControl u)

theorem factorSixteenRawBand_nonempty
    (Allowed : FactorSixteenControl → Prop)
    (hAllowed : ∃ c, Allowed c) :
    ∃ u, FactorSixteenRawBand Allowed u := by
  obtain ⟨c, hc⟩ := hAllowed
  exact ⟨factorSixteenEmbed rawZeroClosedN c, .ofN, by simpa using hc⟩

/-- Every state in every forged raw control band still outputs follower. -/
theorem factorSixteenRawBand_output_false
    (T : FactorSixteenState → FactorSixteenState →
      FactorSixteenState × FactorSixteenState)
    (Allowed : FactorSixteenControl → Prop)
    (u : FactorSixteenState) (hu : FactorSixteenRawBand Allowed u) :
    isLeaderOutput ((factorSixteenProtocol T).output u) = false := by
  have hleader := hu.1.leader_false (factorSixteenRaw u)
  simp [factorSixteenProtocol, hleader, isLeaderOutput]

/-- No transition-closed nonempty collection of forged control words over the
raw alphabet is compatible with an arbitrary-initialization producer. -/
theorem factorSixteenProducer_breaks_every_nonempty_rawBand
    (ring : DirectedRing n)
    (T : FactorSixteenState → FactorSixteenState →
      FactorSixteenState × FactorSixteenState)
    (Allowed : FactorSixteenControl → Prop)
    (hAllowed : ∃ c, Allowed c) (L : Nat)
    (hproducer : BoundedSafeScheduleProducer ring T
      (fun _ : FactorSixteenConfig n => True)
      (fun C => PopulationProtocol.IsSafe
        (factorSixteenProtocol T) ring C isLeaderOutput) L) :
    ¬ LocalPairClosed T (FactorSixteenRawBand Allowed) := by
  exact fun hclosed =>
    nonemptyZeroClass_not_allConfig_boundedSafeProducer
      (factorSixteenProtocol T) ring isLeaderOutput
      (FactorSixteenRawBand Allowed)
      (factorSixteenRawBand_nonempty Allowed hAllowed)
      hclosed (factorSixteenRawBand_output_false T Allowed) L hproducer

/-- Sharp local witness form of the preceding necessary interface. -/
theorem factorSixteenProducer_forces_rawBand_escape
    (ring : DirectedRing n)
    (T : FactorSixteenState → FactorSixteenState →
      FactorSixteenState × FactorSixteenState)
    (Allowed : FactorSixteenControl → Prop)
    (hAllowed : ∃ c, Allowed c) (L : Nat)
    (hproducer : BoundedSafeScheduleProducer ring T
      (fun _ : FactorSixteenConfig n => True)
      (fun C => PopulationProtocol.IsSafe
        (factorSixteenProtocol T) ring C isLeaderOutput) L) :
    ∃ l r,
      FactorSixteenRawBand Allowed l ∧
      FactorSixteenRawBand Allowed r ∧
      let q := T l r
      ¬ (FactorSixteenRawBand Allowed q.1 ∧
        FactorSixteenRawBand Allowed q.2) := by
  exact allConfigProducer_forces_local_escape
    (factorSixteenProtocol T) ring isLeaderOutput
    (FactorSixteenRawBand Allowed)
    (factorSixteenRawBand_nonempty Allowed hAllowed)
    (factorSixteenRawBand_output_false T Allowed) L hproducer

/-- The identical band-escape witness is forced by an arbitrary-state finite
`c/n` Definition-1 iid theorem itself. -/
theorem factorSixteenOneOverNFailure_forces_rawBand_escape
    (ring : DirectedRing n)
    (T : FactorSixteenState → FactorSixteenState →
      FactorSixteenState × FactorSixteenState)
    (Allowed : FactorSixteenControl → Prop)
    (hAllowed : ∃ control, Allowed control)
    (c t : Nat)
    (hfailure : UniformOneOverNFailureAtHorizon
      (factorSixteenProtocol T) ring isLeaderOutput c t) :
    ∃ l r,
      FactorSixteenRawBand Allowed l ∧
      FactorSixteenRawBand Allowed r ∧
      let q := T l r
      ¬ (FactorSixteenRawBand Allowed q.1 ∧
        FactorSixteenRawBand Allowed q.2) := by
  exact uniformOneOverNFailure_forces_local_escape
    (factorSixteenProtocol T) ring isLeaderOutput
    (FactorSixteenRawBand Allowed)
    (factorSixteenRawBand_nonempty Allowed hAllowed)
    (factorSixteenRawBand_output_false T Allowed) c t hfailure

/-! ## Two unavoidable reset obligations -/

/-- Across all forged controls, some interaction must physically leave R97's
four-state alphabet.  Control-bit churn alone cannot repair arbitrary
initialization. -/
theorem factorSixteenProducer_requires_physical_raw_escape
    (ring : DirectedRing n)
    (T : FactorSixteenState → FactorSixteenState →
      FactorSixteenState × FactorSixteenState)
    (L : Nat)
    (hproducer : BoundedSafeScheduleProducer ring T
      (fun _ : FactorSixteenConfig n => True)
      (fun C => PopulationProtocol.IsSafe
        (factorSixteenProtocol T) ring C isLeaderOutput) L) :
    ∃ l r,
      InRawZeroAlphabet (factorSixteenRaw l) ∧
      InRawZeroAlphabet (factorSixteenRaw r) ∧
      let q := T l r
      ¬ (InRawZeroAlphabet (factorSixteenRaw q.1) ∧
        InRawZeroAlphabet (factorSixteenRaw q.2)) := by
  obtain ⟨l, r, hl, hr, hout⟩ :=
    factorSixteenProducer_forces_rawBand_escape
      ring T (fun _ => True) ⟨⟨false, false, false, false⟩, trivial⟩
      L hproducer
  refine ⟨l, r, hl.1, hr.1, ?_⟩
  dsimp only
  intro hphysical
  exact hout ⟨⟨hphysical.1, trivial⟩, ⟨hphysical.2, trivial⟩⟩

/-- Direct iid form: an all-carrier finite `c/n` theorem forces a transition
whose physical output leaves the raw four-state alphabet. -/
theorem factorSixteenOneOverNFailure_requires_physical_raw_escape
    (ring : DirectedRing n)
    (T : FactorSixteenState → FactorSixteenState →
      FactorSixteenState × FactorSixteenState)
    (c t : Nat)
    (hfailure : UniformOneOverNFailureAtHorizon
      (factorSixteenProtocol T) ring isLeaderOutput c t) :
    ∃ l r,
      InRawZeroAlphabet (factorSixteenRaw l) ∧
      InRawZeroAlphabet (factorSixteenRaw r) ∧
      let q := T l r
      ¬ (InRawZeroAlphabet (factorSixteenRaw q.1) ∧
        InRawZeroAlphabet (factorSixteenRaw q.2)) := by
  obtain ⟨l, r, hl, hr, hout⟩ :=
    factorSixteenOneOverNFailure_forces_rawBand_escape
      ring T (fun _ => True) ⟨⟨false, false, false, false⟩, trivial⟩
      c t hfailure
  refine ⟨l, r, hl.1, hr.1, ?_⟩
  dsimp only
  intro hphysical
  exact hout ⟨⟨hphysical.1, trivial⟩, ⟨hphysical.2, trivial⟩⟩

/-- Exact passthrough of the raw transition on one complete uniform control
slice. -/
def FactorSixteenExactRawLiftAt
    (T : FactorSixteenState → FactorSixteenState →
      FactorSixteenState × FactorSixteenState)
    (c : FactorSixteenControl) : Prop :=
  ∀ l r, InRawZeroAlphabet l → InRawZeroAlphabet r →
    let q := P_partialUnconditional rawZeroClosed_hpsi 0 0 l r
    T (factorSixteenEmbed l c) (factorSixteenEmbed r c) =
      (factorSixteenEmbed q.1 c, factorSixteenEmbed q.2 c)

private theorem exactRawLiftAt_pairClosed
    (T : FactorSixteenState → FactorSixteenState →
      FactorSixteenState × FactorSixteenState)
    (c : FactorSixteenControl)
    (hlift : FactorSixteenExactRawLiftAt T c) :
    LocalPairClosed T (FactorSixteenRawBand (fun d => d = c)) := by
  intro x y hx hy
  have hxEq : x = factorSixteenEmbed (factorSixteenRaw x) c := by
    calc
      x = factorSixteenEmbed (factorSixteenRaw x)
          (factorSixteenControl x) := (factorSixteen_embed_eta x).symm
      _ = factorSixteenEmbed (factorSixteenRaw x) c := by rw [hx.2]
  have hyEq : y = factorSixteenEmbed (factorSixteenRaw y) c := by
    calc
      y = factorSixteenEmbed (factorSixteenRaw y)
          (factorSixteenControl y) := (factorSixteen_embed_eta y).symm
      _ = factorSixteenEmbed (factorSixteenRaw y) c := by rw [hy.2]
  have hraw := rawZeroAlphabet_transition_closed
    (factorSixteenRaw x) (factorSixteenRaw y) hx.1 hy.1
  have hstep := hlift (factorSixteenRaw x) (factorSixteenRaw y) hx.1 hy.1
  rw [hxEq, hyEq, hstep]
  exact ⟨⟨hraw.1, factorSixteenControl_embed _ c⟩,
    ⟨hraw.2, factorSixteenControl_embed _ c⟩⟩

/-- Any uniform control slice on which the prospective repair delegates the
complete raw `4 × 4` table is still an all-schedules zero-output trap. -/
theorem factorSixteenExactRawLiftAt_no_finite_safe
    (ring : DirectedRing n)
    (T : FactorSixteenState → FactorSixteenState →
      FactorSixteenState × FactorSixteenState)
    (c : FactorSixteenControl)
    (hlift : FactorSixteenExactRawLiftAt T c) :
    ¬ ∃ word : DetSchedule n,
      PopulationProtocol.IsSafe (factorSixteenProtocol T) ring
        (runLocalSchedule ring T
          (fun _ => factorSixteenEmbed rawZeroClosedN c) word)
        isLeaderOutput := by
  apply pointwiseClass_no_finite_safe
    (factorSixteenProtocol T) ring isLeaderOutput
    (FactorSixteenRawBand (fun d => d = c))
    (exactRawLiftAt_pairClosed T c hlift)
    (factorSixteenRawBand_output_false T (fun d => d = c))
  intro i
  exact ⟨.ofN, factorSixteenControl_embed _ c⟩

/-- Exact raw passthrough on even one forged uniform control slice rules out
every arbitrary-state finite `c/n` Definition-1 iid theorem. -/
theorem factorSixteenExactRawLiftAt_not_uniformOneOverNFailure
    (ring : DirectedRing n)
    (T : FactorSixteenState → FactorSixteenState →
      FactorSixteenState × FactorSixteenState)
    (control : FactorSixteenControl)
    (hlift : FactorSixteenExactRawLiftAt T control)
    (c t : Nat) :
    ¬ UniformOneOverNFailureAtHorizon
      (factorSixteenProtocol T) ring isLeaderOutput c t := by
  exact nonemptyZeroClass_not_uniformOneOverNFailure
    (factorSixteenProtocol T) ring isLeaderOutput
    (FactorSixteenRawBand (fun d => d = control))
    ⟨factorSixteenEmbed rawZeroClosedN control,
      .ofN, factorSixteenControl_embed _ control⟩
    (exactRawLiftAt_pairClosed T control hlift)
    (factorSixteenRawBand_output_false T (fun d => d = control)) c t

/-- Therefore arbitrary-initialization production forbids an exact raw
passthrough epoch at every one of the sixteen forged control words. -/
theorem factorSixteenProducer_forbids_exactRawLiftAt
    (ring : DirectedRing n)
    (T : FactorSixteenState → FactorSixteenState →
      FactorSixteenState × FactorSixteenState)
    (L : Nat)
    (hproducer : BoundedSafeScheduleProducer ring T
      (fun _ : FactorSixteenConfig n => True)
      (fun C => PopulationProtocol.IsSafe
        (factorSixteenProtocol T) ring C isLeaderOutput) L)
    (c : FactorSixteenControl) :
    ¬ FactorSixteenExactRawLiftAt T c := by
  intro hlift
  exact factorSixteenProducer_breaks_every_nonempty_rawBand
    ring T (fun d => d = c) ⟨c, rfl⟩ L hproducer
    (exactRawLiftAt_pairClosed T c hlift)

/-- Table-level witness: for each forged control word, at least one raw
alphabet entry must differ in physical output or in a control bit. -/
theorem factorSixteenProducer_requires_table_change_at
    (ring : DirectedRing n)
    (T : FactorSixteenState → FactorSixteenState →
      FactorSixteenState × FactorSixteenState)
    (L : Nat)
    (hproducer : BoundedSafeScheduleProducer ring T
      (fun _ : FactorSixteenConfig n => True)
      (fun C => PopulationProtocol.IsSafe
        (factorSixteenProtocol T) ring C isLeaderOutput) L)
    (c : FactorSixteenControl) :
    ∃ l r,
      InRawZeroAlphabet l ∧ InRawZeroAlphabet r ∧
      let q := P_partialUnconditional rawZeroClosed_hpsi 0 0 l r
      T (factorSixteenEmbed l c) (factorSixteenEmbed r c) ≠
        (factorSixteenEmbed q.1 c, factorSixteenEmbed q.2 c) := by
  classical
  have hnotLift := factorSixteenProducer_forbids_exactRawLiftAt
    ring T L hproducer c
  by_cases hex : ∃ l r,
      InRawZeroAlphabet l ∧ InRawZeroAlphabet r ∧
      let q := P_partialUnconditional rawZeroClosed_hpsi 0 0 l r
      T (factorSixteenEmbed l c) (factorSixteenEmbed r c) ≠
        (factorSixteenEmbed q.1 c, factorSixteenEmbed q.2 c)
  · exact hex
  · have hlift : FactorSixteenExactRawLiftAt T c := by
      intro l r hl hr
      let q := P_partialUnconditional rawZeroClosed_hpsi 0 0 l r
      by_cases hEq :
          T (factorSixteenEmbed l c) (factorSixteenEmbed r c) =
            (factorSixteenEmbed q.1 c, factorSixteenEmbed q.2 c)
      · exact hEq
      · exact (hex ⟨l, r, hl, hr, hEq⟩).elim
    exact (hnotLift hlift).elim

/-- Direct iid table witness: each forged uniform control word must alter at
least one entry of the exact raw `4 × 4` lift. -/
theorem factorSixteenOneOverNFailure_requires_table_change_at
    (ring : DirectedRing n)
    (T : FactorSixteenState → FactorSixteenState →
      FactorSixteenState × FactorSixteenState)
    (c t : Nat)
    (hfailure : UniformOneOverNFailureAtHorizon
      (factorSixteenProtocol T) ring isLeaderOutput c t)
    (control : FactorSixteenControl) :
    ∃ l r,
      InRawZeroAlphabet l ∧ InRawZeroAlphabet r ∧
      let q := P_partialUnconditional rawZeroClosed_hpsi 0 0 l r
      T (factorSixteenEmbed l control) (factorSixteenEmbed r control) ≠
        (factorSixteenEmbed q.1 control,
          factorSixteenEmbed q.2 control) := by
  classical
  have hnotLift := factorSixteenExactRawLiftAt_not_uniformOneOverNFailure
    ring T control
  by_cases hex : ∃ l r,
      InRawZeroAlphabet l ∧ InRawZeroAlphabet r ∧
      let q := P_partialUnconditional rawZeroClosed_hpsi 0 0 l r
      T (factorSixteenEmbed l control) (factorSixteenEmbed r control) ≠
        (factorSixteenEmbed q.1 control,
          factorSixteenEmbed q.2 control)
  · exact hex
  · have hlift : FactorSixteenExactRawLiftAt T control := by
      intro l r hl hr
      let q := P_partialUnconditional rawZeroClosed_hpsi 0 0 l r
      by_cases hEq :
          T (factorSixteenEmbed l control) (factorSixteenEmbed r control) =
            (factorSixteenEmbed q.1 control,
              factorSixteenEmbed q.2 control)
      · exact hEq
      · exact (hex ⟨l, r, hl, hr, hEq⟩).elim
    exact (hnotLift hlift c t hfailure).elim

/-! ## A direct closed-class statement for auditing candidate transitions -/

/-- If a candidate transition never moves the physical projection out of the
raw four-state alphabet, the full factor-sixteen raw shift is closed. -/
def FactorSixteenRawPhysicalClosed
    (T : FactorSixteenState → FactorSixteenState →
      FactorSixteenState × FactorSixteenState) : Prop :=
  ∀ l r,
    InRawZeroAlphabet (factorSixteenRaw l) →
    InRawZeroAlphabet (factorSixteenRaw r) →
    let q := T l r
    InRawZeroAlphabet (factorSixteenRaw q.1) ∧
      InRawZeroAlphabet (factorSixteenRaw q.2)

theorem factorSixteenRawPhysicalClosed_no_finite_safe
    (ring : DirectedRing n)
    (T : FactorSixteenState → FactorSixteenState →
      FactorSixteenState × FactorSixteenState)
    (hclosed : FactorSixteenRawPhysicalClosed T) :
    ¬ ∃ word : DetSchedule n,
      PopulationProtocol.IsSafe (factorSixteenProtocol T) ring
        (runLocalSchedule ring T
          (fun _ => factorSixteenEmbed rawZeroClosedN
            ⟨false, false, false, false⟩) word)
        isLeaderOutput := by
  apply pointwiseClass_no_finite_safe
    (factorSixteenProtocol T) ring isLeaderOutput
    (FactorSixteenRawBand (fun _ => True))
  · intro l r hl hr
    have hout := hclosed l r hl.1 hr.1
    exact ⟨⟨hout.1, trivial⟩, ⟨hout.2, trivial⟩⟩
  · exact factorSixteenRawBand_output_false T (fun _ => True)
  · intro i
    exact ⟨.ofN, trivial⟩

/-- A candidate that only churns the four control bits while preserving the
raw physical alphabet cannot satisfy arbitrary-state finite `c/n` iid
stabilization. -/
theorem factorSixteenRawPhysicalClosed_not_uniformOneOverNFailure
    (ring : DirectedRing n)
    (T : FactorSixteenState → FactorSixteenState →
      FactorSixteenState × FactorSixteenState)
    (hclosed : FactorSixteenRawPhysicalClosed T)
    (c t : Nat) :
    ¬ UniformOneOverNFailureAtHorizon
      (factorSixteenProtocol T) ring isLeaderOutput c t := by
  exact nonemptyZeroClass_not_uniformOneOverNFailure
    (factorSixteenProtocol T) ring isLeaderOutput
    (FactorSixteenRawBand (fun _ => True))
    ⟨factorSixteenEmbed rawZeroClosedN
      ⟨false, false, false, false⟩, .ofN, trivial⟩
    (by
      intro l r hl hr
      have hout := hclosed l r hl.1 hr.1
      exact ⟨⟨hout.1, trivial⟩, ⟨hout.2, trivial⟩⟩)
    (factorSixteenRawBand_output_false T (fun _ => True)) c t

