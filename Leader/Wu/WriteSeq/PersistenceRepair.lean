/-! ## Unequal comparison-command transport

An unequal comparison has three executable cases.  A larger target with a
flag-one writer overwrites; a larger target with a flag-zero writer only flips
the writer flag; and a smaller target moves the writer without changing the
target.  The proof relation below connects the comparison result, common flag,
and forward command without adding a protocol field.
-/

/-- The clean writer-control frame with one live forward command. -/
def WriterTransportCommandFrame (u : AgentState ψ)
    (command : WriteAction) : Prop :=
  u.leader = false ∧ u.write = command ∧ u.last = false ∧
    u.last_set = false ∧ u.last_unset = false ∧ u.ws_echo = false

/-- Exact command selected by an unequal comparison and the common writer
flag. -/
def WriterUnequalCommand (comparison : WriteState) (flag : Nat)
    (command : WriteAction) : Prop :=
  (comparison = .larger ∧ flag = 1 ∧ command = .overwrite) ∨
    (comparison = .larger ∧ flag = 0 ∧ command = .move_flip) ∨
    (comparison = .less ∧ command = .move)

/-- Every unequal command is nonempty, so the guarded Algorithm-20 handoff
moves it rather than discarding it. -/
theorem WriterUnequalCommand.ne_none
    {comparison : WriteState} {flag : Nat} {command : WriteAction}
    (h : WriterUnequalCommand comparison flag command) :
    command ≠ .none := by
  rcases h with ⟨_, _, rfl⟩ | ⟨_, _, rfl⟩ | ⟨_, rfl⟩ <;> decide

/-- Payload after executing an unequal action.  Overwrite and move-flip
complement the writer flag; move leaves the payload unchanged. -/
def writerUnequalPayload (command : WriteAction)
    (p3 : Path3Info) : Path3Info :=
  match command with
  | .overwrite | .move_flip => { p3 with flag := 1 - p3.flag }
  | _ => p3

/-- Physical target bit after executing an unequal action.  Only overwrite
changes it, copying the attached writer bit. -/
def writerUnequalBit (command : WriteAction)
    (p3 : Path3Info) (bit : Bool) : Bool :=
  match command with
  | .overwrite => p3.bit == 1
  | _ => bit

/-- A nonterminal unequal comparison creates its exact forward command on the
responder.  The comparison result is handed left, the discovered component is
retired, and the guarded Algorithm-20 tail preserves the new command. -/
theorem writeSeqPersistentComparisonTransportLifecycle_unequal_nonterminal
    (hψ : ψ > 0) (l r : AgentState ψ) (pL pR : Path3Info)
    (comparison : WriteState) (command : WriteAction)
    (hlpath : l.path3 = some pL) (hrpath : r.path3 = some pR)
    (hlstate : l.write_state = .equal) (hrstate : r.write_state = .none)
    (hlalign : l.label.val = pL.label)
    (hralign : r.label.val = pR.label)
    (hcompare : checkBitWS r.bit pR.bit = comparison)
    (hdecision : WriterUnequalCommand comparison pR.flag command)
    (hlcompare : l.label.val < ψ - 1)
    (hrzero : r.label ≠ ⟨0, hψ⟩)
    (hrterminal : r.label ≠ ⟨ψ - 1, by omega⟩)
    (horder : l.label < r.label)
    (hlclean : WriterTransportCleanFrame l)
    (hrclean : WriterTransportCleanFrame r) :
    let q := writeSeqPersistentComparisonTransportLifecycle hψ l r
    q.1.path3 = some pL ∧ q.1.write_state = comparison ∧
      q.1.label = l.label ∧ q.1.bit = l.bit ∧
      WriterTransportCleanFrame q.1 ∧
      q.2.path3 = some pR ∧ q.2.write_state = .depart ∧
      q.2.write = command ∧ q.2.label = r.label ∧ q.2.bit = r.bit ∧
      WriterTransportCommandFrame q.2 command := by
  have hpLcompare : pL.label < ψ - 1 := by omega
  rcases hlclean with ⟨hlleader, hlwrite, hllast, hllastSet,
    hllastUnset, hlecho⟩
  rcases hrclean with ⟨hrleader, hrwrite, hrlast, hrlastSet,
    hrlastUnset, hecho⟩
