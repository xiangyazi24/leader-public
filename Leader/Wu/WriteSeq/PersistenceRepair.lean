      ⟨rfl, hpflag, rfl⟩ | ⟨rfl, rfl⟩ <;>
    simp [WriterTransportCleanFrame, WriterTransportCommandFrame,
      writeSeqPersistentComparisonTransportLifecycle,
      clearInputIncrementPair, clearIncrementAction, writeSeqLeaderMove,
