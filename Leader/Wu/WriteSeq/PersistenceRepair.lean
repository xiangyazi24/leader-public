field. -/
theorem transportReady_inProtocolDomain
    (u : AgentState ψ) (hu : u.inProtocolDomain κ) :
    (writeSeqSetWriteReadyTransport u).inProtocolDomain κ := by
  cases hp : u.path3 with
  | none => simpa [writeSeqSetWriteReadyTransport, hp,
      AgentState.inProtocolDomain] using hu
  | some p3 =>
    by_cases hdepart : u.write_state = .depart
    · simpa [writeSeqSetWriteReadyTransport, hp, hdepart,
        AgentState.inProtocolDomain] using hu
    · by_cases halign : u.label.val = p3.label
      · by_cases hidle : u.write_state = .none <;>
          simpa [writeSeqSetWriteReadyTransport, hp, hdepart, halign, hidle,
            AgentState.inProtocolDomain] using hu
      · simpa [writeSeqSetWriteReadyTransport, hp, hdepart, halign,
          AgentState.inProtocolDomain] using hu

/-- Clearing an input increment changes no declared numeric-domain field. -/
theorem clearIncrementAction_inProtocolDomain
    (u : AgentState ψ) (hu : u.inProtocolDomain κ) :
    (clearIncrementAction u).inProtocolDomain κ := by
  unfold clearIncrementAction
  split <;> simpa [AgentState.inProtocolDomain] using hu

/-- Pair form of numeric-domain preservation for the input sanitizer. -/
theorem clearInputIncrementPair_inProtocolDomain
    (l r : AgentState ψ) (hl : l.inProtocolDomain κ)
    (hr : r.inProtocolDomain κ) :
    let q := clearInputIncrementPair l r
    q.1.inProtocolDomain κ ∧ q.2.inProtocolDomain κ := by
  exact ⟨clearIncrementAction_inProtocolDomain l hl,
    clearIncrementAction_inProtocolDomain r hr⟩

end PPLLWriteSeqPersistenceRepair
