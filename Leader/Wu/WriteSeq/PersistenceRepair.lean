import Leader.Wu.WriteSeq.IncrementGate
import Leader.Wu.WriteSeq.DeadBranches

/-!
# A persistent-state repair for Algorithm 16

Literal Algorithm 16 overwrites every non-`depart` `write_state` with `ready`,
which makes its propagated comparison and terminal branches dead.  This
separately named research repair changes only the ready-initialization stage:

* an aligned `path3` whose state is `none` becomes `ready`;
* an aligned non-idle state, including `equal`, `larger`, `less`, and `depart`,
  is preserved;
* a missing or misaligned `path3` is reset to `none`.

The full local stage also clears pre-existing `increment_group` actions before
preparation.  A terminal increment newly generated by the repaired
same-interaction comparison is consumed immediately by Algorithm 19, whereas
an arbitrary input increment is not trusted.  Other transported actions and
all pre-existing non-idle `write_state` values remain untouched. In particular
this module does not yet repair the condition-4 forged-`move_flip` obstruction,
prevent an arbitrary input `write_state` command, or claim a closed write
lifecycle.  It does repair the separate source omission in a legitimately
generated `increment_group`: every visited component flips its writer flag,
and carry completion propagates `move_flip` through the remaining components.

The second repair boundary below restores the intended handoff from Algorithm
19 to Algorithm 20.  Empty terminal commands no longer erase a live `depart`,
and an idle responder no longer overwrites an initiator's attached departure
state.  These two guards recover both inside-group and terminal-wrap path3
transfer while preserving same-call terminal increments.  They are source
changes, not interpretations of the printed assignments.

The third boundary makes movement a genuine one-group transport rather than a
one-edge event.  A present `depart` survives while its payload label is in
transit.  Algorithm 20 retires the transport exactly when the copied component
reaches the next physical host with the same label.  The cyclic label distance
is a strict finite rank: every successful stable-edge transfer consumes one
unit, starting at `ψ` on the source-aligned host and ending at zero on arrival.
This stop-on-alignment rule is a separately named repair; the printed
Algorithms 16 and 20 contain no such state transition.

The fourth boundary restores the unequal comparison commands. Printed
Algorithm 20 lines 23--25 copies the initiator `write` field to the responder
unconditionally, so an empty initiator erases a command just generated on the
responder by Algorithm 16. The repaired tail copies only a nonempty initiator
command. When a real backward action later supersedes a persistent
`larger`/`less` state, its propagation also clears the stale regenerated
command at that predecessor. These changes add no field; they make the three
existing actions `overwrite`, `move_flip`, and `move` follow one finite
clockwise-command/counterclockwise-action lifecycle.
-/

namespace PPLLWriteSeqPersistenceRepair

open PPLL PPLLWriteIncrementGate

/-- Repaired lines 7--11: initialize only an idle aligned component, preserve
an aligned active comparison/movement state, and clear a malformed component. -/
def writeSeqSetWriteReadyPersistent (u : AgentState ψ) : AgentState ψ :=
  match u.path3 with
  | some p3 =>
      if u.label.val = p3.label then
        if u.write_state = .none then { u with write_state := .ready }
        else u
      else { u with write_state := .none }
  | none => { u with write_state := .none }

/-! ## Stop-on-alignment transport state -/

/-- Repaired ready initialization for a moving writer component.  A present
`depart` is physical transport state and survives even while the host and
payload labels differ.  Other misaligned states still fail closed. -/
def writeSeqSetWriteReadyTransport (u : AgentState ψ) : AgentState ψ :=
  match u.path3 with
  | some p3 =>
      if u.write_state = .depart then u
      else if u.label.val = p3.label then
        if u.write_state = .none then { u with write_state := .ready }
        else u
      else { u with write_state := .none }
  | none => { u with write_state := .none }

/-- Remaining clockwise label steps to the next occurrence of `target`.
At an aligned departure the distance is `ψ`, not zero: the current occurrence
is the source group, so the component must make one complete label cycle. -/
def writerTransportDistance (ψ host target : Nat) : Nat :=
  if host = target then ψ
  else if host < target then target - host
  else ψ - host + target

/-- Physical rank of a live writer-transport component. -/
def writerTransportPhase (u : AgentState ψ) : Nat :=
  match u.path3 with
  | some p3 =>
      if u.write_state = .depart then
        writerTransportDistance ψ u.label.val p3.label
      else 0
  | none => 0

/-- Moving to the next stable physical label consumes exactly one unit of the
cyclic transport distance.  Arrival at the matching label is the zero-rank
branch. -/
theorem writerTransportDistance_successor
    (hψ : ψ > 0) (host target : Nat)
    (hhost : host < ψ) (htarget : target < ψ) :
    (if (host + 1) % ψ = target then 0
      else writerTransportDistance ψ ((host + 1) % ψ) target) + 1 =
        writerTransportDistance ψ host target := by
  by_cases hnowrap : host + 1 < ψ
  · rw [Nat.mod_eq_of_lt hnowrap]
    by_cases h1 : host + 1 = target <;>
      by_cases h2 : host + 1 < target <;>
      by_cases h3 : host = target <;>
      by_cases h4 : host < target <;>
      simp [writerTransportDistance, h1, h2, h3, h4] <;>
      first | omega | (split <;> omega)
  · have hwrap : host + 1 = ψ := by omega
    rw [hwrap, Nat.mod_self]
    by_cases h1 : 0 = target <;>
      by_cases h2 : 0 < target <;>
      by_cases h3 : host = target <;>
      by_cases h4 : host < target <;>
      simp [writerTransportDistance, h1, h2, h3, h4] <;> omega

/-- Pair form of the repaired ready-initialization stage. -/
def writeSeqReadyPersistent (l r : AgentState ψ) :
    AgentState ψ × AgentState ψ :=
  (writeSeqSetWriteReadyPersistent l, writeSeqSetWriteReadyPersistent r)

/-- Algorithm-16 command preparation with persistent comparison states. -/
def writeSeqPreparePersistent (hψ : ψ > 0)
    (l r : AgentState ψ) : AgentState ψ × AgentState ψ :=
  let q := writeSeqReadyPersistent l r
  let q := writeSeqCompare hψ q.1 q.2
  writeSeqCommands hψ q.1 q.2

/-- Pair form of stop-on-alignment ready initialization. -/
def writeSeqReadyTransport (l r : AgentState ψ) :
    AgentState ψ × AgentState ψ :=
  (writeSeqSetWriteReadyTransport l, writeSeqSetWriteReadyTransport r)

/-- Algorithm-16 preparation using physical writer-transport state. -/
def writeSeqPrepareTransport (hψ : ψ > 0)
    (l r : AgentState ψ) : AgentState ψ × AgentState ψ :=
  let q := writeSeqReadyTransport l r
  let q := writeSeqCompare hψ q.1 q.2
  writeSeqCommands hψ q.1 q.2

/-- Clear arbitrary input increments before Algorithm 16 can inspect them.
This sanitizer changes no other action and adds no state. -/
def clearInputIncrementPair (l r : AgentState ψ) :
    AgentState ψ × AgentState ψ :=
  (clearIncrementAction l, clearIncrementAction r)

/-- Repaired Algorithm 16: clear pre-existing increments, execute the original
leader/group/generation prefix, use persistent comparison preparation, retain
the existing prepared increment support gate, and then run Algorithms 19--20. -/
def writeSeqPersistentIncrementGate (hψ : ψ > 0)
    (l r : AgentState ψ) : AgentState ψ × AgentState ψ :=
  let q0 := clearInputIncrementPair l r
  let q1 := writeSeqLeaderMove hψ q0.1 q0.2
  let q2 := groupInfo hψ q1.1 q1.2
  let q3 := writeSeqGenerate hψ q2.1 q2.2
  let q4 := writeSeqPreparePersistent hψ q3.1 q3.2
  writeSeqAfterPrepare hψ
    (gatePreparedIncrement q4.1) (gatePreparedIncrement q4.2)

/-! ## Algorithm-19 to Algorithm-20 live handoff -/

/-- Source repair for Algorithm 19's increment branch.  The prose and the
Algorithm-16 comment require `increment_group` to flip the writer bit.  Every
component visited by the carry therefore flips its local `path3.flag`; after
the first zero group bit becomes one, the state changes to `move_flip` so the
remaining more-significant components flip their flags without changing their
group bits.  A pathless increment is retired fail-closed. -/
def writeActionApplyIncrementAndFlip (r : AgentState ψ) : AgentState ψ :=
  match r.path3 with
  | none => { r with write_state := .none }
  | some p3 =>
      let r := { r with path3 := some { p3 with flag := 1 - p3.flag } }
      if r.bit = true then { r with bit := false }
      else { r with bit := true, write_state := .move_flip }

/-- The repaired increment changes only the carrier flag inside `path3`; its
payload label and payload bit are preserved exactly. -/
theorem writeActionApplyIncrementAndFlip_path3_exact
    (r : AgentState ψ) (p3 : Path3Info) (hpath : r.path3 = some p3) :
    (writeActionApplyIncrementAndFlip r).path3 =
      some { p3 with flag := 1 - p3.flag } := by
  simp [writeActionApplyIncrementAndFlip, hpath]

/-- The increment/flag source repair preserves every declared value range. -/
theorem writeActionApplyIncrementAndFlip_inProtocolDomain {ψ κ : Nat}
    (r : AgentState ψ) (hr : r.inProtocolDomain κ) :
    (writeActionApplyIncrementAndFlip r).inProtocolDomain κ := by
  cases h : r.path3 with
  | none =>
      simp only [AgentState.inProtocolDomain] at hr ⊢
      simpa [writeActionApplyIncrementAndFlip, h] using hr
  | some p3 =>
      rcases hr with ⟨hcount, hpath, hpath2, hpath3, hpath4, hpath5⟩
      rw [h] at hpath3
      change p3.label < ψ ∧ p3.bit ≤ 1 ∧ p3.flag ≤ 1 at hpath3
      simp only [writeActionApplyIncrementAndFlip, h]
      split
      · exact ⟨hcount, hpath, hpath2,
          ⟨hpath3.1, hpath3.2.1, Nat.sub_le 1 p3.flag⟩, hpath4, hpath5⟩
      · exact ⟨hcount, hpath, hpath2,
          ⟨hpath3.1, hpath3.2.1, Nat.sub_le 1 p3.flag⟩, hpath4, hpath5⟩

/-- Repaired Algorithm-19 activation: a terminal endpoint consumes a command
only when the separate `write` field is nonempty.  In particular, an attached
`depart` path is not replaced by the idle image of `.none`. -/
def writeActionActivateNonempty (hψ : ψ > 0)
    (u : AgentState ψ) : AgentState ψ :=
  if u.label = ⟨ψ - 1, by omega⟩ ∧ u.write ≠ .none then
    { u with write_state := writeActionToState u.write, write := .none }
  else u

/-- Propagate an Algorithm-19 state to the preceding component.  A genuine
backward action supersedes any comparison command that the preceding
component may have regenerated from a stored `larger` or `less` result;
non-action states retain the command needed by the forward handoff. -/
def writeActionPropagateState (l : AgentState ψ)
    (state : WriteState) : AgentState ψ :=
  match state with
  | .overwrite | .move_flip | .move | .increment_group =>
      { l with write_state := state, write := .none }
  | _ => { l with write_state := state }

/-- A real backward action clears any command regenerated from the comparison
state it supersedes. -/
theorem writeActionPropagateState_action_write
    (l : AgentState ψ) (state : WriteState)
    (haction : state = .overwrite ∨ state = .move_flip ∨
      state = .move ∨ state = .increment_group) :
    (writeActionPropagateState l state).write = .none := by
  rcases haction with rfl | rfl | rfl | rfl <;>
    rfl

/-- Repaired Algorithm-19 execution: propagate a responder state left only
when it is active.  This preserves a `depart` attached to the initiator while
an empty responder is prepared for Algorithm-20 transfer. -/
def writeActionExecutePreservingDepart (hψ : ψ > 0)
    (l r : AgentState ψ) : AgentState ψ × AgentState ψ :=
  if l.label < r.label ∨ r.label = ⟨0, hψ⟩ then
    let r := if r.write_state = .overwrite then
      writeActionApplyOverwrite r
    else r
    let r := if r.write_state = .move_flip then
      writeActionApplyMoveFlip r
    else r
    let r := if r.write_state = .increment_group then
      writeActionApplyIncrementAndFlip r else r
    let l := if r.label ≠ ⟨0, hψ⟩ ∧ r.write_state ≠ .none then
      writeActionPropagateState l r.write_state
    else l
    (l, { r with write_state := .depart })
  else (l, r)

/-- Algorithm 19 with both live-handoff guards. -/
def writeActionPreservingDepart (hψ : ψ > 0)
    (l r : AgentState ψ) : AgentState ψ × AgentState ψ :=
  writeActionExecutePreservingDepart hψ
    (writeActionActivateNonempty hψ l) (writeActionActivateNonempty hψ r)

/-! ## Persistent comparison handoff

The line-8 repair makes a previous comparison result readable by the next
WRITE_SEQ interaction, but printed Algorithm 19 line 19 still replaces every
responder result by `depart` in the same call.  A whole-group comparison needs
the equal prefix to remain on the newly checked component until that component
becomes the initiator of the next stable-label edge.  The repair below keeps
exactly that unresolved `equal` state.  Terminal equality is unaffected:
Algorithm 16 first emits a nonempty command, and terminal activation converts
the state to `move_flip` or `increment_group` before this guard is inspected.
-/

/-- Preserve an unresolved equal prefix across Algorithm 19.  Every decided
order or activated terminal command continues through the guarded action and
departure logic, so this changes only the cross-interaction comparison token. -/
def writeActionExecutePreservingComparison (hψ : ψ > 0)
    (l r : AgentState ψ) : AgentState ψ × AgentState ψ :=
  if r.write_state = .equal then (l, r)
  else writeActionExecutePreservingDepart hψ l r

/-- Algorithm 19 with nonempty terminal activation, live departure handoff,
and persistence of an unresolved equal prefix. -/
def writeActionPreservingComparison (hψ : ψ > 0)
    (l r : AgentState ψ) : AgentState ψ × AgentState ψ :=
  writeActionExecutePreservingComparison hψ
    (writeActionActivateNonempty hψ l) (writeActionActivateNonempty hψ r)

/-- With no pending terminal command, Algorithm 19 is exactly the identity on
an unresolved responder equality.  This is the local persistence fact used by
the forward whole-group comparison sweep. -/
theorem writeActionPreservingComparison_equal_of_no_commands
    (hψ : ψ > 0) (l r : AgentState ψ)
    (hlwrite : l.write = .none) (hrwrite : r.write = .none)
    (hrequal : r.write_state = .equal) :
    writeActionPreservingComparison hψ l r = (l, r) := by
  simp [writeActionPreservingComparison, writeActionActivateNonempty,
    writeActionExecutePreservingComparison, hlwrite, hrwrite, hrequal]

/-- Repaired Algorithm-16 suffix using the guarded Algorithm 19 and unchanged
Algorithm 20. -/
def writeSeqAfterPreparePreservingDepart (hψ : ψ > 0)
    (l r : AgentState ψ) : AgentState ψ × AgentState ψ :=
  let q := writeActionPreservingDepart hψ l r
  moveWsig hψ q.1 q.2

/-- Combined positive lifecycle prototype: persistent Algorithm-16 comparison,
prepared increment validation, guarded Algorithm 19, and unchanged Algorithm
20 movement. -/
def writeSeqPersistentLifecycle (hψ : ψ > 0)
    (l r : AgentState ψ) : AgentState ψ × AgentState ψ :=
  let q0 := clearInputIncrementPair l r
  let q1 := writeSeqLeaderMove hψ q0.1 q0.2
  let q2 := groupInfo hψ q1.1 q1.2
  let q3 := writeSeqGenerate hψ q2.1 q2.2
  let q4 := writeSeqPreparePersistent hψ q3.1 q3.2
  writeSeqAfterPreparePreservingDepart hψ
    (gatePreparedIncrement q4.1) (gatePreparedIncrement q4.2)

/-! ## Exact one-group writer transport -/

/-- Algorithm-20 transfer with an explicit arrival rule.  A copied component
remains `depart` while its payload label and new host label differ.  At the
next matching host it becomes idle, so the next interaction can start the
group comparison instead of launching another unbounded lap. -/
def moveWsigTransferStopAligned (l r : AgentState ψ) :
    AgentState ψ × AgentState ψ :=
  match l.path3, r.path3 with
  | some p3, none =>
    if l.write_state = .depart then
      if r.ws_echo = false then
        let r := { r with
          path3 := some p3
          write_state := if r.label.val = p3.label then .none else .depart }
        let l := { l with path3 := none, write_state := .none, write := .none }
        let l := if l.last = true ∧ l.leader ≠ true then
          { l with ws_echo := true } else l
        (l, r)
      else
        ({ l with path3 := none, write := .none, write_state := .none }, r)
    else (l, r)
  | _, _ => (l, r)

/-! ## Live comparison-command handoff

Algorithm 16 creates the first `larger` or `less` command on the responder.
Printed Algorithm 20 lines 23--25 then copy the initiator's `write` field into
that responder unconditionally.  On the discovery edge the initiator command
is empty, so the newly generated decision is erased before it can travel to
the terminal component.  The repair below makes the same nonempty-handoff
choice already used for Algorithm-19 state propagation: an initiator command
moves forward when present, and otherwise the responder command is retained.
-/

/-- Move a write command forward only when the initiator actually carries one.
This preserves a command freshly generated on the responder instead of
overwriting it with `.none`. -/
def moveWsigMoveWritePreservingNonempty (l r : AgentState ψ) :
    AgentState ψ × AgentState ψ :=
  if l.label < r.label ∧ l.write ≠ .none then
    ({ l with write := .none }, { r with write := l.write })
  else (l, r)

/-- Printed Algorithm 20 erases any responder command on an increasing-label
edge when the initiator command is empty. This is the exact local source defect
that kills a freshly selected interior unequal command. -/
theorem moveWsigMoveWrite_erases_responder_command_of_empty
    (l r : AgentState ψ) (horder : l.label < r.label)
    (hlwrite : l.write = .none) :
    (moveWsigMoveWrite l r).2.write = .none := by
  simp [moveWsigMoveWrite, horder, hlwrite]

/-- The repaired handoff is identity when the initiator has no command, so a
fresh responder command is retained. -/
theorem moveWsigMoveWritePreservingNonempty_of_empty
    (l r : AgentState ψ) (hlwrite : l.write = .none) :
    moveWsigMoveWritePreservingNonempty l r = (l, r) := by
  simp [moveWsigMoveWritePreservingNonempty, hlwrite]

/-- Algorithm-20 tail with source-faithful command transport and unchanged
leader, signal, and echo movement. -/
def moveWsigFinishPreservingCommand (l r : AgentState ψ) :
    AgentState ψ × AgentState ψ :=
  let q := moveWsigMoveWritePreservingNonempty l r
  let q := moveWsigLeaderSignal q.1 q.2
  let q := moveWsigSignalMove q.1 q.2
  moveWsigEchoMove q.1 q.2

/-- Algorithm 20 with the stop-on-alignment transfer and the unchanged source
start, last-group cleanup, and control-signal tail. -/
def moveWsigStopAligned (_hψ : ψ > 0) (l r : AgentState ψ) :
    AgentState ψ × AgentState ψ :=
  let q := moveWsigStart l r
  let l := moveWsigCheckLast q.1
  let q := moveWsigTransferStopAligned l q.2
  moveWsigFinishPreservingCommand q.1 q.2

/-- Guarded Algorithm 19 followed by stop-on-alignment Algorithm 20. -/
def writeSeqAfterPrepareTransport (hψ : ψ > 0)
    (l r : AgentState ψ) : AgentState ψ × AgentState ψ :=
  let q := writeActionPreservingDepart hψ l r
  moveWsigStopAligned hψ q.1 q.2

/-- Algorithm-16 suffix that combines persistent comparison with bounded
one-group writer transport. -/
def writeSeqAfterPrepareComparisonTransport (hψ : ψ > 0)
    (l r : AgentState ψ) : AgentState ψ × AgentState ψ :=
  let q := writeActionPreservingComparison hψ l r
  moveWsigStopAligned hψ q.1 q.2

/-- Positive writer lifecycle with persistent comparison, repaired flag carry,
guarded state handoff, and bounded stop-on-alignment transport. -/
def writeSeqPersistentTransportLifecycle (hψ : ψ > 0)
    (l r : AgentState ψ) : AgentState ψ × AgentState ψ :=
  let q0 := clearInputIncrementPair l r
  let q1 := writeSeqLeaderMove hψ q0.1 q0.2
  let q2 := groupInfo hψ q1.1 q1.2
  let q3 := writeSeqGenerate hψ q2.1 q2.2
  let q4 := writeSeqPrepareTransport hψ q3.1 q3.2
  writeSeqAfterPrepareTransport hψ
    (gatePreparedIncrement q4.1) (gatePreparedIncrement q4.2)

/-- Corrected WRITE_SEQ lifecycle used by the condition-4 repair lane.  It
retains equal-prefix comparison progress, executes the repaired flag carry,
and transports decided writers with the stop-on-alignment rank. -/
def writeSeqPersistentComparisonTransportLifecycle (hψ : ψ > 0)
    (l r : AgentState ψ) : AgentState ψ × AgentState ψ :=
  let q0 := clearInputIncrementPair l r
  let q1 := writeSeqLeaderMove hψ q0.1 q0.2
  let q2 := groupInfo hψ q1.1 q1.2
  let q3 := writeSeqGenerate hψ q2.1 q2.2
  let q4 := writeSeqPrepareTransport hψ q3.1 q3.2
  writeSeqAfterPrepareComparisonTransport hψ
    (gatePreparedIncrement q4.1) (gatePreparedIncrement q4.2)

/-- A present departure survives Algorithm 16's repaired ready stage at every
intermediate host. -/
theorem transportReady_preserves_depart
    (u : AgentState ψ) (p3 : Path3Info) (hpath : u.path3 = some p3)
    (hdepart : u.write_state = .depart) :
    (writeSeqSetWriteReadyTransport u).write_state = .depart := by
  simp [writeSeqSetWriteReadyTransport, hpath, hdepart]

/-- Exact payload and arrival-state contract of the repaired Algorithm-20
transfer. -/
theorem moveWsigTransferStopAligned_exact
    (l r : AgentState ψ) (p3 : Path3Info)
    (hlpath : l.path3 = some p3) (hrpath : r.path3 = none)
    (hdepart : l.write_state = .depart) (hecho : r.ws_echo = false) :
    let q := moveWsigTransferStopAligned l r
    q.1.path3 = none ∧ q.2.path3 = some p3 ∧
      q.2.label = r.label ∧ q.2.write_state =
        (if r.label.val = p3.label then .none else .depart) := by
  simp [moveWsigTransferStopAligned, hlpath, hrpath, hdepart, hecho]

/-- The repaired physical transfer only moves an already range-valid `path3`
payload; its arrival-state choice changes no numeric protocol field. -/
theorem moveWsigTransferStopAligned_inProtocolDomain {ψ κ : Nat}
    (l r : AgentState ψ) (hl : l.inProtocolDomain κ)
    (hr : r.inProtocolDomain κ) :
    let q := moveWsigTransferStopAligned l r
    q.1.inProtocolDomain κ ∧ q.2.inProtocolDomain κ := by
  cases hL : l.path3 <;> cases hR : r.path3
  all_goals simp_all only [moveWsigTransferStopAligned]
  all_goals repeat split
  all_goals simp_all [AgentState.inProtocolDomain]

/-- The executable transfer realizes the arithmetic rank decrease. -/
theorem moveWsigTransferStopAligned_phase
    (hψ : ψ > 0) (l r : AgentState ψ) (p3 : Path3Info)
    (hlpath : l.path3 = some p3) (hrpath : r.path3 = none)
    (hdepart : l.write_state = .depart) (hecho : r.ws_echo = false)
    (hp3 : p3.label < ψ)
    (hlabel : r.label =
      ⟨(l.label.val + 1) % ψ, Nat.mod_lt _ hψ⟩) :
    let q := moveWsigTransferStopAligned l r
    writerTransportPhase q.2 + 1 = writerTransportPhase l := by
  have hmove := moveWsigTransferStopAligned_exact
    l r p3 hlpath hrpath hdepart hecho
  dsimp only at hmove ⊢
  have hval : r.label.val = (l.label.val + 1) % ψ :=
    congrArg Fin.val hlabel
  by_cases harrive : (l.label.val + 1) % ψ = p3.label
  · simpa [writerTransportPhase, hlpath, hdepart, hmove.2.1,
      hmove.2.2.1, hmove.2.2.2, hval, harrive] using
      (writerTransportDistance_successor hψ
        l.label.val p3.label l.label.isLt hp3)
  · simpa [writerTransportPhase, hlpath, hdepart, hmove.2.1,
      hmove.2.2.1, hmove.2.2.2, hval, harrive] using
      (writerTransportDistance_successor hψ
        l.label.val p3.label l.label.isLt hp3)

/-- On a clean transport edge the entire repaired Algorithms-16--20 lifecycle,
not merely its transfer primitive, moves the component exactly once.  The
source must not be an aligned last-group endpoint, which Algorithm 20 consumes
instead of forwarding; intermediate misalignment or `last=false` supplies the
two live cases used by a right-to-left group sweep. -/
theorem writeSeqPersistentTransportLifecycle_clean_edge
    (hψ : ψ > 0) (l r : AgentState ψ) (p3 : Path3Info)
    (hlpath : l.path3 = some p3) (hrpath : r.path3 = none)
    (hdepart : l.write_state = .depart)
    (hlwrite : l.write = .none) (hrwrite : r.write = .none)
    (hlleader : l.leader = false) (hrleader : r.leader = false)
    (hrlastSet : r.last_set = false) (hrlastUnset : r.last_unset = false)
    (hnotlast : l.label.val ≠ p3.label ∨ l.last = false)
    (hecho : r.ws_echo = false) :
    let q := writeSeqPersistentTransportLifecycle hψ l r
    q.1.path3 = none ∧ q.1.write_state = .none ∧
      q.2.path3 = some p3 ∧ q.2.label = r.label ∧
      q.2.write_state =
        (if r.label.val = p3.label then .none else .depart) ∧
      q.2.write = .none ∧ q.2.leader = false ∧
      q.2.last = r.last ∧ q.2.last_set = false ∧
      q.2.last_unset = false ∧ q.2.ws_echo = false := by
  rcases hnotlast with hmisaligned | hlast
  all_goals simp [writeSeqPersistentTransportLifecycle,
    clearInputIncrementPair, clearIncrementAction, writeSeqLeaderMove,
