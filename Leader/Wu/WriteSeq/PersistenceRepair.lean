/-- Fields that must remain clean while a right-to-left sweep reuses each
vacated source cell as the next responder. -/
def WriterTransportCleanFrame (u : AgentState ψ) : Prop :=
  u.leader = false ∧ u.write = .none ∧ u.last = false ∧
    u.last_set = false ∧ u.last_unset = false ∧ u.ws_echo = false

/-- Sweep-strengthened edge contract.  Both the vacated source and occupied
destination preserve the clean frame, so the next edge to the left can reuse
the source cell as its empty responder. -/
theorem writeSeqPersistentTransportLifecycle_clean_sweep_edge
    (hψ : ψ > 0) (l r : AgentState ψ) (p3 : Path3Info)
    (hlpath : l.path3 = some p3) (hrpath : r.path3 = none)
    (hdepart : l.write_state = .depart)
    (hlclean : WriterTransportCleanFrame l)
    (hrclean : WriterTransportCleanFrame r) :
    let q := writeSeqPersistentTransportLifecycle hψ l r
    q.1.path3 = none ∧ q.1.write_state = .none ∧
      q.1.label = l.label ∧ q.1.bit = l.bit ∧
      WriterTransportCleanFrame q.1 ∧
      q.2.path3 = some p3 ∧ q.2.label = r.label ∧
      q.2.bit = r.bit ∧
      q.2.write_state =
        (if r.label.val = p3.label then .none else .depart) ∧
      WriterTransportCleanFrame q.2 := by
  rcases hlclean with ⟨hlleader, hlwrite, hllast, hllastSet,
    hllastUnset, hlecho⟩
