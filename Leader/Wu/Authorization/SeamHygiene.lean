    ("sIRS6", sIRS6), ("sIRS7", sIRS7), ("sTG2", sTG2), ("sTG2L", sTG2L),
    ("sIRS8", sIRS8), ("sIRS9", sIRS9), ("sIRS4ng", sIRS4ng),
    ("sVplus", sVplus), ("sVplusC2", sVplusC2), ("sTG2WPC2", sTG2WPC2), ("sVplusE", sVplusE), ("sVplusET", sVplusET), ("sVplusETR", sVplusETR), ("sVplusETL", sVplusETL), ("sVplusETL2", sVplusETL2), ("sVplusETL4", sVplusETL4), ("sVplusETL8", sVplusETL8),
    ("sTG2W", sTG2W), ("sTG2P", sTG2P), ("sTG2WP", sTG2WP), ("sIRS9P", sIRS9P) ]

/-! ## Physical words (mirrors `PPLLAuthChamp.champRun`) -/

abbrev seamProtocol (hψ : ψ > 0) (κ : Nat) (c : SeamCfg) : PopulationProtocol where
  Q := AuthState ψ
  Y := Bool
  transition := seamStep hψ κ c
  output := fun a => a.core.leader

def seamRun {n : Nat} (hψ : ψ > 0) (κ : Nat) (c : SeamCfg) (ring : DirectedRing n)
    (C : Fin n → AuthState ψ) : List (Fin n) → (Fin n → AuthState ψ)
  | [] => C
  | e :: es => seamRun hψ κ c ring ((seamProtocol hψ κ c).step ring C e) es

/-- The seam protocol on cells carrying their EpisodeCap counter (`seamStepE`). -/
abbrev seamProtocolE (hψ : ψ > 0) (κ : Nat) (c : SeamCfg) : PopulationProtocol where
  Q := AuthState ψ × Fin 3
  Y := Bool
  transition := fun a b =>
    let (q, e) := seamStepE hψ κ c a.1 b.1 a.2 b.2
    ((q.1, e.1), (q.2, e.2))
  output := fun a => a.1.core.leader

def seamRunE {n : Nat} (hψ : ψ > 0) (κ : Nat) (c : SeamCfg) (ring : DirectedRing n)
    (C : Fin n → AuthState ψ × Fin 3) : List (Fin n) → (Fin n → AuthState ψ × Fin 3)
  | [] => C
  | e :: es => seamRunE hψ κ c ring ((seamProtocolE hψ κ c).step ring C e) es

abbrev seamProtocolA (hψ : ψ > 0) (κ : Nat) (c : SeamCfg) : PopulationProtocol where
  Q := (AuthState ψ × Fin 3) × Nat
  Y := Bool
  transition := fun a b =>
    let ((q, e), t) := seamStepA hψ κ c a.1.1 b.1.1 a.1.2 b.1.2 a.2 b.2
    (((q.1, e.1), t.1), ((q.2, e.2), t.2))
  output := fun a => a.1.1.core.leader

def seamRunA {n : Nat} (hψ : ψ > 0) (κ : Nat) (c : SeamCfg) (ring : DirectedRing n)
    (C : Fin n → (AuthState ψ × Fin 3) × Nat) : List (Fin n) → (Fin n → (AuthState ψ × Fin 3) × Nat)
  | [] => C
  | e :: es => seamRunA hψ κ c ring ((seamProtocolA hψ κ c).step ring C e) es

end PPLLAuthSeam
