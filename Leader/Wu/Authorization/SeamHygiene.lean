import Leader.Wu.Authorization.DebrisHygiene

/-!
# Narrower seam / hygiene treatments for the champion amendment (design study)

`PPLLAuthChamp.authFchamp` fences the two CLEAN slots facing a
physical terminal→head seam (`seamFence`) and scrubs `-1` commands, tokens, `E` and the
lottery bits on pathless cells (`emptyScrub`).  The regression battery
(`run/verification/g62/champ/REGRESSION.md`) attributes most same-cap regressions to
`seamFence`, and seed 309 needs *both* `seamFence` and `emptyScrub` off.  Without the
fence the two seam hazards return (a stale `-1` command on an occupied
head crosses the seam leftwards; a stale `path5` witness on an occupied
terminal turns into a self-deleting command at the seam).

This file factors both mechanisms into independent sub-flags and adds the
**impossible-record scrub** (IRS), which drops only CLEAN records that the dynamics of
`authFplusmcc` can never produce on an occupied cell and which are therefore pure
initial-state debris:

* `occCmd`: a `-1` command coexisting with a main path.  `cleanApplyAuth` resolves every
  command on an occupied cell in the edge that creates or moves it (delete the path, or
  clear the command on a mark mismatch); `wipeProduceAuth`, `clearCmpAuth` and the
  `step1Auth` arrival scrub clear both slots.  So (occupied ∧ command) at the start of an
  edge is debris.  Removes the stale-command hazard without touching pathless transport.
* `impWit`: a `path5` witness `(pl, b)` on an occupied terminal is reachable only with
  `b = 0` and `pl ≤ ψ-3` (it must have travelled through a hole; a witness generated at
  `pl` is consumed at the edge `(pl, pl+1)` whenever that cell is occupied, and the
  terminal rule of `step6Auth` sets `b := 0`).  Symmetrically a `path4` witness on an
  occupied head needs `b = 0` and `pl ≥ 2`.  Everything else is debris; at ψ = 2 every
  such witness is debris.  Removes the stale-witness hazard.  Non-endpoint occupied cells regenerate
  their witnesses in `genConnectAuth` every edge, so no rule is needed there.
* `endWit`: the stronger reading that drops *every* witness on an occupied endpoint
  (loses the ψ ≥ 3 hole-fragment detection through an occupied endpoint).

Seam sub-flags: `sfFull` (the full fence), `sfCmd` (fence only `-1` commands crossing
the seam), `sfNoGen` (no command generation by `step3Auth`/`step4Auth` on a seam edge).
Empty-cell sub-flags: `esCmd` (drop `-1` commands), `esTok` (drop `path2`), `esE`
(`eliminate_signal → none`), `esLottery` (`p := p_carry := false`); `PPLLAuthChamp`'s
`emptyScrub` is all four.  `lotteryScrub` and `strictScope` are reused verbatim from
`PPLLAuthChamp` through `toChamp`.

Nothing here edits an accepted module.  Design and battery:
`run/verification/g62/champ/SEAM_DESIGN_FABLE.md`.
-/

set_option autoImplicit false

namespace PPLLAuthSeam

open PPLL PPLLRepair PPLLBirthPatch PPLLBirthPatchM2 PPLLPostElectionGuard
open PPLLFableDesignR1 PPLLAstraDesign2 PPLLAstraDesign3 PPLLAuthF PPLLAuthChamp

variable {ψ : Nat}

structure SeamCfg where
  base : PPLLAuthF.Cfg := {}
  -- emptyScrub, factored
  esCmd : Bool := false
  esTok : Bool := false
  esE : Bool := false
  esLottery : Bool := false
  -- seam treatments
  sfFull : Bool := false
  sfCmd : Bool := false
  sfNoGen : Bool := false
  -- impossible-record scrub on occupied cells
  occCmd : Bool := false
  impWit : Bool := false
  endWit : Bool := false
  /-- Correction: key the non-generated witness slot on the CARRIED path
  label (`path4` when `path.label = 0`, `path5` when `path.label = ψ-1`), not on the
  physical label; every witness in that slot is dropped (it cannot be regenerated by
  `genConnectAuth` and is never installed on an occupied cell in a clean history). -/
  impWitCarried : Bool := false
  /-- Residual hazard: a session-scope control (A1/A3/A4) may enter a cell
  only if that cell has entered the session (a wave state, or a session-stamped depart
  with `ctrl_mark ≠ path_mark`); a lineage `depart` whose `ctrl_mark` merely equals the
  session mark is rejected. -/
  sessionGuard : Bool := false
  /-- `sessionGuard` restricted to the kill tokens A3/A4.  The full guard is refuted
  from a Fresh start (ψ=3, m=2, seeds 27/36/97 of `sstuck sIRS4 3 2 1 100 1 50000`): the
  A1/A2 comparison shuttle legitimately crosses the source block's lineage `depart`
  cells, and a session's mark can coincide with the current source lineage mark, so the
  full guard drops the shuttle and closes the session into a leaderless component of
  22490 states.  A1/A2 use `entry`; A3/A4 must land on a cell that entered the session. -/
  killGuard : Bool := false
  /-- Phase A candidate M1 (lineage-guarded release): the two `CHECK_ready → depart`
  releases (move stage last line, `releaseReadySuffix`) fire only when the departed
  successor carries the predecessor's `path_mark`; a foreign departed successor no longer
  releases an unchecked train. -/
  lineageRelease : Bool := false
  /-- Command-target guard (replaces `esCmd`): a leftward `-1` command (`path4`) never
  deletes a cell whose carried label is `ψ-1`, and a rightward `-1` command (`path5`)
  never deletes a cell whose carried label is `0`; such a command is cleared instead.  In
  a clean history a `path4` command returns from a `path5` witness, which only
  non-terminals emit, and walks the run leftwards through labels below the emitter's; a
  `path5` command returns from a `path4` witness, which only non-heads emit, and walks
  rightwards through labels above the emitter's.  Commands in transit through pathless
  cells (Wu's CLEAN return through holes) are untouched. -/
  cmdTarget : Bool := false
  /-- Addition P: at the post-Step1, pre-`moveTokensAuth` cut, an incoming
  valid session A2 (`Incoming2`) preempts line CHECK residue on a `LinePreemptible`
  destination (`claimA2` then `dropP2`).  Addition W is `impWitCarried`
  (ordinary path4 dropped on a carried head, ordinary path5 on a carried terminal;
  pathless records and commands kept). -/
  a2Preempt : Bool := false
  /-- Whole-ring round (PHASEA_WHOLERING_FABLE.md §4): reduced compare2 supplement to
  `maintainAuth` (non-terminal compare2 responder, terminal compare2 initiator facing a
  pathless successor).  Hygiene only; see `c2Maintain`. -/
  c2Release : Bool := false
  /-- EpisodeCap (PHASEA_WHOLERING_FABLE.md §9.3): each physical head carries
  a counter `episodes ∈ {0,1,2}` (`PPLLAuthSim.Marks.episodes`, threaded by `seamStepE`).
  The two counted `waveAuth` events at a physical head `r` (`r.core.label = 0`) are the
  session start (F 604–611) and the re-emission (F 622–626); at `episodes = 2` the event
  is suppressed and the head self-deletes (`path := ⊥`, `state := none`), the terminal
  untouched.  The first emission after acknowledgement (F 618–621) and `landForward`'s
  next-bit A2 are not counted.  After the row a cell whose main path changed is reset to
  0.  Only `seamStepE` sees the flag; `seamStep` ignores it. -/
  episodeCap : Bool := false
  /-- Repair of the EpisodeCap reset: the counter resets when the cell's
  packet is touched at ANY stage of the row — `(core.path, path_mark)` changed between
  two consecutive stages, or the cell entered `produce` (recruitment) — not only when
  the row's endpoint path differs from its input path (`seamStepE` without this flag
  keeps a stale count across an erase-then-refill row: `eliminateSig` erases the head,
  `step1Auth` refills it with the same `PathInfo`).  Every `path_mark` write site
  (`clearCmpAuth`, `genSigAuth` start/recruit/propagation, `step1Auth`) is a packet
  write, so a mark change identifies a replacement.  Residual blind spot: an erase and
  a same-value refill inside ONE stage function (none known). -/
  episodeResetTouch : Bool := false
  /-- Arm EpisodeCap on the reset wave (controller design after the §10.5 churn finding):
  the counter is charged and the break fires only while `reset_cmd = false` on both served
  cells (the zero-leader chain runs under RF; after the election the reset wave sets
  `reset_cmd = true` everywhere, `isSuppressed`).  With `reset_cmd` set on either cell the
  comparison lifecycle is the plain `waveAuth` and the counters are untouched. -/
  episodeResetArm : Bool := false
  /-- Arm EpisodeCap on a per-cell latch (`seamStepA`): the latch of a cell is set the first
  time the cell carries `reset_cmd` (the hopping token of Algorithm 14, emitted by a leader
  only) or is a leader, and is never cleared; while either served cell is latched the
  comparison lifecycle is the plain `waveAuth`.  A leaderless RF ring never sets a latch. -/
  episodeLatch : Bool := false
  /-- Grace of the latch (`episodeLatch`): `0` is the sticky latch (never cleared); `k > 0`
  sets the latch to `k` on a token visit / leader and drains it by one at every EpisodeCap
  charge event (session start or re-emission at a served physical head), so that a leaderless
  ring — which never refreshes it — is back to `sVplusET` after at most `k` charges per cell
  (self-stabilization: the initial latches are arbitrary). -/
  latchGrace : Nat := 0
  -- reused from PPLLAuthChamp
  lotteryScrub : Bool := false
  strictScope : Bool := false
  deriving Repr

def toChamp (c : SeamCfg) : ChampCfg :=
  { base := c.base, emptyScrub := false, seamFenceOn := false,
    lotteryScrub := c.lotteryScrub, strictScope := c.strictScope }

/-! ## Hygiene pass (after GENSIG, before CLEAN) -/

/-- Pathless non-producer: the four factored halves of `emptyScrub`. -/
def emptyHygiene (c : SeamCfg) (u : AuthState ψ) : AuthState ψ :=
  { u with core := { u.core with
      path4 := if c.esCmd && isCmd u.core.path4 then none else u.core.path4,
      path5 := if c.esCmd && isCmd u.core.path5 then none else u.core.path5,
      path2 := if c.esTok then none else u.core.path2,
      p := if c.esLottery then false else u.core.p,
      p_carry := if c.esLottery then false else u.core.p_carry,
      state := if c.esE && u.core.state = .eliminate_signal then .none else u.core.state } }

/-- Is a `path5` witness `(pl, b)` on an occupied cell of physical label `ℓ` reachable?
Only on the terminal, with `b = 0` and `pl + 2 ≤ ℓ`. -/
def witness5OK (ℓ : Nat) (rec : Int × Nat) : Bool :=
  rec.2 == 0 && (rec.1 + 2 ≤ (ℓ : Int))

/-- Is a `path4` witness `(pl, b)` on an occupied cell of physical label `ℓ` reachable?
Only on the head, with `b = 0` and `ℓ + 2 ≤ pl`. -/
def witness4OK (ℓ : Nat) (rec : Int × Nat) : Bool :=
  rec.2 == 0 && ((ℓ : Int) + 2 ≤ rec.1)

/-- Occupied cell: the impossible-record scrub.  With `impWitCarried` the non-generated
slot is determined by the carried path label; otherwise by the physical
label with the bit forms `witness4OK`/`witness5OK` (`impWit`) or unconditionally
(`endWit`). -/
def occHygiene (c : SeamCfg) (u : AuthState ψ) : AuthState ψ :=
  let ℓ := u.core.label.val
  let pl : Nat := match u.core.path with | .some pl _ => pl | .bot => ℓ
  let slot4 : Bool := if c.impWitCarried then pl == 0 else ℓ == 0
  let slot5 : Bool := if c.impWitCarried then pl == ψ - 1 else ℓ == ψ - 1
  let p4 := match u.core.path4 with
    | none => none
    | some rec =>
      if isCmd (some rec) then (if c.occCmd then none else some rec)
      else if slot4 then
        (if c.endWit || c.impWitCarried then none
         else if c.impWit && !witness4OK ℓ rec then none else some rec)
      else some rec
  let p5 := match u.core.path5 with
    | none => none
    | some rec =>
      if isCmd (some rec) then (if c.occCmd then none else some rec)
      else if slot5 then
        (if c.endWit || c.impWitCarried then none
         else if c.impWit && !witness5OK ℓ rec then none else some rec)
      else some rec
  { u with core := { u.core with path4 := p4, path5 := p5 } }

def hygieneOne (c : SeamCfg) (u : AuthState ψ) : AuthState ψ :=
  match u.core.path with
  | .some _ _ => occHygiene c u
  | .bot => if u.st = .produce then u else emptyHygiene c u

/-! ## CLEAN with seam treatments -/

def isSeam (l r : AuthState ψ) : Bool :=
  l.core.label.val == ψ - 1 && r.core.label.val == 0

/-- `sfFull`: the full fence; `sfCmd`: only commands are fenced. -/
def seamFenceS (c : SeamCfg) (l r : AuthState ψ) : AuthState ψ × AuthState ψ :=
  if !isSeam l r then (l, r)
  else if c.sfFull then
    ({ l with core := { l.core with path5 := none }, path5_mark := 0 },
     { r with core := { r.core with path4 := none }, path4_mark := 0 })
  else if c.sfCmd then
    ({ l with core := { l.core with path5 := if isCmd l.core.path5 then none else l.core.path5 } },
     { r with core := { r.core with path4 := if isCmd r.core.path4 then none else r.core.path4 } })
  else (l, r)

/-- `cleanApplyAuth` behind the command-target guard. -/
def cleanApplyS (c : SeamCfg) (u : AuthState ψ) : AuthState ψ :=
  if !c.cmdTarget then cleanApplyAuth u else
  match u.core.path with
  | .bot => u
  | .some pl _ =>
    let u := if pl == ψ - 1 && isCmd u.core.path4 then
      { u with core := { u.core with path4 := none } } else u
    let u := if pl == 0 && isCmd u.core.path5 then
      { u with core := { u.core with path5 := none } } else u
    cleanApplyAuth u

/-- `PPLLAuthF.cleanSourceAuth` with the seam fence variants after `genConnectAuth` and,
under `sfNoGen`, no `step3Auth`/`step4Auth` on a seam edge. -/
def seamCleanSourceAuth (hψ : ψ > 0) (c : SeamCfg) (l r : AuthState ψ) :
    AuthState ψ × AuthState ψ :=
  let l := genConnectAuth l
  let r := genConnectAuth r
  let (l, r) := seamFenceS c l r
  let skip := c.sfNoGen && isSeam l r
  let (l, r) := if skip then (l, r) else step3Auth c.base.cleanNbr c.base.markClean l r
  let (l, r) := if skip then (l, r) else step4Auth c.base.cleanNbr c.base.markClean l r
  let (l, r) := if isCmd l.core.path4 then (l, { r with core := { r.core with path4 := none } })
    else step5Auth hψ l r
  let (l, r) := if isCmd r.core.path5 then ({ l with core := { l.core with path5 := none } }, r)
    else step6Auth hψ l r
  (cleanApplyS c l, cleanApplyS c r)

/-! ## Token entry with the session guard -/

/-- `PPLLAuthF.entry` with, under `sessionGuard`, the destination of a session-scope
A1/A3/A4 required to have entered the session. -/
def entryS (c : SeamCfg) (src dst : AuthState ψ) (t : Path2Info) : Entry :=
  if c.killGuard && !c.sessionGuard then
    (if src.path2_scope == .session && (t.action == 3 || t.action == 4) then
      (if dst.hasPath && dst.ctrl_mark == src.path2_mark &&
          (waveState dst.st || (dst.st == .depart && dst.ctrl_mark != dst.path_mark)) then .ok
       else .reject)
     else entry c.base.claimCheck src dst t)
  else
  if !c.sessionGuard then entry c.base.claimCheck src dst t else
  if !dst.hasPath then .reject else
  match src.path2_scope with
  | .line => if dst.path_mark == src.path2_mark then .ok else .reject
  | .session =>
    if t.action = 2 then
      if dst.ctrl_mark == src.path2_mark && (waveState dst.st || dst.st == .depart) then .ok
      else if claimable c.base.claimCheck dst then .claim else .reject
    else if dst.ctrl_mark == src.path2_mark &&
        (waveState dst.st || (dst.st == .depart && dst.ctrl_mark != dst.path_mark)) then .ok
    else .reject

/-- `PPLLAuthF.moveTokensAuth` verbatim with `entry` replaced by `entryS`. -/
def seamMoveTokensAuth (c : SeamCfg) (l r : AuthState ψ) : AuthState ψ × AuthState ψ :=
  let cc := c.base.claimCheck
  let failA4 : Bool := match l.core.path2 with
    | some tl => c.base.retire && tl.action == 4 && l.path2_scope == .line && p2Valid l &&
        canMoveR l.core tl && r.hasPath && l.path2_mark != r.path_mark
    | none => false
  let failA2 : Bool := match r.core.path2 with
    | some tr => c.base.retire && tr.action == 2 && r.path2_scope == .session && p2Valid r &&
        canMoveL r.core tr && l.hasPath &&
        (waveState l.st || l.st == .CHECK_ready || l.st == .equal || l.st == .larger || l.st == .less) &&
        l.ctrl_mark != r.path2_mark && !claimable cc l
    | none => false
  if failA4 || failA2 then
    ((if failA4 then clearCmpAuth l else l), (if failA2 then clearCmpAuth r else r))
  else
  let eR : Entry := match l.core.path2 with
    | some tl => if canMoveR l.core tl then entryS c l r tl else .ok
    | none => .ok
  let eL : Entry := match r.core.path2 with
    | some tr => if canMoveL r.core tr then entryS c r l tr else .ok
    | none => .ok
  let l := if eR = .reject then l.dropP2 else l
  let r := if eL = .reject then r.dropP2 else r
  match l.core.path2, r.core.path2 with
  | some tl, some tr =>
    if canMoveR l.core tl ∧ canMoveL r.core tr then
      (receive eL r l (dec tr), receive eR l r (dec tl))
    else if canMoveR l.core tl ∧ rightward tr ∧ canMoveR r.core tr then
      (l.dropP2, r)
    else if canMoveL r.core tr ∧ leftward tl ∧ canMoveL l.core tl then
      (l, r.dropP2)
    else (l, r)
  | some tl, none =>
    if canMoveR l.core tl then (l.dropP2, receive eR l r (dec tl)) else (l, r)
  | none, some tr =>
    if canMoveL r.core tr then (receive eL r l (dec tr), r.dropP2) else (l, r)
  | none, none => (l, r)

/-- `PPLLAuthChamp.champMoveSourceAuth` verbatim with `seamMoveTokensAuth`. -/
def seamMoveSourceAuth (hψ : ψ > 0) (c : SeamCfg) (l r : AuthState ψ) :
    AuthState ψ × AuthState ψ :=
  let cc := toChamp c
  let nextLabel : Fin ψ := ⟨(l.core.label.val + 1) % ψ, Nat.mod_lt _ hψ⟩
  let l := if l.core.leader = true ∨ (r.core.leader = true ∧ r.core.label ≠ nextLabel) then
    clearCmpAuth l else l
  let r := if r.core.leader = true then clearCmpAuth r else r
  let (l, r) := validateCheck l r
  let l := champSanitizeP2 cc l
  let r := champSanitizeP2 cc r
  let preL := l
  let preR := r
  let (l, r) := if l.st = .done then (l, r) else step1Auth l r
  let l := if c.lotteryScrub then
      match preL.core.path, preR.core.path, l.core.path with
      | .some _ _, .bot, .bot => { l with core := { l.core with p := false, p_carry := false } }
      | _, _, _ => l
    else l
  let l := if c.a2Preempt then
      let incoming2 : Bool := match r.core.path2 with
        | some t => r.path2_scope == .session && p2Valid r && t.action == 2 && canMoveL r.core t
        | none => false
      let linePre : Bool := l.hasPath && l.ctrl_mark == l.path_mark &&
        (l.st == .depart || l.st == .equal || l.st == .less) &&
        (match l.core.path2 with
          | none => true
          | some t' => t'.action == 6 && l.path2_scope == .line && l.path2_mark == l.path_mark)
      if incoming2 && linePre then (claimA2 r.path2_mark l).dropP2 else l
    else l
  let (l, r) := seamMoveTokensAuth c l r
  let (l, r) := leaderWallAuth l r
  let l := applyControlAuth hψ l
  let r := applyControlAuth hψ r
  let l := if r.st = .depart ∧ l.core.label.val < ψ - 1 ∧ l.st = .CHECK_ready ∧
      (!c.lineageRelease || r.path_mark == l.path_mark) then
    l.lineage .depart else l
  (l, r)

/-- `PPLLAuthF.repairAuth` with `releaseReadySuffix` lineage-guarded under `lineageRelease`. -/
def seamRepairAuth (c : SeamCfg) (l r : AuthState ψ) : AuthState ψ × AuthState ψ :=
  let l := liftLife (fun u => normalizeCarrier (normalizeOrphan u)) l
  let r := liftLife (fun u => normalizeCarrier (normalizeOrphan u)) r
  let (l, r) := if c.lineageRelease && l.path_mark != r.path_mark then (l, r)
    else lift2Life releaseReadySuffix l r
  ackTailAuth l r

/-! ## compare2 maintenance supplement (c2Release) -/

/-- Reduced compare2 supplement (PHASEA_WHOLERING_FABLE.md §4).
`maintainAuth` (F 564–569) already handles a `compare2` initiator: a non-terminal becomes
`none`, a terminal is kept only while its successor is a same-control locked head.  The two
cases it does not cover: (i) a non-terminal `compare2` RESPONDER (released here to lineage
`depart`, one row earlier than its own outgoing edge would), (ii) a terminal `compare2`
initiator facing a pathless successor (kept by `maintainAuth`'s `.bot` clause; released
here so the emitter tail of a deleted target moves as an ordinary depart).  Tokens are
retained.  Not needed for any known closed family; hygiene only. -/
def c2Maintain (l r : AuthState ψ) : AuthState ψ × AuthState ψ :=
  let last := ψ - 1
  let r := match r.core.path with
    | .some rl _ => if r.st == .compare2 && rl != last then r.lineage .depart else r
    | .bot => r
  let l := match l.core.path, r.core.path with
    | .some ll _, .bot => if l.st == .compare2 && ll == last then l.lineage .depart else l
    | _, _ => l
  (l, r)

/-- `PPLLAuthF.compareLifecycleAuth` with `c2Maintain` after `maintainAuth` under
`c2Release`. -/
def compareLifecycleS (κ : Nat) (c : SeamCfg) (l r : AuthState ψ) : AuthState ψ × AuthState ψ :=
  if !c.c2Release then compareLifecycleAuth κ l r else
  let l := match l.core.path with
    | .bot => if l.st = .produce then l else l.setState .none
    | .some _ _ => l
  let (l, r) := maintainAuth l r
  let (l, r) := c2Maintain l r
  let (l, r) := completeWaveAuth l r
  let (l, r) := waveAuth l r
  let (l, r) := lift2 PPLLFableDesignR1.dropStray l r
  (landBackwardAuth l, landForwardAuth κ r)

/-! ## EpisodeCap -/

/-- `PPLLAuthF.waveAuth` (F 601–628) with the episode counter `er` of the responder `r`.
Counted events: the session start and the re-emission, both only when `r` is a physical
head (`r.core.label = 0`).  With `er < 2` the ordinary branch fires and `er` increments;
with `er = 2` the branch is suppressed and `r` self-deletes, `l` untouched.  A non-head
`r` is treated exactly as in `waveAuth` and never counted. -/
def waveAuthE (l r : AuthState ψ) (er : Fin 3) : (AuthState ψ × AuthState ψ) × Fin 3 :=
  let last := ψ - 1
  match l.core.path, r.core.path with
  | .some ll _, .some rl _ =>
    let head : Bool := decide (r.core.label.val = 0)
    let start : Bool := decide (ll = last) && decide (rl = 0) && l.st == .depart &&
      r.st == .depart && l.ctrl_mark == l.path_mark && r.ctrl_mark == r.path_mark &&
      !sessionTokenOn l && !sessionTokenOn r
    if start && head && er.val = 2 then
      ((l, { r with core := { r.core with path := .bot, state := .none } }), er)
    else
    let er : Fin 3 := if start && head then
      (if h : er.val < 2 then ⟨er.val + 1, by omega⟩ else er) else er
    let (l, r) := if start then
      let σ := fresh3 l.ctrl_mark r.ctrl_mark
      ({ l with ctrl_mark := σ },
       { r with core := { r.core with state := .lock, path2 := none, path4 := none, path5 := none },
                ctrl_mark := σ })
      else (l, r)
    let r := if l.st = .lock ∧ rl = ll + 1 ∧ r.st = .depart then
      { (r.setState (if rl = last then .compare1 else .lock)) with ctrl_mark := l.ctrl_mark } else r
    let l := if r.st = .compare1 ∧ rl = ll + 1 ∧ l.st = .lock ∧ r.ctrl_mark = l.ctrl_mark then
      l.setState .compare1 else l
    let l := if ll = last ∧ rl = 0 ∧ r.st = .compare1 ∧
        (l.st = .depart ∨ lockedState l.st) ∧ l.ctrl_mark = r.ctrl_mark then
      { l with core := { l.core with state := .compare2, path2 := some (a2Token (ψ := ψ)) },
               path2_scope := .session, path2_mark := r.ctrl_mark } else l
    let reemit : Bool := decide (ll = last ∧ rl = 0 ∧ r.st = .compare1 ∧ l.st = .compare2 ∧
        l.core.path2 = none ∧ r.core.path2 = none ∧ l.ctrl_mark = r.ctrl_mark)
    if reemit && head && er.val = 2 then
      ((l, { r with core := { r.core with path := .bot, state := .none } }), er)
    else
    let er : Fin 3 := if reemit && head then
      (if h : er.val < 2 then ⟨er.val + 1, by omega⟩ else er) else er
    let l := if reemit then
      { l with core := { l.core with path2 := some (a2Token (ψ := ψ)) },
               path2_scope := .session, path2_mark := r.ctrl_mark } else l
    ((l, r), er)
  | _, _ => ((l, r), er)

/-- `compareLifecycleS` with `waveAuthE` (the `c2Release` supplement kept). -/
def compareLifecycleE (κ : Nat) (c : SeamCfg) (l r : AuthState ψ) (er : Fin 3) :
    (AuthState ψ × AuthState ψ) × Fin 3 :=
  let l := match l.core.path with
    | .bot => if l.st = .produce then l else l.setState .none
    | .some _ _ => l
  let (l, r) := maintainAuth l r
  let (l, r) := if c.c2Release then c2Maintain l r else (l, r)
  let (l, r) := completeWaveAuth l r
  let ((l, r), er) := waveAuthE l r er
  let (l, r) := lift2 PPLLFableDesignR1.dropStray l r
  ((landBackwardAuth l, landForwardAuth κ r), er)


/-- `compareLifecycleE` with an explicit arm: while `armed` the wave is `waveAuth` and the
counter is untouched (`compareLifecycleE` is the case `armed = false`; kept separate so that
the accepted stage lemmas on `compareLifecycleE` are unaffected).  Also returns whether the
row is an EpisodeCap charge event (what `waveAuthE` would count), for the latch drain. -/
def compareLifecycleA (κ : Nat) (c : SeamCfg) (l r : AuthState ψ) (er : Fin 3) (armed : Bool) :
    ((AuthState ψ × AuthState ψ) × Fin 3) × Bool :=
  let l := match l.core.path with
    | .bot => if l.st = .produce then l else l.setState .none
    | .some _ _ => l
  let (l, r) := maintainAuth l r
  let (l, r) := if c.c2Release then c2Maintain l r else (l, r)
  let (l, r) := completeWaveAuth l r
  -- charge event of EpisodeCap on this row (session start / re-emission at a physical head)
  let charged : Bool := (waveAuthE l r 0).2 != 0
  let ((l, r), er) := if armed then (waveAuth l r, er) else waveAuthE l r er
  let (l, r) := lift2 PPLLFableDesignR1.dropStray l r
  (((landBackwardAuth l, landForwardAuth κ r), er), charged)

/-! ## Pipeline -/

def seamBeforeElimination (hψ : ψ > 0) (κ : Nat) (c : SeamCfg) (l r : AuthState ψ) :
    AuthState ψ × AuthState ψ :=
  let cc := toChamp c
  let q := lift2 (pPsiProbeWall hψ) l r
  let q := genSigAuth hψ κ q.1 q.2
  let q := (hygieneOne c q.1, hygieneOne c q.2)
  let q := seamCleanSourceAuth hψ c q.1 q.2
  let q := lift2Life (releaseSource hψ) q.1 q.2
  let q := lift2 (eliminateSig hψ) q.1 q.2
  let q := seamMoveSourceAuth hψ c q.1 q.2
  let q := (liftLife dropStale q.1, liftLife dropStale q.2)
  let q := preCheckResetAuth q.1 q.2
  let q := (liftLife normalizeReady q.1, liftLife normalizeReady q.2)
  let q := checkSourceAuth hψ c.base q.1 q.2
  let q := champDisappearAuth hψ cc q.1 q.2
  let q := seamRepairAuth c q.1 q.2
  let q := compareLifecycleS κ c q.1 q.2
  suppressSigResetKillAuth hψ q.1 q.2

def seamStep (hψ : ψ > 0) (κ : Nat) (c : SeamCfg) (l r : AuthState ψ) :
    AuthState ψ × AuthState ψ :=
  let q := seamBeforeElimination hψ κ c l r
  let q := lift2 (k4Kernel hψ) q.1 q.2
  let q := lift2 (writeWithBundle hψ) q.1 q.2
  conserveAuth l r q

/-- `seamBeforeElimination` with `compareLifecycleE`. -/
def seamBeforeEliminationE (hψ : ψ > 0) (κ : Nat) (c : SeamCfg) (l r : AuthState ψ)
    (er : Fin 3) : (AuthState ψ × AuthState ψ) × Fin 3 :=
  let cc := toChamp c
  let q := lift2 (pPsiProbeWall hψ) l r
  let q := genSigAuth hψ κ q.1 q.2
  let q := (hygieneOne c q.1, hygieneOne c q.2)
  let q := seamCleanSourceAuth hψ c q.1 q.2
  let q := lift2Life (releaseSource hψ) q.1 q.2
  let q := lift2 (eliminateSig hψ) q.1 q.2
  let q := seamMoveSourceAuth hψ c q.1 q.2
  let q := (liftLife dropStale q.1, liftLife dropStale q.2)
  let q := preCheckResetAuth q.1 q.2
  let q := (liftLife normalizeReady q.1, liftLife normalizeReady q.2)
  let q := checkSourceAuth hψ c.base q.1 q.2
  let q := champDisappearAuth hψ cc q.1 q.2
  let q := seamRepairAuth c q.1 q.2
  let (q, er) := compareLifecycleE κ c q.1 q.2 er
  (suppressSigResetKillAuth hψ q.1 q.2, er)

/-- Packet touched between two stages (`episodeResetTouch`). -/
def pathTouched (p q : AuthState ψ) : Bool :=
  p.core.path != q.core.path || p.path_mark != q.path_mark ||
    (q.st == .produce && p.st != .produce)

@[inline] def touch2 (t : Bool × Bool) (p q : AuthState ψ × AuthState ψ) : Bool × Bool :=
  (t.1 || pathTouched p.1 q.1, t.2 || pathTouched p.2 q.2)

/-- `seamBeforeEliminationE` with the per-stage touch bits of the two cells. -/
def seamBeforeEliminationT (hψ : ψ > 0) (κ : Nat) (c : SeamCfg) (l r : AuthState ψ)
    (er : Fin 3) : ((AuthState ψ × AuthState ψ) × Fin 3) × (Bool × Bool) :=
  let cc := toChamp c
  let p := (l, r)
  let q := lift2 (pPsiProbeWall hψ) p.1 p.2
  let t := touch2 (false, false) p q
  let p := q
  let q := genSigAuth hψ κ p.1 p.2
  let t := touch2 t p q
  let p := q
  let q := (hygieneOne c p.1, hygieneOne c p.2)
  let t := touch2 t p q
  let p := q
  let q := seamCleanSourceAuth hψ c p.1 p.2
  let t := touch2 t p q
  let p := q
  let q := lift2Life (releaseSource hψ) p.1 p.2
  let t := touch2 t p q
  let p := q
  let q := lift2 (eliminateSig hψ) p.1 p.2
  let t := touch2 t p q
  let p := q
  let q := seamMoveSourceAuth hψ c p.1 p.2
  let t := touch2 t p q
  let p := q
  let q := (liftLife dropStale p.1, liftLife dropStale p.2)
  let t := touch2 t p q
  let p := q
  let q := preCheckResetAuth p.1 p.2
  let t := touch2 t p q
  let p := q
  let q := (liftLife normalizeReady p.1, liftLife normalizeReady p.2)
  let t := touch2 t p q
  let p := q
  let q := checkSourceAuth hψ c.base p.1 p.2
  let t := touch2 t p q
  let p := q
  let q := champDisappearAuth hψ cc p.1 p.2
  let t := touch2 t p q
  let p := q
  let q := seamRepairAuth c p.1 p.2
  let t := touch2 t p q
  let p := q
  let (q, er) := compareLifecycleE κ c p.1 p.2 er
  let t := touch2 t p q
  let p := q
  let q := suppressSigResetKillAuth hψ p.1 p.2
  let t := touch2 t p q
  ((q, er), t)

/-- `seamStepE` under `episodeResetTouch`: the counter of a cell resets whenever its
packet was touched at any stage of the row. -/
def seamStepT (hψ : ψ > 0) (κ : Nat) (c : SeamCfg) (l r : AuthState ψ) (el er : Fin 3) :
    (AuthState ψ × AuthState ψ) × (Fin 3 × Fin 3) :=
  let ((p, er), t) := seamBeforeEliminationT hψ κ c l r er
  let q := lift2 (k4Kernel hψ) p.1 p.2
  let t := touch2 t p q
  let p := q
  let q := lift2 (writeWithBundle hψ) p.1 p.2
  let t := touch2 t p q
  let p := q
  let q := conserveAuth l r p
  let t := touch2 t p q
  let el := if t.1 then 0 else el
  let er := if t.2 then 0 else er
  (q, (el, er))

/-- `seamStep` with the EpisodeCap counters `el`, `er` of the two cells threaded through.
Without `episodeCap` this is `seamStep` and the counters are untouched.
With it, after the row a cell whose main path changed has its counter reset to 0
(endpoint inequality; with `episodeResetTouch`, `seamStepT`'s per-stage touch). -/
def seamStepE (hψ : ψ > 0) (κ : Nat) (c : SeamCfg) (l r : AuthState ψ) (el er : Fin 3) :
    (AuthState ψ × AuthState ψ) × (Fin 3 × Fin 3) :=
  if !c.episodeCap then (seamStep hψ κ c l r, (el, er)) else
  if c.episodeResetTouch then seamStepT hψ κ c l r el er else
  let (q, er) := seamBeforeEliminationE hψ κ c l r er
  let q := lift2 (k4Kernel hψ) q.1 q.2
  let q := lift2 (writeWithBundle hψ) q.1 q.2
  let q := conserveAuth l r q
  let el := if q.1.core.path = l.core.path then el else 0
  let er := if q.2.core.path = r.core.path then er else 0
  (q, (el, er))


/-! ## Armed pipeline (`seamStepA`, §10.8 of the Phase-A memo)

Copies of `seamBeforeEliminationE`/`seamBeforeEliminationT`/`seamStepT`/`seamStepE` with an
explicit `armed : Bool` reaching `compareLifecycleA`; the originals are untouched so that
accepted stage lemmas keep their targets.  `seamStepA` computes the arm from the flags:
`episodeResetArm` (both served cells' `reset_cmd`) and `episodeLatch` (per-cell latches
`al`/`ar`, set on carrying `reset_cmd` or being a leader, never cleared). -/

def seamBeforeEliminationA (hψ : ψ > 0) (κ : Nat) (c : SeamCfg) (l r : AuthState ψ)
    (er : Fin 3) (armed : Bool) : ((AuthState ψ × AuthState ψ) × Fin 3) × Bool :=
  let cc := toChamp c
  let q := lift2 (pPsiProbeWall hψ) l r
  let q := genSigAuth hψ κ q.1 q.2
  let q := (hygieneOne c q.1, hygieneOne c q.2)
  let q := seamCleanSourceAuth hψ c q.1 q.2
  let q := lift2Life (releaseSource hψ) q.1 q.2
  let q := lift2 (eliminateSig hψ) q.1 q.2
  let q := seamMoveSourceAuth hψ c q.1 q.2
  let q := (liftLife dropStale q.1, liftLife dropStale q.2)
  let q := preCheckResetAuth q.1 q.2
  let q := (liftLife normalizeReady q.1, liftLife normalizeReady q.2)
  let q := checkSourceAuth hψ c.base q.1 q.2
  let q := champDisappearAuth hψ cc q.1 q.2
  let q := seamRepairAuth c q.1 q.2
  let ((q, er), charged) := compareLifecycleA κ c q.1 q.2 er armed
  ((suppressSigResetKillAuth hψ q.1 q.2, er), charged)


def seamBeforeEliminationTA (hψ : ψ > 0) (κ : Nat) (c : SeamCfg) (l r : AuthState ψ)
    (er : Fin 3) (armed : Bool) : (((AuthState ψ × AuthState ψ) × Fin 3) × (Bool × Bool)) × Bool :=
  let cc := toChamp c
  let p := (l, r)
  let q := lift2 (pPsiProbeWall hψ) p.1 p.2
  let t := touch2 (false, false) p q
  let p := q
  let q := genSigAuth hψ κ p.1 p.2
  let t := touch2 t p q
  let p := q
  let q := (hygieneOne c p.1, hygieneOne c p.2)
  let t := touch2 t p q
  let p := q
  let q := seamCleanSourceAuth hψ c p.1 p.2
  let t := touch2 t p q
  let p := q
  let q := lift2Life (releaseSource hψ) p.1 p.2
  let t := touch2 t p q
  let p := q
  let q := lift2 (eliminateSig hψ) p.1 p.2
  let t := touch2 t p q
  let p := q
  let q := seamMoveSourceAuth hψ c p.1 p.2
  let t := touch2 t p q
  let p := q
  let q := (liftLife dropStale p.1, liftLife dropStale p.2)
  let t := touch2 t p q
  let p := q
  let q := preCheckResetAuth p.1 p.2
  let t := touch2 t p q
  let p := q
  let q := (liftLife normalizeReady p.1, liftLife normalizeReady p.2)
  let t := touch2 t p q
  let p := q
  let q := checkSourceAuth hψ c.base p.1 p.2
  let t := touch2 t p q
  let p := q
  let q := champDisappearAuth hψ cc p.1 p.2
  let t := touch2 t p q
  let p := q
  let q := seamRepairAuth c p.1 p.2
  let t := touch2 t p q
  let p := q
  let ((q, er), charged) := compareLifecycleA κ c p.1 p.2 er armed
  let t := touch2 t p q
  let p := q
  let q := suppressSigResetKillAuth hψ p.1 p.2
  let t := touch2 t p q
  (((q, er), t), charged)


def seamStepTA (hψ : ψ > 0) (κ : Nat) (c : SeamCfg) (l r : AuthState ψ) (el er : Fin 3)
    (armed : Bool) :
    ((AuthState ψ × AuthState ψ) × (Fin 3 × Fin 3)) × Bool :=
  let (((p, er), t), charged) := seamBeforeEliminationTA hψ κ c l r er armed
  let q := lift2 (k4Kernel hψ) p.1 p.2
  let t := touch2 t p q
  let p := q
  let q := lift2 (writeWithBundle hψ) p.1 p.2
  let t := touch2 t p q
  let p := q
  let q := conserveAuth l r p
  let t := touch2 t p q
  let el := if t.1 then 0 else el
  let er := if t.2 then 0 else er
  ((q, (el, er)), charged)


def seamStepEA (hψ : ψ > 0) (κ : Nat) (c : SeamCfg) (l r : AuthState ψ) (el er : Fin 3)
    (armed : Bool) :
    ((AuthState ψ × AuthState ψ) × (Fin 3 × Fin 3)) × Bool :=
  let ((q, er), charged) := seamBeforeEliminationA hψ κ c l r er armed
  let q := lift2 (k4Kernel hψ) q.1 q.2
  let q := lift2 (writeWithBundle hψ) q.1 q.2
  let q := conserveAuth l r q
  let el := if q.1.core.path = l.core.path then el else 0
  let er := if q.2.core.path = r.core.path then er else 0
  ((q, (el, er)), charged)


/-- Latch refresh of one cell (`episodeLatch` only): a token visit or a leader sets it to
`latchGrace` (sticky variant: to 1). -/
def latchArm (c : SeamCfg) (u : AuthState ψ) (a : Nat) : Nat :=
  if c.episodeLatch && (u.core.reset_cmd || u.core.leader) then
    (if c.latchGrace = 0 then max a 1 else c.latchGrace) else a

/-- Latch drain: a charge event lowers a graced latch by one (the sticky latch is kept). -/
def latchDrain (c : SeamCfg) (charged : Bool) (a : Nat) : Nat :=
  if charged && c.latchGrace != 0 then a - 1 else a

/-- `seamStepE` with the arm; without `episodeResetArm`/`episodeLatch` the result is
`seamStepE` and the latches are untouched.  Latches are refreshed from the input cells,
drained on a charge event, and refreshed again from the output cells (the token hops onto
`r`). -/
def seamStepA (hψ : ψ > 0) (κ : Nat) (c : SeamCfg) (l r : AuthState ψ) (el er : Fin 3)
    (al ar : Nat) : ((AuthState ψ × AuthState ψ) × (Fin 3 × Fin 3)) × (Nat × Nat) :=
  let al := latchArm c l al
  let ar := latchArm c r ar
  let armed := (c.episodeResetArm && (l.core.reset_cmd || r.core.reset_cmd)) ||
    (c.episodeLatch && (al > 0 || ar > 0))
  let ((q, ctr), charged) :=
    if !c.episodeCap then ((seamStep hψ κ c l r, (el, er)), false) else
    if c.episodeResetTouch then seamStepTA hψ κ c l r el er armed else
    seamStepEA hψ κ c l r el er armed
  let al := latchDrain c charged al
  let ar := latchDrain c charged ar
  ((q, ctr), (latchArm c q.1 al, latchArm c q.2 ar))

