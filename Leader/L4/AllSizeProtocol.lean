import Leader.L4.Count
import Init.Data.BitVec.Lemmas

/-! The scaled outer slices and the old-pair wiring.
Concrete row emitters must supply the indicated write masks; a typed row
without event masks is not a total padded-byte implementation. -/
namespace L4.AllSizeProtocol

/-- Width of UInt(q), with zero width for q≤1. -/
def ell (q : Nat) : Nat :=
  if q ≤ 1 then 0 else (q-1).log2+1

theorem ell_le_iff (q w : Nat) : ell q ≤ w ↔ q ≤ 2^w := by
  unfold ell
  split
  · rename_i h
    have hP : 0 < 2^w := Nat.pow_pos (by decide)
    omega
  · rename_i h
    have hh : q-1 ≠ 0 := by omega
    have H := Nat.log2_lt (k:=w) hh
    omega

theorem power_of_ell (q : Nat) : q ≤ 2^ell q :=
  (ell_le_iff q (ell q)).mp (Nat.le_refl _)

/-- This manifest is the reflected grammar's totals, not the older
sparse software dictionary. Its equality to generated byte offsets
is still a separate compiler obligation. -/
structure LongManifest where
  wordNodes : Nat
  scalarBits : Nat
  opcodes : Nat
  deriving DecidableEq, Repr

structure LargeParams where
  k1 : Nat
  k2 : Nat
  t2 : Nat
  J1 : Nat
  J2 : Nat
  r : Nat
  c : Nat
  p : Nat
  c1 : Nat
  alu : LongManifest
  deriving DecidableEq, Repr

def reportWidth (β t J : Nat) : Nat :=
  ell (max 3 t+1)+67+6*ell β+4*ell (5+4*t)+3*max 7 (2+2*ell β)+ell J

def longWidth (m : LongManifest) : Nat :=
  1162+12*ell m.opcodes+m.scalarBits+4*m.wordNodes

def publicWidth (p c1 : Nat) : Nat :=
  ell p+11+ell (4*c1+3)

/-- Long geometry off, successor-header and successor-end are included
in the Long slice; they are not extra top-level site bits. -/
def largeWidth (a : LargeParams) : Nat :=
  6+96+96+96+reportWidth (a.k1+1) 1 a.J1+reportWidth 2 a.t2 a.J2+
    (30+ell (a.c+1))+longWidth a.alu+8+publicWidth a.p a.c1

def boundedProviderWidth (N : Nat) : Nat := 5+ell (N+1)
def boundedWidth (N p c1 : Nat) : Nat := boundedProviderWidth N+8+publicWidth p c1

structure LargeSite (a : LargeParams) where
  physical : BitVec 6
  mis1 : BitVec 96
  mis2 : BitVec 96
  mis3 : BitVec 96
  report1 : BitVec (reportWidth (a.k1+1) 1 a.J1)
  report2 : BitVec (reportWidth 2 a.t2 a.J2)
  widthClient : BitVec (30+ell (a.c+1))
  long : BitVec (longWidth a.alu)
  guard : BitVec 8
  publicRow : BitVec (publicWidth a.p a.c1)

structure BoundedSite (N p c1 : Nat) where
  provider : BitVec (boundedProviderWidth N)
  guard : BitVec 8
  publicRow : BitVec (publicWidth p c1)

inductive Layout where
  | bounded (N p c1 : Nat)
  | large (params : LargeParams)

def Layout.State : Layout → Type
  | .bounded N p c1 => BoundedSite N p c1
  | .large a => LargeSite a

def Layout.width : Layout → Nat
  | .bounded N p c1 => boundedWidth N p c1
  | .large a => largeWidth a

private def rawWordCoding (w : Nat) : ExactCoding (BitVec w) (Fin (2^w)) :=
  ⟨BitVec.toFin, BitVec.ofFin, BitVec.ofFin_toFin, BitVec.toFin_ofFin⟩

private def castFinCoding {u v : Nat} (h : u=v) : ExactCoding (Fin u) (Fin v) :=
  h ▸ ExactCoding.id _

private def rawJoin {α β : Type} {a b : Nat}
    (x : ExactCoding α (Fin (2^a))) (y : ExactCoding β (Fin (2^b))) :
    ExactCoding (α × β) (Fin (2^(a+b))) :=
  (ExactCoding.pair x y).trans (castFinCoding (Nat.pow_add 2 a b).symm)

private def largeTuple (a : LargeParams) :=
  (((((((((BitVec 6 × BitVec 96) × BitVec 96) × BitVec 96) ×
    BitVec (reportWidth (a.k1+1) 1 a.J1)) × BitVec (reportWidth 2 a.t2 a.J2)) ×
    BitVec (30+ell (a.c+1))) × BitVec (longWidth a.alu)) × BitVec 8) ×
    BitVec (publicWidth a.p a.c1))

private def largeTupleCoding (a : LargeParams) : ExactCoding (LargeSite a) (largeTuple a) where
  encode x :=
    (((((((((x.physical,x.mis1),x.mis2),x.mis3),x.report1),x.report2),
      x.widthClient),x.long),x.guard),x.publicRow)
  decode
    | (((((((((ph,m1),m2),m3),r1),r2),w),l),g),u) => ⟨ph,m1,m2,m3,r1,r2,w,l,g,u⟩
  left_inv x := by cases x; rfl
  right_inv x := by rcases x with ⟨⟨⟨⟨⟨⟨⟨⟨⟨_,_⟩,_⟩,_⟩,_⟩,_⟩,_⟩,_⟩,_⟩,_⟩; rfl

set_option exponentiation.threshold 512 in
def largeCoding (a : LargeParams) : ExactCoding (LargeSite a) (Fin (2^largeWidth a)) :=
  (largeTupleCoding a).trans
    (rawJoin (rawJoin (rawJoin (rawJoin (rawJoin (rawJoin (rawJoin (rawJoin
      (rawJoin (rawWordCoding 6) (rawWordCoding 96)) (rawWordCoding 96)) (rawWordCoding 96))
      (rawWordCoding _)) (rawWordCoding _)) (rawWordCoding _)) (rawWordCoding _))
      (rawWordCoding 8)) (rawWordCoding _))

def boundedCoding (N p c1 : Nat) : ExactCoding (BoundedSite N p c1) (Fin (2^boundedWidth N p c1)) :=
  let tuple : ExactCoding (BoundedSite N p c1) _ :=
    ⟨fun x => ((x.provider,x.guard),x.publicRow), fun ((a,b),c) => ⟨a,b,c⟩,
      fun x => by cases x; rfl, fun x => by rcases x with ⟨⟨_,_⟩,_⟩; rfl⟩
  tuple.trans (rawJoin (rawJoin (rawWordCoding _) (rawWordCoding 8)) (rawWordCoding _))

/-- Exact padded state count. Layout is a common constant and costs
no stored advice/branch bit. Raw spare words are included. -/
def stateCoding (a : Layout) : ExactCoding a.State (Fin (2^a.width)) :=
  match a with
  | .large l => largeCoding l
  | .bounded N p c1 => boundedCoding N p c1

/-- Reusable quantitative conversion. A width bound in the emitted
age-dependent fields certifies an explicit polynomial cardinality. -/
theorem alphabet_bound (a : Layout) (s C D : Nat)
    (h : a.width ≤ C+D*ell (s+2)) :
    2^a.width ≤ (2^C*2^D)*(s+2)^D := by
  have cap : 2^ell (s+2) ≤ 2*(s+2) := by
    have hh : (s+2)-1 ≠ 0 := by omega
    have hh' : 2^(((s+2)-1).log2) ≤ (s+2)-1 := (Nat.le_log2 hh).mp (Nat.le_refl _)
    rw [ell, if_neg (by omega),Nat.pow_succ]
    have := Nat.mul_le_mul_right 2 hh'
    omega
  calc
    _ ≤ 2^(C+D*ell (s+2)) := Nat.pow_le_pow_right (by decide) h
    _ = 2^C*(2^ell (s+2))^D := by rw [Nat.pow_add,Nat.mul_comm D (ell (s+2)),Nat.pow_mul]
    _ ≤ 2^C*(2*(s+2))^D := Nat.mul_le_mul_left _ (Nat.pow_le_pow_left cap D)
    _ = _ := by rw [Nat.mul_pow, Nat.mul_assoc]

theorem ell_mono {a b : Nat} (h : a≤b) : ell a≤ell b :=
  (ell_le_iff a (ell b)).mpr (Nat.le_trans h (power_of_ell b))

theorem ell_mul_le (a b : Nat) : ell (a*b)≤ell a+ell b := by
  apply (ell_le_iff ..).mpr
  rw [Nat.pow_add]
  exact Nat.mul_le_mul (power_of_ell a) (power_of_ell b)

theorem ell_add_one_pow (k : Nat) : ell (2^k+1)=k+1 := by
  have H : 0<2^k := Nat.pow_pos (by decide)
  apply Nat.le_antisymm
  · apply (ell_le_iff ..).mpr
    rw [Nat.pow_succ]
    omega
  · have HH : ¬ell (2^k+1)≤k := fun h => by
      have := (ell_le_iff ..).mp h
      omega
    omega

theorem reportDigits_le (s k : Nat) (h : k≤2^s) : ell (k+1)≤s+1 :=
  Nat.le_trans (ell_mono (Nat.add_le_add_right h 1)) (Nat.le_of_eq (ell_add_one_pow s))

theorem boundedProviderWidth_pow (j : Nat) : boundedProviderWidth (2^j)=j+6 := by
  unfold boundedProviderWidth
  rw [ell_add_one_pow]
  omega

theorem productionProviderWidth : boundedProviderWidth (2^1024)=1030 :=
  boundedProviderWidth_pow 1024

private theorem ell_scale (s K d : Nat) (h : K ≤ 2^d * (s+2)) :
    ell K ≤ ell (s+2)+d := by
  apply (ell_le_iff ..).mpr
  rw [Nat.add_comm,Nat.pow_add]
  exact Nat.le_trans h (Nat.mul_le_mul_left _ (power_of_ell _))

/-- The production growth envelope: k1=s, t2≤s+1, c=s+11, and
the two streak capacities grow at most linearly with a fixed
coefficient A. Neither prefix length nor k2 contributes a separate
wide site register. Fixed public and grammar choices go in C. -/
theorem production_large_width (a : LargeParams) (s A : Nat)
    (hK : a.k1=s) (ht : a.t2≤s+1) (hc : a.c=s+11)
    (hJ1 : a.J1≤A*(s+2)) (hJ2 : a.J2≤A*(s+2)) :
    largeWidth a ≤
      (549+2*ell A+longWidth a.alu+publicWidth a.p a.c1)+20*ell (s+2) := by
  let E := ell (s+2)
  have hb : ell (a.k1+1)≤E := by rw [hK]; exact ell_mono (by omega)
  have hJ1' : ell a.J1≤ell A+E := Nat.le_trans (ell_mono hJ1) (ell_mul_le ..)
  have hJ2' : ell a.J2≤ell A+E := Nat.le_trans (ell_mono hJ2) (ell_mul_le ..)
  have hT1 : ell (max 3 a.t2+1)≤E+2 := by
    apply ell_scale
    omega
  have hT2 : ell (5+4*a.t2)≤E+3 := by
    apply ell_scale
    omega
  have hC : ell (a.c+1)≤E+3 := by
    apply ell_scale
    omega
  have hr1 : reportWidth (a.k1+1) 1 a.J1 ≤ 106+13*E+ell A := by
    unfold reportWidth
    change 2+67+6*ell (a.k1+1)+4*4+3*max 7 (2+2*ell (a.k1+1))+ell a.J1 ≤ _
    omega
  have hr2 : reportWidth 2 a.t2 a.J2 ≤ 108+6*E+ell A := by
    unfold reportWidth
    change ell (max 3 a.t2+1)+67+6*1+4*ell (5+4*a.t2)+3*7+ell a.J2 ≤ _
    omega
  change 6+96+96+96+reportWidth _ _ _+reportWidth _ _ _+
    (30+ell (a.c+1))+longWidth _+8+publicWidth _ _ ≤ _+20*E
  omega

/-- A prefix-length-independent finite alphabet for fixed grammar, provider
and public parameters. p and c1 may also be variable if their packed
contribution is accounted for separately. -/
theorem production_large_polynomial (a : LargeParams) (s A : Nat)
    (hK : a.k1=s) (ht : a.t2≤s+1) (hc : a.c=s+11)
    (hJ1 : a.J1≤A*(s+2)) (hJ2 : a.J2≤A*(s+2)) :
    2^largeWidth a ≤
      (2^(549+2*ell A+longWidth a.alu+publicWidth a.p a.c1)*2^20)*(s+2)^20 :=
  alphabet_bound (.large a) s _ 20 (production_large_width a s A hK ht hc hJ1 hJ2)

/-- A write-intent patch is not a decoded next value. A field written
even to its old decoded value may materialize canonical padding. -/
structure Patch (w : Nat) where
  mask : BitVec w
  value : BitVec w

def Patch.apply {w : Nat} (p : Patch w) (old : BitVec w) : BitVec w :=
  (old &&& ~~~p.mask) ||| (p.value &&& p.mask)

theorem Patch.hold {w : Nat} (p : Patch w) (old : BitVec w) (i : Nat)
    (h : p.mask.getLsbD i = false) :
    (p.apply old).getLsbD i = old.getLsbD i := by
  simp [Patch.apply,h]
  by_cases hi : i<w
  · simp [hi]
  · simp [hi,BitVec.getLsbD_of_ge old i (Nat.le_of_not_gt hi)]

theorem Patch.write {w : Nat} (p : Patch w) (old : BitVec w) (i : Nat)
    (h : p.mask.getLsbD i = true) :
    (p.apply old).getLsbD i = p.value.getLsbD i := by
  simp [Patch.apply,h]

def Patch.empty (w : Nat) : Patch w := ⟨0,0⟩

def Patch.compose {w : Nat} (first second : Patch w) : Patch w :=
  ⟨first.mask ||| second.mask, second.apply first.value⟩

theorem Patch.compose_apply {w : Nat} (first second : Patch w) (old : BitVec w) :
    (first.compose second).apply old = second.apply (first.apply old) := by
  apply BitVec.eq_of_getLsbD_eq
  intro i hi
  simp [Patch.compose,Patch.apply,hi]
  cases first.mask[i] <;> cases second.mask[i] <;> simp

def Patch.disjoint {w : Nat} (p q : Patch w) : Prop :=
  ∀ i, p.mask.getLsbD i = true → q.mask.getLsbD i = false

theorem Patch.commute {w : Nat} (p q : Patch w) (old : BitVec w)
    (h : p.disjoint q) : p.apply (q.apply old)=q.apply (p.apply old) := by
  apply (BitVec.eq_of_getLsbD_eq)
  intro i _
  cases hp : p.mask.getLsbD i
  · rw [p.hold _ i hp]
    cases hq : q.mask.getLsbD i
    · rw [q.hold _ i hq,q.hold _ i hq,p.hold _ i hp]
    · rw [q.write _ i hq,q.write _ i hq]
  · have hq := h i hp
    rw [p.write _ i hp,q.hold _ i hq,p.write _ i hp]

/-- One layout field in a contiguous raw lane. The proof of capacity
is part of the fixed layout, not a mutable site coordinate. -/
structure Field (w n : Nat) where
  offset : Nat
  fits : offset+n≤w

def Field.read {w n : Nat} (f : Field w n) (x : BitVec w) : BitVec n :=
  x.extractLsb' f.offset n

def Field.assign {w n : Nat} (f : Field w n) (x : BitVec n) : Patch w :=
  ⟨(BitVec.allOnes n).setWidth w <<< f.offset, x.setWidth w <<< f.offset⟩

theorem Field.inMask {w n : Nat} (f : Field w n) (x : BitVec n) (i : Nat) :
    (f.assign x).mask.getLsbD i = true ↔ f.offset≤i ∧ i<f.offset+n := by
  simp [Field.assign]
  have := f.fits
  omega

theorem Field.hold_outside {w n : Nat} (f : Field w n) (x : BitVec n) (raw : BitVec w)
    (i : Nat) (h : i<f.offset ∨ f.offset+n≤i) :
    ((f.assign x).apply raw).getLsbD i=raw.getLsbD i := by
  apply Patch.hold
  apply Bool.eq_false_iff.mpr
  intro hm
  have := (f.inMask x i).mp hm
  omega

theorem Field.read_assign {w n : Nat} (f : Field w n) (x : BitVec n) (raw : BitVec w) :
    f.read ((f.assign x).apply raw)=x := by
  apply BitVec.eq_of_getLsbD_eq
  intro j hj
  have hM := (f.inMask x (f.offset+j)).mpr ⟨by omega,by omega⟩
  have hW : f.offset+j<w := by have := f.fits; omega
  simp [Field.read,hj]
  rw [Patch.write _ _ _ hM]
  simp [Field.assign,hW,show j<w by omega,show ¬f.offset+j<f.offset by omega,←BitVec.getLsbD_eq_getElem]

theorem Field.read_other_assign {w n l : Nat} (f : Field w n) (g : Field w l)
    (v : BitVec l) (raw : BitVec w)
    (separate : f.offset+n≤g.offset ∨ g.offset+l≤f.offset) :
    f.read ((g.assign v).apply raw)=f.read raw := by
  apply BitVec.eq_of_getLsbD_eq
  intro j hj
  have h : f.offset+j<g.offset ∨ g.offset+l≤f.offset+j := by omega
  have H := g.hold_outside v raw (f.offset+j) h
  simpa only [Field.read,BitVec.getLsbD_extractLsb',hj,decide_true,Bool.true_and] using
    (show ((g.assign v).apply raw).getLsbD (f.offset+j)=raw.getLsbD (f.offset+j) from H)

abbrev Pair (α : Type) := α × α

def patchPair {w : Nat} (p : Pair (Patch w)) (x : Pair (BitVec w)) : Pair (BitVec w) :=
  (p.1.apply x.1,p.2.apply x.2)

/-- The only join-owned bits in a short-sheet slice. For the
high-first numeric layout the saturated offset is the leading field,
with successor-header immediately below it. -/
structure ShortGeo (w k : Nat) where
  off : Field w k
  successor : Field w 1
  order : successor.offset+1=off.offset

namespace ShortGeo

def mis : ShortGeo 96 2 := ⟨⟨94,by decide⟩,⟨93,by decide⟩,rfl⟩

def width (c : Nat) : ShortGeo (30+ell (c+1)) (ell (c+1)) :=
  ⟨⟨30,Nat.le_refl _⟩,⟨29,by omega⟩,rfl⟩

def report (β t J : Nat) :
    ShortGeo (reportWidth β t J) (ell (max 3 t+1)) := by
  let k := ell (max 3 t+1)
  let w := reportWidth β t J
  have h : k+1≤w := by simp only [w,k,reportWidth]; omega
  exact ⟨⟨w-k,by omega⟩,⟨w-k-1,by omega⟩,by change w-k-1+1=w-k; omega⟩

def owned {w k : Nat} (G : ShortGeo w k) (i : Nat) : Prop :=
  G.successor.offset≤i ∧ i<G.off.offset+k

/-- Discard any writes proposed to the join-owned geometry lane.
The geometry generator below is the sole writer, even on idempotent
and spare-valued inputs or a proposal with an overbroad work mask. -/
def work {w k : Nat} (G : ShortGeo w k) (q : Patch w) : Patch w :=
  ⟨q.mask &&& ~~~((G.off.assign 0).mask ||| (G.successor.assign 0).mask),q.value⟩

theorem work_owned_mask {w k : Nat} (G : ShortGeo w k) (q : Patch w) (i : Nat)
    (h : G.owned i) : (G.work q).mask.getLsbD i=false := by
  have hi : i<w := by have := G.off.fits; have := h.2; omega
  by_cases hs : i<G.off.offset
  · have he : ((G.successor.assign 0).mask).getLsbD i=true :=
      (G.successor.inMask _ _).mpr ⟨h.1,by have := G.order; omega⟩
    simp only [work,BitVec.getLsbD_and,BitVec.getLsbD_not,BitVec.getLsbD_or,hi,decide_true,he]
    simp
  · have he : ((G.off.assign 0).mask).getLsbD i=true :=
      (G.off.inMask _ _).mpr ⟨by omega,h.2⟩
    simp only [work,BitVec.getLsbD_and,BitVec.getLsbD_not,BitVec.getLsbD_or,hi,decide_true,he]
    simp

theorem work_other_mask {w k : Nat} (G : ShortGeo w k) (q : Patch w) (i : Nat)
    (h : ¬G.owned i) : (G.work q).mask.getLsbD i=q.mask.getLsbD i := by
  have ho : ((G.off.assign 0).mask).getLsbD i=false := by
    apply Bool.eq_false_iff.mpr
    intro hh
    have H := (G.off.inMask _ _).mp hh
    have E := G.order
    exact h ⟨by omega,H.2⟩
  have hs : ((G.successor.assign 0).mask).getLsbD i=false := by
    apply Bool.eq_false_iff.mpr
    intro hh
    have H := (G.successor.inMask _ _).mp hh
    have E := G.order
    exact h ⟨H.1,by omega⟩
  by_cases hi : i<w
  · simp only [work,BitVec.getLsbD_and,BitVec.getLsbD_not,BitVec.getLsbD_or,hi,decide_true,ho,hs]
    simp
  · simp [work,hi,BitVec.getLsbD_of_ge q.mask i (by omega)]

def effective {w k : Nat} (G : ShortGeo w k) (cap : Nat) (oldHeader : Bool)
    (old : BitVec w) : Nat :=
  if oldHeader then 0 else min cap (G.off.read old).toNat

def nextOff {w k : Nat} (G : ShortGeo w k) (cap : Nat) (h : Pair Bool)
    (x : Pair (BitVec w)) : BitVec k :=
  BitVec.ofNat k (if h.2 then 0 else min cap (G.effective cap h.1 x.1+1))

theorem nextOff_nat {w k : Nat} (G : ShortGeo w k) (cap : Nat) (h : Pair Bool)
    (x : Pair (BitVec w)) (hc : cap < 2^k) :
    (G.nextOff cap h x).toNat=
      (if h.2 then 0 else min cap (G.effective cap h.1 x.1+1)) := by
  unfold nextOff
  rw [BitVec.toNat_ofNat]
  apply Nat.mod_eq_of_lt
  split
  · exact Nat.zero_lt_of_lt hc
  · exact Nat.lt_of_le_of_lt (Nat.min_le_left _ _) hc

theorem ell_cap (cap : Nat) : cap<2^ell (cap+1) :=
  Nat.lt_of_lt_of_le (Nat.lt_succ_self _) (power_of_ell _)

def nextSuccessor (h : Pair Bool) : BitVec 1 := BitVec.ofNat 1 h.2.toNat

def patches {w k : Nat} (G : ShortGeo w k) (cap : Nat) (h : Pair Bool)
    (x : Pair (BitVec w)) (proposal : Pair (Patch w)) : Pair (Patch w) :=
  ((G.work proposal.1).compose (G.successor.assign (nextSuccessor h)),
   (G.work proposal.2).compose (G.off.assign (G.nextOff cap h x)))

theorem read_successor {w k : Nat} (G : ShortGeo w k) (cap : Nat) (h : Pair Bool)
    (x : Pair (BitVec w)) (p : Pair (Patch w)) :
    G.successor.read (patchPair (G.patches cap h x p) x).1=nextSuccessor h := by
  unfold patchPair patches
  rw [Patch.compose_apply,Field.read_assign]

theorem read_offset {w k : Nat} (G : ShortGeo w k) (cap : Nat) (h : Pair Bool)
    (x : Pair (BitVec w)) (p : Pair (Patch w)) :
    G.off.read (patchPair (G.patches cap h x p) x).2=G.nextOff cap h x := by
  change G.off.read (((G.work p.2).compose (G.off.assign (G.nextOff cap h x))).apply x.2)=_
  rw [Patch.compose_apply,Field.read_assign]

theorem held_offset {w k : Nat} (G : ShortGeo w k) (cap : Nat) (h : Pair Bool)
    (x : Pair (BitVec w)) (p : Pair (Patch w)) :
    G.off.read (patchPair (G.patches cap h x p) x).1=G.off.read x.1 := by
  apply BitVec.eq_of_getLsbD_eq
  intro j hj
  let i := G.off.offset+j
  have H := G.order
  have hf : i<G.off.offset+k := by dsimp [i]; omega
  have hb : G.off.offset≤i := by simp [i]
  have owned : G.owned i := ⟨by omega,hf⟩
  have outside : G.successor.offset+1≤i := by omega
  simp only [Field.read,BitVec.getLsbD_extractLsb',hj,decide_true,Bool.true_and]
  change (((G.patches cap h x p).1.apply x.1).getLsbD i)=x.1.getLsbD i
  unfold patches
  rw [Patch.compose_apply,Field.hold_outside _ _ _ _ (.inr outside),
    Patch.hold _ _ _ (G.work_owned_mask _ _ owned)]

theorem held_successor {w k : Nat} (G : ShortGeo w k) (cap : Nat) (h : Pair Bool)
    (x : Pair (BitVec w)) (p : Pair (Patch w)) :
    G.successor.read (patchPair (G.patches cap h x p) x).2=G.successor.read x.2 := by
  apply BitVec.eq_of_getLsbD_eq
  intro j hj
  have hz : j=0 := by omega
  subst j
  let i := G.successor.offset
  have H := G.order
  have owned : G.owned i := ⟨Nat.le_refl _,by dsimp [i]; omega⟩
  have outside : i<G.off.offset := by dsimp [i]; omega
  simp only [Field.read,BitVec.getLsbD_extractLsb',Nat.add_zero]
  change (((G.patches cap h x p).2.apply x.2).getLsbD i)=x.2.getLsbD i
  unfold patches
  rw [Patch.compose_apply,Field.hold_outside _ _ _ _ (.inl outside),
    Patch.hold _ _ _ (G.work_owned_mask _ _ owned)]

theorem work_agrees_outside {w k : Nat} (G : ShortGeo w k) (cap : Nat) (h : Pair Bool)
    (x : Pair (BitVec w)) (p : Pair (Patch w)) (i : Nat) (hi : ¬G.owned i) :
    ((patchPair (G.patches cap h x p) x).1.getLsbD i=
        (patchPair p x).1.getLsbD i) ∧
    ((patchPair (G.patches cap h x p) x).2.getLsbD i=
        (patchPair p x).2.getLsbD i) := by
  have he := G.order
  have o : i<G.off.offset ∨ G.off.offset+k≤i := by
    by_cases hh : i<G.off.offset
    · exact .inl hh
    · exact .inr (by
        apply Nat.le_of_not_gt; intro H
        exact hi ⟨by omega,H⟩)
  have s : i<G.successor.offset ∨ G.successor.offset+1≤i := by
    by_cases hh : i<G.successor.offset
    · exact .inl hh
    · exact .inr (by
        apply Nat.le_of_not_gt; intro H
        exact hi ⟨by omega,by omega⟩)
  have agree (q : Patch w) (old : BitVec w) :
      ((G.work q).apply old).getLsbD i=(q.apply old).getLsbD i := by
    have mask := G.work_other_mask q i hi
    unfold Patch.apply
    simp only [BitVec.getLsbD_or,BitVec.getLsbD_and,BitVec.getLsbD_not,mask]
    rfl
  unfold patchPair patches
  constructor
  · rw [Patch.compose_apply,Field.hold_outside _ _ _ _ s]
    exact agree p.1 x.1
  · change (((G.work p.2).compose (G.off.assign (G.nextOff cap h x))).apply x.2).getLsbD i=
      (p.2.apply x.2).getLsbD i
    rw [Patch.compose_apply,Field.hold_outside _ _ _ _ o]
    exact agree p.2 x.2

end ShortGeo

namespace PhysicalMIS

/-- The scaled order places the three role bits above x, left, right.
Raw role 5–7 decodes I but remains raw on a role-holding row. -/
def roleField : Field 6 3 := ⟨3,by decide⟩
def xField : Field 6 1 := ⟨2,by decide⟩
def leftField : Field 6 1 := ⟨1,by decide⟩
def rightField : Field 6 1 := ⟨0,by decide⟩

def rawRole (x : BitVec 6) : Nat := (roleField.read x).toNat

def role (x : BitVec 6) : Nat :=
  if rawRole x < 5 then rawRole x else 0

def selected (x : BitVec 6) : Bool := x.getLsbD 2

def writeX (x : BitVec 6) : Patch 6 :=
  if role x=2 then
    xField.assign (BitVec.ofBool (!(x.getLsbD 1 || x.getLsbD 0)))
  else Patch.empty 6

def writeRole (r : Nat) : Patch 6 := roleField.assign (BitVec.ofNat 3 r)

/-- Physical ordered pair over *raw* 6-bit fields. Roles
I/P/A/U/V are 0/1/2/3/4. Both old A commits use cached old
inputs, including on a same-mark role replacement. -/
def row (x : Pair (BitVec 6)) : Pair (Patch 6) :=
  let a := role x.1
  let b := role x.2
  let px := writeX x.1
  let py := writeX x.2
  if a=0 ∧ b=0 then
    (px.compose (writeRole 3),
     (py.compose (writeRole 1)).compose (leftField.assign (BitVec.ofBool (selected x.1))))
  else if a=1 ∧ (b=0 ∨ b=4) then
    ((px.compose (writeRole 2)).compose (rightField.assign (BitVec.ofBool (selected x.2))),
     py.compose (writeRole 4))
  else
    (if a=2 ∨ a=1 ∨ a=3 then px.compose (writeRole 0) else px,
     if b=2 ∨ b=1 ∨ b=4 then py.compose (writeRole 0) else py)

def next (x : Pair (BitVec 6)) : Pair (BitVec 6) := patchPair (row x) x

-- Role spares decode idle, participate in a launch, and are
-- canonically overwritten only on the written role sites.
example : next (60,48)=(28,10) := by decide

-- On an untouched role, the same spare is retained, not re-encoded.
example : next (60,32)=(60,0) := by decide

end PhysicalMIS

/-- The H0 physical tape is always present. All six other axes are
nested from that tape, even when an old selected bit is a raw spare. -/
structure Headers where
  h1 : Bool
  h2 : Bool
  h3 : Bool
  h4 : Bool
  h5 : Bool
  h6 : Bool
  deriving DecidableEq, Repr

structure LongGeometry where
  axes : Headers
  inside : Bool
  last : Bool
  offset : Nat
  successorEnd : Bool
  deriving DecidableEq, Repr

structure RefView where
  header : Bool
  current : Bool
  deriving DecidableEq, Repr

structure GuardWrites where
  slots : Pair (Patch 8)
  seed : Pair Bool

namespace H5

def aField : Field 8 3 := ⟨5,by decide⟩
def bField : Field 8 3 := ⟨2,by decide⟩
def pcField : Field 8 2 := ⟨0,by decide⟩

private def readToken (f : Field 8 3) (x : BitVec 8) : Nat :=
  let q := (f.read x).toNat
  if q≤5 then q else 0

private def readPC (x : BitVec 8) : Nat :=
  let q := (pcField.read x).toNat
  if q≤2 then q else 0

private def front (t : Nat) : Bool := t==2 || t==3
private def back (t : Nat) : Bool := t==4 || t==5
private def token (f : Field 8 3) (v : Nat) : Patch 8 := f.assign (BitVec.ofNat 3 v)
private def pc (v : Nat) : Patch 8 := pcField.assign (BitVec.ofNat 2 v)

def seesReference (x : RefView) : Bool := x.header && x.current

/-- Literal H5 table with explicit A/B/control write intents.
All ordinary mark arguments are from one previously evaluated public
pair. The extra seed occurs on the left endpoint only; a reference
withdrawn on the selected edge cannot seed. -/
def row (old : Pair (BitVec 8)) (oldRef newRef : Pair RefView)
    (marks ordinary : Pair Bool) : GuardWrites :=
  let u := old.1
  let v := old.2
  let ra := seesReference oldRef.1
  let rb := seesReference oldRef.2
  let na := seesReference newRef.1
  let nb := seesReference newRef.2
  let ua := readToken aField u
  let ub := readToken bField u
  let va := readToken aField v
  let vb := readToken bField v
  let up := readPC u
  let vp := readPC v
  let seed := rb && nb && (vp == 2)
  let seesA := fun t : Nat => (t==3) || marks.1 || ordinary.1 || seed
  let seesB := fun t : Nat => (t==3) || marks.2 || ordinary.2
  let crosses := marks.1 && !ordinary.1 && ordinary.2
  let seesHop := fun t : Nat => (t==3) || marks.2 || ordinary.1 || seed || crosses
  let markF := fun hit : Bool => if hit then 3 else 2
  let touched := fun f t hit => if front t then token f (markF hit) else Patch.empty 8
  let x := (touched aField ua (seesA ua)).compose (touched bField ub (seesA ub))
  let y := (touched aField va (seesB va)).compose (touched bField vb (seesB vb))
  let left := if ra then bField else aField
  let q := if ra then ub else ua
  let p := va
  let routed :=
    if front p then (x.compose (token left (markF (seesHop p))),y.compose (token aField 1))
    else if back q then (x.compose (token left 0),y.compose (token aField q))
    else if p==1 && q==0 then (x,y.compose (token aField 0))
    else (x,y)
  let x := routed.1
  let y := routed.2
  let x :=
    if ra then
      if up==0 then (x.compose (token aField (markF (seesA 2)))).compose (pc 1)
      else if up==1 && (back ua || ua==0) then
        (x.compose (token aField 0)).compose (pc (if ua==4 then 2 else 0))
      else x
    else x
  let y :=
    if rb then
      let y := if front vb then y.compose (token bField (if seesB vb then 5 else 4))
               else if vb==1 then y.compose (token bField 0)
               else y
      if vp==2 then y.compose (pc 0) else y
    else y
  let discard := (token bField 0).compose (pc 0)
  ⟨(if ra&&na then x else x.compose discard,
      if rb&&nb then y else y.compose discard),(seed,false)⟩

theorem seed_exact (old : Pair (BitVec 8)) (oldRef newRef : Pair RefView)
    (marks ordinary : Pair Bool) :
    (row old oldRef newRef marks ordinary).seed =
      (seesReference oldRef.2 && seesReference newRef.2 && (readPC old.2==2),false) := rfl

theorem withdrawal_no_seed (old : Pair (BitVec 8)) (oldRef newRef : Pair RefView)
    (marks ordinary : Pair Bool) (h : seesReference newRef.2=false) :
    (row old oldRef newRef marks ordinary).seed=(false,false) := by
  rw [seed_exact,h]
  simp

end H5

/-- Every input of the ordinary public row is the old public pair.
The concrete H5 bookkeeping separately receives the ordinary pre/post
markers, both private reference snapshots and both old guard words. Its
only extra public effect is the prescribed marker OR. -/
structure SharedRows (p c1 : Nat) where
  ordinaryPublic : Pair (BitVec (publicWidth p c1)) → Pair (Patch (publicWidth p c1))

/-- Exact radius-one old-read/write interface. The proof project has
not ingested every raw codec, canonicalization event, and literal
write-set generator. These are executable arguments, not assumptions
that the desired closure or progress properties already hold. -/
structure LargeRows (a : LargeParams) where
  misSelected : BitVec 96 → Bool
  report1Pulse : BitVec (reportWidth (a.k1+1) 1 a.J1) → Bool
  report2Pulse : BitVec (reportWidth 2 a.t2 a.J2) → Bool
  widthInside : BitVec (30+ell (a.c+1)) → Bool
  widthLast : BitVec (30+ell (a.c+1)) → Bool
  longOffset : BitVec (longWidth a.alu) → Nat
  longSuccessorEnd : BitVec (longWidth a.alu) → Bool
  longCurrH : BitVec (longWidth a.alu) → Bool
  mis : Pair Bool → Pair (BitVec 96) → Pair (Patch 96)
  report1 : Pair Bool → Pair (BitVec (reportWidth (a.k1+1) 1 a.J1)) →
    Pair (Patch (reportWidth (a.k1+1) 1 a.J1))
  report2 : Pair Bool → Pair (BitVec (reportWidth 2 a.t2 a.J2)) →
    Pair (Patch (reportWidth 2 a.t2 a.J2))
  widthClient : Pair Bool → Pair (BitVec (30+ell (a.c+1))) →
    Pair (Patch (30+ell (a.c+1)))
  longWork : Pair LongGeometry → Pair (BitVec (longWidth a.alu)) →
    Pair (Patch (longWidth a.alu))
  /-- Geometry scratch patches are reserved, disjoint from work under
  the actual table. Their masks are applied last, but read only old
  geometry and old long bytes. -/
  longScratch : Pair LongGeometry → Pair (BitVec (longWidth a.alu)) →
    Pair (Patch (longWidth a.alu))
  shared : SharedRows a.p a.c1

structure BoundedRows (N p c1 : Nat) where
  provider : Pair (BitVec (boundedProviderWidth N)) → Pair (Patch (boundedProviderWidth N))
  shared : SharedRows p c1

def Layout.Rows : (b : Layout) → Type
  | .large a => LargeRows a
  | .bounded N p c1 => BoundedRows N p c1

def oldHeaders {a : LargeParams} (b : LargeRows a) (x : LargeSite a) : Headers :=
  let h1 := PhysicalMIS.selected x.physical
  let h2 := h1 && b.misSelected x.mis1
  let h3 := h2 && b.misSelected x.mis2
  let h4 := h3 && b.misSelected x.mis3
  let h5 := h4 && b.report1Pulse x.report1
  let h6 := h5 && b.report2Pulse x.report2
  ⟨h1,h2,h3,h4,h5,h6⟩

def longGeometry {a : LargeParams} (b : LargeRows a) (x : LargeSite a) : LongGeometry :=
  ⟨oldHeaders b x,b.widthInside x.widthClient,b.widthLast x.widthClient,
    b.longOffset x.long,b.longSuccessorEnd x.long⟩

def reference {a : LargeParams} (b : LargeRows a) (x : LargeSite a) : RefView :=
  ⟨(oldHeaders b x).h6,b.longCurrH x.long⟩

def Pair.map {α β : Type} (f : α → β) (u : Pair α) : Pair β := (f u.1,f u.2)

/-! The long incoming door owns a source register and K0. The
repair is computed from the old right raw word, before an occupied
WAIT can be accepted. Numerical offsets use the high-first lanes. -/
namespace LongDoorGuard

def wordTail (m : LongManifest) : Nat := 464+4*m.wordNodes
def opcodeWidth (m : LongManifest) : Nat := ell m.opcodes
def tokenWidth (m : LongManifest) : Nat := 43+opcodeWidth m
def fileWidth (m : LongManifest) : Nat := 62+m.scalarBits
def sourceOffset (m : LongManifest) : Nat := wordTail m+11*tokenWidth m

def phaseField (m : LongManifest) : Field (longWidth m) 2 :=
  ⟨sourceOffset m+fileWidth m+opcodeWidth m,by
    unfold sourceOffset wordTail tokenWidth fileWidth opcodeWidth longWidth
    omega⟩

def opcodeField (m : LongManifest) : Field (longWidth m) (opcodeWidth m) :=
  ⟨sourceOffset m+fileWidth m,by
    unfold sourceOffset wordTail tokenWidth fileWidth opcodeWidth longWidth
    omega⟩

def fileField (m : LongManifest) : Field (longWidth m) (fileWidth m) :=
  ⟨sourceOffset m,by unfold sourceOffset wordTail tokenWidth fileWidth opcodeWidth longWidth; omega⟩

def k0Field (m : LongManifest) : Field (longWidth m) (tokenWidth m) :=
  ⟨wordTail m+10*tokenWidth m,by unfold wordTail tokenWidth opcodeWidth longWidth; omega⟩

def sourceField (m : LongManifest) : Field (longWidth m) (fileWidth m+opcodeWidth m+2) :=
  ⟨sourceOffset m,by unfold sourceOffset wordTail tokenWidth fileWidth opcodeWidth longWidth; omega⟩

def valid (m : LongManifest) (x : BitVec (longWidth m)) : Bool :=
  let phase := ((phaseField m).read x).toNat
  ((phase == 1) || (phase == 2)) && decide (((opcodeField m).read x).toNat < m.opcodes)

/-- ISSUE is one and the generated registry puts RSTOP at index zero.
The four writes are intentional even for idempotent/spare raw data.
The tag-empty K0 has zero inactive payload. -/
def repair (m : LongManifest) : Patch (longWidth m) :=
  (((phaseField m).assign 1).compose ((opcodeField m).assign 0)).compose
    (((fileField m).assign 0).compose ((k0Field m).assign 0))

def guard (m : LongManifest) (rightHeader : Bool) (old : BitVec (longWidth m))
    (q : Patch (longWidth m)) : Patch (longWidth m) :=
  if rightHeader && !valid m old then q.compose (repair m) else q

theorem invalid_override (m : LongManifest) (x : BitVec (longWidth m))
    (q : Patch (longWidth m)) (h : valid m x=false) :
    guard m true x q=q.compose (repair m) := by simp [guard,h]

theorem valid_no_override (m : LongManifest) (x : BitVec (longWidth m))
    (q : Patch (longWidth m)) (h : valid m x=true) :
    guard m true x q=q := by simp [guard,h]

theorem no_authority (m : LongManifest) (x : BitVec (longWidth m))
    (q : Patch (longWidth m)) :
    guard m false x q=q := by simp [guard]

private theorem phase_before_k0 (m : LongManifest) :
    (k0Field m).offset+tokenWidth m≤(phaseField m).offset := by
  simp [k0Field,phaseField,sourceOffset]; omega

private theorem file_before_phase (m : LongManifest) :
    (fileField m).offset+fileWidth m≤(phaseField m).offset := by
  simp [fileField,phaseField]

private theorem opcode_before_phase (m : LongManifest) :
    (opcodeField m).offset+opcodeWidth m≤(phaseField m).offset := by
  simp [opcodeField,phaseField]

private theorem k0_before_file (m : LongManifest) :
    (k0Field m).offset+tokenWidth m≤(fileField m).offset := by
  simp [k0Field,fileField,sourceOffset]; omega

private theorem file_before_opcode (m : LongManifest) :
    (fileField m).offset+fileWidth m≤(opcodeField m).offset := by
  simp [fileField,opcodeField]

theorem repair_values (m : LongManifest) (raw : BitVec (longWidth m)) :
    let y := (repair m).apply raw
    (phaseField m).read y=1 ∧ (opcodeField m).read y=0 ∧
    (fileField m).read y=0 ∧ (k0Field m).read y=0 := by
  dsimp only
  simp only [repair,Patch.compose_apply]
  refine ⟨?_,?_,?_,Field.read_assign _ _ _⟩
  · rw [Field.read_other_assign _ _ _ _ (.inr (phase_before_k0 m)),
      Field.read_other_assign _ _ _ _ (.inr (file_before_phase m)),
      Field.read_other_assign _ _ _ _ (.inr (opcode_before_phase m)),
      Field.read_assign]
  · have H := Nat.le_trans (k0_before_file m)
      (show (fileField m).offset≤(opcodeField m).offset by simp [fileField,opcodeField])
    rw [Field.read_other_assign _ _ _ _ (.inr H),
      Field.read_other_assign _ _ _ _ (.inr (file_before_opcode m)),
      Field.read_assign]
  · rw [Field.read_other_assign _ _ _ _ (.inr (k0_before_file m)),Field.read_assign]

theorem repair_holds_outside (m : LongManifest) (raw : BitVec (longWidth m)) (i : Nat)
    (hK : i<(k0Field m).offset ∨ (k0Field m).offset+tokenWidth m≤i)
    (hS : i<(sourceField m).offset ∨ (sourceField m).offset+(fileWidth m+opcodeWidth m+2)≤i) :
    ((repair m).apply raw).getLsbD i=raw.getLsbD i := by
  have hf : i<(fileField m).offset ∨ (fileField m).offset+fileWidth m≤i := by
    simp [fileField,sourceField] at hS ⊢; omega
  have hp : i<(phaseField m).offset ∨ (phaseField m).offset+2≤i := by
    simp [phaseField,sourceField] at hS ⊢; omega
  have ho : i<(opcodeField m).offset ∨ (opcodeField m).offset+opcodeWidth m≤i := by
    simp [opcodeField,sourceField] at hS ⊢; omega
  simp only [repair,Patch.compose_apply]
  rw [Field.hold_outside _ _ _ _ hK,Field.hold_outside _ _ _ _ hf,
    Field.hold_outside _ _ _ _ ho,Field.hold_outside _ _ _ _ hp]

/-- The join owns only right source and K0 at this invalid-door cut. -/
def pairGuard (m : LongManifest) (g : Pair LongGeometry) (x : Pair (BitVec (longWidth m)))
    (q : Pair (Patch (longWidth m))) : Pair (Patch (longWidth m)) :=
  (q.1,guard m g.2.axes.h6 x.2 q.2)

end LongDoorGuard

private def localWork {a : LargeParams} (b : LargeRows a) (x : Pair (LargeSite a)) :
    Pair (LargeSite a) :=
  let h := Pair.map (oldHeaders b) x
  let f := PhysicalMIS.next (Pair.map LargeSite.physical x)
  let m1 := Pair.map LargeSite.mis1 x
  let m2 := Pair.map LargeSite.mis2 x
  let m3 := Pair.map LargeSite.mis3 x
  let h1 := Pair.map Headers.h1 h
  let m1' := patchPair (ShortGeo.mis.patches 3 h1 m1 (b.mis h1 m1)) m1
  let h2 := Pair.map Headers.h2 h
  let m2' := patchPair (ShortGeo.mis.patches 3 h2 m2 (b.mis h2 m2)) m2
  let h3 := Pair.map Headers.h3 h
  let m3' := patchPair (ShortGeo.mis.patches 3 h3 m3 (b.mis h3 m3)) m3
  let r1 := Pair.map LargeSite.report1 x
  let r2 := Pair.map LargeSite.report2 x
  let h4 := Pair.map Headers.h4 h
  let r1' := patchPair ((ShortGeo.report (a.k1+1) 1 a.J1).patches 3 h4 r1 (b.report1 h4 r1)) r1
  let h5 := Pair.map Headers.h5 h
  let r2' := patchPair ((ShortGeo.report 2 a.t2 a.J2).patches (max 3 a.t2) h5 r2 (b.report2 h5 r2)) r2
  let w := Pair.map LargeSite.widthClient x
  let h6 := Pair.map Headers.h6 h
  let w' := patchPair ((ShortGeo.width a.c).patches a.c h6 w (b.widthClient h6 w)) w
  let g := Pair.map (longGeometry b) x
  let l := Pair.map LargeSite.long x
  let lw := b.longWork g l
  let ls := b.longScratch g l
  let proposal := (lw.1.compose ls.1,lw.2.compose ls.2)
  let l' := patchPair (LongDoorGuard.pairGuard a.alu g l proposal) l
  (⟨f.1,m1'.1,m2'.1,m3'.1,r1'.1,r2'.1,w'.1,l'.1,x.1.guard,x.1.publicRow⟩,
    ⟨f.2,m1'.2,m2'.2,m3'.2,r1'.2,r2'.2,w'.2,l'.2,x.2.guard,x.2.publicRow⟩)

/-- When interpreted as an unsigned mixed-radix word, the public
slice lists residue first (MSBs), then the mark, then the remaining
ten fixed bits and patrol-source bits. -/
def publicMarkOffset (c1 : Nat) : Nat := 10+ell (4*c1+3)

def setPublicMark {p c1 : Nat} (x : BitVec (publicWidth p c1)) (seed : Bool) :
    BitVec (publicWidth p c1) :=
  if seed then x ||| BitVec.ofNat _ (2^publicMarkOffset c1) else x

theorem setPublicMark_only_mark {p c1 : Nat} (x : BitVec (publicWidth p c1)) (seed : Bool)
    (i : Nat) (hi : i≠publicMarkOffset c1) :
    (setPublicMark (p:=p) (c1:=c1) x seed).getLsbD i=x.getLsbD i := by
  cases seed <;> simp [setPublicMark,BitVec.getLsbD_ofNat,Ne.symm hi]

theorem setPublicMark_at_mark {p c1 : Nat} (x : BitVec (publicWidth p c1)) (seed : Bool) :
    (setPublicMark (p:=p) (c1:=c1) x seed).getLsbD (publicMarkOffset c1)=
      (x.getLsbD (publicMarkOffset c1) || seed) := by
  have h : publicMarkOffset c1 < publicWidth p c1 := by
    unfold publicWidth publicMarkOffset
    omega
  cases seed <;> simp [setPublicMark,BitVec.getLsbD_ofNat,h]

private def sharedWork {p c1 : Nat} (b : SharedRows p c1)
    (guardOld : Pair (BitVec 8)) (views viewsNext : Pair RefView)
    (pub : Pair (BitVec (publicWidth p c1))) :
    Pair (BitVec 8) × Pair (BitVec (publicWidth p c1)) :=
  let q := patchPair (b.ordinaryPublic pub) pub
  let m := fun x : BitVec (publicWidth p c1) => x.getLsbD (publicMarkOffset c1)
  let u := H5.row guardOld views viewsNext (Pair.map m pub) (Pair.map m q)
  (patchPair u.slots guardOld,
    (setPublicMark (p:=p) (c1:=c1) q.1 u.seed.1,setPublicMark (p:=p) (c1:=c1) q.2 u.seed.2))

/-- Joined selected clockwise pair. H5 alone sees the updated
private outputs. No other consumer rereads them on this edge. -/
def largePair {a : LargeParams} (b : LargeRows a) (x : Pair (LargeSite a)) :
    Pair (LargeSite a) :=
  let y := localWork b x
  let (g,p) := sharedWork b.shared (Pair.map LargeSite.guard x)
    (Pair.map (reference b) x) (Pair.map (reference b) y) (Pair.map LargeSite.publicRow x)
  ({y.1 with guard:=g.1,publicRow:=p.1},{y.2 with guard:=g.2,publicRow:=p.2})

/-- The deployed packed alphabet has no observer or public modular row. -/
structure PackedCore (a : LargeParams) where
  physical : BitVec 6
  mis1 : BitVec 96
  mis2 : BitVec 96
  mis3 : BitVec 96
  report1 : BitVec (reportWidth (a.k1+1) 1 a.J1)
  report2 : BitVec (reportWidth 2 a.t2 a.J2)
  widthClient : BitVec (30+ell (a.c+1))
  long : BitVec (longWidth a.alu)

namespace PackedCore

def width (a : LargeParams) : Nat :=
  6+96+96+96+reportWidth (a.k1+1) 1 a.J1+reportWidth 2 a.t2 a.J2+
    (30+ell (a.c+1))+longWidth a.alu

def project {a : LargeParams} (x : LargeSite a) : PackedCore a :=
  ⟨x.physical,x.mis1,x.mis2,x.mis3,x.report1,x.report2,x.widthClient,x.long⟩

def lift {a : LargeParams} (x : PackedCore a) : LargeSite a :=
  ⟨x.physical,x.mis1,x.mis2,x.mis3,x.report1,x.report2,x.widthClient,x.long,0,0⟩

@[simp] theorem project_lift {a : LargeParams} (x : PackedCore a) :
    project (lift x) = x := by cases x; rfl

/-- Only the private work rows execute. The lift is a proof adapter and its
unused zero fields do not belong to the state alphabet. -/
def pair {a : LargeParams} (b : LargeRows a) (x : Pair (PackedCore a)) :
    Pair (PackedCore a) :=
  Pair.map project (localWork b (Pair.map lift x))

theorem pair_projects {a : LargeParams} (b : LargeRows a) (x : Pair (LargeSite a)) :
    Pair.map project (largePair b x) = pair b (Pair.map project x) := by
  rcases x with ⟨l,r⟩
  cases l
  cases r
  rfl

theorem reference_projects {a : LargeParams} (b : LargeRows a) (x : LargeSite a) :
    reference b (lift (project x)) = reference b x := by cases x; rfl

set_option exponentiation.threshold 512 in
def coding (a : LargeParams) : ExactCoding (PackedCore a) (Fin (2^width a)) :=
  let tuple : ExactCoding (PackedCore a) _ :=
    ⟨fun x => (((((((x.physical,x.mis1),x.mis2),x.mis3),x.report1),x.report2),
      x.widthClient),x.long),
      fun (((((((ph,m1),m2),m3),r1),r2),w),l) => ⟨ph,m1,m2,m3,r1,r2,w,l⟩,
      fun x => by cases x; rfl,
      fun x => by rcases x with ⟨⟨⟨⟨⟨⟨⟨_,_⟩,_⟩,_⟩,_⟩,_⟩,_⟩,_⟩; rfl⟩
  tuple.trans (rawJoin (rawJoin (rawJoin (rawJoin (rawJoin (rawJoin
      (rawJoin (rawWordCoding 6) (rawWordCoding 96)) (rawWordCoding 96)) (rawWordCoding 96))
      (rawWordCoding _)) (rawWordCoding _)) (rawWordCoding _)) (rawWordCoding _))

theorem production_width (a : LargeParams) (s A : Nat)
    (hK : a.k1=s) (ht : a.t2≤s+1) (hc : a.c=s+11)
    (hJ1 : a.J1≤A*(s+2)) (hJ2 : a.J2≤A*(s+2)) :
    width a ≤ (541+2*ell A+longWidth a.alu)+20*ell (s+2) := by
  have h := production_large_width a s A hK ht hc hJ1 hJ2
  change width a+8+publicWidth a.p a.c1 ≤ _ at h
  omega

end PackedCore

def ShortGeo.Refresh {w k : Nat} (G : ShortGeo w k) (cap : Nat)
    (h : Pair Bool) (old y : Pair (BitVec w)) : Prop :=
  G.successor.read y.1=ShortGeo.nextSuccessor h ∧
  G.off.read y.2=G.nextOff cap h old ∧
  G.off.read y.1=G.off.read old.1 ∧
  G.successor.read y.2=G.successor.read old.2

theorem ShortGeo.refresh {w k : Nat} (G : ShortGeo w k) (cap : Nat) (h : Pair Bool)
    (x : Pair (BitVec w)) (work : Pair (Patch w)) :
    G.Refresh cap h x (patchPair (G.patches cap h x work) x) :=
  ⟨G.read_successor cap h x work,G.read_offset cap h x work,
    G.held_offset cap h x work,G.held_successor cap h x work⟩

/-- All six short-sheet cache writers are literal actions of largePair.
Each right-header value is from the old lower slice, including when
that lower slice commits on the same edge. -/
theorem largePair_short_geometry {a : LargeParams} (b : LargeRows a) (x : Pair (LargeSite a)) :
    let h := Pair.map (oldHeaders b) x
    let y := largePair b x
    ShortGeo.mis.Refresh 3 (Pair.map Headers.h1 h) (Pair.map LargeSite.mis1 x) (Pair.map LargeSite.mis1 y) ∧
    ShortGeo.mis.Refresh 3 (Pair.map Headers.h2 h) (Pair.map LargeSite.mis2 x) (Pair.map LargeSite.mis2 y) ∧
    ShortGeo.mis.Refresh 3 (Pair.map Headers.h3 h) (Pair.map LargeSite.mis3 x) (Pair.map LargeSite.mis3 y) ∧
    (ShortGeo.report (a.k1+1) 1 a.J1).Refresh 3 (Pair.map Headers.h4 h)
      (Pair.map LargeSite.report1 x) (Pair.map LargeSite.report1 y) ∧
    (ShortGeo.report 2 a.t2 a.J2).Refresh (max 3 a.t2) (Pair.map Headers.h5 h)
      (Pair.map LargeSite.report2 x) (Pair.map LargeSite.report2 y) ∧
    (ShortGeo.width a.c).Refresh a.c (Pair.map Headers.h6 h)
      (Pair.map LargeSite.widthClient x) (Pair.map LargeSite.widthClient y) := by
  exact ⟨ShortGeo.refresh ..,ShortGeo.refresh ..,ShortGeo.refresh ..,
    ShortGeo.refresh ..,ShortGeo.refresh ..,ShortGeo.refresh ..⟩

theorem largePair_projects_physical {a : LargeParams} (b : LargeRows a) (x : Pair (LargeSite a)) :
    Pair.map LargeSite.physical (largePair b x)=PhysicalMIS.next (Pair.map LargeSite.physical x) := rfl

/-- A commit can flip the right header on this very edge. The
successor cache still samples the original zero header. -/
theorem geometry_old_snapshot_regression :
    let raw := (BitVec.ofNat 6 0,BitVec.ofNat 6 16)
    let h := Pair.map PhysicalMIS.selected raw
    let x : Pair (BitVec 96) := (BitVec.ofNat 96 (2^93),0)
    let y := patchPair (ShortGeo.mis.patches 3 h x (Patch.empty 96,Patch.empty 96)) x
    PhysicalMIS.selected (PhysicalMIS.next raw).2=true ∧
      ShortGeo.mis.successor.read y.1=0 := by decide

/-- The join owns these masks even when the assigned bit is already
zero. A bogus proposal to either reserved field cannot change the
endpoint on which that field is specified to hold. -/
theorem geometry_mask_regression :
    let h : Pair Bool := (false,false)
    let x : Pair (BitVec 96) := (0,BitVec.ofNat 96 (2^93))
    let bogus := ShortGeo.mis.off.assign (3 : BitVec 2)
    let p := ShortGeo.mis.patches 3 h x (bogus,ShortGeo.mis.successor.assign 0)
    let y := patchPair p x
    p.1.mask.getLsbD 93=true ∧ p.1.mask.getLsbD 94=false ∧
    p.2.mask.getLsbD 93=false ∧ p.2.mask.getLsbD 94=true ∧
    ShortGeo.mis.successor.read y.2=1 ∧ ShortGeo.mis.off.read y.1=0 := by decide

/-- Projection of the actual joined long bytes. The invalid decision
reads only the old right endpoint, so a valid WAIT or a nonheader does
not acquire the repair's masks. Other source/lanes remain backend work. -/
theorem largePair_long_invalid_door {a : LargeParams} (b : LargeRows a)
    (x : Pair (LargeSite a)) (head : (oldHeaders b x.2).h6=true)
    (bad : LongDoorGuard.valid a.alu x.2.long=false) :
    let y := (largePair b x).2.long
    (LongDoorGuard.phaseField a.alu).read y=1 ∧ (LongDoorGuard.opcodeField a.alu).read y=0 ∧
      (LongDoorGuard.fileField a.alu).read y=0 ∧ (LongDoorGuard.k0Field a.alu).read y=0 := by
  let g := Pair.map (longGeometry b) x
  let old := Pair.map LargeSite.long x
  let p := (b.longWork g old).2.compose (b.longScratch g old).2
  have hY : (largePair b x).2.long=(LongDoorGuard.repair a.alu).apply (p.apply x.2.long) := by
    change (LongDoorGuard.guard a.alu (oldHeaders b x.2).h6 x.2.long p).apply x.2.long=_
    rw [head,LongDoorGuard.invalid_override _ _ _ bad,Patch.compose_apply]
  dsimp only
  rw [hY]
  exact LongDoorGuard.repair_values a.alu (p.apply x.2.long)

def boundedReference {N : Nat} (b : BitVec (boundedProviderWidth N)) : RefView :=
  ⟨true,b.getLsbD (4+ell (N+1))⟩

def boundedPair {N p c1 : Nat} (b : BoundedRows N p c1) (x : Pair (BoundedSite N p c1)) :
    Pair (BoundedSite N p c1) :=
  let old := Pair.map BoundedSite.provider x
  let new := patchPair (b.provider old) old
  let (g,p) := sharedWork b.shared (Pair.map BoundedSite.guard x)
    (Pair.map boundedReference old) (Pair.map boundedReference new) (Pair.map BoundedSite.publicRow x)
  (⟨new.1,g.1,p.1⟩,⟨new.2,g.2,p.2⟩)

/-- Common external advice determines the branch before execution. -/
def joinedPair : (a : Layout) → a.Rows → Pair a.State → Pair a.State
  | .large _, b,x => largePair b x
  | .bounded _ _ _, b,x => boundedPair b x

/-- Packed-site slice transport. The typed join and the raw alphabet
use the very same two-sided coding; there is no extra quotient. -/
def packedPair (a : Layout) (b : a.Rows) :
    Pair (Fin (2^a.width)) → Pair (Fin (2^a.width)) :=
  fun x => Pair.map (stateCoding a).encode (joinedPair a b (Pair.map (stateCoding a).decode x))

theorem packedPair_project (a : Layout) (b : a.Rows) (x : Pair (Fin (2^a.width))) :
    Pair.map (stateCoding a).decode (packedPair a b x) =
    joinedPair a b (Pair.map (stateCoding a).decode x) := by
  unfold packedPair Pair.map
  rw [(stateCoding a).left_inv,(stateCoding a).left_inv]

end L4.AllSizeProtocol

