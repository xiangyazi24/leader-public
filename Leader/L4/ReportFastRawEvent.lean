import Leader.L4.ReportFastKernel
import Leader.L4.ReportResetRawHooks
import Leader.L4.ReportRawCommitSnapshot
import Leader.L4.AdviceBandRadiusBudget

namespace L4.ReportFastRawEvent
open AllSizeProtocol PhysicalCustody ReportByteRows ReportResetRawHooks ReportFastKernel

/-- Boolean COMMIT acceptance at the old pair, before any return or
source update. This test makes no claim about transaction ancestry. -/
def accepts (p : Params) (hu : Bool) (u v : BitVec p.w) : Bool :=
  let t := oldReportToken p hu u 0
  decide (t = {tag:=2,opcode:=commitOp p,payload:=t.payload}) &&
    packetCommitGuard p v t

theorem accepts_iff (p : Params) (hu : Bool) (u v : BitVec p.w) :
    accepts p hu u v=true ↔
      CommitGuard p hu u v (oldReportToken p hu u 0).payload := by
  unfold accepts packetCommitGuard CommitGuard oldReportToken
  simp
  intro T
  have A := congrArg MISByteCodec.Token.applied T
  exact ⟨fun H => ⟨H.1.1.2,H.1.2,H.2⟩,
    fun H => ⟨⟨⟨A,H.1⟩,H.2.1⟩,H.2.2⟩⟩

/-- Target of a guarded incoming COMMIT is the old right header. The
fixed lower mask is checked too, so this is total on all raw bytes. -/
def classify (d : Sheet) {s n : Nat} (h : Fin n→Bool)
    (x : Raw s n) (e : Fin n) : Option {i : Fin n // h i=true} :=
  let r := rightNeighbor e
  if H : h r=true then
    if lower d (oldHeaders (rows s) (x r)) &&
      accepts (params d s) (lower d (oldHeaders (rows s) (x e)))
        (selectBytes d (x e)) (selectBytes d (x r))
    then some ⟨r,H⟩ else none
  else none

theorem classify_iff (d : Sheet) {s n : Nat} (h : Fin n→Bool)
    (x : Raw s n) (e : Fin n) (j : {i : Fin n // h i=true}) :
    let r := rightNeighbor e
    let hu := lower d (oldHeaders (rows s) (x e))
    let p := params d s
    let u := selectBytes d (x e)
    let v := selectBytes d (x r)
    classify d h x e=some j ↔
      r=j.val ∧ lower d (oldHeaders (rows s) (x r))=true ∧
        CommitGuard p hu u v (oldReportToken p hu u 0).payload := by
  dsimp [classify]
  by_cases M : h (rightNeighbor e)=true
  · rw [dif_pos M]
    by_cases C : (lower d (oldHeaders (rows s) (x (rightNeighbor e))) &&
        accepts (params d s) (lower d (oldHeaders (rows s) (x e)))
          (selectBytes d (x e)) (selectBytes d (x (rightNeighbor e)))) = true
    · rw [if_pos C]
      have H := (Bool.and_eq_true_iff.mp C)
      constructor
      · intro E
        exact ⟨congrArg Subtype.val (Option.some.inj E), H.1,(accepts_iff ..).mp H.2⟩
      · intro E
        exact congrArg some (Subtype.ext E.1)
    · rw [if_neg C]
      constructor
      · intro E
        cases E
      · intro E
        exact False.elim (C (Bool.and_eq_true_iff.mpr ⟨E.2.1,(accepts_iff ..).mpr E.2.2⟩))
  · rw [dif_neg M]
    constructor
    · intro E
      cases E
    · intro E
      exact False.elim (M (E.1.symm ▸ j.property))

/-- A detected mark really performs the old-snapshot selected write.
Whether the packet was generated by its owner is a separate invariant. -/
theorem classified_snapshot (d : Sheet) {s n : Nat} (h : Fin n→Bool)
    (x : Raw s n) (e : Fin n) (j : {i : Fin n // h i=true})
    (E : e≠rightNeighbor e) (K : classify d h x e=some j) :
    let p := params d s
    let u := selectBytes d (x e)
    let hu := lower d (oldHeaders (rows s) (x e))
    let a := (oldReportToken p hu u 0).payload
    let v := selectBytes d (x j.val)
    let y := selectBytes d (rawNext s x e j.val)
    let ix := (a/4)%2
    publicationSelector p y=ix ∧ publicationA p y ix=Z p v ∧
      publicationPair p y ix=a%4 ∧
      Z p y=(if paints p true 1 v then publicationPair p v (publicationSelector p v)==0 else Z p v) := by
  obtain ⟨J,R,G⟩ := (classify_iff d h x e j).mp K
  dsimp only
  rw [← J]
  cases d
  · exact ReportRawCommitSnapshot.report1_commit_same_mark x e E R _ G
  · exact ReportRawCommitSnapshot.report2_commit_same_mark x e E R _ G

def maxWidth (d : Sheet) (s : Nat) : Nat :=
  match d with
  | .first => 81
  | .second => 81*(2*s+1)

def mu (d : Sheet) (s : Nat) : Nat :=
  coefficient (params d s).digits (maxWidth d s)

theorem mu_first_constant (s : Nat) : mu .first s=coefficient 1 81 := rfl

theorem mu_second_poly {s : Nat} (H : 6≤s) :
    mu .second s ≤ coefficient (s+1) (81*(2*s+1)) := by
  unfold mu coefficient maxWidth
  exact Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ (Nat.mul_le_mul_left _
    (AdviceBandRadiusBudget.t2_le H)))

end L4.ReportFastRawEvent
